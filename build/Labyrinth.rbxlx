      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Building</string>
          <string name="Source"><![CDATA[-- Строительство как в Rust: сетка 8x8, фундамент, стены, проём с дверью, окно,
-- перекрытие и лестница. Ставятся чертежом (из досок), улучшаются молотком:
-- чертёж → дерево → камень → металл.
-- Здесь общие для сервера и клиента вещи: список деталей, уровни и привязка к сетке.

local Building = {}

local V = Vector3.new
local RGB = Color3.fromRGB

Building.Grid = 8
Building.WallH = 8
local G = Building.Grid

Building.Pieces = {
	{ Id = "foundation", Name = "Фундамент", Cost = { planks = 6 }, Size = V(8, 3, 8) },
	{ Id = "wall", Name = "Стена", Cost = { planks = 4 }, Size = V(8, 8, 0.8), Edge = true },
	{ Id = "doorway", Name = "Проём с дверью", Cost = { planks = 6 }, Size = V(8, 8, 0.8), Edge = true },
	{ Id = "window", Name = "Стена с окном", Cost = { planks = 4 }, Size = V(8, 8, 0.8), Edge = true },
	{ Id = "floor", Name = "Перекрытие / крыша", Cost = { planks = 4 }, Size = V(8, 0.8, 8) },
	{ Id = "stairs", Name = "Лестница", Cost = { planks = 5 }, Size = V(7.6, 8, 8) },
}
Building.ById = {}
for i, p in ipairs(Building.Pieces) do
	p.Index = i
	Building.ById[p.Id] = p
end

Building.Tiers = {
	[0] = { Name = "Чертёж", Color = RGB(205, 180, 125), Material = Enum.Material.WoodPlanks, HP = 40 },
	[1] = { Name = "Дерево", Color = RGB(118, 82, 50), Material = Enum.Material.WoodPlanks, HP = 150, Cost = { wood = 6 } },
	[2] = { Name = "Камень", Color = RGB(128, 128, 124), Material = Enum.Material.Slate, HP = 400, Cost = { stone = 8 } },
	[3] = { Name = "Металл", Color = RGB(92, 96, 102), Material = Enum.Material.DiamondPlate, HP = 900, Cost = { iron = 4 } },
}

-- CFrame детали по параметрам привязки
-- cell-детали: {cx, cz, y, rot}; y — поверхность, на которую ставим (у фундамента — его верх)
-- edge-детали: {ex, ez, axis, y}
function Building.cframe(id, O, a)
	if id == "foundation" then
		return CFrame.new(O + V((a.cx + 0.5) * G, a.y - 1.5, (a.cz + 0.5) * G))
	elseif id == "floor" then
		return CFrame.new(O + V((a.cx + 0.5) * G, a.y + 0.4, (a.cz + 0.5) * G))
	elseif id == "stairs" then
		return CFrame.new(O + V((a.cx + 0.5) * G, a.y + 4, (a.cz + 0.5) * G)) * CFrame.Angles(0, (a.rot or 0) * math.pi / 2, 0)
	else
		if a.axis == "X" then
			return CFrame.new(O + V((a.ex + 0.5) * G, a.y + 4, a.ez * G))
		else
			return CFrame.new(O + V(a.ex * G, a.y + 4, (a.ez + 0.5) * G)) * CFrame.Angles(0, math.pi / 2, 0)
		end
	end
end

-- уникальный ключ места (две детали в одно место поставить нельзя)
function Building.key(id, a)
	local y = math.floor(a.y * 2 + 0.5)
	if Building.ById[id].Edge then
		return "E:" .. a.ex .. ":" .. a.ez .. ":" .. a.axis .. ":" .. y
	elseif id == "stairs" then
		return "S:" .. a.cx .. ":" .. a.cz .. ":" .. y
	else
		return "C:" .. a.cx .. ":" .. a.cz .. ":" .. y
	end
end

-- верх детали — сюда ставится следующая
function Building.top(id, a)
	if id == "foundation" then
		return a.y
	elseif id == "floor" then
		return a.y + 0.8
	else
		return a.y + Building.WallH
	end
end

local function pieceOf(inst)
	while inst and inst ~= workspace do
		if inst:IsA("Model") and inst:GetAttribute("BKind") then
			return inst
		end
		inst = inst.Parent
	end
end
Building.pieceOf = pieceOf

local function dominant(v)
	if math.abs(v.X) > math.abs(v.Z) then
		return v.X > 0 and 1 or -1, 0
	end
	return 0, v.Z > 0 and 1 or -1
end

-- куда встанет деталь, если смотреть в точку pos (hitInst — во что попали)
-- pieces — список уже стоящих деталей (Model с атрибутами)
function Building.snap(id, O, pos, hitInst, look, pieces)
	local piece = pieceOf(hitInst)
	local rel = pos - O
	local flat = V(look.X, 0, look.Z)
	flat = flat.Magnitude > 0.01 and flat.Unit or V(0, 0, -1)
	local pk = piece and piece:GetAttribute("BKind")
	local def = Building.ById[id]
	if id == "foundation" then
		if pk == "foundation" then
			local dx, dz = dominant(flat)
			return { cx = piece:GetAttribute("CX") + dx, cz = piece:GetAttribute("CZ") + dz, y = piece:GetAttribute("Top") }
		end
		if piece then
			return nil
		end
		local cx, cz = math.floor(rel.X / G), math.floor(rel.Z / G)
		local y = pos.Y + 0.8
		-- рядом уже есть фундамент — встаём с ним вровень
		for _, p in ipairs(pieces) do
			if p:GetAttribute("BKind") == "foundation" then
				local px, pz = p:GetAttribute("CX"), p:GetAttribute("CZ")
				if math.abs(px - cx) + math.abs(pz - cz) == 1 and math.abs(p:GetAttribute("Top") - y) < 4 then
					y = p:GetAttribute("Top")
					break
				end
			end
		end
		return { cx = cx, cz = cz, y = y }
	elseif def.Edge then
		if pk == "foundation" or pk == "floor" then
			local cx, cz = piece:GetAttribute("CX"), piece:GetAttribute("CZ")
			local u, w = rel.X - cx * G, rel.Z - cz * G
			local y = piece:GetAttribute("Top")
			local best = math.min(u, G - u, w, G - w)
			if best == u then
				return { ex = cx, ez = cz, axis = "Z", y = y }
			elseif best == G - u then
				return { ex = cx + 1, ez = cz, axis = "Z", y = y }
			elseif best == w then
				return { ex = cx, ez = cz, axis = "X", y = y }
			else
				return { ex = cx, ez = cz + 1, axis = "X", y = y }
			end
		elseif pk and Building.ById[pk].Edge then
			-- стена на стену (второй этаж без перекрытия)
			return { ex = piece:GetAttribute("EX"), ez = piece:GetAttribute("EZ"), axis = piece:GetAttribute("Axis"), y = piece:GetAttribute("Top") }
		end
		return nil
	elseif id == "floor" then
		if pk and Building.ById[pk].Edge then
			local q = rel + flat * 4
			return { cx = math.floor(q.X / G), cz = math.floor(q.Z / G), y = piece:GetAttribute("Top") }
		elseif pk == "floor" then
			local dx, dz = dominant(flat)
			return { cx = piece:GetAttribute("CX") + dx, cz = piece:GetAttribute("CZ") + dz, y = piece:GetAttribute("Base") }
		end
		return nil
	elseif id == "stairs" then
		if pk == "foundation" or pk == "floor" then
			local dx, dz = dominant(flat)
			-- клин поднимается от игрока вперёд (высокий край клина — его +Z)
			local rot = (dz == -1 and 2) or (dx == -1 and 3) or (dz == 1 and 0) or 1
			return { cx = piece:GetAttribute("CX"), cz = piece:GetAttribute("CZ"), y = piece:GetAttribute("Top"), rot = rot }
		end
		return nil
	end
end

return Building
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- Настройки игры «ЛАБИРИНТ». Здесь меняется всё: размер лабиринта, длина дня и ночи, монстры.

local Config = {}

Config.GameTitle = "ЛАБИРИНТ"

-- Тестовые кнопки (полный свет, полёт, день/ночь, ресурсы). Перед публикацией поставь false!
Config.DevTools = true

Config.Maze = {
	Cells = 41, -- лабиринт 41 x 41 клеток (41 x 32 = 1312 studs)
	CellSize = 32, -- ширина коридора
	WallHeight = 56,
	WallThickness = 4,
	ClearingCells = 13, -- поляна в центре 13 x 13 клеток (416 x 416)
	ExtraOpenings = 0.07,
	Mines = 11,
	Chests = 42,
	Cracks = 44, -- узкие щели в стенах (пролезть можно только пригнувшись)
}
Config.GateWidth = 32
Config.SlotSpacing = 3000 -- у каждой группы свой лабиринт, далеко друг от друга

-- Сложность: выбирается лифтом в лобби
Config.Difficulty = {
	easy = { Name = "ЛЕГКО", Color = { 90, 200, 110 }, Day = 360, Night = 120, Monsters = 2, PerPlayer = 0.5, Damage = 14, Speed = 17, Health = 200, Coins = 1 },
	normal = { Name = "ОБЫЧНО", Color = { 230, 190, 70 }, Day = 300, Night = 150, Monsters = 4, PerPlayer = 1, Damage = 22, Speed = 19, Health = 260, Coins = 2 },
	hard = { Name = "ТЯЖЕЛО", Color = { 220, 70, 60 }, Day = 240, Night = 180, Monsters = 7, PerPlayer = 1.5, Damage = 30, Speed = 21, Health = 340, Coins = 3 },
}
Config.WarningTime = 30

-- Игрок
Config.WalkSpeed = 16
Config.SprintSpeed = 24
Config.CrouchSpeed = 7
Config.StaminaMax = 100
Config.StaminaDrain = 22
Config.StaminaRegen = 14
Config.BerryHeal = 20
Config.DownedTime = 45 -- сколько секунд раненый ждёт помощи
Config.ReviveHealth = 40

-- Монеты: за каждый прожитый день и за побег (умножаются на сложность)
Config.CoinsPerDay = 10
Config.CoinsEscape = 100

-- Классы у торговца в лобби
Config.Classes = {
	{ Id = "none", Name = "Без класса", Price = 0, Desc = "Обычный выживший." },
	{ Id = "runner", Name = "Бегун", Price = 100, Desc = "+30% скорость бега, +60 выносливости." },
	{ Id = "lumber", Name = "Лесоруб", Price = 120, Desc = "Начинает с каменным топором. Дерева в 2 раза больше." },
	{ Id = "miner", Name = "Шахтёр", Price = 150, Desc = "Начинает с каменной киркой. Добыча руды +50%." },
	{ Id = "warrior", Name = "Воин", Price = 250, Desc = "+40 здоровья. Начинает с копьём." },
}

-- Скрежетники — ночные монстры лабиринта (урон, скорость, здоровье — из сложности)
Config.Monster = {
	Name = "Скрежетник",
	AttackCooldown = 1.3,
	AttackRange = 7,
	PatrolSpeed = 10,
	SightRange = 110,
	HearRange = 35,
}

Config.Elevator = {
	Countdown = 15,
	RideTime = 9,
	MaxPlayers = 5,
}

Config.NodeRespawn = 90

Config.Sounds = {
	Hit = "rbxasset://sounds/action_jump_land.mp3",
	Swing = "rbxasset://sounds/swoosh.wav",
	Pickup = "rbxasset://sounds/electronicpingshort.wav",
	Click = "rbxasset://sounds/button.wav",
	Hurt = "rbxasset://sounds/uuhhh.mp3",
	Rumble = "rbxasset://sounds/action_falling.mp3",
	Step = "rbxasset://sounds/action_footsteps_plastic.mp3",
}

Config.Animations = {
	Walk = "rbxassetid://507777826",
	Run = "rbxassetid://507767714",
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">ItemModels</string>
          <string name="Source"><![CDATA[-- 3D-модели инструментов и оружия. Используются и в руках персонажа (видят другие игроки),
-- и в виде от первого лица (руки игрока).
-- Модель строится вдоль оси Y: рукоять в начале координат, рабочая часть вверху.

local Items = require(script.Parent.Items)

local ItemModels = {}

local V = Vector3.new
local RGB = Color3.fromRGB
local WOOD = RGB(110, 76, 46)

local function part(model, name, size, cf, color, material)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.Anchored = true
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = model
	return p
end

-- build(id, base): base — CFrame рукояти. Возвращает Model с PrimaryPart "Grip".
function ItemModels.build(id, base)
	base = base or CFrame.new()
	local def = Items.Tools[id]
	local m = Instance.new("Model")
	m.Name = "Item_" .. id
	if not def or def.Kind == "fists" then
		local grip = part(m, "Grip", V(0.1, 0.1, 0.1), base, WOOD)
		grip.Transparency = 1
		m.PrimaryPart = grip
		return m
	end
	local c = def.Color and RGB(def.Color[1], def.Color[2], def.Color[3]) or RGB(150, 150, 150)
	local metal = (id:find("iron") or id:find("crystal")) and Enum.Material.Metal or Enum.Material.Slate
	if id:find("crystal") then
		metal = Enum.Material.Neon
	end

	if def.Kind == "pickaxe" then
		local grip = part(m, "Grip", V(0.25, 3.2, 0.25), base * CFrame.new(0, 1.2, 0), WOOD, Enum.Material.Wood)
		-- голова кирки лежит в плоскости удара (острия вперёд и назад)
		part(m, "Head", V(0.35, 0.35, 2.4), base * CFrame.new(0, 2.7, 0), c, metal)
		part(m, "Collar", V(0.45, 0.5, 0.45), base * CFrame.new(0, 2.7, 0), RGB(70, 60, 50), Enum.Material.Metal)
		for _, sz in ipairs({ -1, 1 }) do
			part(m, "Tip", V(0.22, 0.22, 0.7), base * CFrame.new(0, 2.55, sz * 1.4) * CFrame.Angles(math.rad(25 * sz), 0, 0), c, metal)
		end
		m.PrimaryPart = grip
	elseif def.Kind == "axe" then
		local grip = part(m, "Grip", V(0.25, 3, 0.25), base * CFrame.new(0, 1.1, 0), WOOD, Enum.Material.Wood)
		part(m, "Head", V(0.25, 1, 1.3), base * CFrame.new(0, 2.25, -0.55), c, metal)
		part(m, "Edge", V(0.12, 1.3, 0.25), base * CFrame.new(0, 2.25, -1.25), RGB(200, 200, 205), Enum.Material.Metal)
		m.PrimaryPart = grip
	elseif def.Kind == "sword" then
		local grip = part(m, "Grip", V(0.25, 0.9, 0.25), base * CFrame.new(0, 0.2, 0), RGB(50, 34, 24), Enum.Material.Wood)
		part(m, "Pommel", V(0.35, 0.25, 0.35), base * CFrame.new(0, -0.35, 0), c, metal)
		part(m, "Guard", V(1.1, 0.18, 0.3), base * CFrame.new(0, 0.72, 0), RGB(90, 80, 60), Enum.Material.Metal)
		local blade = part(m, "Blade", V(0.12, 3.3, 0.38), base * CFrame.new(0, 2.45, 0), c, metal)
		blade.Reflectance = 0.15
		part(m, "BladeTip", V(0.12, 0.45, 0.26), base * CFrame.new(0, 4.25, 0), c, metal)
		if id:find("crystal") then
			local l = Instance.new("PointLight")
			l.Color = c
			l.Range = 8
			l.Brightness = 1.2
			l.Parent = blade
		end
		m.PrimaryPart = grip
	elseif def.Kind == "spear" then
		local grip = part(m, "Grip", V(0.2, 6, 0.2), base * CFrame.new(0, 1.5, 0), WOOD, Enum.Material.Wood)
		part(m, "Tip", V(0.14, 1, 0.38), base * CFrame.new(0, 5, 0), c, metal)
		part(m, "Binding", V(0.28, 0.4, 0.28), base * CFrame.new(0, 4.4, 0), RGB(140, 120, 80), Enum.Material.Fabric)
		m.PrimaryPart = grip
	elseif def.Kind == "torch" then
		local grip = part(m, "Grip", V(0.28, 2.2, 0.28), base * CFrame.new(0, 0.6, 0), WOOD, Enum.Material.Wood)
		local head = part(m, "Flame", V(0.5, 0.55, 0.5), base * CFrame.new(0, 1.9, 0), RGB(255, 140, 40), Enum.Material.Neon)
		local l = Instance.new("PointLight")
		l.Color = RGB(255, 170, 90)
		l.Range = 26
		l.Brightness = 1.6
		l.Shadows = true
		l.Parent = head
		local fire = Instance.new("Fire")
		fire.Size = 2
		fire.Heat = 4
		fire.Parent = head
		m.PrimaryPart = grip
	end
	if def.Kind == "blueprint" then
		-- свёрнутый синий чертёж
		local grip = part(m, "Grip", V(0.5, 1.8, 0.5), base * CFrame.new(0, 0.5, 0), RGB(60, 100, 180), Enum.Material.Fabric)
		part(m, "Sheet", V(0.08, 1.6, 1.4), base * CFrame.new(0.3, 0.9, -0.5), RGB(90, 140, 220), Enum.Material.SmoothPlastic)
		part(m, "Line", V(0.1, 1.2, 0.06), base * CFrame.new(0.32, 0.9, -0.5), RGB(230, 240, 255), Enum.Material.Neon)
		m.PrimaryPart = grip
	elseif def.Kind == "hammer" then
		local grip = part(m, "Grip", V(0.25, 2.2, 0.25), base * CFrame.new(0, 0.8, 0), WOOD, Enum.Material.Wood)
		part(m, "Head", V(0.5, 0.5, 1.3), base * CFrame.new(0, 2, -0.1), c, Enum.Material.Metal)
		m.PrimaryPart = grip
	end
	-- точка опоры модели = рукоять (base), чтобы PivotTo ставил рукоять в руку
	if m.PrimaryPart then
		m.PrimaryPart.PivotOffset = m.PrimaryPart.CFrame:ToObjectSpace(base)
	end
	return m
end

return ItemModels
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Items</string>
          <string name="Source"><![CDATA[-- Ресурсы, инструменты, оружие и рецепты.

local Items = {}

Items.Resources = {
	wood = { Name = "Дерево", Order = 1 },
	stone = { Name = "Камень", Order = 2 },
	fiber = { Name = "Трава", Order = 3 },
	iron = { Name = "Железо", Order = 4 },
	crystal = { Name = "Кристалл", Order = 5 },
	fang = { Name = "Клык Скрежетника", Order = 6 },
	berry = { Name = "Ягоды (H — съесть)", Order = 7 },
	bandage = { Name = "Бинт (поднять друга)", Order = 8 },
	planks = { Name = "Доски", Order = 9 },
	key = { Name = "КЛЮЧ-КАРТА ВЫХОДА", Order = 10 },
}

-- Kind: pickaxe / axe / sword / spear / torch / blueprint / hammer. Tier — что может добывать.
Items.Tools = {
	fists = { Name = "Кулаки", Kind = "fists", Tier = 0, Damage = 5, Range = 7 },
	wood_pickaxe = { Name = "Деревянная кирка", Kind = "pickaxe", Tier = 1, Damage = 6, Range = 9, Color = { 120, 85, 50 } },
	stone_pickaxe = { Name = "Каменная кирка", Kind = "pickaxe", Tier = 2, Damage = 8, Range = 9, Color = { 120, 120, 125 } },
	iron_pickaxe = { Name = "Железная кирка", Kind = "pickaxe", Tier = 3, Damage = 11, Range = 9, Color = { 190, 190, 200 } },
	wood_axe = { Name = "Деревянный топор", Kind = "axe", Tier = 1, Damage = 9, Range = 9, Color = { 120, 85, 50 } },
	stone_axe = { Name = "Каменный топор", Kind = "axe", Tier = 2, Damage = 14, Range = 9, Color = { 120, 120, 125 } },
	spear = { Name = "Копьё", Kind = "spear", Tier = 0, Damage = 22, Range = 13, Color = { 120, 120, 125 } },
	stone_sword = { Name = "Каменный меч", Kind = "sword", Tier = 0, Damage = 26, Range = 9, Color = { 130, 130, 135 } },
	iron_sword = { Name = "Железный меч", Kind = "sword", Tier = 0, Damage = 40, Range = 9.5, Color = { 200, 200, 210 } },
	crystal_blade = { Name = "Кристальный клинок", Kind = "sword", Tier = 0, Damage = 65, Range = 10, Color = { 170, 90, 255 } },
	torch = { Name = "Факел", Kind = "torch", Tier = 0, Damage = 0, Range = 0, Color = { 255, 150, 60 } },
	blueprint = { Name = "Чертёж (строить)", Kind = "blueprint", Tier = 0, Damage = 0, Range = 0, Color = { 70, 110, 190 } },
	hammer = { Name = "Молоток (улучшать)", Kind = "hammer", Tier = 0, Damage = 4, Range = 10, Color = { 110, 110, 115 } },
}

-- Station: nil — крафт из инвентаря (C), "bench" — нужен верстак рядом (Level — его уровень)
Items.Recipes = {
	{ Id = "workbench", Name = "Верстак (поставить перед собой)", Cost = { wood = 12, stone = 4 }, Place = "workbench" },
	{ Id = "bandage", Name = "Бинт", Cost = { fiber = 3 }, Res = "bandage" },
	{ Id = "torch", Cost = { wood = 3, fiber = 1 } },
	{ Id = "planks", Name = "Доски ×4", Cost = { wood = 3 }, Res = "planks", Amount = 4 },
	{ Id = "blueprint", Cost = { planks = 4 } },
	{ Id = "hammer", Cost = { wood = 3, stone = 2 } },
	{ Id = "bed", Name = "Кровать (поставить; ночью — проспать ночь)", Cost = { planks = 8, fiber = 6 }, Place = "bed" },
	{ Id = "chest", Name = "Сундук-хранилище (поставить)", Cost = { planks = 10 }, Place = "chest" },
	{ Id = "stone_pickaxe", Station = "bench", Level = 1, Cost = { wood = 5, stone = 8 } },
	{ Id = "stone_axe", Station = "bench", Level = 1, Cost = { wood = 5, stone = 6 } },
	{ Id = "spear", Station = "bench", Level = 1, Cost = { wood = 8, stone = 3, fiber = 2 } },
	{ Id = "stone_sword", Station = "bench", Level = 1, Cost = { wood = 4, stone = 12 } },
	{ Id = "upgrade2", Station = "bench", Level = 1, Name = "Улучшить верстак до 2 уровня", Cost = { wood = 20, stone = 20, iron = 6 } },
	{ Id = "iron_pickaxe", Station = "bench", Level = 2, Cost = { wood = 6, iron = 10 } },
	{ Id = "iron_sword", Station = "bench", Level = 2, Cost = { wood = 6, iron = 14 } },
	{ Id = "crystal_blade", Station = "bench", Level = 2, Cost = { iron = 8, crystal = 6, fang = 3 } },
}

-- Что добывается и чем
Items.Nodes = {
	tree = { Name = "Дерево", Tool = "axe", Tier = 1, Health = 40, Drop = "wood", Amount = 2, Action = "Рубить" },
	stone = { Name = "Камень", Tool = "pickaxe", Tier = 1, Health = 40, Drop = "stone", Amount = 2, Action = "Добыть" },
	iron = { Name = "Железная руда", Tool = "pickaxe", Tier = 2, Health = 60, Drop = "iron", Amount = 2, Action = "Добыть" },
	crystal = { Name = "Кристалл", Tool = "pickaxe", Tier = 3, Health = 80, Drop = "crystal", Amount = 2, Action = "Добыть" },
}

function Items.toolName(id)
	local t = Items.Tools[id]
	return t and t.Name or id
end

return Items
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="8">
        <Properties>
          <string name="Name">R6Animate</string>
          <string name="Source"><![CDATA[-- Анимации квадратного (R6) персонажа: стоять, идти, прыгать, падать.
-- Копируется в персонажа сервером (лежит в ReplicatedStorage и сам там не работает).

local char = script.Parent
if not char:IsA("Model") or not char:FindFirstChildOfClass("Humanoid") then
	return
end
local hum = char:FindFirstChildOfClass("Humanoid")
local animator = hum:FindFirstChildOfClass("Animator")
if not animator then
	animator = Instance.new("Animator")
	animator.Parent = hum
end

local function load(id, looped)
	local a = Instance.new("Animation")
	a.AnimationId = id
	local ok, track = pcall(function()
		return animator:LoadAnimation(a)
	end)
	if ok and track then
		track.Looped = looped
		return track
	end
	return nil
end

local idle = load("rbxassetid://180435571", true)
local walk = load("rbxassetid://180426354", true)
local jump = load("rbxassetid://125750702", false)
local fall = load("rbxassetid://180436148", true)

if idle then
	idle:Play()
end

hum.Running:Connect(function(speed)
	if speed > 0.5 then
		if walk and not walk.IsPlaying then
			walk:Play(0.2)
		end
		if walk then
			walk:AdjustSpeed(math.clamp(speed / 14, 0.5, 2))
		end
		if idle then
			idle:Stop(0.2)
		end
	else
		if walk then
			walk:Stop(0.2)
		end
		if idle and not idle.IsPlaying then
			idle:Play(0.2)
		end
	end
end)
hum.Jumping:Connect(function(active)
	if active and jump then
		jump:Play(0.1)
	end
end)
hum.FreeFalling:Connect(function(active)
	if fall then
		if active then
			fall:Play(0.2)
		else
			fall:Stop(0.2)
		end
	end
end)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="9">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="10">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Build</string>
          <string name="Source"><![CDATA[-- Постройки игроков: детали дома (по сетке), кровать, сундук.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Parts = require(script.Parent.Parts)
local Building = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Building"))

local Build = {}

local V = Vector3.new
local RGB = Color3.fromRGB
local M = Enum.Material

local function prompt(part, action, object, hold, dist)
	local p = Instance.new("ProximityPrompt")
	p.ActionText = action
	p.ObjectText = object or ""
	p.HoldDuration = hold or 0
	p.MaxActivationDistance = dist or 10
	p.RequiresLineOfSight = false
	p.Parent = part
	return p
end

-- перекрасить деталь под уровень
function Build.setTier(model, tier)
	local t = Building.Tiers[tier]
	model:SetAttribute("Tier", tier)
	model:SetAttribute("HP", t.HP)
	for _, d in ipairs(model:GetChildren()) do
		if d:IsA("BasePart") and d.Name ~= "Door" and d.Name ~= "Handle" then
			d.Color = t.Color
			d.Material = t.Material
			d.Transparency = tier == 0 and 0.15 or 0
		end
	end
end

-- деталь по сетке. a — параметры привязки (см. Building.cframe)
function Build.piece(parent, id, O, a)
	local def = Building.ById[id]
	local cf = Building.cframe(id, O, a)
	local m = Instance.new("Model")
	m.Name = def.Name
	m:SetAttribute("BKind", id)
	m:SetAttribute("Key", Building.key(id, a))
	m:SetAttribute("Base", a.y)
	m:SetAttribute("Top", Building.top(id, a))
	if def.Edge then
		m:SetAttribute("EX", a.ex)
		m:SetAttribute("EZ", a.ez)
		m:SetAttribute("Axis", a.axis)
	else
		m:SetAttribute("CX", a.cx)
		m:SetAttribute("CZ", a.cz)
	end
	local c = RGB(200, 180, 120)
	local function part(name, rel, size)
		return Parts.box(m, name, cf * rel, size, c, M.WoodPlanks)
	end
	if id == "foundation" or id == "floor" then
		part("Slab", CFrame.new(), def.Size)
	elseif id == "wall" then
		part("Wall", CFrame.new(), def.Size)
	elseif id == "window" then
		part("Wall", CFrame.new(0, -2.5, 0), V(8, 3, 0.8))
		part("Wall", CFrame.new(0, 3, 0), V(8, 2, 0.8))
		part("Wall", CFrame.new(-2.75, 0.5, 0), V(2.5, 3, 0.8))
		part("Wall", CFrame.new(2.75, 0.5, 0), V(2.5, 3, 0.8))
		Parts.box(m, "Bar", cf * CFrame.new(0, 0.5, 0), V(0.25, 3, 0.25), RGB(60, 50, 40), M.Wood)
	elseif id == "doorway" then
		part("Wall", CFrame.new(-2.9, 0, 0), V(2.2, 8, 0.8))
		part("Wall", CFrame.new(2.9, 0, 0), V(2.2, 8, 0.8))
		part("Wall", CFrame.new(0, 3.1, 0), V(3.6, 1.8, 0.8))
		-- дверь на петлях (левый край)
		local hinge = cf * CFrame.new(-1.8, -0.9, 0)
		local door = Parts.box(m, "Door", hinge * CFrame.new(1.8, 0, 0), V(3.6, 6.2, 0.4), RGB(96, 64, 40), M.Wood)
		local handle = Parts.box(m, "Handle", hinge * CFrame.new(3.1, 0, -0.35), V(0.25, 0.6, 0.25), RGB(40, 40, 40), M.Metal, { CanCollide = false })
		local open = false
		local pr = prompt(door, "Открыть", "Дверь", 0, 8)
		local dRel, hRel = hinge:ToObjectSpace(door.CFrame), hinge:ToObjectSpace(handle.CFrame)
		pr.Triggered:Connect(function()
			open = not open
			pr.ActionText = open and "Закрыть" or "Открыть"
			local h = hinge * CFrame.Angles(0, open and math.rad(100) or 0, 0)
			TweenService:Create(door, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { CFrame = h * dRel }):Play()
			TweenService:Create(handle, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { CFrame = h * hRel }):Play()
		end)
	elseif id == "stairs" then
		local w = Instance.new("WedgePart")
		w.Name = "Steps"
		w.Anchored = true
		w.Size = def.Size
		w.CFrame = cf
		w.Parent = m
	end
	CollectionService:AddTag(m, "BuildPiece")
	Build.setTier(m, 0)
	m.Parent = parent
	return m
end

-- кровать: лечь и проспать ночь
function Build.bed(parent, cf)
	local m = Instance.new("Model")
	m.Name = "Bed"
	local wood = RGB(100, 70, 44)
	Parts.box(m, "Frame", cf * CFrame.new(0, 0.6, 0), V(4, 1.2, 7.5), wood, M.Wood)
	Parts.box(m, "Mattress", cf * CFrame.new(0, 1.45, 0.2), V(3.6, 0.6, 7), RGB(200, 190, 170), M.Fabric)
	Parts.box(m, "Blanket", cf * CFrame.new(0, 1.8, 1.3), V(3.7, 0.25, 4.6), RGB(120, 50, 45), M.Fabric)
	Parts.box(m, "Pillow", cf * CFrame.new(0, 1.9, -2.6), V(2.6, 0.5, 1.2), RGB(235, 230, 220), M.Fabric)
	Parts.box(m, "Headboard", cf * CFrame.new(0, 2, -3.6), V(4, 2.8, 0.4), wood, M.Wood)
	local pr = prompt(m:FindFirstChild("Mattress"), "Лечь спать", "Кровать", 0.4, 8)
	m:SetAttribute("SleepCF", cf * CFrame.new(0, 2.6, 0.4))
	m.Parent = parent
	return m, pr
end

-- сундук-хранилище
function Build.chest(parent, cf)
	local m = Instance.new("Model")
	m.Name = "StorageChest"
	local wood = RGB(110, 76, 46)
	local body = Parts.box(m, "Body", cf * CFrame.new(0, 1, 0), V(4.4, 2, 2.6), wood, M.WoodPlanks)
	Parts.box(m, "Lid", cf * CFrame.new(0, 2.3, 0), V(4.6, 0.6, 2.8), RGB(90, 60, 36), M.WoodPlanks)
	Parts.box(m, "Lock", cf * CFrame.new(0, 1.9, -1.45), V(0.6, 0.7, 0.2), RGB(200, 170, 60), M.Metal)
	local put = prompt(body, "Положить всё", "Сундук (пусто)", 0.3, 9)
	local take = prompt(body, "Забрать всё", "Сундук", 0.3, 9)
	take.KeyboardKeyCode = Enum.KeyCode.F
	take.UIOffset = Vector2.new(0, 70)
	m.Parent = parent
	return m, put, take
end

return Build
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="12">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Главный серверный скрипт «ЛАБИРИНТ».
-- Лобби (3 лифта сложности, торговец классами) -> лифт -> своя поляна и свой лабиринт для группы.
-- День: врата открыты, добывай и исследуй. Ночь: врата закрыты, Скрежетники.
-- Раненого поднимает друг бинтом. Найди Ключ и выход — улетай на вертолёте.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")
local PhysicsService = game:GetService("PhysicsService")
local DataStoreService = game:GetService("DataStoreService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Items = require(Shared:WaitForChild("Items"))
local ItemModels = require(Shared:WaitForChild("ItemModels"))
local World = require(script.Parent.World)
local Monster = require(script.Parent.Monster)
local Build = require(script.Parent.Build)
local Building = require(Shared:WaitForChild("Building"))

local V = Vector3.new

------------------------------------------------------------------
-- Remotes
------------------------------------------------------------------
local remotes = ReplicatedStorage:FindFirstChild("Remotes") or Instance.new("Folder")
remotes.Name = "Remotes"
remotes.Parent = ReplicatedStorage
local R = {}
for _, name in ipairs({
	"Swing", "Equip", "Craft", "Eat", "OpenCraft", "Notify", "PlayElevator", "Arrive", "Hurt", "HitMarker",
	"Outro", "Dev", "Crouch", "Note", "LiftSettings", "ShopOpen", "ShopBuy", "ShopSelect", "Build",
}) do
	local r = remotes:FindFirstChild(name) or Instance.new("RemoteEvent")
	r.Name = name
	r.Parent = remotes
	R[name] = r
end

------------------------------------------------------------------
-- Группы столкновений: пригнувшийся игрок проходит сквозь «крышку» щели
------------------------------------------------------------------
pcall(function()
	PhysicsService:RegisterCollisionGroup("CrawlCover")
	PhysicsService:RegisterCollisionGroup("Crawler")
	PhysicsService:CollisionGroupSetCollidable("CrawlCover", "Crawler", false)
end)

------------------------------------------------------------------
-- Освещение (время суток каждый игрок видит своё — его рисует клиент)
------------------------------------------------------------------
for _, c in ipairs(Lighting:GetChildren()) do
	if c:IsA("PostEffect") or c:IsA("Atmosphere") then
		c:Destroy()
	end
end
-- Небо НЕ удаляем: если вставить красивое небо из Toolbox в Lighting, оно останется
if not Lighting:FindFirstChildOfClass("Sky") then
	local sky = Instance.new("Sky")
	sky.StarCount = 4000
	sky.MoonAngularSize = 14
	sky.SunAngularSize = 16
	sky.Parent = Lighting
end
Lighting.GlobalShadows = true
Lighting.EnvironmentDiffuseScale = 0.6
Lighting.EnvironmentSpecularScale = 0.6
Lighting.ClockTime = 14
local atmo = Instance.new("Atmosphere")
atmo.Density = 0.3
atmo.Haze = 1.2
atmo.Parent = Lighting
for _, cls in ipairs({ "BloomEffect", "SunRaysEffect", "ColorCorrectionEffect", "DepthOfFieldEffect" }) do
	local e = Instance.new(cls)
	if cls == "BloomEffect" then
		e.Intensity, e.Size, e.Threshold = 0.5, 30, 1.1
	elseif cls == "SunRaysEffect" then
		e.Intensity, e.Spread = 0.12, 0.7
	elseif cls == "DepthOfFieldEffect" then
		e.FarIntensity, e.FocusDistance, e.InFocusRadius, e.NearIntensity = 0.12, 70, 100, 0
	end
	e.Parent = Lighting
end

------------------------------------------------------------------
-- Профиль: монеты и классы (сохраняются в опубликованной игре)
------------------------------------------------------------------
local profileStore
pcall(function()
	profileStore = DataStoreService:GetDataStore("LabyrinthProfile")
end)
local profiles = {}

local function syncProfile(p)
	local pr = profiles[p]
	p:SetAttribute("Coins", pr.coins)
	p:SetAttribute("Class", pr.class)
	p:SetAttribute("OwnedClasses", HttpService:JSONEncode(pr.owned))
end

local function saveProfile(p)
	local pr = profiles[p]
	if pr and profileStore then
		task.spawn(function()
			pcall(function()
				profileStore:SetAsync("u" .. p.UserId, HttpService:JSONEncode(pr))
			end)
		end)
	end
end

local function loadProfile(p)
	local pr = { coins = 0, owned = { "none" }, class = "none" }
	if profileStore then
		local ok, json = pcall(function()
			return profileStore:GetAsync("u" .. p.UserId)
		end)
		if ok and typeof(json) == "string" then
			local ok2, data = pcall(function()
				return HttpService:JSONDecode(json)
			end)
			if ok2 and typeof(data) == "table" then
				pr.coins = tonumber(data.coins) or 0
				pr.owned = typeof(data.owned) == "table" and data.owned or { "none" }
				pr.class = typeof(data.class) == "string" and data.class or "none"
			end
		end
	end
	profiles[p] = pr
	syncProfile(p)
end

local function addCoins(p, n)
	local pr = profiles[p]
	if pr then
		pr.coins += n
		syncProfile(p)
		saveProfile(p)
	end
end

------------------------------------------------------------------
-- Игроки и инвентарь
------------------------------------------------------------------
local lobby = World.BuildLobby()
local state = {} -- [player] = {...}
local sessions = {}
local usedSlots = {}

local function notify(p, text)
	R.Notify:FireClient(p, text)
end

local function sessionOf(p)
	local st = state[p]
	return st and st.session
end

local function notifySession(s, text)
	for _, p in ipairs(s.players) do
		notify(p, text)
	end
end

local function addRes(p, k, n)
	local st = state[p]
	st.res[k] = math.max(0, (st.res[k] or 0) + n)
	p:SetAttribute("Res_" .. k, st.res[k])
end

local function syncInventory(p)
	local st = state[p]
	for k in pairs(Items.Resources) do
		p:SetAttribute("Res_" .. k, st.res[k] or 0)
	end
	p:SetAttribute("Tools", HttpService:JSONEncode(st.tools))
	p:SetAttribute("Equipped", st.equipped)
end

local function freshInventory(p)
	local st = state[p]
	st.res, st.tools, st.equipped, st.gotSupply = {}, { "wood_pickaxe", "wood_axe" }, nil, false
	local cls = profiles[p] and profiles[p].class or "none"
	if cls == "lumber" then
		table.insert(st.tools, "stone_axe")
	elseif cls == "miner" then
		table.insert(st.tools, "stone_pickaxe")
	elseif cls == "warrior" then
		table.insert(st.tools, "spear")
	end
	syncInventory(p)
end

local function hrpOf(p)
	local c = p.Character
	return c and c:FindFirstChild("HumanoidRootPart"), c
end

local function place(p, cf, anchored)
	local hrp, char = hrpOf(p)
	if hrp then
		hrp.Anchored = anchored == true
		char:PivotTo(cf)
		hrp.AssemblyLinearVelocity = Vector3.zero
	end
end

local function inSafeZone(s, pos)
	local h = World.CLEARING_HALF - 3
	local rel = pos - s.O
	return math.abs(rel.X) < h and math.abs(rel.Z) < h and rel.Y > -20 and rel.Y < 300
end

local function classOf(p)
	return profiles[p] and profiles[p].class or "none"
end

-- предмет в руке (виден другим игрокам)
local function updateHeld(p)
	local st = state[p]
	local char = p.Character
	if not char or not st then
		return
	end
	local old = char:FindFirstChild("HeldItem")
	if old then
		old:Destroy()
	end
	local hand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
	if not st.equipped or not hand then
		return
	end
	local m = ItemModels.build(st.equipped)
	m.Name = "HeldItem"
	m:PivotTo(hand.CFrame * CFrame.new(0, -hand.Size.Y / 2, -0.1) * CFrame.Angles(-math.pi / 2, 0, 0))
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = false
			local w = Instance.new("WeldConstraint")
			w.Part0 = hand
			w.Part1 = d
			w.Parent = d
		end
	end
	m.Parent = char
end

R.Equip.OnServerEvent:Connect(function(p, id)
	local st = state[p]
	if not st or (id ~= nil and (typeof(id) ~= "string" or not table.find(st.tools, id))) then
		return
	end
	st.equipped = id
	p:SetAttribute("Equipped", id)
	updateHeld(p)
end)

------------------------------------------------------------------
-- Ранение и подъём
------------------------------------------------------------------
local respawnAtClearing

local function setDownedVisual(p, on)
	local _, char = hrpOf(p)
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.PlatformStand = on
		hum.WalkSpeed = on and 0 or Config.WalkSpeed
		hum.JumpPower = on and 0 or 50
	end
end

local function revive(p, by)
	local st = state[p]
	if not st or not st.downed then
		return
	end
	st.downed = false
	p:SetAttribute("Downed", false)
	if st.revivePrompt then
		st.revivePrompt:Destroy()
		st.revivePrompt = nil
	end
	setDownedVisual(p, false)
	local _, char = hrpOf(p)
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.Health = Config.ReviveHealth
	end
	notify(p, by and (by.DisplayName .. " поднял тебя!") or "Ты пришёл в себя")
end

local function checkAllDowned(s)
	for _, p in ipairs(s.players) do
		local st = state[p]
		if st and not st.downed then
			return
		end
	end
	notifySession(s, "Все ранены... Вы очнулись у лифта на поляне.")
	for _, p in ipairs(s.players) do
		respawnAtClearing(p)
	end
end

local function down(p)
	local st = state[p]
	local s = st and st.session
	if not s or st.downed then
		return
	end
	st.downed = true
	st.downedAt = os.clock()
	p:SetAttribute("Downed", true)
	p:SetAttribute("DownedEnd", workspace:GetServerTimeNow() + Config.DownedTime)
	setDownedVisual(p, true)
	local hrp = hrpOf(p)
	if hrp then
		local pr = Instance.new("ProximityPrompt")
		pr.ActionText = "Поднять (нужен бинт)"
		pr.ObjectText = p.DisplayName .. " ранен"
		pr.HoldDuration = 2.5
		pr.MaxActivationDistance = 9
		pr.RequiresLineOfSight = false
		pr.Parent = hrp
		st.revivePrompt = pr
		pr.Triggered:Connect(function(by)
			local bst = state[by]
			if by == p or not bst or bst.session ~= s or bst.downed then
				return
			end
			if (bst.res.bandage or 0) < 1 then
				notify(by, "Нужен бинт! Сделай его из травы (C → Бинт).")
				return
			end
			addRes(by, "bandage", -1)
			revive(p, by)
		end)
	end
	for _, other in ipairs(s.players) do
		if other ~= p then
			notify(other, p.DisplayName .. " ранен! Подойди и подними его бинтом (зажми E).")
		end
	end
	local token = st.downedAt
	task.delay(Config.DownedTime, function()
		if st.downed and st.downedAt == token and st.session == s then
			notify(p, "Ты очнулся у лифта на поляне.")
			respawnAtClearing(p)
		end
	end)
	checkAllDowned(s)
end

local function damage(p, amount)
	local st = state[p]
	local _, char = hrpOf(p)
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not st or not hum or st.downed then
		return
	end
	hum.Health = math.max(1, hum.Health - amount)
	R.Hurt:FireClient(p)
	if hum.Health <= 1 then
		down(p)
	end
end

------------------------------------------------------------------
-- Ресурсные узлы
------------------------------------------------------------------
local function setNodeVisible(model, visible)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			if d:GetAttribute("BaseT") == nil then
				d:SetAttribute("BaseT", d.Transparency)
				d:SetAttribute("BaseC", d.CanCollide)
			end
			d.Transparency = visible and d:GetAttribute("BaseT") or 1
			d.CanCollide = visible and d:GetAttribute("BaseC") or false
			d.CanQuery = visible
		elseif d:IsA("Light") or d:IsA("ProximityPrompt") then
			d.Enabled = visible
		end
	end
end

local function hitNode(p, model, def)
	local kind = model:GetAttribute("Node")
	local nd = Items.Nodes[kind]
	if not nd or model:GetAttribute("Depleted") then
		return false
	end
	if def.Kind ~= nd.Tool then
		notify(p, nd.Tool == "axe" and "Нужен топор" or "Нужна кирка")
		return false
	end
	if def.Tier < nd.Tier then
		notify(p, "Слишком твёрдо! Нужна кирка " .. nd.Tier .. " уровня (крафт на верстаке)")
		return false
	end
	local dmg = def.Damage
	local gain = 1
	local cls = classOf(p)
	if cls == "miner" and nd.Tool == "pickaxe" then
		dmg *= 1.5
	end
	if cls == "lumber" and nd.Tool == "axe" then
		gain = 2
	end
	local hp = (model:GetAttribute("HP") or nd.Health) - dmg
	model:SetAttribute("HP", hp)
	addRes(p, nd.Drop, gain)
	R.HitMarker:FireClient(p, "node", nd.Tool)
	if hp <= 0 then
		addRes(p, nd.Drop, nd.Amount * gain)
		model:SetAttribute("Depleted", true)
		setNodeVisible(model, false)
		-- от дерева остаётся пень, потом оно заново вырастает
		local stump
		local trunk = kind == "tree" and model:FindFirstChild("Trunk")
		if trunk then
			local base = trunk.Position - V(0, trunk.Size.Y / 2, 0)
			model.WorldPivot = CFrame.new(base)
			stump = Instance.new("Part")
			stump.Name = "Stump"
			stump.Anchored = true
			stump.Size = V(trunk.Size.X + 0.3, 1.4, trunk.Size.Z + 0.3)
			stump.CFrame = CFrame.new(base + V(0, 0.7, 0))
			stump.Color = trunk.Color
			stump.Material = Enum.Material.Wood
			stump.Parent = model.Parent
		end
		task.delay(Config.NodeRespawn, function()
			if not model.Parent then
				return
			end
			if stump then
				stump:Destroy()
				pcall(function()
					model:ScaleTo(0.15)
				end)
				setNodeVisible(model, true)
				for i = 1, 40 do
					task.wait(0.25)
					pcall(function()
						model:ScaleTo(0.15 + 0.85 * i / 40)
					end)
				end
			else
				setNodeVisible(model, true)
			end
			model:SetAttribute("Depleted", false)
			model:SetAttribute("HP", nd.Health)
		end)
	end
	return true
end

-- лучший свой инструмент нужного вида (для добычи на E)
local function bestTool(p, kind)
	local st = state[p]
	local best
	for _, id in ipairs(st.tools) do
		local t = Items.Tools[id]
		if t and t.Kind == kind and (not best or t.Tier > best.Tier) then
			best = t
		end
	end
	return best
end

------------------------------------------------------------------
-- Монстры
------------------------------------------------------------------
local function alivePlayers(s)
	local list = {}
	for _, p in ipairs(s.players) do
		local st = state[p]
		if st and not st.downed and p.Parent then
			table.insert(list, p)
		end
	end
	return list
end

local function spawnMonsters(s)
	if s.ended or #s.players == 0 then
		return
	end
	local d = s.diff
	local count = math.floor(d.Monsters + d.PerPlayer * #s.players + 0.5)
	local far = {}
	for _, c in ipairs(s.maze.cells) do
		if (c - s.O).Magnitude > World.CLEARING_HALF + 70 then
			table.insert(far, c)
		end
	end
	for _ = 1, count do
		local pos = far[math.random(1, #far)]
		local mon = Monster.new({
			parent = s.folder,
			spawn = CFrame.new(pos + V(0, 10, 0)),
			patrol = s.maze.cells,
			getPlayers = function()
				return alivePlayers(s)
			end,
			inSafeZone = function(pos2)
				return inSafeZone(s, pos2)
			end,
			damage = damage,
			health = d.Health,
			speed = d.Speed,
			dmg = d.Damage,
		})
		s.monsters[mon.model] = mon
	end
end

local function clearMonsters(s, retreat)
	for model, mon in pairs(s.monsters) do
		mon:Die(retreat)
		s.monsters[model] = nil
	end
end

------------------------------------------------------------------
-- Удар (ЛКМ)
------------------------------------------------------------------
R.Swing.OnServerEvent:Connect(function(p, hit, hitPos)
	local st = state[p]
	local s = st and st.session
	if not s or st.downed then
		return
	end
	local def = Items.Tools[st.equipped or "fists"] or Items.Tools.fists
	if def.Kind == "torch" then
		return -- факел только светит
	end
	local now = os.clock()
	if now - (st.lastSwing or 0) < 0.4 then
		return
	end
	st.lastSwing = now
	if typeof(hit) ~= "Instance" or typeof(hitPos) ~= "Vector3" then
		return
	end
	local _, char = hrpOf(p)
	local head = char and char:FindFirstChild("Head")
	if not head or (head.Position - hitPos).Magnitude > def.Range + 4 then
		return
	end
	-- молоток: улучшение постройки
	local piece = Building.pieceOf(hit)
	if piece and def.Kind == "hammer" and piece:IsDescendantOf(s.folder) then
		local tier = (piece:GetAttribute("Tier") or 0) + 1
		local t = Building.Tiers[tier]
		if not t then
			notify(p, "Это уже металл — сильнее не бывает")
			return
		end
		for k, n in pairs(t.Cost) do
			if (st.res[k] or 0) < n then
				notify(p, "Для улучшения до «" .. t.Name .. "» нужно: " .. Items.Resources[k].Name .. " " .. n)
				return
			end
		end
		for k, n in pairs(t.Cost) do
			addRes(p, k, -n)
		end
		Build.setTier(piece, tier)
		R.HitMarker:FireClient(p, "node", "axe")
		notify(p, piece.Name .. " → " .. t.Name)
		return
	end
	local model = hit:FindFirstAncestorOfClass("Model")
	while model and not s.monsters[model] and model.Parent and model.Parent:IsA("Model") do
		model = model.Parent
	end
	local mon = model and s.monsters[model]
	if mon then
		local died = mon:TakeDamage(def.Damage, head.Position)
		R.HitMarker:FireClient(p, died and "kill" or "monster")
		if died then
			s.monsters[model] = nil
			addRes(p, "fang", 2)
			notifySession(s, p.DisplayName .. " победил Скрежетника!")
		end
		return
	end
	local nodeModel = hit:FindFirstAncestorWhichIsA("Model")
	while nodeModel and nodeModel:GetAttribute("Node") == nil and nodeModel.Parent and nodeModel.Parent:IsA("Model") do
		nodeModel = nodeModel.Parent
	end
	if nodeModel and nodeModel:GetAttribute("Node") then
		hitNode(p, nodeModel, def)
	end
end)

R.Eat.OnServerEvent:Connect(function(p)
	local st = state[p]
	local _, char = hrpOf(p)
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not st or st.downed or not hum or (st.res.berry or 0) < 1 or hum.Health >= hum.MaxHealth then
		return
	end
	addRes(p, "berry", -1)
	hum.Health = math.min(hum.MaxHealth, hum.Health + Config.BerryHeal)
end)

------------------------------------------------------------------
-- Крафт: из инвентаря (C) и на верстаке
------------------------------------------------------------------
local connectBed, connectChest
local function recipeById(id)
	for _, r in ipairs(Items.Recipes) do
		if r.Id == id then
			return r
		end
	end
end

local function nearestBench(s, pos)
	local best, bd
	for _, b in ipairs(s.benches) do
		if b.model.Parent then
			local d = (b.top.Position - pos).Magnitude
			if d < 16 and (not bd or d < bd) then
				best, bd = b, d
			end
		end
	end
	return best
end

local function connectBench(s, bench)
	bench.prompt.Triggered:Connect(function(p)
		if sessionOf(p) == s then
			R.OpenCraft:FireClient(p, bench.model:GetAttribute("Level") or 1)
		end
	end)
end

------------------------------------------------------------------
-- Кровать, сундук, прятки в лианах
------------------------------------------------------------------
local function wake(p)
	local st = state[p]
	if not st or not st.sleeping then
		return
	end
	st.sleeping = nil
	p:SetAttribute("Sleeping", false)
	local hrp, char = hrpOf(p)
	if hrp then
		hrp.Anchored = false
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.PlatformStand = false
		end
		char:PivotTo(hrp.CFrame * CFrame.new(0, 1, 0) * CFrame.Angles(math.rad(-90), 0, 0) + V(0, 1.5, 0))
	end
end

local function checkSleep(s)
	if s.phase ~= "night" then
		return
	end
	local awake = 0
	for _, q in ipairs(s.players) do
		local st = state[q]
		if st and not st.downed and not st.sleeping then
			awake += 1
		end
	end
	if awake == 0 and #s.players > 0 then
		notifySession(s, "Все уснули... Ночь проходит.")
		s.skip = true
	end
end

function connectBed(s, bed, pr)
	pr.Triggered:Connect(function(p)
		local st = state[p]
		if not st or st.session ~= s or st.downed then
			return
		end
		if st.sleeping then
			wake(p)
			return
		end
		if s.phase ~= "night" then
			notify(p, "Спать можно только ночью")
			return
		end
		local hrp, char = hrpOf(p)
		if not hrp then
			return
		end
		st.sleeping = bed
		p:SetAttribute("Sleeping", true)
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.PlatformStand = true
		end
		hrp.Anchored = true
		char:PivotTo(bed:GetAttribute("SleepCF") * CFrame.Angles(math.rad(90), 0, 0))
		notify(p, "Ты спишь. Если уснут все — ночь пройдёт. E у кровати — встать.")
		checkSleep(s)
	end)
end

function connectChest(s, chest, put, take)
	local store = {}
	local function label()
		local n = 0
		for _, v in pairs(store) do
			n += v
		end
		put.ObjectText = n > 0 and ("Сундук (" .. n .. " шт.)") or "Сундук (пусто)"
	end
	put.Triggered:Connect(function(p)
		local st = state[p]
		if not st or st.session ~= s then
			return
		end
		for k, n in pairs(st.res) do
			if k ~= "key" and n > 0 then
				store[k] = (store[k] or 0) + n
				addRes(p, k, -n)
			end
		end
		label()
		notify(p, "Ресурсы сложены в сундук")
	end)
	take.Triggered:Connect(function(p)
		local st = state[p]
		if not st or st.session ~= s then
			return
		end
		for k, n in pairs(store) do
			addRes(p, k, n)
		end
		store = {}
		label()
		notify(p, "Ты забрал всё из сундука")
	end)
	local _ = chest
end

local function unhide(p)
	local st = state[p]
	if not st or not st.hidden then
		return
	end
	local spot = st.hidden
	st.hidden = nil
	p:SetAttribute("Hidden", false)
	spot:SetAttribute("Occupied", false)
	local pr = spot:FindFirstChildOfClass("ProximityPrompt")
	if pr then
		pr.ActionText = "Спрятаться"
	end
	local hrp, char = hrpOf(p)
	if hrp then
		hrp.Anchored = false
		local out = (spot:GetAttribute("Out") or spot.Position + V(0, 0, 6))
		char:PivotTo(CFrame.lookAt(out + V(0, 1, 0), out + V(0, 1, 0) + (out - spot.Position) * V(1, 0, 1)))
	end
end

------------------------------------------------------------------
-- Строительство (чертёж)
------------------------------------------------------------------
R.Build.OnServerEvent:Connect(function(p, id, a)
	local st = state[p]
	local s = st and st.session
	local def = typeof(id) == "string" and Building.ById[id]
	local hrp = hrpOf(p)
	if not s or not def or not hrp or st.downed or st.equipped ~= "blueprint" or typeof(a) ~= "table" then
		return
	end
	-- проверка параметров
	local ok = typeof(a.y) == "number" and a.y == a.y and math.abs(a.y) < 400
	if def.Edge then
		ok = ok and typeof(a.ex) == "number" and typeof(a.ez) == "number" and (a.axis == "X" or a.axis == "Z")
		ok = ok and a.ex % 1 == 0 and a.ez % 1 == 0
	else
		ok = ok and typeof(a.cx) == "number" and typeof(a.cz) == "number" and a.cx % 1 == 0 and a.cz % 1 == 0
	end
	if not ok then
		return
	end
	local args = { cx = a.cx, cz = a.cz, ex = a.ex, ez = a.ez, axis = a.axis, y = a.y, rot = (typeof(a.rot) == "number" and a.rot % 1 == 0) and a.rot % 4 or 0 }
	local key = Building.key(id, args)
	if s.pieces[key] and s.pieces[key].Parent then
		notify(p, "Здесь уже стоит постройка")
		return
	end
	local cf = Building.cframe(id, s.O, args)
	if (cf.Position - hrp.Position).Magnitude > 32 then
		return
	end
	if (cf.Position - s.O).Magnitude < 16 then
		notify(p, "Слишком близко к лифту")
		return
	end
	-- не строим внутри стен, деревьев и игроков
	-- selene: allow(undefined_variable)
	local op = OverlapParams.new()
	op.FilterType = Enum.RaycastFilterType.Exclude
	op.FilterDescendantsInstances = { s.buildFolder }
	op.RespectCanCollide = true
	local size = def.Size - V(0.6, 0.6, 0.6)
	if id == "foundation" then
		size = V(7.4, 1.2, 7.4)
		cf = cf * CFrame.new(0, 0.8, 0)
	end
	for _, part in ipairs(workspace:GetPartBoundsInBox(cf, V(math.max(0.2, size.X), math.max(0.2, size.Y), math.max(0.2, size.Z)), op)) do
		if not part:IsA("Terrain") then
			notify(p, "Мешает: " .. part.Name)
			return
		end
	end
	for k, n in pairs(def.Cost) do
		if (st.res[k] or 0) < n then
			notify(p, "Не хватает: " .. Items.Resources[k].Name .. " (" .. n .. "). Доски делаются в крафте (C).")
			return
		end
	end
	for k, n in pairs(def.Cost) do
		addRes(p, k, -n)
	end
	s.pieces[key] = Build.piece(s.buildFolder, id, s.O, args)
	R.HitMarker:FireClient(p, "node", "axe")
end)

R.Craft.OnServerEvent:Connect(function(p, id)
	local st = state[p]
	local s = st and st.session
	local r = typeof(id) == "string" and recipeById(id)
	local hrp = hrpOf(p)
	if not s or not r or not hrp or st.downed then
		return
	end
	local bench
	if r.Station == "bench" then
		bench = nearestBench(s, hrp.Position)
		if not bench then
			notify(p, "Нужен верстак рядом. Сделай его: C → Верстак.")
			return
		end
		if r.Level > (bench.model:GetAttribute("Level") or 1) then
			notify(p, "Нужен верстак " .. r.Level .. " уровня")
			return
		end
	end
	if r.Id == "upgrade2" and (bench.model:GetAttribute("Level") or 1) >= 2 then
		notify(p, "Этот верстак уже 2 уровня")
		return
	end
	if Items.Tools[r.Id] and table.find(st.tools, r.Id) then
		notify(p, "У тебя уже есть: " .. Items.toolName(r.Id))
		return
	end
	-- инструмент того же вида, но лучше — уже есть
	local newDef = Items.Tools[r.Id]
	local function power(d)
		return d.Kind == "sword" and d.Damage or d.Tier
	end
	if newDef and newDef.Kind ~= "torch" then
		for _, t in ipairs(st.tools) do
			local d = Items.Tools[t]
			if d and d.Kind == newDef.Kind and power(d) >= power(newDef) then
				notify(p, "У тебя уже есть лучше: " .. d.Name)
				return
			end
		end
	end
	for k, n in pairs(r.Cost) do
		if (st.res[k] or 0) < n then
			notify(p, "Не хватает: " .. Items.Resources[k].Name)
			return
		end
	end
	for k, n in pairs(r.Cost) do
		addRes(p, k, -n)
	end
	if r.Place then
		local look = hrp.CFrame.LookVector * V(1, 0, 1)
		local pos = hrp.Position + look.Unit * 7
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { p.Character }
		local hit = workspace:Raycast(pos + V(0, 6, 0), V(0, -30, 0), params)
		local ground = hit and hit.Position or (pos - V(0, 3, 0))
		local cf = CFrame.lookAt(ground, ground - look)
		if r.Place == "workbench" then
			local b = World.BuildWorkbench(s.folder, cf)
			table.insert(s.benches, b)
			connectBench(s, b)
			notifySession(s, p.DisplayName .. " поставил верстак")
		elseif r.Place == "bed" then
			local bed, pr = Build.bed(s.folder, cf)
			connectBed(s, bed, pr)
			notify(p, "Кровать поставлена. Ночью ляг спать — если уснут все, ночь пройдёт быстрее.")
		elseif r.Place == "chest" then
			local chest, put, take = Build.chest(s.folder, cf)
			connectChest(s, chest, put, take)
			notify(p, "Сундук поставлен: E — положить всё, F — забрать всё.")
		end
	elseif r.Id == "upgrade2" then
		bench.model:SetAttribute("Level", 2)
		bench.label.Text = "Верстак · ур. 2"
		notifySession(s, p.DisplayName .. " улучшил верстак до 2 уровня!")
	elseif r.Res then
		addRes(p, r.Res, r.Amount or 1)
		notify(p, "Создано: " .. Items.Resources[r.Res].Name)
	else
		-- новый инструмент заменяет старый того же вида (каменная кирка вместо деревянной)
		local slot
		for i = #st.tools, 1, -1 do
			local d = Items.Tools[st.tools[i]]
			if d and newDef and d.Kind == newDef.Kind and newDef.Kind ~= "torch" then
				if st.equipped == st.tools[i] then
					st.equipped = r.Id
				end
				table.remove(st.tools, i)
				slot = i
			end
		end
		table.insert(st.tools, slot or #st.tools + 1, r.Id)
		p:SetAttribute("Tools", HttpService:JSONEncode(st.tools))
		if st.equipped == r.Id then
			p:SetAttribute("Equipped", r.Id)
			updateHeld(p)
		end
		notify(p, "Создано: " .. Items.toolName(r.Id) .. (slot and " (заменил старый)" or " (выбери цифрой)"))
	end
end)

------------------------------------------------------------------
-- Врата
------------------------------------------------------------------
local function moveGates(s, close, duration)
	s.gatesClosed = close
	for _, g in ipairs(s.gates) do
		for _, leaf in ipairs(g.leaves) do
			local from = leaf.part.CFrame
			local to = close and leaf.closed or leaf.open
			local children = {}
			for _, ch in ipairs(leaf.part:GetChildren()) do
				if ch:IsA("BasePart") then
					children[ch] = from:ToObjectSpace(ch.CFrame)
				end
			end
			task.spawn(function()
				local t0 = os.clock()
				while leaf.part.Parent do
					local a = math.clamp((os.clock() - t0) / duration, 0, 1)
					local e = a * a * (3 - 2 * a)
					local cf = from:Lerp(to, e)
					leaf.part.CFrame = cf
					for ch, rel in pairs(children) do
						ch.CFrame = cf * rel
					end
					if a >= 1 then
						break
					end
					RunService.Heartbeat:Wait()
				end
			end)
		end
		local snd = Instance.new("Sound")
		snd.SoundId = Config.Sounds.Rumble
		snd.Volume = 3
		snd.PlaybackSpeed = 0.25
		snd.RollOffMaxDistance = 500
		snd.Parent = g.leaves[1].part
		snd:Play()
		task.delay(duration + 1, function()
			snd:Destroy()
		end)
	end
end

------------------------------------------------------------------
-- Сессии (одна группа = один лабиринт)
------------------------------------------------------------------
local function setPhase(s, phase, len)
	s.phase, s.phaseStart, s.phaseLen = phase, os.clock(), len
	local now = workspace:GetServerTimeNow()
	for _, p in ipairs(s.players) do
		p:SetAttribute("Phase", phase)
		p:SetAttribute("PhaseStart", now)
		p:SetAttribute("PhaseLen", len)
		p:SetAttribute("Day", s.day)
	end
end

local function endSession(s)
	if s.ended then
		return
	end
	s.ended = true
	clearMonsters(s, false)
	for _, p in ipairs(table.clone(s.players)) do
		local st = state[p]
		if st and p.Parent then
			st.session = nil
			st.downed = false
			st.hidden, st.sleeping = nil, nil
			p:SetAttribute("Downed", false)
			p:SetAttribute("Hidden", false)
			p:SetAttribute("Sleeping", false)
			p:SetAttribute("InMatch", false)
			freshInventory(p)
			p:LoadCharacter()
		end
	end
	s.folder:Destroy()
	World.ClearTerrain(s.O)
	usedSlots[s.slot] = nil
	sessions[s] = nil
end

local function leaveSession(p)
	local st = state[p]
	local s = st and st.session
	if not s then
		return
	end
	st.session = nil
	local i = table.find(s.players, p)
	if i then
		table.remove(s.players, i)
	end
	if #s.players == 0 then
		endSession(s)
	end
end

local function connectSessionPrompts(s)
	s.clearing.supplyPrompt.Triggered:Connect(function(p)
		local st = state[p]
		if not st or st.session ~= s then
			return
		end
		if st.gotSupply then
			notify(p, "Ты уже забрал свои припасы")
			return
		end
		st.gotSupply = true
		addRes(p, "wood", 14)
		addRes(p, "stone", 6)
		addRes(p, "fiber", 3)
		addRes(p, "berry", 3)
		notify(p, "Припасы: +14 дерева, +6 камня, +3 травы, +3 ягоды. Нажми C — крафт.")
	end)
	for _, pr in ipairs(s.folder:GetDescendants()) do
		if pr:IsA("ProximityPrompt") then
			if CollectionService:HasTag(pr, "NodePrompt") then
				pr.Triggered:Connect(function(p)
					local st = state[p]
					if not st or st.session ~= s or st.downed then
						return
					end
					local model = pr.Parent:FindFirstAncestorWhichIsA("Model")
					local nd = model and Items.Nodes[model:GetAttribute("Node")]
					if not nd then
						return
					end
					local tool = bestTool(p, nd.Tool)
					if not tool then
						notify(p, nd.Tool == "axe" and "Нужен топор" or "Нужна кирка")
						return
					end
					hitNode(p, model, tool)
				end)
			elseif CollectionService:HasTag(pr, "BerryPrompt") then
				pr.Triggered:Connect(function(p)
					if sessionOf(p) ~= s then
						return
					end
					local now = os.clock()
					if (pr:GetAttribute("Next") or 0) > now then
						notify(p, "Ягоды ещё не выросли")
						return
					end
					pr:SetAttribute("Next", now + 40)
					addRes(p, "berry", 3)
					notify(p, "+3 ягоды (H — съесть, лечит)")
				end)
			elseif CollectionService:HasTag(pr, "NotePrompt") then
				pr.Triggered:Connect(function(p)
					if sessionOf(p) == s then
						R.Note:FireClient(p, pr:GetAttribute("Title") or "Записка", pr:GetAttribute("Text") or "")
					end
				end)
			elseif CollectionService:HasTag(pr, "LootPrompt") then
				pr.Triggered:Connect(function(p)
					local st = state[p]
					if not st or st.session ~= s then
						return
					end
					if pr:GetAttribute("Looted") then
						notify(p, "Пусто")
						return
					end
					pr:SetAttribute("Looted", true)
					pr.Enabled = false
					local pool = { { "wood", 3, 6 }, { "stone", 3, 6 }, { "fiber", 2, 4 }, { "berry", 2, 3 }, { "bandage", 1, 1 }, { "iron", 1, 3 } }
					local got = {}
					for _ = 1, 2 do
						local e = pool[math.random(1, #pool)]
						local n = math.random(e[2], e[3])
						addRes(p, e[1], n)
						table.insert(got, "+" .. n .. " " .. Items.Resources[e[1]].Name)
					end
					notify(p, (pr.ObjectText ~= "" and pr.ObjectText or "Находка") .. ": " .. table.concat(got, ", "))
				end)
			elseif CollectionService:HasTag(pr, "HidePrompt") then
				local spot = pr.Parent
				pr.Triggered:Connect(function(p)
					local st = state[p]
					if not st or st.session ~= s or st.downed then
						return
					end
					if st.hidden then
						unhide(p)
						return
					end
					if spot:GetAttribute("Occupied") then
						notify(p, "Тут уже кто-то прячется")
						return
					end
					local hrp, char = hrpOf(p)
					if not hrp then
						return
					end
					-- откуда залезли — туда и вылезем
					local flat = (hrp.Position - spot.Position) * V(1, 0, 1)
					spot:SetAttribute("Out", spot.Position * V(1, 0, 1) + V(0, hrp.Position.Y - 1, 0) + (flat.Magnitude > 0.1 and flat.Unit or V(0, 0, 1)) * 6)
					spot:SetAttribute("Occupied", true)
					st.hidden = spot
					p:SetAttribute("Hidden", true)
					pr.ActionText = "Вылезти"
					hrp.Anchored = true
					char:PivotTo(CFrame.lookAt(spot.Position, spot.Position - flat))
					notify(p, "Ты спрятался в лианах. Скрежетники тебя не видят. E — вылезти.")
				end)
			elseif CollectionService:HasTag(pr, "FiberPrompt") then
				pr.Triggered:Connect(function(p)
					if sessionOf(p) ~= s then
						return
					end
					local now = os.clock()
					if (pr:GetAttribute("Next") or 0) > now then
						notify(p, "Трава ещё не отросла")
						return
					end
					pr:SetAttribute("Next", now + 30)
					addRes(p, "fiber", 2)
					notify(p, "+2 травы (для бинтов, факелов, копья)")
				end)
			end
		end
	end
	for _, c in ipairs(s.maze.chests) do
		c.prompt.Triggered:Connect(function(p)
			local st = state[p]
			if not st or st.session ~= s then
				return
			end
			if c.model:GetAttribute("Opened") then
				notify(p, "Сундук пуст")
				return
			end
			c.model:SetAttribute("Opened", true)
			c.prompt.Enabled = false
			c.lid.CFrame = c.lid.CFrame * CFrame.new(0, 0.6, 1.2) * CFrame.Angles(math.rad(70), 0, 0)
			local got = {}
			local function gain(k, n)
				addRes(p, k, n)
				table.insert(got, "+" .. n .. " " .. Items.Resources[k].Name)
			end
			if c.model:GetAttribute("Golden") then
				local glow = c.model:FindFirstChild("KeyGlow")
				if glow then
					glow:Destroy()
				end
				gain("key", 1)
				gain("crystal", 3)
				gain("iron", 5)
				notifySession(s, p.DisplayName .. " нашёл КЛЮЧ-КАРТУ! Найдите выход и вставьте её в считыватель.")
			else
				local depth = c.model:GetAttribute("Depth") or 5
				local pool = { { "wood", 4, 8 }, { "stone", 4, 8 }, { "berry", 2, 4 }, { "fiber", 2, 4 }, { "bandage", 1, 2 } }
				if depth > 6 then
					table.insert(pool, { "iron", 2, 5 })
				end
				if depth > 14 then
					table.insert(pool, { "crystal", 1, 3 })
				end
				for _ = 1, 2 do
					local e = pool[math.random(1, #pool)]
					gain(e[1], math.random(e[2], e[3]))
				end
				if math.random() < 0.2 then
					local tool = ({ "spear", "stone_sword", "torch" })[math.random(1, 3)]
					if not table.find(st.tools, tool) then
						table.insert(st.tools, tool)
						p:SetAttribute("Tools", HttpService:JSONEncode(st.tools))
						table.insert(got, Items.toolName(tool))
					end
				end
			end
			notify(p, "Сундук: " .. table.concat(got, ", "))
		end)
	end
	if s.maze.exitPrompt then
		s.maze.exitPrompt.Triggered:Connect(function(p)
			local st = state[p]
			if not st or st.session ~= s or s.won then
				return
			end
			local hasKey = false
			for _, q in ipairs(s.players) do
				if state[q] and (state[q].res.key or 0) > 0 then
					hasKey = true
				end
			end
			if not hasKey then
				notify(p, "Нужна ключ-карта — она в золотом сундуке в самом дальнем тупике (над ним светится ключ).")
				return
			end
			s.won = true
			clearMonsters(s, true)
			if s.maze.readerLight then
				s.maze.readerLight.Color = Color3.fromRGB(60, 255, 90)
			end
			notifySession(s, p.DisplayName .. " вставил ключ-карту! Ворота открываются...")
			task.delay(1, function()
				TweenService:Create(s.maze.exitDoor, TweenInfo.new(4, Enum.EasingStyle.Sine), { CFrame = s.maze.exitDoor.CFrame + V(0, 60, 0) }):Play()
			end)
			local coins = Config.CoinsEscape * s.diff.Coins
			for _, q in ipairs(s.players) do
				addCoins(q, coins)
				local hrp = hrpOf(q)
				if hrp then
					hrp.Anchored = true
				end
				R.Outro:FireClient(q, s.maze.helipad, s.maze.exitOut, s.players, s.day, coins, s.O)
			end
			task.delay(35, function()
				endSession(s)
			end)
		end)
	end
end

local function sessionLoop(s)
	while not s.ended do
		setPhase(s, "day", s.diff.Day)
		for _, q in ipairs(s.players) do
			wake(q)
		end
		if s.gatesClosed then
			moveGates(s, false, 6)
			notifySession(s, "Рассвет. Врата открываются. День " .. s.day .. ".")
		end
		clearMonsters(s, true)
		local t0 = os.clock()
		local warned = false
		while not s.ended and os.clock() - t0 < s.diff.Day and not s.skip do
			if not warned and s.diff.Day - (os.clock() - t0) <= Config.WarningTime then
				warned = true
				notifySession(s, "Скоро закат! Врата закроются через " .. Config.WarningTime .. " секунд — возвращайтесь на поляну!")
			end
			task.wait(0.25)
		end
		s.skip = false
		if s.ended then
			break
		end
		setPhase(s, "night", s.diff.Night)
		moveGates(s, true, 8)
		notifySession(s, "Ночь. Врата закрылись. В лабиринте — Скрежетники...")
		task.delay(6, function()
			if s.phase == "night" and not s.won then
				spawnMonsters(s)
			end
		end)
		t0 = os.clock()
		while not s.ended and os.clock() - t0 < s.diff.Night and not s.skip do
			task.wait(0.25)
		end
		s.skip = false
		if s.ended then
			break
		end
		s.day += 1
		-- монеты за прожитую ночь
		for _, p in ipairs(s.players) do
			local st = state[p]
			if st and not st.downed then
				local c = Config.CoinsPerDay * s.diff.Coins
				addCoins(p, c)
				notify(p, "Ты пережил ночь! +" .. c .. " монет")
			end
		end
	end
end

local function openLiftGrate(s)
	local grate = s.clearing.grate
	local closed = s.clearing.grateClosed
	task.spawn(function()
		for i = 1, 30 do
			grate:PivotTo(closed + V(0, 15 * i / 30, 0))
			task.wait(0.03)
		end
		-- решётка остаётся открытой, чтобы никто не оказался заперт в лифте
	end)
end

local function startSession(riders, diffId)
	local slot
	for i = 1, 50 do
		if not usedSlots[i] then
			slot = i
			break
		end
	end
	if not slot then
		for _, p in ipairs(riders) do
			notify(p, "Все лабиринты заняты, попробуйте позже")
		end
		return
	end
	usedSlots[slot] = true
	local O = V(slot * Config.SlotSpacing, 0, 0)
	local s = {
		slot = slot,
		O = O,
		diff = Config.Difficulty[diffId],
		diffId = diffId,
		players = riders,
		monsters = {},
		benches = {},
		day = 1,
		gatesClosed = true,
	}
	sessions[s] = s
	s.folder = Instance.new("Folder")
	s.folder.Name = "Session_" .. slot
	s.folder.Parent = workspace
	s.pieces = {}
	s.buildFolder = Instance.new("Folder")
	s.buildFolder.Name = "Buildings"
	s.buildFolder.Parent = s.folder
	local seed = math.random(1, 1e6)
	World.BuildTerrain(O)
	s.clearing = World.BuildClearing(s.folder, seed, O)
	s.gates = World.BuildClearingWalls(s.folder, O)
	s.maze = World.BuildMaze(s.folder, seed + 7, O)
	World.BuildWaterSurface(s.folder, O)
	World.BuildOuterForest(s.folder, O, seed)
	connectSessionPrompts(s)
	for _, p in ipairs(riders) do
		local st = state[p]
		st.session = s
		st.downed = false
		freshInventory(p)
		p:SetAttribute("InMatch", true)
		p:SetAttribute("Difficulty", diffId)
		p:SetAttribute("SessionO", O)
	end
	-- лифт приехал
	for i, p in ipairs(riders) do
		local off = V(((i - 1) % 3 - 1) * 4, 0, math.floor((i - 1) / 3) * 4)
		place(p, s.clearing.liftSpawn + off, true)
		R.Arrive:FireClient(p, s.clearing.liftPos, riders)
	end
	openLiftGrate(s)
	moveGates(s, false, 0.1)
	task.delay(7, function()
		for _, p in ipairs(s.players) do
			local hrp = hrpOf(p)
			if hrp then
				hrp.Anchored = false
			end
		end
	end)
	task.spawn(sessionLoop, s)
end

function respawnAtClearing(p)
	local st = state[p]
	if not st then
		return
	end
	st.downed = false
	p:SetAttribute("Downed", false)
	if st.revivePrompt then
		st.revivePrompt:Destroy()
		st.revivePrompt = nil
	end
	p:LoadCharacter()
end

------------------------------------------------------------------
-- Лифты в лобби: настройки хозяина (только друзья, сколько игроков), отсчёт
------------------------------------------------------------------
local lifts = {}
for id, e in pairs(lobby.elevators) do
	lifts[id] = { id = id, label = e.label, zone = e.zone, outside = e.outside, host = nil, friendsOnly = false, max = Config.Elevator.MaxPlayers, countdownEnd = nil, riding = false, goNow = false }
end
local friendCache = {}
local function isFriend(a, b)
	local key = math.min(a.UserId, b.UserId) .. "_" .. math.max(a.UserId, b.UserId)
	if friendCache[key] == nil then
		local ok, res = pcall(function()
			return a:IsFriendsWith(b.UserId)
		end)
		friendCache[key] = ok and res or false
	end
	return friendCache[key]
end

local function inZone(zone, pos)
	local rel = zone.CFrame:PointToObjectSpace(pos)
	local h = zone.Size / 2
	return math.abs(rel.X) < h.X and math.abs(rel.Y) < h.Y + 4 and math.abs(rel.Z) < h.Z
end

R.LiftSettings.OnServerEvent:Connect(function(p, action, value)
	for _, lift in pairs(lifts) do
		if lift.host == p then
			if action == "friends" and typeof(value) == "boolean" then
				lift.friendsOnly = value
			elseif action == "max" and typeof(value) == "number" then
				lift.max = math.clamp(math.floor(value), 1, Config.Elevator.MaxPlayers)
			elseif action == "go" then
				lift.goNow = true
			elseif action == "diff" and typeof(value) == "string" and Config.Difficulty[value] then
				lift.diff = value
			end
		end
	end
end)

task.spawn(function()
	while true do
		task.wait(0.4)
		for _, lift in pairs(lifts) do
			if not lift.riding then
				local inside = {}
				for _, p in ipairs(Players:GetPlayers()) do
					local st = state[p]
					local hrp = hrpOf(p)
					if st and not st.session and hrp and inZone(lift.zone, hrp.Position) then
						table.insert(inside, p)
					end
				end
				if lift.host and not table.find(inside, lift.host) then
					lift.host = nil
				end
				if not lift.host and inside[1] then
					lift.host = inside[1]
					lift.friendsOnly = false
					lift.max = Config.Elevator.MaxPlayers
					lift.diff = "normal"
				end
				-- кто не проходит по правилам — выходит из лифта
				local allowed = {}
				for _, p in ipairs(inside) do
					local ok = true
					if p ~= lift.host then
						if lift.friendsOnly and not isFriend(p, lift.host) then
							ok = false
							notify(p, "Этот лифт только для друзей " .. lift.host.DisplayName)
						elseif #allowed >= lift.max then
							ok = false
							notify(p, "Лифт заполнен (" .. lift.max .. " игроков)")
						end
					end
					if ok then
						table.insert(allowed, p)
					else
						place(p, lift.outside, false)
					end
				end
				if #allowed > 0 then
					lift.countdownEnd = lift.countdownEnd or (os.clock() + Config.Elevator.Countdown)
				else
					lift.countdownEnd = nil
					lift.goNow = false
				end
				local left = lift.countdownEnd and math.max(0, math.ceil(lift.countdownEnd - os.clock())) or -1
				local dname = Config.Difficulty[lift.diff or "normal"].Name
				if lift.label then
					lift.label.Text = #allowed > 0 and (dname .. "  " .. #allowed .. "/" .. lift.max .. "  ·  " .. left .. "с") or "ЛИФТ"
				end
				for _, p in ipairs(Players:GetPlayers()) do
					if table.find(allowed, p) then
						p:SetAttribute("LiftId", lift.id)
						p:SetAttribute("LiftHost", p == lift.host)
						p:SetAttribute("LiftHostName", lift.host and lift.host.DisplayName or "")
						p:SetAttribute("LiftFriends", lift.friendsOnly)
						p:SetAttribute("LiftMax", lift.max)
						p:SetAttribute("LiftCount", #allowed)
						p:SetAttribute("LiftCountdown", left)
						p:SetAttribute("LiftDiff", lift.diff or "normal")
					elseif p:GetAttribute("LiftId") == lift.id then
						p:SetAttribute("LiftId", nil)
					end
				end
				if #allowed > 0 and (left <= 0 or lift.goNow) then
					lift.riding = true
					lift.countdownEnd = nil
					lift.goNow = false
					lift.host = nil
					for _, p in ipairs(allowed) do
						p:SetAttribute("LiftId", nil)
						local hrp = hrpOf(p)
						if hrp then
							hrp.Anchored = true
						end
						R.PlayElevator:FireClient(p, allowed, Config.Elevator.RideTime, lift.diff or "normal")
					end
					task.spawn(function()
						task.wait(Config.Elevator.RideTime)
						local riders = {}
						for _, p in ipairs(allowed) do
							if p.Parent then
								table.insert(riders, p)
							end
						end
						if #riders > 0 then
							startSession(riders, lift.diff or "normal")
						end
						lift.riding = false
					end)
				end
			end
		end
	end
end)

------------------------------------------------------------------
-- Торговец классами
------------------------------------------------------------------
lobby.merchantPrompt.Triggered:Connect(function(p)
	R.ShopOpen:FireClient(p)
end)

local function classById(id)
	for _, c in ipairs(Config.Classes) do
		if c.Id == id then
			return c
		end
	end
end

R.ShopBuy.OnServerEvent:Connect(function(p, id)
	local pr = profiles[p]
	local c = typeof(id) == "string" and classById(id)
	if not pr or not c then
		return
	end
	if table.find(pr.owned, id) then
		pr.class = id
	elseif pr.coins >= c.Price then
		pr.coins -= c.Price
		table.insert(pr.owned, id)
		pr.class = id
		notify(p, "Куплен класс «" .. c.Name .. "»!")
	else
		notify(p, "Не хватает монет: нужно " .. c.Price)
		return
	end
	syncProfile(p)
	saveProfile(p)
end)

------------------------------------------------------------------
-- Пригнуться (Ctrl): пролезать в щели
------------------------------------------------------------------
R.Crouch.OnServerEvent:Connect(function(p, on)
	local _, char = hrpOf(p)
	if not char or typeof(on) ~= "boolean" then
		return
	end
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CollisionGroup = on and "Crawler" or "Default"
		end
	end
	p:SetAttribute("Crouched", on)
end)

------------------------------------------------------------------
-- Игроки
------------------------------------------------------------------
-- Квадратный персонаж (R6) из аватара игрока: одежда и цвета сохраняются
local animTemplate = Shared:WaitForChild("R6Animate")
local descCache = {}
local function morphR6(p, oldChar)
	local desc = descCache[p]
	if not desc then
		local ok, d = pcall(function()
			return Players:GetHumanoidDescriptionFromUserId(math.max(1, p.UserId))
		end)
		desc = ok and d or Instance.new("HumanoidDescription")
		descCache[p] = desc
	end
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R6)
	end)
	if not ok or not model or not oldChar.Parent then
		return false
	end
	model.Name = p.Name
	model:SetAttribute("Morphed", true)
	local oldAnim = model:FindFirstChild("Animate")
	if oldAnim then
		oldAnim:Destroy()
	end
	local anim = animTemplate:Clone()
	anim.Name = "Animate"
	anim.Disabled = false
	anim.Parent = model
	model:PivotTo(oldChar:GetPivot())
	p.Character = model
	model.Parent = workspace
	oldChar:Destroy()
	return true
end

local function onCharacter(p, char)
	local st = state[p]
	local hrp = char:WaitForChild("HumanoidRootPart", 5)
	local hum = char:WaitForChild("Humanoid", 5)
	if not hrp or not hum or not st then
		return
	end
	if hum.RigType == Enum.HumanoidRigType.R15 and not char:GetAttribute("Morphed") then
		if morphR6(p, char) then
			return -- CharacterAdded сработает ещё раз уже для квадратного персонажа
		end
	end
	hum.BreakJointsOnDeath = false
	hum.WalkSpeed = Config.WalkSpeed
	if classOf(p) == "warrior" then
		hum.MaxHealth = 140
		hum.Health = 140
	end
	-- смерть от чего-то другого (например, падение) = ранение
	hum.HealthChanged:Connect(function(h)
		if h <= 0 and st.session and not st.downed then
			hum.Health = 1
			down(p)
		end
	end)
	p:SetAttribute("Crouched", false)
	p:SetAttribute("Hidden", false)
	p:SetAttribute("Sleeping", false)
	st.hidden, st.sleeping = nil, nil
	task.wait()
	if st.session then
		place(p, st.session.clearing.liftSpawn, false)
	else
		char:PivotTo(lobby.spawn.CFrame + V(math.random(-4, 4), 4, math.random(-2, 2)))
	end
	updateHeld(p)
end

local function onPlayer(p)
	state[p] = { res = {}, tools = {} }
	loadProfile(p)
	freshInventory(p)
	p:SetAttribute("InMatch", false)
	p.CharacterAdded:Connect(function(char)
		onCharacter(p, char)
	end)
	if p.Character then
		task.spawn(onCharacter, p, p.Character)
	end
end
Players.PlayerAdded:Connect(onPlayer)
for _, p in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayer, p)
end
Players.PlayerRemoving:Connect(function(p)
	leaveSession(p)
	saveProfile(p)
	state[p] = nil
	profiles[p] = nil
end)

------------------------------------------------------------------
-- Тестовые кнопки
------------------------------------------------------------------
R.Dev.OnServerEvent:Connect(function(p, action, value)
	if not Config.DevTools then
		return
	end
	local s = sessionOf(p)
	if action == "ghost" and typeof(value) == "boolean" then
		p:SetAttribute("DevGhost", value)
	elseif action == "phase" and s then
		s.skip = true
	elseif action == "res" then
		for k in pairs(Items.Resources) do
			addRes(p, k, k == "key" and 1 or 30)
		end
		notify(p, "[Тест] +30 всех ресурсов и Ключ")
	elseif action == "toexit" and s and s.maze.exitOut then
		place(p, s.maze.exitOut * CFrame.new(0, 4, -30), false)
	elseif action == "coins" then
		addCoins(p, 500)
	elseif action == "down" and s then
		down(p)
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Monster</string>
          <string name="Source"><![CDATA[-- Скрежетник — ночной монстр лабиринта. Патрулирует, видит и слышит игроков,
-- гонится, бьёт когтями. Не заходит на поляну.

local PathfindingService = game:GetService("PathfindingService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local S = Config.Monster

local Monster = {}
Monster.__index = Monster

local V = Vector3.new
local RGB = Color3.fromRGB
local SKIN = RGB(26, 24, 28)

-- Сервер держит только «скелет»: невидимый корпус + Humanoid (ходьба и поиск пути).
-- Само тело (слизень, 8 механических ног, жало) рисует клиент — MonsterView.lua,
-- поэтому ноги двигаются плавно и не грузят сеть.
local function buildRig()
	local m = Instance.new("Model")
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = V(6, 4, 12)
	root.Transparency = 1
	root.CanCollide = true
	root.Color = SKIN
	root.Parent = m
	m.PrimaryPart = root
	local head = Instance.new("Part")
	head.Name = "Head"
	head.Size = V(2, 2, 2)
	head.Transparency = 1
	head.CanCollide = false
	head.CanQuery = false
	head.Massless = true
	head.CFrame = root.CFrame * CFrame.new(0, 1, -6)
	head.Parent = m
	local w = Instance.new("WeldConstraint")
	w.Part0 = root
	w.Part1 = head
	w.Parent = head
	local hum = Instance.new("Humanoid")
	hum.RigType = Enum.HumanoidRigType.R15
	hum.HipHeight = 3.6
	hum.RequiresNeck = false
	hum.Parent = m
	return m
end

-- opts: parent, spawn (CFrame), patrol ({Vector3}), getPlayers(), inSafeZone(pos) -> bool,
-- damage(player, amount), health, speed, dmg
function Monster.new(opts)
	local self = setmetatable({}, Monster)
	self.opts = opts
	self.maxHealth = opts.health or 260
	self.chaseSpeed = opts.speed or 19
	self.dmg = opts.dmg or 22
	self.alive = true
	self.state = "patrol"
	self.lastAttack = 0
	local model = buildRig()
	model.Name = S.Name
	self.model = model
	self.humanoid = model:FindFirstChildOfClass("Humanoid")
	self.root = model:FindFirstChild("HumanoidRootPart")
	self.head = model:FindFirstChild("Head") or self.root
	local hum = self.humanoid
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.BreakJointsOnDeath = false
	hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
	hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
	hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
	hum.MaxHealth = self.maxHealth
	hum.Health = self.maxHealth
	hum.WalkSpeed = S.PatrolSpeed
	model:SetAttribute("MaxHP", self.maxHealth)
	model:SetAttribute("HP", self.maxHealth)
	model:PivotTo(opts.spawn)
	model.Parent = opts.parent
	CollectionService:AddTag(model, "Monster")
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and not d.Anchored then
			pcall(function()
				d:SetNetworkOwner(nil)
			end)
		end
	end
	self.path = PathfindingService:CreatePath({ AgentRadius = 4, AgentHeight = 8, AgentCanJump = false, WaypointSpacing = 6 })

	-- шаги и рычание
	local step = Instance.new("Sound")
	step.SoundId = Config.Sounds.Step
	step.Looped = true
	step.Volume = 1.4
	step.PlaybackSpeed = 0.45
	step.RollOffMaxDistance = 80
	step.Parent = self.root
	self.step = step
	hum.Running:Connect(function(speed)
		local moving = speed > 0.5
		if moving and not step.IsPlaying then
			step:Play()
		elseif not moving then
			step:Stop()
		end
	end)
	task.spawn(function()
		self:Loop()
	end)
	return self
end

function Monster:LineOfSight(from, to, char)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { self.model }
	local r = workspace:Raycast(from, to - from, params)
	return r == nil or r.Instance:IsDescendantOf(char)
end

function Monster:Navigate(goal)
	local pos = self.root.Position
	local flat = V(goal.X - pos.X, 0, goal.Z - pos.Z)
	if flat.Magnitude < 4 then
		self.humanoid:MoveTo(pos)
		self.waypoints = nil
		return true
	end
	local now = os.clock()
	if not self.waypoints or (self.goal - goal).Magnitude > 6 or now - self.pathTime > 2 then
		self.goal, self.pathTime = goal, now
		local ok = pcall(function()
			self.path:ComputeAsync(pos, goal)
		end)
		if ok and self.path.Status == Enum.PathStatus.Success then
			self.waypoints, self.wp = self.path:GetWaypoints(), 2
		else
			self.waypoints = nil
		end
	end
	if self.waypoints and self.waypoints[self.wp] then
		local w = self.waypoints[self.wp]
		if V(w.Position.X - pos.X, 0, w.Position.Z - pos.Z).Magnitude < 3 then
			self.wp += 1
			w = self.waypoints[self.wp] or w
		end
		self.humanoid:MoveTo(w.Position)
	else
		self.humanoid:MoveTo(goal)
	end
	return false
end

function Monster:Think()
	local now = os.clock()
	local best, bestD
	for _, p in ipairs(self.opts.getPlayers()) do
		local char = p.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hrp and hum and hum.Health > 0 and p:GetAttribute("DevGhost") ~= true and p:GetAttribute("Downed") ~= true and p:GetAttribute("Hidden") ~= true and not self.opts.inSafeZone(hrp.Position) then
			local d = (hrp.Position - self.root.Position).Magnitude
			local sees = d < S.SightRange and self:LineOfSight(self.head.Position, hrp.Position, char)
			local hears = d < S.HearRange and hrp.AssemblyLinearVelocity.Magnitude > 18
			if (sees or hears) and (not best or d < bestD) then
				best, bestD = p, d
			end
		end
	end

	if best then
		self.state = "chase"
		self.target = best
		self.lastSeen = now
	elseif self.state == "chase" and now - (self.lastSeen or 0) > 5 then
		self.state = "patrol"
		self.patrolGoal = nil
	end

	if self.state == "chase" and self.target and self.target.Character then
		local hrp = self.target.Character:FindFirstChild("HumanoidRootPart")
		if not hrp or self.opts.inSafeZone(hrp.Position) or self.target:GetAttribute("Downed") == true or self.target:GetAttribute("Hidden") == true then
			self.state = "patrol"
			return
		end
		self.humanoid.WalkSpeed = self.chaseSpeed
		local d = (hrp.Position - self.root.Position).Magnitude
		if d < S.AttackRange and now - self.lastAttack > S.AttackCooldown then
			self.lastAttack = now
			self:Attack(self.target)
		end
		if d < 16 then
			self.waypoints = nil
			self.humanoid:MoveTo(hrp.Position)
		else
			self:Navigate(hrp.Position)
		end
		return
	end

	self.humanoid.WalkSpeed = S.PatrolSpeed
	if not self.patrolGoal or now - (self.patrolSince or 0) > 30 then
		local cells = self.opts.patrol
		self.patrolGoal = cells[math.random(1, #cells)]
		self.patrolSince = now
	end
	if self:Navigate(self.patrolGoal) then
		self.patrolGoal = nil
	end
end

function Monster:Attack(player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then
		return
	end
	-- рывок вперёд
	local root = self.root
	local look = (char.HumanoidRootPart.Position - root.Position) * V(1, 0, 1)
	if look.Magnitude > 0.1 then
		self.model:PivotTo(CFrame.lookAt(root.Position, root.Position + look))
	end
	self.model:SetAttribute("Attacks", (self.model:GetAttribute("Attacks") or 0) + 1)
	self.opts.damage(player, self.dmg)
end

function Monster:TakeDamage(amount, fromPos)
	if not self.alive then
		return
	end
	local hum = self.humanoid
	hum.Health = math.max(0, hum.Health - amount)
	self.model:SetAttribute("HP", hum.Health)
	self.model:SetAttribute("Flash", (self.model:GetAttribute("Flash") or 0) + 1)
	-- отброс
	if fromPos then
		local dir = (self.root.Position - fromPos) * V(1, 0, 1)
		if dir.Magnitude > 0.1 then
			self.root.AssemblyLinearVelocity = dir.Unit * 30 + V(0, 8, 0)
		end
	end
	self.state = "chase"
	self.lastSeen = os.clock()
	if hum.Health <= 0 then
		self:Die()
		return true
	end
	return false
end

-- исчезает (утро или смерть)
function Monster:Die(retreat)
	if not self.alive then
		return
	end
	self.alive = false
	self.step:Stop()
	self.humanoid:MoveTo(self.root.Position)
	self.model:SetAttribute("Dead", retreat and "retreat" or "kill")
	self.root.Anchored = true
	task.delay(3, function()
		self.model:Destroy()
	end)
end

function Monster:Loop()
	while self.alive and self.model.Parent do
		task.wait(0.15)
		if self.alive then
			local ok, err = pcall(function()
				self:Think()
			end)
			if not ok then
				warn("[Labyrinth] Ошибка ИИ:", err)
			end
		end
	end
end

return Monster
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Parts</string>
          <string name="Source"><![CDATA[-- Помощники для постройки уровня из простых деталей (Part).

local CollectionService = game:GetService("CollectionService")

local Parts = {}

local V = Vector3.new
local GLASS = Color3.fromRGB(38, 46, 58)
local BOARD = Color3.fromRGB(62, 48, 36)

function Parts.box(parent, name, cf, size, color, material, props)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = size
	p.CFrame = cf
	p.Color = color or Color3.fromRGB(120, 120, 120)
	p.Material = material or Enum.Material.SmoothPlastic
	if props then
		for k, v in pairs(props) do
			p[k] = v
		end
	end
	p.Parent = parent
	return p
end

-- Деталь между двумя углами (a и b — локальные координаты относительно origin)
function Parts.span(parent, name, origin, a, b, color, material, props)
	local minV = V(math.min(a.X, b.X), math.min(a.Y, b.Y), math.min(a.Z, b.Z))
	local maxV = V(math.max(a.X, b.X), math.max(a.Y, b.Y), math.max(a.Z, b.Z))
	return Parts.box(parent, name, CFrame.new(origin + (minV + maxV) / 2), maxV - minV, color, material, props)
end

-- Стена с проёмами.
-- axis "X": стена идёт вдоль X на z = fixed. axis "Z": вдоль Z на x = fixed.
-- openings: { {c = центр, w = ширина, b = высота низа проёма, h = высота проёма, glass = true, boarded = true}, ... }
function Parts.wall(parent, origin, axis, fixed, a1, a2, y0, height, openings, color, material, thickness)
	thickness = thickness or 1
	local half = thickness / 2

	local function seg(s, e, yb, yt)
		if e - s < 0.05 or yt - yb < 0.05 then
			return
		end
		if axis == "X" then
			Parts.span(parent, "Wall", origin, V(s, yb, fixed - half), V(e, yt, fixed + half), color, material)
		else
			Parts.span(parent, "Wall", origin, V(fixed - half, yb, s), V(fixed + half, yt, e), color, material)
		end
	end

	local ops = table.clone(openings or {})
	table.sort(ops, function(p, q)
		return p.c < q.c
	end)

	local cursor = a1
	for _, op in ipairs(ops) do
		local l, r = op.c - op.w / 2, op.c + op.w / 2
		local b = op.b or 0
		seg(cursor, l, y0, y0 + height)
		seg(l, r, y0, y0 + b)
		seg(l, r, y0 + b + op.h, y0 + height)

		if op.glass then
			local yb, yt = y0 + b, y0 + b + op.h
			if axis == "X" then
				Parts.span(parent, "Window", origin, V(l, yb, fixed - 0.1), V(r, yt, fixed + 0.1), GLASS, Enum.Material.Glass, { Transparency = 0.5 })
			else
				Parts.span(parent, "Window", origin, V(fixed - 0.1, yb, l), V(fixed + 0.1, yt, r), GLASS, Enum.Material.Glass, { Transparency = 0.5 })
			end
			if op.boarded then
				local center = (axis == "X") and V(op.c, (yb + yt) / 2, fixed + half + 0.1)
					or V(fixed + half + 0.1, (yb + yt) / 2, op.c)
				local turn = (axis == "X") and CFrame.new() or CFrame.Angles(0, math.pi / 2, 0)
				for _, ang in ipairs({ 25, -20 }) do
					Parts.box(
						parent,
						"Board",
						CFrame.new(origin + center) * turn * CFrame.Angles(0, 0, math.rad(ang)),
						V(op.w * 1.2, 0.7, 0.2),
						BOARD,
						Enum.Material.WoodPlanks
					)
				end
			end
		end
		cursor = r
	end
	seg(cursor, a2, y0, y0 + height)
end

-- Лестница: видимые ступени (без коллизии) + невидимый пандус, по которому удобно ходить
-- и игроку, и Топотуну (pathfinding).
function Parts.stairs(parent, origin, x1, x2, zStart, yStart, zEnd, yEnd, steps, color, material)
	local dz = (zEnd - zStart) / steps
	local dy = (yEnd - yStart) / steps
	for k = 1, steps do
		local za = zStart + dz * (k - 1)
		local zb = zStart + dz * k
		Parts.span(parent, "Step", origin, V(x1, yStart - 1, za), V(x2, yStart + dy * k, zb), color, material, { CanCollide = false })
		-- невидимый твёрдый блок на ступень ниже: снизу и сбоку под лестницу не пройти,
		-- а ходить по ней всё равно удобно (по пандусу)
		if k > 1 then
			Parts.span(parent, "StairFill", origin, V(x1, yStart - 1, za), V(x2, yStart + dy * (k - 1), zb), color, material, { Transparency = 1 })
		end
	end
	local run = math.abs(zEnd - zStart)
	local rise = yEnd - yStart
	local length = math.sqrt(run * run + rise * rise) + 0.6
	local mid = V((x1 + x2) / 2, (yStart + yEnd) / 2 + dy / 2, (zStart + zEnd) / 2)
	local sign = (zEnd < zStart) and 1 or -1
	local angle = math.atan2(rise, run) * sign
	Parts.box(
		parent,
		"StairRamp",
		CFrame.new(origin + mid) * CFrame.Angles(angle, 0, 0) * CFrame.new(0, -0.5, 0),
		V(math.abs(x2 - x1), 1, length),
		color,
		material,
		{ Transparency = 1 }
	)
end

function Parts.light(part, range, brightness, color, flicker)
	local l = Instance.new("PointLight")
	l.Range = range
	l.Brightness = brightness
	l.Color = color or Color3.fromRGB(255, 170, 90)
	l.Shadows = true
	l.Parent = part
	if flicker then
		CollectionService:AddTag(l, "FlickerLight")
	end
	return l
end

function Parts.deadTree(parent, pos, rng)
	local wood = Color3.fromRGB(36, 31, 28)
	local h = rng:NextNumber(12, 22)
	Parts.box(parent, "Trunk", CFrame.new(pos + V(0, h / 2, 0)) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0), V(1.6, h, 1.6), wood, Enum.Material.Wood)
	for _ = 1, rng:NextInteger(3, 6) do
		local len = rng:NextNumber(4, 9)
		local y = rng:NextNumber(h * 0.45, h * 0.95)
		local base = CFrame.new(pos + V(0, y, 0)) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0) * CFrame.Angles(0, 0, rng:NextNumber(0.5, 1.15))
		Parts.box(parent, "Branch", base * CFrame.new(0, len / 2, 0), V(0.55, len, 0.55), wood, Enum.Material.Wood)
	end
end

return Parts
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[-- Постройка мира: лобби (3 лифта сложности, торговец классами), поляна (лес, река, лифт),
-- стены с воротами и лабиринт (шахты, сундуки, щели, выход с вертолётной площадкой).
-- Каждая группа игроков получает свой лабиринт со своим смещением O.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Parts = require(script.Parent.Parts)
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Items = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Items"))

local World = {}

local V = Vector3.new
local RGB = Color3.fromRGB
local M = Enum.Material

local MZ = Config.Maze
local N, C = MZ.Cells, MZ.CellSize
local MID = (N - 1) / 2
local HALF = N * C / 2
local CLEAR_LO, CLEAR_HI = MID - (MZ.ClearingCells - 1) / 2, MID + (MZ.ClearingCells - 1) / 2
local CLEAR_HALF = MZ.ClearingCells * C / 2

World.LOBBY = V(0, 50, 0)
World.CLEARING_HALF = CLEAR_HALF
World.HALF = HALF

local WALL = RGB(84, 86, 82)
local WALL_DARK = RGB(60, 62, 60)
local IVY = RGB(52, 82, 44)
local WOOD = RGB(92, 64, 40)
local METAL = RGB(70, 72, 76)
local NOCOLLIDE = { CanCollide = false }

local function cellPos(O, i, j)
	return O + V((i - MID) * C, 0, (j - MID) * C)
end

local function inClearing(i, j)
	return i >= CLEAR_LO and i <= CLEAR_HI and j >= CLEAR_LO and j <= CLEAR_HI
end

local function tag(inst, name)
	CollectionService:AddTag(inst, name)
end

local function prompt(part, action, object, hold, dist)
	local p = Instance.new("ProximityPrompt")
	p.ActionText = action
	p.ObjectText = object or ""
	p.HoldDuration = hold or 0
	p.MaxActivationDistance = dist or 10
	p.RequiresLineOfSight = false
	p.Parent = part
	return p
end

------------------------------------------------------------------
-- Ресурсные узлы (деревья, камни, руда) — добываются ударом или зажатой E
------------------------------------------------------------------
local function node(parent, kind, pos, rng)
	local def = Items.Nodes[kind]
	local m = Instance.new("Model")
	m.Name = def.Name
	m:SetAttribute("Node", kind)
	m:SetAttribute("HP", def.Health)
	local main
	if kind == "tree" then
		local h = rng:NextNumber(20, 30)
		main = Parts.box(m, "Trunk", CFrame.new(pos + V(0, h / 2, 0)), V(2.2, h, 2.2), RGB(84, 60, 40), M.Wood)
		local leaf = RGB(rng:NextInteger(38, 58), rng:NextInteger(86, 112), rng:NextInteger(38, 52))
		for k = 1, 5 do
			local s = rng:NextNumber(9, 13) * (1 - k * 0.11)
			Parts.box(m, "Leaves", CFrame.new(pos + V(rng:NextNumber(-2, 2), h * 0.55 + k * 2.8, rng:NextNumber(-2, 2))), V(s, s * 0.8, s), leaf, M.LeafyGrass, {
				Shape = Enum.PartType.Ball,
				CanCollide = false,
			})
		end
	else
		local rock = RGB(100, 100, 104)
		for _ = 1, 3 do
			local s = rng:NextNumber(2.6, 4.4)
			local cf = CFrame.new(pos + V(rng:NextNumber(-1.6, 1.6), s * 0.4, rng:NextNumber(-1.6, 1.6)))
				* CFrame.Angles(rng:NextNumber(0, 3), rng:NextNumber(0, 3), rng:NextNumber(0, 3))
			local r = Parts.box(m, "Rock", cf, V(s, s * 0.8, s), rock, M.Slate)
			main = main or r
		end
		if kind ~= "stone" then
			local c = kind == "iron" and RGB(170, 100, 60) or RGB(170, 90, 255)
			local mat = kind == "iron" and M.CorrodedMetal or M.Neon
			for _ = 1, 5 do
				local cf = CFrame.new(pos + V(rng:NextNumber(-2, 2), rng:NextNumber(0.8, 3), rng:NextNumber(-2, 2)))
					* CFrame.Angles(rng:NextNumber(0, 3), rng:NextNumber(0, 3), rng:NextNumber(0, 3))
				Parts.box(m, "Ore", cf, kind == "crystal" and V(0.5, 1.8, 0.5) or V(0.9, 0.9, 0.9), c, mat, NOCOLLIDE)
			end
			if kind == "crystal" then
				Parts.light(m:FindFirstChild("Ore"), 12, 1, c, false)
			end
		end
	end
	local p = prompt(main, def.Action, def.Name, 0.7, 11)
	tag(p, "NodePrompt")
	m.Parent = parent
	tag(m, "Node")
	return m
end
World.node = node

------------------------------------------------------------------
-- Верстак (крафтится игроком и ставится перед собой)
------------------------------------------------------------------
function World.BuildWorkbench(parent, cf)
	local wb = Instance.new("Model")
	wb.Name = "Workbench"
	local top = Parts.box(wb, "Top", cf * CFrame.new(0, 3.45, 0), V(8, 0.5, 4), RGB(110, 80, 50), M.WoodPlanks)
	for _, x in ipairs({ -3.5, 3.5 }) do
		for _, z in ipairs({ -1.5, 1.5 }) do
			Parts.box(wb, "Leg", cf * CFrame.new(x, 1.6, z), V(0.6, 3.2, 0.6), WOOD, M.Wood)
		end
	end
	Parts.box(wb, "Shelf", cf * CFrame.new(0, 1, 0), V(7.4, 0.3, 3.4), WOOD, M.WoodPlanks)
	Parts.box(wb, "Vise", cf * CFrame.new(3, 4.1, -1), V(1.1, 0.9, 1), METAL, M.Metal)
	Parts.box(wb, "Saw", cf * CFrame.new(-1.7, 3.75, 0.9), V(2.5, 0.1, 0.8), RGB(170, 170, 175), M.Metal)
	Parts.box(wb, "Hammer", cf * CFrame.new(0.8, 3.8, -1.05), V(1.6, 0.25, 0.3), WOOD, M.Wood)
	local p = prompt(top, "Крафт", "Верстак", 0, 10)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.new(0, 200, 0, 36)
	bb.StudsOffset = V(0, 3, 0)
	bb.MaxDistance = 60
	bb.Parent = top
	local bl = Instance.new("TextLabel")
	bl.Size = UDim2.fromScale(1, 1)
	bl.BackgroundTransparency = 1
	bl.TextColor3 = RGB(255, 230, 180)
	bl.TextStrokeTransparency = 0.3
	bl.Font = Enum.Font.GothamBold
	bl.TextScaled = true
	bl.Text = "Верстак · ур. 1"
	bl.Parent = bb
	wb:SetAttribute("Level", 1)
	wb.Parent = parent
	tag(wb, "Workbench")
	return { model = wb, prompt = p, label = bl, top = top }
end

------------------------------------------------------------------
-- Классический Roblox-человечек (торговец)
------------------------------------------------------------------
local function classicNPC(parent, cf, name)
	local m = Instance.new("Model")
	m.Name = name
	local yellow, blue, green = RGB(245, 205, 48), RGB(13, 105, 172), RGB(40, 127, 71)
	local torso = Parts.box(m, "Torso", cf * CFrame.new(0, 3, 0), V(2, 2, 1), blue, M.SmoothPlastic)
	local head = Parts.box(m, "Head", cf * CFrame.new(0, 4.5, 0), V(2, 1, 1), yellow, M.SmoothPlastic)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Head
	mesh.Scale = V(1.25, 1.25, 1.25)
	mesh.Parent = head
	local face = Instance.new("Decal")
	face.Name = "face"
	face.Texture = "rbxasset://textures/face.png"
	face.Face = Enum.NormalId.Front
	face.Parent = head
	Parts.box(m, "Left Arm", cf * CFrame.new(-1.5, 3, 0), V(1, 2, 1), yellow, M.SmoothPlastic)
	Parts.box(m, "Right Arm", cf * CFrame.new(1.5, 3, 0), V(1, 2, 1), yellow, M.SmoothPlastic)
	Parts.box(m, "Left Leg", cf * CFrame.new(-0.5, 1, 0), V(1, 2, 1), green, M.SmoothPlastic)
	Parts.box(m, "Right Leg", cf * CFrame.new(0.5, 1, 0), V(1, 2, 1), green, M.SmoothPlastic)
	local hum = Instance.new("Humanoid")
	hum.DisplayName = name
	hum.Parent = m
	m.PrimaryPart = torso
	m.Parent = parent
	return m, torso
end

------------------------------------------------------------------
-- Лобби: три лифта (легко / обычно / тяжело), торговец классами, декор
------------------------------------------------------------------
function World.BuildLobby()
	local m = Instance.new("Model")
	m.Name = "Lobby"
	local o = World.LOBBY
	local concrete = RGB(74, 76, 78)
	Parts.span(m, "Floor", o, V(-62, -1, -27), V(62, 0, 27), RGB(56, 58, 60), M.Concrete)
	Parts.span(m, "Ceiling", o, V(-62, 20, -45), V(62, 21, 27), concrete, M.Concrete)
	Parts.wall(m, o, "X", 27, -62, 62, 0, 20, nil, concrete, M.Concrete, 1)
	Parts.wall(m, o, "Z", -62, -27, 27, 0, 20, nil, concrete, M.Concrete, 1)
	Parts.wall(m, o, "Z", 62, -27, 27, 0, 20, nil, concrete, M.Concrete, 1)
	-- северная стена с тремя проёмами лифтов
	local lifts = { { id = "easy", x = -36 }, { id = "normal", x = 0 }, { id = "hard", x = 36 } }
	local ops = {}
	for _, l in ipairs(lifts) do
		table.insert(ops, { c = l.x, w = 14, b = 0, h = 13 })
	end
	Parts.wall(m, o, "X", -27, -62, 62, 0, 20, ops, concrete, M.Concrete, 1)

	local elevators = {}
	for _, l in ipairs(lifts) do
		local col = RGB(230, 220, 190)
		local x = l.x
		Parts.span(m, "LiftFloor", o, V(x - 9, -1, -45), V(x + 9, 0, -27), RGB(40, 40, 42), M.DiamondPlate)
		Parts.span(m, "LiftWall", o, V(x - 9.5, 0, -45), V(x - 9, 20, -27), METAL, M.DiamondPlate)
		Parts.span(m, "LiftWall", o, V(x + 9, 0, -45), V(x + 9.5, 20, -27), METAL, M.DiamondPlate)
		Parts.span(m, "LiftWall", o, V(x - 9.5, 0, -45.5), V(x + 9.5, 20, -45), METAL, M.DiamondPlate)
		local lamp = Parts.span(m, "LiftLight", o, V(x - 6, 19.2, -42), V(x + 6, 19.5, -30), RGB(255, 235, 200), M.Neon)
		Parts.light(lamp, 24, 1.1, RGB(255, 225, 190), false)
		-- цветная полоса и табличка над входом
		Parts.span(m, "LiftStripe", o, V(x - 7, 13, -26.6), V(x + 7, 13.6, -26.2), col, M.Neon)
		local sign = Parts.span(m, "LiftSign", o, V(x - 7, 14, -26.6), V(x + 7, 18, -26.2), RGB(20, 20, 22), M.SmoothPlastic)
		local sg = Instance.new("SurfaceGui")
		sg.Face = Enum.NormalId.Back
		sg.PixelsPerStud = 25
		sg.Parent = sign
		local t = Instance.new("TextLabel")
		t.Size = UDim2.fromScale(1, 1)
		t.BackgroundTransparency = 1
		t.Font = Enum.Font.GothamBlack
		t.TextScaled = true
		t.TextColor3 = col
		t.Text = "ЛИФТ"
		t.Parent = sg
		for k = -3, 3 do
			Parts.span(m, "Hazard", o, V(x + k * 2 - 0.5, 0, -27), V(x + k * 2 + 0.5, 0.05, -25), (k % 2 == 0) and RGB(220, 180, 30) or RGB(20, 20, 20), M.SmoothPlastic)
		end
		local zone = Parts.span(m, "LiftZone", o, V(x - 8.5, 0, -44.5), V(x + 8.5, 12, -27.5), nil, nil, { Transparency = 1, CanCollide = false, CanQuery = false })
		elevators[l.id] = { zone = zone, door = o + V(x, 0, -27), outside = CFrame.lookAt(o + V(x, 3, -20), o + V(x, 3, 0)), label = t }
	end

	-- лампы
	for x = -48, 48, 24 do
		for _, z in ipairs({ -10, 12 }) do
			local lamp = Parts.span(m, "Lamp", o, V(x - 2.5, 19.4, z - 1), V(x + 2.5, 19.9, z + 1), RGB(255, 235, 200), M.Neon)
			Parts.light(lamp, 30, 0.9, RGB(255, 225, 190), (x + z) % 3 == 0)
		end
	end

	-- правила
	local board = Parts.span(m, "Rules", o, V(61.4, 4, -12), V(61.6, 15, 12), RGB(28, 30, 34), M.SmoothPlastic)
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Left
	sg.PixelsPerStud = 25
	sg.Parent = board
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.TextColor3 = RGB(230, 225, 210)
	t.Font = Enum.Font.GothamBold
	t.TextScaled = true
	t.TextWrapped = true
	t.Text = "ПРАВИЛА ПОЛЯНЫ\n\n1. Днём врата открыты — исследуй лабиринт.\n2. На закате врата закрываются. Вернись!\n3. Ночью в лабиринте Скрежетники.\n4. Раненого друга подними бинтом.\n5. Найди Ключ в золотом сундуке и выход.\n6. Ctrl — пригнуться и пролезть в щель."
	t.Parent = sg

	-- торговец классами
	local counter = Parts.span(m, "Counter", o, V(-58, 0, 2), V(-50, 3.5, 18), RGB(90, 64, 40), M.WoodPlanks)
	Parts.span(m, "CounterTop", o, V(-58.3, 3.5, 1.7), V(-49.7, 3.9, 18.3), RGB(120, 90, 60), M.Wood)
	local _, npcTorso = classicNPC(m, CFrame.lookAt(o + V(-59.5, 0, 10), o + V(-40, 0, 10)), "Торговец классами")
	local mp = prompt(counter, "Классы", "Торговец", 0, 12)
	local msign = Parts.span(m, "ShopSign", o, V(-61.4, 9, 2), V(-61.2, 13, 18), RGB(40, 24, 16), M.Wood)
	local ms = Instance.new("SurfaceGui")
	ms.Face = Enum.NormalId.Right
	ms.PixelsPerStud = 25
	ms.Parent = msign
	local mt = Instance.new("TextLabel")
	mt.Size = UDim2.fromScale(1, 1)
	mt.BackgroundTransparency = 1
	mt.Font = Enum.Font.GothamBlack
	mt.TextScaled = true
	mt.TextColor3 = RGB(255, 210, 90)
	mt.Text = "КЛАССЫ · за монеты"
	mt.Parent = ms
	local _ = npcTorso

	-- декор: ящики, бочки, растения, скамейки
	local rng = Random.new(42)
	for _, p in ipairs({ V(50, 0, 20), V(54, 0, 22), V(52, 4, 21), V(-20, 0, 22), V(20, 0, 23) }) do
		Parts.span(m, "Crate", o, p + V(-2, 0, -2), p + V(2, 4, 2), RGB(110, 85, 55), M.WoodPlanks)
	end
	for _, x in ipairs({ -30, -10, 10, 30 }) do
		Parts.span(m, "Bench", o, V(x - 5, 1.6, 20), V(x + 5, 2.1, 23), WOOD, M.WoodPlanks)
		Parts.span(m, "BenchLeg", o, V(x - 4.5, 0, 20.5), V(x - 4, 1.6, 22.5), METAL, M.Metal)
		Parts.span(m, "BenchLeg", o, V(x + 4, 0, 20.5), V(x + 4.5, 1.6, 22.5), METAL, M.Metal)
	end
	for _, p in ipairs({ V(-56, 0, -22), V(56, 0, -22), V(-56, 0, 24), V(42, 0, 24) }) do
		Parts.span(m, "Pot", o, p + V(-1.5, 0, -1.5), p + V(1.5, 2, 1.5), RGB(80, 60, 50), M.Slate)
		Parts.box(m, "Plant", CFrame.new(o + p + V(0, 4, 0)), V(4, 4.5, 4), RGB(50, 110, 55), M.LeafyGrass, { Shape = Enum.PartType.Ball })
	end
	local _ = rng

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "LobbySpawn"
	spawn.Anchored = true
	spawn.Size = V(12, 1, 6)
	spawn.CFrame = CFrame.new(o + V(0, -0.4, 14))
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Parent = m
	m.Parent = workspace
	return { model = m, spawn = spawn, elevators = elevators, merchantPrompt = mp }
end

------------------------------------------------------------------
-- Рельеф: земля лабиринта, трава поляны, река
------------------------------------------------------------------
-- озеро сверху слева (северо-запад), из него на восток течёт река
local LAKE = V(-112, 0, -112)
local LAKE_R, SAND_R = 74, 92
local RIVER = { V(-50, 0, -96), V(40, 0, -74), V(120, 0, -40), V(196, 0, -26) }

local function distToWater(p)
	local best = (V(p.X, 0, p.Z) - LAKE).Magnitude - LAKE_R
	for k = 1, #RIVER - 1 do
		local a, b = RIVER[k], RIVER[k + 1]
		local ab = b - a
		local t = math.clamp((p - a):Dot(ab) / ab:Dot(ab), 0, 1)
		local q = a + ab * t
		best = math.min(best, (V(p.X, 0, p.Z) - V(q.X, 0, q.Z)).Magnitude)
	end
	return best
end

local function safe(fn)
	local ok, err = pcall(fn)
	if not ok then
		warn("[Labyrinth] рельеф:", err)
	end
end

local terrainBuilt = {}
function World.BuildTerrain(O)
	if terrainBuilt[O.X] then
		return
	end
	terrainBuilt[O.X] = true
	local terrain = workspace.Terrain
	local size = Config.SlotSpacing - 120
	-- снаружи лабиринта трава (там лес), внутри коридоров — утоптанная земля
	safe(function()
		terrain:FillBlock(CFrame.new(O + V(0, -8, 0)), V(size, 16, size), M.Grass)
	end)
	safe(function()
		terrain:FillBlock(CFrame.new(O + V(0, -2, 0)), V(HALF * 2 + 8, 4, HALF * 2 + 8), M.Ground)
	end)
	safe(function()
		terrain:FillBlock(CFrame.new(O + V(0, -2, 0)), V(CLEAR_HALF * 2, 4, CLEAR_HALF * 2), M.Grass)
	end)
	-- озеро и река. Сначала весь песок, потом выемка, потом вода —
	-- иначе песок следующего куска реки закрывает воду предыдущего.
	local segs = {}
	for k = 1, #RIVER - 1 do
		local a, b = O + RIVER[k], O + RIVER[k + 1]
		local mid = (a + b) / 2
		table.insert(segs, { cf = CFrame.lookAt(mid, mid + (b - a)), len = (b - a).Magnitude })
	end
	local function fillWater(mat, lakeR, riverW, y, h)
		safe(function()
			terrain:FillCylinder(CFrame.new(O + LAKE + V(0, y, 0)), h, lakeR, mat)
		end)
		for _, sg in ipairs(segs) do
			safe(function()
				terrain:FillBlock(sg.cf * CFrame.new(0, y, 0), V(riverW, h, sg.len), mat)
			end)
		end
		-- круглые стыки, чтобы на поворотах не было ступенек
		for k = 2, #RIVER do
			safe(function()
				terrain:FillCylinder(CFrame.new(O + RIVER[k] + V(0, y, 0)), h, riverW / 2, mat)
			end)
		end
	end
	fillWater(M.Sand, SAND_R, 30, -2, 4)
	fillWater(M.Air, LAKE_R, 16, 1, 6)
	fillWater(M.Water, LAKE_R, 16, -6, 10)
	-- холмы и горы вдалеке, чтобы с вертолёта не было видно края мира
	local rng = Random.new(O.X + 11)
	for k = 1, 22 do
		local a = k / 22 * math.pi * 2 + rng:NextNumber(-0.1, 0.1)
		local dist = rng:NextNumber(HALF + 420, HALF + 760)
		local r = rng:NextNumber(110, 190)
		local c = O + V(math.cos(a) * dist, -r * 0.55, math.sin(a) * dist)
		safe(function()
			terrain:FillBall(c, r, M.Grass)
		end)
		if k % 3 == 0 then
			safe(function()
				terrain:FillBall(c + V(0, r * 0.35, 0), r * 0.55, M.Rock)
			end)
		end
	end
	safe(function()
		if not terrain:FindFirstChildOfClass("Clouds") then
			local clouds = Instance.new("Clouds")
			clouds.Cover = 0.55
			clouds.Density = 0.6
			clouds.Parent = terrain
		end
		terrain.WaterColor = RGB(40, 100, 115)
		terrain.WaterTransparency = 0.5
		terrain.WaterWaveSize = 0.12
		terrain.WaterReflectance = 0.7
	end)
end

-- поверхность воды из деталей: видна, даже если вода рельефа не появилась
function World.BuildWaterSurface(parent, O)
	local m = Instance.new("Model")
	m.Name = "WaterSurface"
	local water = RGB(45, 110, 125)
	local function props()
		return { Shape = Enum.PartType.Cylinder, CanCollide = false, CanQuery = false, Transparency = 0.45, Reflectance = 0.2, CastShadow = false }
	end
	Parts.box(m, "Lake", CFrame.new(O + LAKE + V(0, -0.5, 0)) * CFrame.Angles(0, 0, math.pi / 2), V(0.2, LAKE_R * 2 - 2, LAKE_R * 2 - 2), water, M.Glass, props())
	for k = 1, #RIVER - 1 do
		local a, b = O + RIVER[k], O + RIVER[k + 1]
		local mid = (a + b) / 2
		Parts.box(m, "River", CFrame.lookAt(mid, mid + (b - a)) * CFrame.new(0, -0.55, 0), V(15, 0.2, (b - a).Magnitude - 15), water, M.Glass, {
			CanCollide = false,
			CanQuery = false,
			Transparency = 0.45,
			Reflectance = 0.2,
			CastShadow = false,
		})
	end
	for k = 2, #RIVER do
		Parts.box(m, "RiverBend", CFrame.new(O + RIVER[k] + V(0, -0.6, 0)) * CFrame.Angles(0, 0, math.pi / 2), V(0.2, 15, 15), water, M.Glass, props())
	end
	m.Parent = parent
end

-- лес вокруг всего лабиринта (виден с вертолёта)
function World.BuildOuterForest(parent, O, seed)
	local m = Instance.new("Model")
	m.Name = "OuterForest"
	local rng = Random.new(seed + 5)
	local far = HALF + 900
	local placed, tries = 0, 0
	while placed < 900 and tries < 8000 do
		tries += 1
		-- больше деревьев ближе к стенам, реже вдали
		local r = HALF + 24 + (rng:NextNumber() ^ 1.6) * (far - HALF - 24)
		local a = rng:NextNumber(0, math.pi * 2)
		local x, z = math.cos(a) * r * 1.15, math.sin(a) * r * 1.15
		if math.max(math.abs(x), math.abs(z)) > HALF + 22 and math.max(math.abs(x), math.abs(z)) < Config.SlotSpacing / 2 - 80 then
			placed += 1
			local p = O + V(x, 0, z)
			local h = rng:NextNumber(30, 54)
			local leaf = RGB(rng:NextInteger(30, 52), rng:NextInteger(74, 108), rng:NextInteger(34, 50))
			local s1 = rng:NextNumber(16, 24)
			Parts.box(m, "Trunk", CFrame.new(p + V(0, h / 2, 0)), V(3, h, 3), RGB(78, 56, 38), M.Wood)
			if rng:NextNumber() < 0.4 then
				-- ель
				Parts.box(m, "Crown", CFrame.new(p + V(0, h * 0.62, 0)), V(s1 * 1.1, h * 0.75, s1 * 1.1), RGB(28, 66, 40), M.LeafyGrass, { Shape = Enum.PartType.Ball, CanCollide = false })
			else
				Parts.box(m, "Crown", CFrame.new(p + V(0, h * 0.75, 0)), V(s1, s1 * 0.85, s1), leaf, M.LeafyGrass, { Shape = Enum.PartType.Ball, CanCollide = false })
				if r < HALF + 300 then
					Parts.box(m, "Crown", CFrame.new(p + V(rng:NextNumber(-3, 3), h * 0.95, rng:NextNumber(-3, 3))), V(s1 * 0.7, s1 * 0.6, s1 * 0.7), leaf, M.LeafyGrass, { Shape = Enum.PartType.Ball, CanCollide = false })
				end
			end
		end
	end
	m.Parent = parent
end

-- рельеф у каждого места одинаковый, поэтому его не стираем, а строим один раз
function World.ClearTerrain(_) end

------------------------------------------------------------------
-- Записки прошлых выживших и заброшенные лагеря
------------------------------------------------------------------
local NOTES = {
	{ "Дневник, день 3", "Стены не двигаются. Я проверил: зарубки на камне те же. Это мы теряем рассудок, а не лабиринт меняется." },
	{ "Нацарапано углём", "НЕ БЕГИТЕ НОЧЬЮ. Они слышат шаги. Идите тихо — и, может быть, доживёте до утра." },
	{ "Обрывок карты", "Выход есть! Огромные ворота у самой внешней стены. Но без ключ-карты они не откроются." },
	{ "Записка шахтёра", "Камень — деревянной киркой. Железо — только каменной. Кристаллы светятся в самых дальних шахтах, нужна железная." },
	{ "Медицинская памятка", "Если друг упал — не бросай его. Три пучка высокой травы — и у тебя бинт. Подними его, пока не поздно." },
	{ "Подпись: М.", "Скрежетники огромные. В узкие щели в стенах они не пролезают. Пригнись (Ctrl) — и ты спасён." },
	{ "Дрожащий почерк", "Вчера ночью я слышал вертолёт за стеной. Значит, снаружи кто-то есть. Значит, отсюда можно выбраться." },
	{ "Список", "Нас было пятеро. Осталось двое. Мы больше не ходим в лабиринт после того, как солнце касается стен." },
	{ "Правило поляны", "Пока врата закрыты — поляна безопасна. Опоздал хоть на секунду — ночуешь с ними." },
	{ "Чья-то догадка", "Каждый раз, когда приезжает лифт, коридоры другие. Карты бесполезны. Запоминай приметы: мох, кости, шахты." },
	{ "Рецепт", "Верстак — двенадцать брёвен и четыре камня. Без него не будет ни мечей, ни нормальной кирки." },
	{ "Последняя запись", "Золотой сундук. Самый дальний тупик. Над ним светится ключ. Я почти дошёл, но стемнело..." },
}

local function note(parent, cf, rng, index)
	local n = NOTES[(index - 1) % #NOTES + 1]
	local paper = Parts.box(parent, "Note", cf, V(1.2, 0.05, 1.6), RGB(230, 220, 190), M.SmoothPlastic, NOCOLLIDE)
	paper.CanQuery = true
	local p = prompt(paper, "Прочитать", "Записка", 0, 8)
	p:SetAttribute("Title", n[1])
	p:SetAttribute("Text", n[2])
	tag(p, "NotePrompt")
	local _ = rng
	return paper
end

local function lootCrate(parent, pos, rng, name)
	local crate = Parts.box(parent, name or "SupplyBox", CFrame.new(pos + V(0, 1.1, 0)) * CFrame.Angles(0, rng:NextNumber(0, 6), 0), V(2.6, 2.2, 2.2), RGB(115, 90, 58), M.WoodPlanks)
	local p = prompt(crate, "Обыскать", name == "Backpack" and "Рюкзак" or "Ящик", 0.8, 9)
	tag(p, "LootPrompt")
	return crate
end

-- заброшенный лагерь: палатка, потухший костёр, рюкзак, записка
local function camp(parent, center, rng, noteIndex)
	local base = CFrame.new(center) * CFrame.Angles(0, rng:NextNumber(0, 6), 0)
	local cloth = RGB(rng:NextInteger(90, 140), rng:NextInteger(70, 100), 50)
	for _, side in ipairs({ -1, 1 }) do
		Parts.box(parent, "Tent", base * CFrame.new(side * 2.2, 2.3, -4) * CFrame.Angles(0, 0, side * math.rad(-40)), V(0.2, 6, 7), cloth, M.Fabric)
	end
	Parts.box(parent, "AshPit", base * CFrame.new(3, 0.15, 3), V(3, 0.3, 3), RGB(40, 36, 34), M.Slate, NOCOLLIDE)
	for k = 0, 3 do
		Parts.box(parent, "BurntLog", base * CFrame.new(3, 0.4, 3) * CFrame.Angles(0, k * math.pi / 4, math.pi / 2), V(0.6, 2.6, 0.6), RGB(30, 26, 24), M.Wood, NOCOLLIDE)
	end
	lootCrate(parent, (base * CFrame.new(-3, 0, 2)).Position, rng, "Backpack")
	note(parent, base * CFrame.new(0.5, 0.1, 1) * CFrame.Angles(0, 0.4, 0), rng, noteIndex)
end

-- заросли лиан: занавес из свисающих стеблей и шапка листвы сверху
local function vineHide(parent, pos, rng)
	local m = Instance.new("Model")
	m.Name = "VineHide"
	local center = Parts.box(m, "HideCenter", CFrame.new(pos + V(0, 3, 0)), V(4, 6, 4), IVY, M.LeafyGrass, NOCOLLIDE)
	center.Transparency = 1
	Parts.box(m, "Canopy", CFrame.new(pos + V(0, 10, 0)), V(10, 5, 10), IVY, M.LeafyGrass, { Shape = Enum.PartType.Ball, CanCollide = false })
	for k = 1, 30 do
		local a = k / 30 * math.pi * 2 + rng:NextNumber(-0.1, 0.1)
		local r = rng:NextNumber(2.6, 3.8)
		local len = rng:NextNumber(7, 10)
		local top = 10
		local c = RGB(rng:NextInteger(40, 66), rng:NextInteger(78, 110), rng:NextInteger(36, 52))
		Parts.box(m, "Vine", CFrame.new(pos + V(math.cos(a) * r, top - len / 2, math.sin(a) * r)) * CFrame.Angles(rng:NextNumber(-0.06, 0.06), a, rng:NextNumber(-0.06, 0.06)), V(rng:NextNumber(0.25, 0.5), len, rng:NextNumber(0.6, 1.4)), c, M.LeafyGrass, NOCOLLIDE)
	end
	for _ = 1, 8 do
		local a = rng:NextNumber(0, math.pi * 2)
		Parts.box(m, "Leaves", CFrame.new(pos + V(math.cos(a) * 3.4, rng:NextNumber(1, 7), math.sin(a) * 3.4)), V(2.2, 1.6, 2.2), IVY, M.LeafyGrass, { Shape = Enum.PartType.Ball, CanCollide = false })
	end
	local p = prompt(center, "Спрятаться", "Заросли лиан", 0.3, 9)
	tag(p, "HidePrompt")
	m.Parent = parent
	return m
end

------------------------------------------------------------------
-- Поляна
------------------------------------------------------------------
function World.BuildClearing(parent, seed, O)
	local m = Instance.new("Model")
	m.Name = "Clearing"
	local rng = Random.new(seed)
	local refs = { model = m, nodes = {} }
	local E = CLEAR_HALF

	-- горбатый мост через реку на тропе к северным воротам (река там на z ≈ -84)
	local bz = -84
	local deck = { { -22, -12, 0.5, 2.2 }, { -12, -6, 2.2, 3.4 }, { -6, 6, 3.4, 3.4 }, { 6, 12, 3.4, 2.2 }, { 12, 22, 2.2, 0.5 } }
	for _, d in ipairs(deck) do
		local a, b = O + V(0, d[3], bz + d[1]), O + V(0, d[4], bz + d[2])
		local mid = (a + b) / 2
		local len = (b - a).Magnitude + 0.4
		local cf = CFrame.lookAt(mid, b)
		Parts.box(m, "Bridge", cf * CFrame.new(0, -0.35, 0), V(9, 0.7, len), WOOD, M.WoodPlanks)
		for _, x in ipairs({ -4.4, 4.4 }) do
			Parts.box(m, "BridgeRail", cf * CFrame.new(x, 2.6, 0), V(0.4, 0.4, len), RGB(70, 48, 30), M.Wood)
			Parts.box(m, "BridgePost", cf * CFrame.new(x, 1.2, -len / 2 + 0.3), V(0.5, 3.2, 0.5), RGB(70, 48, 30), M.Wood)
		end
	end
	for _, z in ipairs({ -9, 9 }) do
		for _, x in ipairs({ -3.5, 3.5 }) do
			Parts.box(m, "BridgePile", CFrame.new(O + V(x, -3, bz + z)), V(1, 12, 1), RGB(60, 42, 28), M.Wood)
		end
	end
	-- тропинки от лифта к четырём воротам (через реку — по мосту)
	Parts.span(m, "Path", O, V(-3.5, 0, bz + 22), V(3.5, 0.06, E - 2), RGB(120, 100, 70), M.Ground)
	Parts.span(m, "Path", O, V(-3.5, 0, -E + 2), V(3.5, 0.06, bz - 22), RGB(120, 100, 70), M.Ground)
	Parts.span(m, "Path", O, V(-E + 2, 0, -3.5), V(E - 2, 0.06, 3.5), RGB(120, 100, 70), M.Ground)
	-- деревянный причал на озере
	local dock = O + LAKE + V(52, 0, 40)
	Parts.box(m, "Dock", CFrame.lookAt(dock + V(0, 0.6, 0), O + LAKE + V(0, 0.6, 0)) * CFrame.new(0, 0, -8), V(6, 0.6, 26), WOOD, M.WoodPlanks)

	-- лифт в центре поляны
	local e = O
	Parts.span(m, "LiftFloor", e, V(-9, 0, -9), V(9, 0.6, 9), RGB(40, 40, 42), M.DiamondPlate)
	Parts.span(m, "LiftRoof", e, V(-9.5, 16, -9.5), V(9.5, 17, 9.5), METAL, M.DiamondPlate)
	for _, x in ipairs({ -9, 9 }) do
		Parts.span(m, "LiftWall", e, V(x - 0.3, 0.6, -9), V(x + 0.3, 16, 9), METAL, M.DiamondPlate)
	end
	Parts.span(m, "LiftWall", e, V(-9, 0.6, 8.7), V(9, 16, 9.3), METAL, M.DiamondPlate)
	local liftLight = Parts.span(m, "LiftLight", e, V(-6, 15.6, -6), V(6, 15.9, 6), RGB(255, 230, 190), M.Neon)
	Parts.light(liftLight, 22, 1, nil, false)
	local grate = Instance.new("Model")
	grate.Name = "LiftGrate"
	for x = -8, 8, 1.6 do
		Parts.box(grate, "Bar", CFrame.new(e + V(x, 8.3, -9)), V(0.25, 15.4, 0.25), RGB(50, 50, 54), M.Metal)
	end
	for y = 2, 15, 4 do
		Parts.box(grate, "Bar", CFrame.new(e + V(0, y, -9)), V(17.4, 0.25, 0.25), RGB(50, 50, 54), M.Metal)
	end
	grate.Parent = m
	refs.grate = grate
	refs.grateClosed = grate:GetPivot()
	refs.liftSpawn = CFrame.lookAt(e + V(0, 3.5, 2), e + V(0, 3.5, -30))
	refs.liftPos = e

	-- ящик с припасами у лифта
	local crate = Parts.span(m, "SupplyCrate", O, V(-20, 0, -16), V(-14, 3.5, -11), RGB(120, 95, 60), M.WoodPlanks)
	refs.supplyPrompt = prompt(crate, "Взять припасы", "Начальные ресурсы", 0, 10)
	note(m, CFrame.new(O + V(-17, 3.6, -13.5)), rng, 9)

	-- костёр с брёвнами вокруг
	local fc = O + V(34, 0, 34)
	local fireBase = Parts.box(m, "Campfire", CFrame.new(fc + V(0, 0.3, 0)), V(4, 0.6, 4), RGB(50, 34, 26), M.Slate)
	local fire = Instance.new("Fire")
	fire.Size = 6
	fire.Heat = 9
	fire.Parent = fireBase
	Parts.light(fireBase, 40, 1.5, RGB(255, 150, 70), true)
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		Parts.box(m, "Log", CFrame.new(fc + V(math.cos(a) * 6, 0.8, math.sin(a) * 6)) * CFrame.Angles(0, -a, 0) * CFrame.Angles(0, 0, math.pi / 2), V(1.6, 4.5, 1.6), WOOD, M.Wood, { Shape = Enum.PartType.Cylinder })
	end

	local function freeSpot(minRiver)
		for _ = 1, 60 do
			local p = V(rng:NextNumber(-E + 10, E - 10), 0, rng:NextNumber(-E + 10, E - 10))
			local ok = distToWater(p) > (minRiver or 14)
				and math.abs(p.X) > 8
				and math.abs(p.Z) > 8
				and p.Magnitude > 30
				and (p - V(34, 0, 34)).Magnitude > 14
			if ok then
				return O + p
			end
		end
		return O + V(rng:NextNumber(-E + 10, E - 10), 0, -E + 14)
	end
	-- деревья растут одной большой рощей (юго-восток поляны) и отрастают после вырубки
	local GROVE, GR = V(118, 0, 118), 78
	local grove = {}
	for _ = 1, 900 do
		if #grove >= 110 then
			break
		end
		local ang, rr = rng:NextNumber(0, math.pi * 2), GR * math.sqrt(rng:NextNumber())
		local p = GROVE + V(math.cos(ang) * rr, 0, math.sin(ang) * rr)
		local ok = math.abs(p.X) < E - 8 and math.abs(p.Z) < E - 8 and math.abs(p.X) > 8 and math.abs(p.Z) > 8 and (p - V(34, 0, 34)).Magnitude > 16
		for _, q in ipairs(grove) do
			if (q - p).Magnitude < 8.5 then
				ok = false
				break
			end
		end
		if ok then
			table.insert(grove, p)
			table.insert(refs.nodes, node(m, "tree", O + p, rng))
		end
	end
	for _ = 1, 12 do
		table.insert(refs.nodes, node(m, "tree", freeSpot(18), rng))
	end
	for _ = 1, 16 do
		table.insert(refs.nodes, node(m, "stone", freeSpot(10), rng))
	end
	for _ = 1, 20 do
		local p = freeSpot(10)
		local bush = Parts.box(m, "BerryBush", CFrame.new(p + V(0, 1.8, 0)), V(5, 3.8, 5), RGB(46, 84, 40), M.LeafyGrass, { Shape = Enum.PartType.Ball })
		for _ = 1, 7 do
			Parts.box(m, "Berry", CFrame.new(p + V(rng:NextNumber(-2, 2), rng:NextNumber(1.2, 3.4), rng:NextNumber(-2, 2))), V(0.55, 0.55, 0.55), RGB(200, 30, 50), M.SmoothPlastic, {
				Shape = Enum.PartType.Ball,
				CanCollide = false,
			})
		end
		tag(prompt(bush, "Собрать ягоды", "Куст", 0.5, 10), "BerryPrompt")
	end
	-- высокая трава у реки (из неё делаются бинты и верёвки)
	for _ = 1, 26 do
		local p
		for _ = 1, 40 do
			local cand = V(rng:NextNumber(-E + 8, E - 8), 0, rng:NextNumber(-E + 8, E - 8))
			local d = distToWater(cand)
			if d > 18 and d < 30 and math.abs(cand.X) > 7 then
				p = O + cand
				break
			end
		end
		if p then
			local base = Parts.box(m, "TallGrass", CFrame.new(p + V(0, 1.4, 0)), V(2.6, 2.8, 2.6), RGB(110, 140, 70), M.Grass, NOCOLLIDE)
			base.Transparency = 0.2
			for _ = 1, 6 do
				Parts.box(m, "Blade", CFrame.new(p + V(rng:NextNumber(-1.2, 1.2), 1.8, rng:NextNumber(-1.2, 1.2))) * CFrame.Angles(rng:NextNumber(-0.2, 0.2), 0, rng:NextNumber(-0.2, 0.2)), V(0.2, 3.6, 0.2), RGB(120, 150, 70), M.Grass, NOCOLLIDE)
			end
			tag(prompt(base, "Сорвать траву", "Высокая трава", 0.4, 9), "FiberPrompt")
		end
	end
	-- цветы
	for _ = 1, 160 do
		local p = V(rng:NextNumber(-E + 4, E - 4), 0, rng:NextNumber(-E + 4, E - 4))
		if distToWater(p) > 20 then
			local c = ({ RGB(230, 210, 80), RGB(200, 80, 120), RGB(240, 240, 240), RGB(150, 120, 230) })[rng:NextInteger(1, 4)]
			Parts.box(m, "Flower", CFrame.new(O + p + V(0, 0.4, 0)), V(0.7, 0.3, 0.7), c, M.SmoothPlastic, NOCOLLIDE)
		end
	end

	m.Parent = parent
	return refs
end

------------------------------------------------------------------
-- Стены поляны с воротами
------------------------------------------------------------------
function World.BuildClearingWalls(parent, O)
	local m = Instance.new("Model")
	m.Name = "ClearingWalls"
	local h = MZ.WallHeight + 12
	local t = 8
	local GW = Config.GateWidth
	local GH = h - 14
	local gates = {}
	local E = CLEAR_HALF
	local op = { { c = 0, w = GW, b = 0, h = GH } }
	Parts.wall(m, O, "X", -E, -E - t / 2, E + t / 2, 0, h, op, WALL_DARK, M.Slate, t)
	Parts.wall(m, O, "X", E, -E - t / 2, E + t / 2, 0, h, op, WALL_DARK, M.Slate, t)
	Parts.wall(m, O, "Z", -E, -E, E, 0, h, op, WALL_DARK, M.Slate, t)
	Parts.wall(m, O, "Z", E, -E, E, 0, h, op, WALL_DARK, M.Slate, t)
	-- плющ на стенах поляны
	local rng = Random.new(O.X + 3)
	for _ = 1, 30 do
		local side = rng:NextInteger(1, 4)
		local a = rng:NextNumber(-E + 20, E - 20)
		local len, hh = rng:NextNumber(10, 26), rng:NextNumber(14, 40)
		local inset = E - t / 2 - 0.2
		local p, size
		if side == 1 then
			p, size = V(a, h - hh / 2, -inset), V(len, hh, 0.4)
		elseif side == 2 then
			p, size = V(a, h - hh / 2, inset), V(len, hh, 0.4)
		elseif side == 3 then
			p, size = V(-inset, h - hh / 2, a), V(0.4, hh, len)
		else
			p, size = V(inset, h - hh / 2, a), V(0.4, hh, len)
		end
		if math.abs(a) > GW / 2 + 6 then
			Parts.box(m, "Ivy", CFrame.new(O + p), size, IVY, M.LeafyGrass, NOCOLLIDE)
		end
	end

	for _, g in ipairs({
		{ name = "Север", pos = V(0, 0, -E), axis = "X" },
		{ name = "Юг", pos = V(0, 0, E), axis = "X" },
		{ name = "Запад", pos = V(-E, 0, 0), axis = "Z" },
		{ name = "Восток", pos = V(E, 0, 0), axis = "Z" },
	}) do
		local along = g.axis == "X" and V(1, 0, 0) or V(0, 0, 1)
		local leaves = {}
		for _, side in ipairs({ -1, 1 }) do
			local size = g.axis == "X" and V(GW / 2, GH, 6) or V(6, GH, GW / 2)
			local closed = CFrame.new(O + g.pos + along * side * (GW / 4) + V(0, GH / 2, 0))
			local leaf = Parts.box(m, "GateLeaf", closed, size, RGB(66, 62, 58), M.Slate)
			for y = -GH / 2 + 5, GH / 2 - 5, 9 do
				Parts.box(leaf, "Band", closed * CFrame.new(0, y, 0), g.axis == "X" and V(GW / 2, 1.2, 6.4) or V(6.4, 1.2, GW / 2), METAL, M.Metal, NOCOLLIDE)
			end
			table.insert(leaves, { part = leaf, closed = closed, open = closed + along * side * (GW / 2 + 1) })
		end
		for _, side in ipairs({ -1, 1 }) do
			local inward = -g.pos.Unit
			local tp = O + g.pos + along * side * (GW / 2 + 4) + inward * 5 + V(0, 14, 0)
			local torch = Parts.box(m, "GateTorch", CFrame.new(tp), V(1, 1.5, 1), RGB(255, 140, 50), M.Neon)
			Parts.light(torch, 34, 1.4, RGB(255, 150, 70), true)
			local f = Instance.new("Fire")
			f.Size = 3
			f.Parent = torch
		end
		table.insert(gates, { name = g.name, leaves = leaves })
	end
	m.Parent = parent
	return gates
end

------------------------------------------------------------------
-- Лабиринт
------------------------------------------------------------------
local function generate(rng)
	local openE, openS, visited = {}, {}, {}
	for i = 0, N - 1 do
		openE[i], openS[i], visited[i] = {}, {}, {}
	end
	local function valid(i, j)
		return i >= 0 and j >= 0 and i < N and j < N and not inClearing(i, j)
	end
	local function link(a, b, c, d)
		if a == c then
			openS[a][math.min(b, d)] = true
		else
			openE[math.min(a, c)][b] = true
		end
	end
	local stack = { { MID, CLEAR_LO - 1 } }
	visited[MID][CLEAR_LO - 1] = true
	while #stack > 0 do
		local cur = stack[#stack]
		local i, j = cur[1], cur[2]
		local nbrs = {}
		for _, d in ipairs({ { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }) do
			local ni, nj = i + d[1], j + d[2]
			if valid(ni, nj) and not visited[ni][nj] then
				table.insert(nbrs, { ni, nj })
			end
		end
		if #nbrs == 0 then
			table.remove(stack)
		else
			local nb = nbrs[rng:NextInteger(1, #nbrs)]
			link(i, j, nb[1], nb[2])
			visited[nb[1]][nb[2]] = true
			table.insert(stack, nb)
		end
	end
	for i = 0, N - 2 do
		for j = 0, N - 1 do
			if valid(i, j) and valid(i + 1, j) and rng:NextNumber() < MZ.ExtraOpenings then
				openE[i][j] = true
			end
		end
	end
	for i = 0, N - 1 do
		for j = 0, N - 2 do
			if valid(i, j) and valid(i, j + 1) and rng:NextNumber() < MZ.ExtraOpenings then
				openS[i][j] = true
			end
		end
	end
	return openE, openS, valid
end

local function neighbors(i, j, openE, openS, valid)
	local list = {}
	if i < N - 1 and openE[i][j] and valid(i + 1, j) then
		table.insert(list, { i + 1, j })
	end
	if i > 0 and openE[i - 1][j] and valid(i - 1, j) then
		table.insert(list, { i - 1, j })
	end
	if j < N - 1 and openS[i][j] and valid(i, j + 1) then
		table.insert(list, { i, j + 1 })
	end
	if j > 0 and openS[i][j - 1] and valid(i, j - 1) then
		table.insert(list, { i, j - 1 })
	end
	return list
end

local function chest(parent, pos, facing, golden)
	local m = Instance.new("Model")
	m.Name = golden and "GoldenChest" or "Chest"
	pos = pos + V(0, 0.4, 0)
	local b = CFrame.lookAt(pos, pos + facing)
	local wood = golden and RGB(90, 60, 30) or RGB(100, 70, 40)
	local trim = golden and RGB(230, 180, 60) or RGB(70, 70, 74)
	local body = Parts.box(m, "Body", b * CFrame.new(0, 1.1, 0), V(4, 2.2, 2.6), wood, M.WoodPlanks)
	local lid = Parts.box(m, "Lid", b * CFrame.new(0, 2.5, 0), V(4.1, 0.7, 2.7), wood, M.WoodPlanks)
	for _, x in ipairs({ -1.4, 1.4 }) do
		Parts.box(m, "Band", b * CFrame.new(x, 1.5, 0), V(0.3, 3, 2.8), trim, M.Metal, NOCOLLIDE)
	end
	Parts.box(m, "Lock", b * CFrame.new(0, 2.1, -1.4), V(0.6, 0.7, 0.2), trim, M.Metal, NOCOLLIDE)
	if golden then
		Parts.light(body, 20, 1.4, RGB(255, 200, 90), true)
		-- над золотым сундуком висит ключ
		local key = Parts.box(m, "KeyGlow", b * CFrame.new(0, 5, 0), V(0.4, 1.6, 0.8), RGB(255, 210, 90), M.Neon, NOCOLLIDE)
		Parts.light(key, 14, 1, RGB(255, 210, 90), false)
	end
	local p = prompt(body, "Открыть", golden and "Золотой сундук" or "Сундук", 0.8, 10)
	m:SetAttribute("Golden", golden == true)
	m.Parent = parent
	tag(m, "Chest")
	return { model = m, lid = lid, prompt = p, base = b }
end

local function mine(parent, center, facing, kinds, rng, nodes)
	local b = CFrame.lookAt(center, center + facing)
	local beam = RGB(80, 58, 36)
	for _, x in ipairs({ -10, 10 }) do
		Parts.box(parent, "MineSupport", b * CFrame.new(x, 7, -11), V(1.4, 14, 1.4), beam, M.Wood)
	end
	Parts.box(parent, "MineBeam", b * CFrame.new(0, 14.5, -11), V(21.5, 1.4, 1.4), beam, M.Wood)
	local lantern = Parts.box(parent, "MineLantern", b * CFrame.new(0, 13, -11), V(0.9, 1.3, 0.9), RGB(255, 170, 80), M.Neon)
	Parts.light(lantern, 30, 1.3, RGB(255, 170, 90), true)
	Parts.box(parent, "MineCart", b * CFrame.new(8, 1.2, 5), V(3.4, 2.2, 5), RGB(80, 70, 60), M.CorrodedMetal)
	for k, kind in ipairs(kinds) do
		local off = ({ V(-7, 0, 2), V(5, 0, -3), V(-3, 0, 8), V(7, 0, 9) })[k]
		table.insert(nodes, node(parent, kind, (b * CFrame.new(off)).Position, rng))
	end
end

function World.BuildMaze(parent, seed, O)
	local rng = Random.new(seed)
	local m = Instance.new("Model")
	m.Name = "Maze"
	local openE, openS, valid = generate(rng)
	local refs = { model = m, nodes = {}, chests = {}, cells = {}, reeds = {} }
	local H, T = MZ.WallHeight, MZ.WallThickness

	for i = 0, N - 1 do
		for j = 0, N - 1 do
			if valid(i, j) then
				table.insert(refs.cells, cellPos(O, i, j))
			end
		end
	end

	-- расстояния от ворот
	local dist = {}
	for i = 0, N - 1 do
		dist[i] = {}
	end
	local queue = {}
	for _, s in ipairs({ { MID, CLEAR_LO - 1 }, { MID, CLEAR_HI + 1 }, { CLEAR_LO - 1, MID }, { CLEAR_HI + 1, MID } }) do
		dist[s[1]][s[2]] = 0
		table.insert(queue, s)
	end
	local head = 1
	while head <= #queue do
		local cur = queue[head]
		head += 1
		for _, nb in ipairs(neighbors(cur[1], cur[2], openE, openS, valid)) do
			if dist[nb[1]][nb[2]] == nil then
				dist[nb[1]][nb[2]] = dist[cur[1]][cur[2]] + 1
				table.insert(queue, nb)
			end
		end
	end

	local exitCell, exitD = nil, -1
	for i = 0, N - 1 do
		for j = 0, N - 1 do
			if (i == 0 or j == 0 or i == N - 1 or j == N - 1) and dist[i][j] and dist[i][j] > exitD then
				exitCell, exitD = { i, j }, dist[i][j]
			end
		end
	end

	-- щели: случайные внутренние стены между двумя клетками лабиринта
	local crackS, crackE = {}, {}
	for i = 0, N - 1 do
		crackS[i], crackE[i] = {}, {}
	end
	local placed, tries = 0, 0
	while placed < MZ.Cracks and tries < 2000 do
		tries += 1
		local i, j = rng:NextInteger(1, N - 3), rng:NextInteger(1, N - 3)
		if rng:NextNumber() < 0.5 then
			if valid(i, j) and valid(i, j + 1) and not openS[i][j] and not crackS[i][j] then
				crackS[i][j] = true
				placed += 1
			end
		elseif valid(i, j) and valid(i + 1, j) and not openE[i][j] and not crackE[i][j] then
			crackE[i][j] = true
			placed += 1
		end
	end

	local function ivy(axis, fixed, a, b)
		if rng:NextNumber() < 0.5 then
			local len = math.min(b - a, rng:NextNumber(8, 22))
			local cpos = rng:NextNumber(a + len / 2, b - len / 2)
			local hgt = rng:NextNumber(12, 40)
			local side = rng:NextNumber() < 0.5 and -1 or 1
			if axis == "X" then
				Parts.span(m, "Ivy", O, V(cpos - len / 2, H - hgt, fixed + side * (T / 2) - 0.2), V(cpos + len / 2, H, fixed + side * (T / 2) + 0.2), IVY, M.LeafyGrass, NOCOLLIDE)
			else
				Parts.span(m, "Ivy", O, V(fixed + side * (T / 2) - 0.2, H - hgt, cpos - len / 2), V(fixed + side * (T / 2) + 0.2, H, cpos + len / 2), IVY, M.LeafyGrass, NOCOLLIDE)
			end
		end
	end

	local function wallRun(axis, fixed, from, to)
		local a, b = from - T / 2, to + T / 2
		if axis == "X" then
			Parts.span(m, "MazeWall", O, V(a, 0, fixed - T / 2), V(b, H, fixed + T / 2), WALL, M.Slate)
		else
			Parts.span(m, "MazeWall", O, V(fixed - T / 2, 0, a), V(fixed + T / 2, H, b), WALL, M.Slate)
		end
		ivy(axis, fixed, a, b)
	end

	-- стена со щелью: узкий проём 6 шириной, снизу 4 высотой; выше 4..9 — «крышка»,
	-- сквозь которую проходит только пригнувшийся игрок (группа столкновений CrawlCover)
	local function crackWall(axis, fixed, from, to)
		local mid = (from + to) / 2
		local function seg(a, b, y0, y1, name, group)
			local p
			if axis == "X" then
				p = Parts.span(m, name, O, V(a, y0, fixed - T / 2), V(b, y1, fixed + T / 2), WALL, M.Slate)
			else
				p = Parts.span(m, name, O, V(fixed - T / 2, y0, a), V(fixed + T / 2, y1, b), WALL, M.Slate)
			end
			if group then
				p.CollisionGroup = group
			end
			return p
		end
		seg(from - T / 2, mid - 3, 0, H, "MazeWall")
		seg(mid + 3, to + T / 2, 0, H, "MazeWall")
		seg(mid - 3, mid + 3, 9, H, "MazeWall")
		seg(mid - 3, mid + 3, 4, 9, "CrawlCover", "CrawlCover")
		-- пролом: неровные камни по краю дыры с обеих сторон стены, мох и обломки на полу
		for _, side in ipairs({ -1, 1 }) do
			for k = 0, 6 do
				local a = k / 6 * math.pi
				local along = -math.cos(a) * 3.6
				local up = math.sin(a) * 5.2
				local face = fixed + side * (T / 2 + 0.25)
				local p = axis == "X" and V(mid + along, up, face) or V(face, up, mid + along)
				Parts.box(m, "CrackStone", CFrame.new(O + p) * CFrame.Angles(0, 0, rng:NextNumber(-0.6, 0.6)), axis == "X" and V(rng:NextNumber(0.8, 1.2), rng:NextNumber(0.6, 0.9), 0.5) or V(0.5, rng:NextNumber(0.6, 0.9), rng:NextNumber(0.8, 1.2)), WALL, M.Slate, NOCOLLIDE)
			end
			local mp = axis == "X" and V(mid, 0.1, fixed + side * (T / 2 + 1.5)) or V(fixed + side * (T / 2 + 1.5), 0.1, mid)
			Parts.box(m, "CrackMoss", CFrame.new(O + mp), axis == "X" and V(7, 0.2, 2.5) or V(2.5, 0.2, 7), IVY, M.LeafyGrass, NOCOLLIDE)
			for _ = 1, 3 do
				local off = rng:NextNumber(-6, 6)
				local rp = axis == "X" and V(mid + off, 0.4, fixed + side * rng:NextNumber(3, 6)) or V(fixed + side * rng:NextNumber(3, 6), 0.4, mid + off)
				Parts.box(m, "Rubble", CFrame.new(O + rp) * CFrame.Angles(rng:NextNumber(0, 3), rng:NextNumber(0, 3), 0), V(1.2, 0.8, 1), WALL_DARK, M.Slate, NOCOLLIDE)
			end
		end
	end

	local function isExitWall(axis, line, k)
		if not exitCell then
			return false
		end
		local i, j = exitCell[1], exitCell[2]
		if axis == "X" then
			return k == i and ((line == -1 and j == 0) or (line == N - 1 and j == N - 1))
		else
			return k == j and ((line == -1 and i == 0) or (line == N - 1 and i == N - 1))
		end
	end

	for line = -1, N - 1 do
		local z = (line - MID) * C + C / 2
		local runStart
		for i = 0, N do
			local present, crack = false, false
			if i < N then
				if line == -1 or line == N - 1 then
					present = not isExitWall("X", line, i)
				else
					local cA, cB = inClearing(i, line), inClearing(i, line + 1)
					present = not cA and not cB and not openS[i][line]
					crack = present and crackS[i][line] == true
					present = present and not crack
				end
			end
			if present and not runStart then
				runStart = i
			elseif not present and runStart then
				wallRun("X", z, (runStart - MID) * C - C / 2, (i - 1 - MID) * C + C / 2)
				runStart = nil
			end
			if crack then
				crackWall("X", z, (i - MID) * C - C / 2, (i - MID) * C + C / 2)
			end
		end
	end
	for line = -1, N - 1 do
		local x = (line - MID) * C + C / 2
		local runStart
		for j = 0, N do
			local present, crack = false, false
			if j < N then
				if line == -1 or line == N - 1 then
					present = not isExitWall("Z", line, j)
				else
					local cA, cB = inClearing(line, j), inClearing(line + 1, j)
					present = not cA and not cB and not openE[line][j]
					crack = present and crackE[line][j] == true
					present = present and not crack
				end
			end
			if present and not runStart then
				runStart = j
			elseif not present and runStart then
				wallRun("Z", x, (runStart - MID) * C - C / 2, (j - 1 - MID) * C + C / 2)
				runStart = nil
			end
			if crack then
				crackWall("Z", x, (j - MID) * C - C / 2, (j - MID) * C + C / 2)
			end
		end
	end

	-- тупики
	local deadEnds = {}
	for i = 0, N - 1 do
		for j = 0, N - 1 do
			if valid(i, j) and dist[i][j] and dist[i][j] > 2 and not (exitCell and exitCell[1] == i and exitCell[2] == j) then
				local nb = neighbors(i, j, openE, openS, valid)
				if #nb == 1 then
					table.insert(deadEnds, { i = i, j = j, d = dist[i][j], to = cellPos(O, nb[1][1], nb[1][2]) })
				end
			end
		end
	end
	table.sort(deadEnds, function(a, b)
		return a.d > b.d
	end)
	if deadEnds[1] then
		local de = table.remove(deadEnds, 1)
		local pos = cellPos(O, de.i, de.j)
		table.insert(refs.chests, chest(m, pos, (de.to - pos).Unit, true))
	end
	local far, near = {}, {}
	for k, de in ipairs(deadEnds) do
		table.insert(k <= #deadEnds / 2 and far or near, de)
	end
	local function takeMine(list, kinds)
		if #list == 0 then
			return
		end
		local de = table.remove(list, rng:NextInteger(1, #list))
		local pos = cellPos(O, de.i, de.j)
		mine(m, pos, (de.to - pos).Unit, kinds, rng, refs.nodes)
	end
	for k = 1, MZ.Mines do
		if k % 2 == 1 then
			takeMine(near, { "stone", "stone", "iron", "iron" })
		else
			takeMine(far, { "iron", "crystal", "crystal", "stone" })
		end
	end
	local rest = {}
	for _, de in ipairs(near) do
		table.insert(rest, de)
	end
	for _, de in ipairs(far) do
		table.insert(rest, de)
	end
	for _ = 1, math.min(MZ.Chests, #rest) do
		local de = table.remove(rest, rng:NextInteger(1, #rest))
		local pos = cellPos(O, de.i, de.j)
		local c = chest(m, pos, (de.to - pos).Unit, false)
		c.model:SetAttribute("Depth", de.d)
		table.insert(refs.chests, c)
	end

	-- атмосфера: светящийся мох, кости, обломки, высокая трава в коридорах
	for _ = 1, 90 do
		local p = refs.cells[rng:NextInteger(1, #refs.cells)]
		local glow = Parts.box(m, "GlowMoss", CFrame.new(p + V(rng:NextNumber(-12, 12), 0.2, rng:NextNumber(-12, 12))), V(rng:NextNumber(1, 3), 0.3, rng:NextNumber(1, 3)), RGB(90, 255, 170), M.Neon, NOCOLLIDE)
		if rng:NextNumber() < 0.3 then
			Parts.light(glow, 12, 0.5, RGB(90, 255, 170), false)
		end
	end
	for _ = 1, 40 do
		local p = refs.cells[rng:NextInteger(1, #refs.cells)] + V(rng:NextNumber(-10, 10), 0, rng:NextNumber(-10, 10))
		if rng:NextNumber() < 0.5 then
			Parts.box(m, "Bone", CFrame.new(p + V(0, 0.2, 0)) * CFrame.Angles(0, rng:NextNumber(0, 6), 0), V(0.35, 0.35, 2.4), RGB(220, 215, 195), M.SmoothPlastic, NOCOLLIDE)
		else
			Parts.box(m, "Debris", CFrame.new(p + V(0, 0.8, 0)) * CFrame.Angles(rng:NextNumber(0, 3), rng:NextNumber(0, 3), 0), V(rng:NextNumber(1.5, 3), rng:NextNumber(1, 2), rng:NextNumber(1.5, 3)), WALL_DARK, M.Slate)
		end
	end
	for _ = 1, 24 do
		local p = refs.cells[rng:NextInteger(1, #refs.cells)] + V(rng:NextNumber(-9, 9), 0, rng:NextNumber(-9, 9))
		local base = Parts.box(m, "TallGrass", CFrame.new(p + V(0, 1.4, 0)), V(2.6, 2.8, 2.6), RGB(100, 130, 65), M.Grass, NOCOLLIDE)
		base.Transparency = 0.2
		tag(prompt(base, "Сорвать траву", "Высокая трава", 0.4, 9), "FiberPrompt")
	end

	-- лагеря прошлых выживших, ящики и записки
	for k = 1, 8 do
		local p = refs.cells[rng:NextInteger(1, #refs.cells)]
		if (p - O).Magnitude > CLEAR_HALF + 60 then
			camp(m, p, rng, k)
		end
	end
	for _ = 1, 26 do
		local p = refs.cells[rng:NextInteger(1, #refs.cells)] + V(rng:NextNumber(-9, 9), 0, rng:NextNumber(-9, 9))
		lootCrate(m, p, rng)
	end
	for k = 9, 16 do
		local p = refs.cells[rng:NextInteger(1, #refs.cells)] + V(rng:NextNumber(-8, 8), 0.1, rng:NextNumber(-8, 8))
		note(m, CFrame.new(p) * CFrame.Angles(0, rng:NextNumber(0, 6), 0), rng, k)
	end
	-- заросли лиан: можно залезть внутрь и спрятаться от Скрежетников
	for _ = 1, 26 do
		local c = refs.cells[rng:NextInteger(1, #refs.cells)]
		if (c - O).Magnitude > CLEAR_HALF + 40 then
			local dir = ({ V(1, 0, 0), V(-1, 0, 0), V(0, 0, 1), V(0, 0, -1) })[rng:NextInteger(1, 4)]
			vineHide(m, c + dir * 9.5, rng)
		end
	end

	-- выход и вертолётная площадка за ним
	if exitCell then
		local i, j = exitCell[1], exitCell[2]
		local inner = cellPos(O, i, j)
		local out
		if i == 0 then
			out = V(-1, 0, 0)
		elseif i == N - 1 then
			out = V(1, 0, 0)
		elseif j == 0 then
			out = V(0, 0, -1)
		else
			out = V(0, 0, 1)
		end
		local mouth = inner + out * (C / 2)
		local b = CFrame.lookAt(mouth, mouth + out)
		for _, x in ipairs({ -C / 2, C / 2 }) do
			Parts.box(m, "ExitWall", b * CFrame.new(x, H / 2, -25), V(T, H, 50), WALL_DARK, M.Slate)
		end
		Parts.box(m, "ExitFloor", b * CFrame.new(0, 0.2, -25), V(C, 0.4, 50), RGB(60, 60, 64), M.Concrete)
		local door = Parts.box(m, "ExitDoor", b * CFrame.new(0, H / 2 - 4, -50), V(C, H - 8, 2), RGB(90, 95, 100), M.DiamondPlate)
		for _, x in ipairs({ -10, 10 }) do
			local lamp = Parts.box(m, "ExitLamp", b * CFrame.new(x, H - 10, -48), V(1.8, 1.8, 1.8), RGB(120, 255, 160), M.Neon)
			Parts.light(lamp, 40, 1.8, RGB(140, 255, 170), true)
		end
		local sign = Parts.box(m, "ExitSign", b * CFrame.new(0, H - 4, -48.8), V(18, 4, 0.3), RGB(20, 40, 25), M.SmoothPlastic)
		local sg = Instance.new("SurfaceGui")
		sg.Face = Enum.NormalId.Back
		sg.PixelsPerStud = 25
		sg.Parent = sign
		local tl = Instance.new("TextLabel")
		tl.Size = UDim2.fromScale(1, 1)
		tl.BackgroundTransparency = 1
		tl.Text = "ВЫХОД"
		tl.Font = Enum.Font.GothamBlack
		tl.TextScaled = true
		tl.TextColor3 = RGB(140, 255, 170)
		tl.Parent = sg
		-- считыватель ключ-карты на стене у ворот (на уровне груди)
		local reader = Parts.box(m, "CardReader", b * CFrame.new(C / 2 - T / 2 - 0.4, 4.8, -46) * CFrame.Angles(0, -math.pi / 2, 0), V(1.6, 2.4, 0.5), RGB(30, 32, 36), M.Metal)
		local readerLight = Parts.box(m, "ReaderLight", reader.CFrame * CFrame.new(0, 0.8, -0.3), V(0.5, 0.3, 0.1), RGB(255, 40, 40), M.Neon, NOCOLLIDE)
		Parts.box(m, "ReaderSlot", reader.CFrame * CFrame.new(0, -0.2, -0.3), V(1, 0.12, 0.1), RGB(10, 10, 10), M.SmoothPlastic, NOCOLLIDE)
		refs.readerLight = readerLight

		-- снаружи: лесная поляна, где ждёт вертолёт
		local pad = b * CFrame.new(0, 0, -95)
		local frng = Random.new(seed + 99)
		for _ = 1, 70 do
			local a = frng:NextNumber(0, math.pi * 2)
			local r = frng:NextNumber(34, 120)
			local local2 = V(math.cos(a) * r, 0, math.sin(a) * r)
			-- не ставим деревья на дорогу от ворот к поляне
			local rel = pad * CFrame.new(local2)
			local toMouth = (b:PointToObjectSpace(rel.Position))
			if not (math.abs(toMouth.X) < 14 and toMouth.Z > -100 and toMouth.Z < 0) then
				local h = frng:NextNumber(26, 40)
				local tp = rel.Position
				Parts.box(m, "ForestTrunk", CFrame.new(tp + V(0, h / 2, 0)), V(2.4, h, 2.4), RGB(80, 58, 40), M.Wood)
				for k = 1, 4 do
					local sz = frng:NextNumber(10, 15) * (1 - k * 0.12)
					Parts.box(m, "ForestLeaves", CFrame.new(tp + V(frng:NextNumber(-2, 2), h * 0.6 + k * 3, frng:NextNumber(-2, 2))), V(sz, sz * 0.8, sz), RGB(40, frng:NextInteger(85, 110), 45), M.LeafyGrass, {
						Shape = Enum.PartType.Ball,
						CanCollide = false,
					})
				end
			end
		end
		refs.exitDoor = door
		refs.exitPrompt = prompt(reader, "Вставить ключ-карту", "Считыватель", 1.2, 9)
		refs.exitOut = b
		refs.helipad = pad
	end

	m.Parent = parent
	return refs
end

return World
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="16">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="17">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="18">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">BuildMode</string>
            <string name="Source"><![CDATA[-- Режим строительства (в руке чертёж): прозрачный предпросмотр детали по сетке,
-- R — сменить деталь, ЛКМ — поставить. С молотком — подсказка, во что улучшится.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Building = require(Shared:WaitForChild("Building"))
local Items = require(Shared:WaitForChild("Items"))

local player = Players.LocalPlayer
local V = Vector3.new
local RGB = Color3.fromRGB

local BuildMode = {}

local index = 1
local ghost
local current -- {id, a}
local hint

local function costText(cost)
	local parts = {}
	for k, n in pairs(cost) do
		local have = player:GetAttribute("Res_" .. k) or 0
		table.insert(parts, (Items.Resources[k] and Items.Resources[k].Name or k) .. " " .. have .. "/" .. n)
	end
	return table.concat(parts, ", ")
end

local function makeGhost(id)
	if ghost then
		ghost:Destroy()
	end
	local def = Building.ById[id]
	local p = Instance.new(id == "stairs" and "WedgePart" or "Part")
	p.Name = "BuildGhost"
	p.Size = def.Size
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.ForceField
	p.Transparency = 0.2
	p.Parent = workspace.CurrentCamera
	ghost = p
end

function BuildMode.init(gui, make)
	hint = make("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -96),
		Size = UDim2.new(0, 560, 0, 46),
		BackgroundColor3 = RGB(15, 18, 24),
		BackgroundTransparency = 0.35,
		Font = Enum.Font.GothamBold,
		TextSize = 15,
		TextColor3 = RGB(230, 236, 245),
		TextWrapped = true,
		Visible = false,
		Text = "",
	}, gui)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 8)
	c.Parent = hint
end

function BuildMode.cycle()
	index = index % #Building.Pieces + 1
	makeGhost(Building.Pieces[index].Id)
end

local function pieces()
	return CollectionService:GetTagged("BuildPiece")
end

-- вызывать каждый кадр. mode: "blueprint", "hammer" или nil
function BuildMode.update(mode, rayParams)
	current = nil
	if mode ~= "blueprint" then
		if ghost then
			ghost:Destroy()
			ghost = nil
		end
	end
	if not hint then
		return
	end
	hint.Visible = mode ~= nil
	local cam = workspace.CurrentCamera
	local O = player:GetAttribute("SessionO")
	if not mode or not O then
		hint.Visible = false
		return
	end
	local r = workspace:Raycast(cam.CFrame.Position, cam.CFrame.LookVector * 22, rayParams)
	if mode == "hammer" then
		local piece = r and Building.pieceOf(r.Instance)
		if piece then
			local tier = piece:GetAttribute("Tier") or 0
			local nextT = Building.Tiers[tier + 1]
			hint.Text = piece.Name .. " · " .. Building.Tiers[tier].Name .. (nextT and ("   →   ЛКМ: " .. nextT.Name .. " (" .. costText(nextT.Cost) .. ")") or "   (максимум)")
		else
			hint.Text = "Молоток: наведи на постройку и бей ЛКМ — улучшить (чертёж → дерево → камень → металл)"
		end
		return
	end
	local def = Building.Pieces[index]
	if not ghost or ghost.Size ~= def.Size or (def.Id == "stairs") ~= ghost:IsA("WedgePart") then
		makeGhost(def.Id)
	end
	local a = r and Building.snap(def.Id, O, r.Position, r.Instance, cam.CFrame.LookVector, pieces())
	hint.Text = "R — сменить: " .. def.Name .. "  ·  " .. costText(def.Cost) .. "\nЛКМ — поставить" .. (def.Id == "foundation" and "" or "  ·  ставится на фундамент / стену")
	if not a then
		ghost.Transparency = 1
		return
	end
	local cf = Building.cframe(def.Id, O, a)
	ghost.CFrame = cf
	local free = true
	for _, p in ipairs(pieces()) do
		if p:GetAttribute("Key") == Building.key(def.Id, a) then
			free = false
		end
	end
	local enough = true
	for k, n in pairs(def.Cost) do
		if (player:GetAttribute("Res_" .. k) or 0) < n then
			enough = false
		end
	end
	ghost.Transparency = 0.25
	ghost.Color = (free and enough) and RGB(90, 200, 255) or RGB(255, 80, 70)
	if free then
		current = { id = def.Id, a = a }
	end
end

-- ЛКМ с чертежом
function BuildMode.place(remote)
	if current then
		remote:FireServer(current.id, current.a)
		return true
	end
	return false
end

local _ = V
return BuildMode
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="20">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Клиент «ЛАБИРИНТ»: интерфейс, прицел, руки, удары, тряска камеры, верстак, лифт, победа.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")
local SoundService = game:GetService("SoundService")
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local StarterGui = game:GetService("StarterGui")

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Items = require(Shared:WaitForChild("Items"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Viewmodel = require(script.Parent:WaitForChild("Viewmodel"))
local MonsterView = require(script.Parent:WaitForChild("MonsterView"))
local BuildMode = require(script.Parent:WaitForChild("BuildMode"))
MonsterView.start()

local function remote(n)
	return Remotes:WaitForChild(n)
end

local V = Vector3.new
local RGB = Color3.fromRGB
local UI_FONT = Enum.Font.GothamBold
local TEXT_FONT = Enum.Font.Gotham

------------------------------------------------------------------
-- Помощники
------------------------------------------------------------------
local function make(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do
		o[k] = v
	end
	o.Parent = parent
	return o
end
local function corner(o, r)
	make("UICorner", { CornerRadius = UDim.new(0, r or 8) }, o)
end
local function sound(id, vol, speed)
	if not id or id == "" then
		return
	end
	local s = make("Sound", { SoundId = id, Volume = vol or 1, PlaybackSpeed = speed or 1 }, SoundService)
	s:Play()
	task.delay(4, function()
		s:Destroy()
	end)
end

local gui = make("ScreenGui", { Name = "LabyrinthUI", ResetOnSpawn = false, IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, player:WaitForChild("PlayerGui"))

local function inMatch()
	return player:GetAttribute("InMatch") == true
end
local cutscene = false

------------------------------------------------------------------
-- Тряска камеры
------------------------------------------------------------------
local trauma = 0
local function shake(amount)
	trauma = math.min(1, trauma + amount)
end
local appliedShake = CFrame.new()
-- перед обновлением камеры убираем тряску прошлого кадра, иначе мышь «уплывает» и дёргается
RunService:BindToRenderStep("LabyrinthUnshake", Enum.RenderPriority.Camera.Value - 1, function()
	local cam = workspace.CurrentCamera
	if appliedShake ~= CFrame.new() and cam.CameraType ~= Enum.CameraType.Scriptable then
		cam.CFrame = cam.CFrame * appliedShake:Inverse()
	end
	appliedShake = CFrame.new()
end)
RunService:BindToRenderStep("LabyrinthShake", Enum.RenderPriority.Camera.Value + 1, function(dt)
	if trauma > 0 then
		local t = os.clock() * 30
		local s = trauma * trauma
		local cam = workspace.CurrentCamera
		local sh = CFrame.Angles(math.noise(t, 1) * 0.05 * s, math.noise(t, 2) * 0.05 * s, math.noise(t, 3) * 0.03 * s)
		cam.CFrame = cam.CFrame * sh
		if cam.CameraType ~= Enum.CameraType.Scriptable then
			appliedShake = sh
		end
		trauma = math.max(0, trauma - dt * 2)
	end
end)

------------------------------------------------------------------
-- Прицел: кольцо с четырьмя «усиками», разъезжаются при ударе,
-- красный на монстре, золотой на ресурсе
------------------------------------------------------------------
local cross = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 60, 0, 60), BackgroundTransparency = 1 }, gui)
local ring = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 14, 0, 14), BackgroundTransparency = 1 }, cross)
make("UICorner", { CornerRadius = UDim.new(1, 0) }, ring)
local ringStroke = make("UIStroke", { Thickness = 1.6, Color = RGB(240, 240, 240), Transparency = 0.15 }, ring)
local ticks = {}
for k, d in ipairs({ { 0, -1 }, { 0, 1 }, { -1, 0 }, { 1, 0 } }) do
	local vert = d[1] == 0
	local t = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = vert and UDim2.new(0, 2, 0, 7) or UDim2.new(0, 7, 0, 2),
		BackgroundColor3 = RGB(240, 240, 240),
		BorderSizePixel = 0,
	}, cross)
	ticks[k] = { frame = t, dir = d }
end
local hitX = {}
for _, rot in ipairs({ 45, -45 }) do
	table.insert(hitX, make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0, 22, 0, 2),
		Rotation = rot,
		BackgroundColor3 = RGB(255, 255, 255),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	}, cross))
end
local targetLabel = make("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0.5, 26),
	Size = UDim2.new(0, 360, 0, 22),
	BackgroundTransparency = 1,
	Font = UI_FONT,
	TextSize = 14,
	TextColor3 = RGB(240, 235, 220),
	TextStrokeTransparency = 0.4,
	Text = "",
}, gui)
local targetHP = make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.5, 48), Size = UDim2.new(0, 120, 0, 5), BackgroundColor3 = RGB(40, 10, 10), BorderSizePixel = 0, Visible = false }, gui)
local targetHPFill = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = RGB(220, 50, 40), BorderSizePixel = 0 }, targetHP)
local spread = 0

local lastSwingAnim = 0
local function hitMarker(kind)
	local c = kind == "kill" and RGB(255, 60, 60) or (kind == "monster" and RGB(255, 200, 200) or RGB(255, 220, 120))
	for _, f in ipairs(hitX) do
		f.BackgroundColor3 = c
		f.BackgroundTransparency = 0
		TweenService:Create(f, TweenInfo.new(0.35), { BackgroundTransparency = 1 }):Play()
	end
	sound(Config.Sounds.Hit, 0.5, kind == "node" and 1.6 or 0.9)
	shake(kind == "kill" and 0.5 or 0.18)
end

------------------------------------------------------------------
-- Интерфейс: фаза дня, здоровье, выносливость, ресурсы, хотбар
------------------------------------------------------------------
local phaseLabel = make("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 14),
	Size = UDim2.new(0, 520, 0, 34),
	BackgroundColor3 = RGB(12, 14, 12),
	BackgroundTransparency = 0.35,
	Font = UI_FONT,
	TextSize = 18,
	TextColor3 = RGB(240, 230, 200),
	Text = "",
}, gui)
corner(phaseLabel, 10)

local hpBack = make("Frame", { Position = UDim2.new(0, 20, 1, -46), Size = UDim2.new(0, 260, 0, 14), BackgroundColor3 = RGB(30, 12, 12), BorderSizePixel = 0 }, gui)
corner(hpBack, 6)
local hpFill = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = RGB(200, 50, 45), BorderSizePixel = 0 }, hpBack)
corner(hpFill, 6)
local hpText = make("TextLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Font = UI_FONT, TextSize = 11, TextColor3 = RGB(255, 255, 255), Text = "" }, hpBack)
local stBack = make("Frame", { Position = UDim2.new(0, 20, 1, -26), Size = UDim2.new(0, 260, 0, 6), BackgroundColor3 = RGB(30, 30, 20), BorderSizePixel = 0 }, gui)
corner(stBack, 3)
local stFill = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = RGB(220, 200, 120), BorderSizePixel = 0 }, stBack)
corner(stFill, 3)

local resPanel = make("Frame", { Position = UDim2.new(0, 20, 0, 70), Size = UDim2.new(0, 230, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = RGB(12, 14, 12), BackgroundTransparency = 0.4 }, gui)
corner(resPanel, 10)
make("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8), PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }, resPanel)
make("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, resPanel)

local function refreshRes()
	for _, c in ipairs(resPanel:GetChildren()) do
		if c:IsA("TextLabel") then
			c:Destroy()
		end
	end
	for k, def in pairs(Items.Resources) do
		local n = player:GetAttribute("Res_" .. k) or 0
		if n > 0 then
			make("TextLabel", {
				Size = UDim2.new(1, 0, 0, 20),
				BackgroundTransparency = 1,
				Font = TEXT_FONT,
				TextSize = 15,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextColor3 = k == "key" and RGB(255, 210, 90) or RGB(235, 230, 215),
				Text = def.Name .. ":  " .. n,
				LayoutOrder = def.Order,
			}, resPanel)
		end
	end
	resPanel.Visible = #resPanel:GetChildren() > 2
end

local hotbar = make("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -18), Size = UDim2.new(0, 0, 0, 64), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1 }, gui)
make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, hotbar)
local tools = {}
local equipped = nil
BuildMode.init(gui, make)

local function equip(id)
	if id == equipped then
		id = nil
	end
	equipped = id
	remote("Equip"):FireServer(id)
	Viewmodel.setItem(id or "fists")
	sound(Config.Sounds.Click, 0.4, 1.4)
end

local function refreshHotbar()
	for _, c in ipairs(hotbar:GetChildren()) do
		if c:IsA("TextButton") then
			c:Destroy()
		end
	end
	for i, id in ipairs(tools) do
		local b = make("TextButton", {
			Size = UDim2.new(0, 96, 0, 64),
			BackgroundColor3 = id == equipped and RGB(70, 90, 50) or RGB(18, 20, 18),
			BackgroundTransparency = 0.25,
			Font = UI_FONT,
			TextSize = 12,
			TextWrapped = true,
			TextColor3 = RGB(235, 230, 215),
			Text = i .. "\n" .. Items.toolName(id),
			LayoutOrder = i,
		}, hotbar)
		corner(b, 8)
		if id == equipped then
			make("UIStroke", { Color = RGB(200, 230, 140), Thickness = 2 }, b)
		end
		b.MouseButton1Click:Connect(function()
			equip(id)
			refreshHotbar()
		end)
	end
end

player.AttributeChanged:Connect(function(name)
	if name:sub(1, 4) == "Res_" then
		refreshRes()
	elseif name == "Tools" then
		local ok, list = pcall(function()
			return HttpService:JSONDecode(player:GetAttribute("Tools") or "[]")
		end)
		tools = ok and list or {}
		refreshHotbar()
	elseif name == "Equipped" then
		local e = player:GetAttribute("Equipped")
		if e ~= equipped then
			equipped = e
			Viewmodel.setItem(e or "fists")
		end
		refreshHotbar()
	elseif name == "InMatch" then
		if not inMatch() then
			equipped = nil
			Viewmodel.setItem("fists", true)
		end
	end
end)
refreshRes()

-- уведомления
local notifyLabel = make("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.72),
	Size = UDim2.new(0.8, 0, 0, 50),
	BackgroundTransparency = 1,
	Font = UI_FONT,
	TextSize = 20,
	TextWrapped = true,
	TextColor3 = RGB(245, 240, 225),
	TextStrokeTransparency = 0.3,
	TextTransparency = 1,
	Text = "",
}, gui)
local notifyToken = 0
local function notify(text)
	notifyToken += 1
	local tk = notifyToken
	notifyLabel.Text = text
	notifyLabel.TextTransparency = 0
	notifyLabel.TextStrokeTransparency = 0.3
	task.delay(4, function()
		if tk == notifyToken then
			TweenService:Create(notifyLabel, TweenInfo.new(0.8), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		end
	end)
end
remote("Notify").OnClientEvent:Connect(notify)

-- лобби
local lobbyLabel = make("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.3),
	Size = UDim2.new(0.8, 0, 0, 80),
	BackgroundTransparency = 1,
	Font = Enum.Font.GothamBlack,
	TextSize = 32,
	TextColor3 = RGB(240, 230, 200),
	TextStrokeTransparency = 0.4,
	Text = "",
}, gui)
local titleLabel = make("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 60),
	Size = UDim2.new(0.8, 0, 0, 70),
	BackgroundTransparency = 1,
	Font = Enum.Font.GothamBlack,
	TextScaled = true,
	TextColor3 = RGB(200, 230, 150),
	TextStrokeTransparency = 0.5,
	Text = Config.GameTitle,
}, gui)

-- красная вспышка при ударе по тебе
local hurtFlash = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = RGB(160, 0, 0), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 5 }, gui)
remote("Hurt").OnClientEvent:Connect(function()
	hurtFlash.BackgroundTransparency = 0.45
	TweenService:Create(hurtFlash, TweenInfo.new(0.6), { BackgroundTransparency = 1 }):Play()
	shake(0.7)
	sound(Config.Sounds.Hurt, 0.7, 1.1)
end)
remote("HitMarker").OnClientEvent:Connect(function(kind, toolKind)
	-- добыча на E: руки сами делают удар нужным инструментом
	if toolKind and os.clock() - lastSwingAnim > 0.3 then
		lastSwingAnim = os.clock()
		Viewmodel.swing(toolKind)
		sound(Config.Sounds.Swing, 0.5, 1)
	end
	hitMarker(kind)
end)

------------------------------------------------------------------
-- Верстак
------------------------------------------------------------------
local craft = make("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.new(0, 520, 0, 470),
	BackgroundColor3 = RGB(28, 24, 20),
	Visible = false,
	ZIndex = 10,
}, gui)
corner(craft, 12)
local craftTitle = make("TextLabel", { Position = UDim2.new(0, 16, 0, 10), Size = UDim2.new(1, -32, 0, 34), BackgroundTransparency = 1, Font = Enum.Font.GothamBlack, TextSize = 22, TextColor3 = RGB(240, 220, 170), TextXAlignment = Enum.TextXAlignment.Left, Text = "ВЕРСТАК", ZIndex = 10 }, craft)
local list = make("ScrollingFrame", { Position = UDim2.new(0, 12, 0, 50), Size = UDim2.new(1, -24, 1, -110), BackgroundTransparency = 1, ScrollBarThickness = 6, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 10 }, craft)
make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, list)
local craftClose = make("TextButton", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -12), Size = UDim2.new(0, 160, 0, 40), BackgroundColor3 = RGB(90, 40, 30), Font = UI_FONT, TextSize = 18, TextColor3 = RGB(255, 240, 230), Text = "Закрыть", Modal = true, ZIndex = 10 }, craft)
corner(craftClose, 8)
craftClose.MouseButton1Click:Connect(function()
	craft.Visible = false
end)

local function costText(cost)
	local parts = {}
	for k, n in pairs(cost) do
		local have = player:GetAttribute("Res_" .. k) or 0
		table.insert(parts, (have >= n and "" or "✗ ") .. Items.Resources[k].Name .. " " .. have .. "/" .. n)
	end
	return table.concat(parts, "   ")
end

local benchLevel = nil -- nil — крафт из инвентаря (C), число — открыт верстак этого уровня
local function renderCraft()
	craftTitle.Text = benchLevel and ("ВЕРСТАК · уровень " .. benchLevel) or "КРАФТ (C) · подойди к верстаку для оружия"
	for _, c in ipairs(list:GetChildren()) do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	for i, r in ipairs(Items.Recipes) do
		local lockText
		if r.Station == "bench" then
			if not benchLevel then
				lockText = "нужен верстак"
			elseif r.Level > benchLevel then
				lockText = "нужен ур. " .. r.Level
			end
		end
		local locked = lockText ~= nil
		local row = make("Frame", { Size = UDim2.new(1, -8, 0, 58), BackgroundColor3 = locked and RGB(30, 28, 26) or RGB(45, 40, 32), LayoutOrder = i, ZIndex = 10 }, list)
		corner(row, 8)
		make("TextLabel", {
			Position = UDim2.new(0, 10, 0, 4),
			Size = UDim2.new(1, -140, 0, 24),
			BackgroundTransparency = 1,
			Font = UI_FONT,
			TextSize = 16,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = locked and RGB(130, 120, 110) or RGB(245, 235, 210),
			Text = (r.Name or Items.toolName(r.Id)) .. (locked and ("  · " .. lockText) or ""),
			ZIndex = 10,
		}, row)
		make("TextLabel", {
			Position = UDim2.new(0, 10, 0, 28),
			Size = UDim2.new(1, -140, 0, 24),
			BackgroundTransparency = 1,
			Font = TEXT_FONT,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = RGB(190, 180, 160),
			Text = costText(r.Cost),
			ZIndex = 10,
		}, row)
		local b = make("TextButton", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.new(0, 110, 0, 38),
			BackgroundColor3 = locked and RGB(50, 50, 50) or RGB(60, 110, 50),
			Font = UI_FONT,
			TextSize = 15,
			TextColor3 = RGB(245, 245, 240),
			Text = locked and "Закрыто" or "Создать",
			AutoButtonColor = not locked,
			ZIndex = 10,
		}, row)
		corner(b, 6)
		b.MouseButton1Click:Connect(function()
			if not locked then
				remote("Craft"):FireServer(r.Id)
				sound(Config.Sounds.Click, 0.6, 1)
				if r.Id == "workbench" then
					craft.Visible = false
				else
					task.delay(0.3, renderCraft)
				end
			end
		end)
	end
end
remote("OpenCraft").OnClientEvent:Connect(function(level)
	benchLevel = level
	renderCraft()
	craft.Visible = true
end)
local function openHandCraft()
	if craft.Visible then
		craft.Visible = false
		return
	end
	benchLevel = nil
	renderCraft()
	craft.Visible = true
end

------------------------------------------------------------------
-- Ввод: удар, предметы 1–9, еда, бег
------------------------------------------------------------------
local lastSwing = 0
local function rayParams()
	local p = RaycastParams.new()
	p.FilterType = Enum.RaycastFilterType.Exclude
	p.FilterDescendantsInstances = { player.Character, workspace.CurrentCamera }
	return p
end

local function aimRay(range)
	local cam = workspace.CurrentCamera
	return workspace:Raycast(cam.CFrame.Position, cam.CFrame.LookVector * (range + 4), rayParams())
end

local function doSwing()
	if not inMatch() or cutscene or craft.Visible then
		return
	end
	local def = Items.Tools[equipped or "fists"] or Items.Tools.fists
	if def.Kind == "blueprint" then
		if BuildMode.place(remote("Build")) then
			sound(Config.Sounds.Click, 0.6, 0.8)
		end
		return
	end
	if def.Kind == "torch" or player:GetAttribute("Downed") or player:GetAttribute("Hidden") or player:GetAttribute("Sleeping") then
		return -- факелом не бьют: он только светит
	end
	if os.clock() - lastSwing < 0.42 then
		return
	end
	lastSwing = os.clock()
	Viewmodel.swing()
	spread = 1
	sound(Config.Sounds.Swing, 0.6, 0.9 + math.random() * 0.3)
	shake(0.08)
	task.delay(0.16, function()
		local r = aimRay(def.Range)
		if r then
			remote("Swing"):FireServer(r.Instance, r.Position)
		end
	end)
end

local sprintHeld = false
local flyingNow = false
local crouched = false
local function setCrouch(on)
	crouched = on
	remote("Crouch"):FireServer(on)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		TweenService:Create(hum, TweenInfo.new(0.25), { CameraOffset = on and Vector3.new(0, -2.4, 0) or Vector3.zero }):Play()
	end
end
UserInputService.InputBegan:Connect(function(input, processed)
	if input.KeyCode == Enum.KeyCode.LeftShift then
		sprintHeld = true
	end
	if processed then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.KeyCode == Enum.KeyCode.ButtonR2 then
		doSwing()
	elseif input.KeyCode == Enum.KeyCode.R and equipped == "blueprint" then
		BuildMode.cycle()
		sound(Config.Sounds.Click, 0.4, 1.2)
	elseif input.KeyCode == Enum.KeyCode.H then
		remote("Eat"):FireServer()
	elseif input.KeyCode == Enum.KeyCode.C and inMatch() and not cutscene then
		openHandCraft()
	elseif input.KeyCode == Enum.KeyCode.LeftControl and inMatch() and not cutscene and not flyingNow then
		setCrouch(not crouched)
	elseif input.KeyCode == Enum.KeyCode.Q then
		equip(nil)
		refreshHotbar()
	else
		local n = input.KeyCode.Value - Enum.KeyCode.One.Value + 1
		if n >= 1 and n <= 9 and tools[n] then
			equip(tools[n])
			refreshHotbar()
		end
	end
end)
UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.LeftShift then
		sprintHeld = false
	end
end)

------------------------------------------------------------------
-- Лифт: поездка с друзьями
------------------------------------------------------------------
local fade = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = RGB(0, 0, 0), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 20 }, gui)
local subtitle = make("TextLabel", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -90), Size = UDim2.new(0.8, 0, 0, 40), BackgroundTransparency = 1, Font = UI_FONT, TextSize = 24, TextColor3 = RGB(240, 235, 220), TextStrokeTransparency = 0.3, Text = "", ZIndex = 21 }, gui)

local function cloneAvatar(who)
	local char = who.Character
	if not char then
		return nil
	end
	local ok, c = pcall(function()
		char.Archivable = true
		return char:Clone()
	end)
	if not ok or not c then
		return nil
	end
	for _, d in ipairs(c:GetDescendants()) do
		if d:IsA("Script") or d:IsA("LocalScript") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.LocalTransparencyModifier = 0
		end
	end
	local hum = c:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
	return c
end

remote("PlayElevator").OnClientEvent:Connect(function(riders, duration, diffId)
	cutscene = true
	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Scriptable
	local O = V(6000, 200, 0)
	local m = Instance.new("Model")
	m.Name = "ElevatorRide"
	local function p(size, cf, color, mat, props)
		local pt = make("Part", { Anchored = true, CanCollide = false, CanQuery = false, Size = size, CFrame = cf, Color = color, Material = mat or Enum.Material.DiamondPlate }, m)
		if props then
			for k, v in pairs(props) do
				pt[k] = v
			end
		end
		return pt
	end
	local metal = RGB(64, 66, 70)
	p(V(16, 0.5, 16), CFrame.new(O), metal)
	p(V(16, 0.5, 16), CFrame.new(O + V(0, 14, 0)), metal)
	p(V(0.5, 14, 16), CFrame.new(O + V(-8, 7, 0)), metal)
	p(V(0.5, 14, 16), CFrame.new(O + V(8, 7, 0)), metal)
	p(V(16, 14, 0.5), CFrame.new(O + V(0, 7, 8)), metal)
	local lamp = p(V(10, 0.3, 2), CFrame.new(O + V(0, 13.6, 0)), RGB(255, 220, 170), Enum.Material.Neon)
	make("PointLight", { Range = 18, Brightness = 1.2, Color = RGB(255, 220, 170) }, lamp)
	-- решётка спереди и стена шахты за ней (бегущие вниз лампы — лифт едет вверх)
	for x = -7, 7, 1.4 do
		p(V(0.2, 13.5, 0.2), CFrame.new(O + V(x, 7, -8)), RGB(40, 40, 44), Enum.Material.Metal)
	end
	p(V(20, 80, 1), CFrame.new(O + V(0, 7, -12)), RGB(48, 46, 44), Enum.Material.Concrete)
	local strips = {}
	for k = 0, 5 do
		local s = p(V(14, 0.4, 0.4), CFrame.new(O + V(0, k * 12 - 20, -11.4)), RGB(255, 200, 140), Enum.Material.Neon)
		make("PointLight", { Range = 10, Brightness = 1, Color = RGB(255, 190, 120) }, s)
		table.insert(strips, s)
	end
	m.Parent = workspace
	-- друзья в лифте
	local spots = { V(-3.5, 0, 2), V(3.5, 0, 2), V(-4, 0, -3.5), V(4, 0, -3.5), V(0, 0, 5), V(-5.5, 0, 5), V(5.5, 0, 5) }
	local k = 0
	for _, who in ipairs(riders) do
		if who ~= player then
			k += 1
			local av = cloneAvatar(who)
			if av and spots[k] then
				local pos = O + spots[k] + V(0, 3, 0)
				av:PivotTo(CFrame.lookAt(pos, pos + V(0, 0, -1)))
				av.Parent = m
			end
		end
	end
	fade.BackgroundTransparency = 0
	TweenService:Create(fade, TweenInfo.new(1), { BackgroundTransparency = 1 }):Play()
	local diff = Config.Difficulty[diffId or "normal"]
	subtitle.Text = (diff and ("[" .. diff.Name .. "]  ") or "") .. (#riders > 1 and ("Вас " .. #riders .. ". Лифт поднимается... Куда?") or "Лифт поднимается... Куда?")
	local rumble = make("Sound", { SoundId = Config.Sounds.Rumble, Looped = true, Volume = 0.8, PlaybackSpeed = 0.3 }, SoundService)
	rumble:Play()
	local t0 = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function(dt)
		local t = os.clock() - t0
		for _, s in ipairs(strips) do
			local y = s.Position.Y - dt * 22
			if y < O.Y - 30 then
				y += 72
			end
			s.CFrame = CFrame.new(s.Position.X, y, s.Position.Z)
		end
		local jitter = CFrame.Angles(math.noise(t * 8, 1) * 0.01, math.noise(t * 8, 2) * 0.01, 0)
		cam.CFrame = CFrame.lookAt(O + V(0, 5.2, 4), O + V(0, 5.6, -8)) * jitter
		if t > duration - 2 and fade.BackgroundTransparency > 0.99 then
			fade.BackgroundColor3 = RGB(255, 250, 235)
			TweenService:Create(fade, TweenInfo.new(1.5), { BackgroundTransparency = 0 }):Play()
			subtitle.Text = "Свет... Мы наверху."
		end
	end)
	task.wait(duration)
	conn:Disconnect()
	rumble:Destroy()
	m:Destroy()
	subtitle.Text = ""
	-- экран остаётся белым, пока сервер строит лабиринт; дальше — ролик прибытия
	task.delay(25, function()
		if cutscene and not inMatch() then
			cutscene = false
			cam.CameraType = Enum.CameraType.Custom
			TweenService:Create(fade, TweenInfo.new(1), { BackgroundTransparency = 1 }):Play()
		end
	end)
end)

------------------------------------------------------------------
-- Прибытие: решётка лифта поднимается, выходишь и осматриваешься
------------------------------------------------------------------
local function smoothstep(a)
	return a * a * (3 - 2 * a)
end
local function runFor(duration, fn)
	local t0 = os.clock()
	while true do
		local a = math.clamp((os.clock() - t0) / duration, 0, 1)
		fn(a)
		if a >= 1 then
			break
		end
		RunService.RenderStepped:Wait()
	end
end

remote("Arrive").OnClientEvent:Connect(function(liftPos, riders)
	cutscene = true
	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Scriptable
	local eye0 = liftPos + V(0, 5.6, 4)
	local eye1 = liftPos + V(0, 5.8, -16)
	cam.CFrame = CFrame.lookAt(eye0, eye0 + V(0, 0, -10))
	TweenService:Create(fade, TweenInfo.new(1.6), { BackgroundTransparency = 1 }):Play()
	task.delay(1.6, function()
		fade.BackgroundColor3 = RGB(0, 0, 0)
	end)
	subtitle.Text = #riders > 1 and ("Вас " .. #riders .. ". Решётка поднимается...") or "Решётка поднимается..."
	shake(0.5)
	runFor(1.6, function()
		cam.CFrame = CFrame.lookAt(eye0, eye0 + V(0, 0.4, -10)) * CFrame.Angles(math.noise(os.clock() * 6) * 0.01, 0, 0)
	end)
	-- шаг из лифта
	runFor(2.4, function(a)
		local e = smoothstep(a)
		local pos = eye0:Lerp(eye1, e) + V(0, math.abs(math.sin(a * 2.4 * 7)) * 0.15, 0)
		cam.CFrame = CFrame.lookAt(pos, pos + V(0, 0.6 - e * 0.3, -10))
	end)
	subtitle.Text = "Поляна. Лес, река... и огромные стены со всех сторон."
	-- осматриваемся: налево, вверх на стены, направо, вперёд
	local function lookAt(yaw, pitch)
		return CFrame.new(eye1) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
	end
	local keys = { { 0, 0.03 }, { 0.95, 0.12 }, { 0.6, 0.45 }, { -0.95, 0.15 }, { 0, 0.02 } }
	for k = 1, #keys - 1 do
		local a0, a1 = keys[k], keys[k + 1]
		runFor(1.3, function(a)
			local e = smoothstep(a)
			cam.CFrame = lookAt(a0[1] + (a1[1] - a0[1]) * e, a0[2] + (a1[2] - a0[2]) * e)
		end)
	end
	subtitle.Text = ""
	cam.CameraType = Enum.CameraType.Custom
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		cam.CameraSubject = hum
	end
	cutscene = false
	Viewmodel.rebuild()
	Viewmodel.setItem("fists")
	notify("Нажми C — крафт. Подойди к дереву и зажми E, чтобы рубить.")
end)

------------------------------------------------------------------
-- Финал: дверь открыта, вертолёт садится и уносит всех из лабиринта
------------------------------------------------------------------
local function buildHeli(cf)
	local m = Instance.new("Model")
	m.Name = "Helicopter"
	local function p(size, rel, color, mat, extra)
		local pt = make("Part", { Anchored = true, CanCollide = false, CanQuery = false, Size = size, Color = color, Material = mat or Enum.Material.SmoothPlastic }, m)
		if extra then
			for k, v in pairs(extra) do
				pt[k] = v
			end
		end
		pt:SetAttribute("Rel", rel)
		return pt
	end
	local white, red, dark, glass = RGB(232, 232, 236), RGB(200, 45, 40), RGB(35, 36, 40), RGB(60, 110, 140)
	local M = Enum.Material
	-- кабина: корпус, нос, стёкла, полосы
	p(V(7.5, 6.5, 11), CFrame.new(0, 4.8, 0), white, M.SmoothPlastic)
	p(V(7.6, 1, 11.1), CFrame.new(0, 3.2, 0), red, M.SmoothPlastic)
	p(V(6.5, 5, 4), CFrame.new(0, 4.4, -7), white, M.SmoothPlastic)
	p(V(6, 3, 0.3), CFrame.new(0, 5.6, -9.05), glass, M.Glass, { Transparency = 0.35 })
	for _, x in ipairs({ -3.8, 3.8 }) do
		p(V(0.2, 2.6, 3.6), CFrame.new(x, 5.8, -6.6), glass, M.Glass, { Transparency = 0.35 })
		p(V(0.2, 2.6, 3.4), CFrame.new(x, 5.8, -1.5), glass, M.Glass, { Transparency = 0.35 })
		p(V(0.25, 4.6, 3.6), CFrame.new(x, 4.6, 2.6), dark, M.Metal) -- проём двери
	end
	p(V(5, 1.2, 6), CFrame.new(0, 8.4, 1), white, M.SmoothPlastic) -- двигатель
	-- хвост
	p(V(1.8, 1.8, 16), CFrame.new(0, 6.2, 13), white, M.SmoothPlastic)
	p(V(1.85, 0.5, 16.1), CFrame.new(0, 6.6, 13), red, M.SmoothPlastic)
	p(V(0.4, 5, 3), CFrame.new(0, 8.5, 20.5), white, M.SmoothPlastic)
	p(V(5, 0.3, 2), CFrame.new(0, 6.4, 19), white, M.SmoothPlastic)
	-- полозья
	for _, x in ipairs({ -3.6, 3.6 }) do
		p(V(0.5, 0.5, 15), CFrame.new(x, 0.3, 0), dark, M.Metal)
		p(V(0.35, 1.8, 0.35), CFrame.new(x, 1.3, -3.5), dark, M.Metal)
		p(V(0.35, 1.8, 0.35), CFrame.new(x, 1.3, 3.5), dark, M.Metal)
	end
	-- винты
	p(V(0.8, 1.4, 0.8), CFrame.new(0, 9.6, 1), dark, M.Metal)
	for k = 0, 1 do
		local blade = p(V(34, 0.2, 1.3), CFrame.new(0, 10.3, 1), dark, M.Metal)
		blade:SetAttribute("Blade", k * math.pi / 2)
	end
	for k = 0, 1 do
		local tb = p(V(0.15, 4.5, 0.5), CFrame.new(0.5, 8.6, 21.5), dark, M.Metal)
		tb:SetAttribute("TailBlade", k * math.pi / 2)
	end
	local lamp = p(V(0.8, 0.8, 0.3), CFrame.new(0, 2.8, -9.1), RGB(255, 250, 220), M.Neon)
	make("SpotLight", { Face = Enum.NormalId.Front, Range = 60, Angle = 50, Brightness = 4 }, lamp)
	local beacon = p(V(0.5, 0.5, 0.5), CFrame.new(0, 8.4, 20.5), RGB(255, 40, 40), M.Neon)
	local _ = beacon
	m.Parent = workspace
	local spin = 0
	local function setCF(c, dt)
		spin += (dt or 0) * 25
		for _, d in ipairs(m:GetChildren()) do
			if d:IsA("BasePart") then
				local rel = d:GetAttribute("Rel")
				local b = d:GetAttribute("Blade")
				local tb = d:GetAttribute("TailBlade")
				if b then
					d.CFrame = c * rel * CFrame.Angles(0, spin + b, 0)
				elseif tb then
					d.CFrame = c * rel * CFrame.Angles(spin * 1.5 + tb, 0, 0)
				else
					d.CFrame = c * rel
				end
			end
		end
	end
	setCF(cf)
	return m, setCF
end

remote("Outro").OnClientEvent:Connect(function(pad, exitOut, players, day, coins, mazeCenter)
	cutscene = true
	craft.Visible = false
	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Scriptable
	local temp = {}
	mazeCenter = mazeCenter or (exitOut.Position - exitOut.LookVector * 500)

	-- вертолёт уже ждёт на лесной поляне, винты крутятся
	local heliCF = pad * CFrame.new(0, 0.6, 0) * CFrame.Angles(0, math.pi / 2, 0)
	local heli, setCF = buildHeli(heliCF)
	table.insert(temp, heli)
	local rotor = make("Sound", { SoundId = Config.Sounds.Rumble, Looped = true, Volume = 0.8, PlaybackSpeed = 0.7 }, SoundService)
	rotor:Play()

	-- друзья идут рядом
	local friends = {}
	local k = 0
	for _, who in ipairs(players) do
		if who ~= player then
			k += 1
			local av = cloneAvatar(who)
			if av then
				av.Parent = workspace
				table.insert(temp, av)
				table.insert(friends, { m = av, side = (k % 2 == 1) and -4 or 4, back = 3 + math.floor((k - 1) / 2) * 4 })
			end
		end
	end

	-- 1. ворота поднимаются
	local start = exitOut * CFrame.new(0, 5.4, -40)
	subtitle.Text = "Ворота поднимаются... За ними — свет."
	runFor(4.5, function()
		cam.CFrame = start * CFrame.Angles(math.noise(os.clock() * 3) * 0.01, 0, 0)
		setCF(heliCF, 1 / 60)
	end)

	-- 2. идём от первого лица: покачивание камеры и хруст травы под ногами
	subtitle.Text = "Лес... Настоящий лес. Мы выбрались!"
	local target = pad * CFrame.new(0, 5.4, 16)
	local from, to = start.Position, target.Position
	local walkTime = 8
	local nextStep = 0
	local t0 = os.clock()
	runFor(walkTime, function(a)
		local t = os.clock() - t0
		local pos = from:Lerp(to, a)
		local bob = math.sin(t * 9) * 0.22
		local sideBob = math.cos(t * 4.5) * 0.12
		local look = pos + (to - from).Unit * 10 + V(math.sin(t * 0.7) * 2.5, -0.8, 0)
		cam.CFrame = CFrame.lookAt(pos + V(sideBob, bob, 0), look) * CFrame.Angles(0, 0, math.cos(t * 4.5) * 0.012)
		if t >= nextStep then
			nextStep = t + 0.48
			sound(Config.Sounds.Step, 0.35, 0.7 + math.random() * 0.15)
		end
		for _, f in ipairs(friends) do
			local fp = from:Lerp(to, math.max(0, a - 0.04)) + (exitOut.RightVector * f.side) + exitOut.LookVector * f.back - V(0, 2.4, 0) + V(0, math.abs(math.sin(t * 9)) * 0.3, 0)
			f.m:PivotTo(CFrame.lookAt(fp, fp - exitOut.LookVector))
		end
		setCF(heliCF, 1 / 60)
	end)

	-- 3. садимся в вертолёт
	subtitle.Text = "Залезаем!"
	fade.BackgroundColor3 = RGB(0, 0, 0)
	TweenService:Create(fade, TweenInfo.new(0.4), { BackgroundTransparency = 0 }):Play()
	task.wait(0.45)
	for _, f in ipairs(friends) do
		f.m:Destroy()
	end
	-- место у открытой боковой двери: камера снаружи корпуса, винт выше кадра
	local seat = CFrame.new(5.4, 4.6, 2.6)
	cam.CFrame = CFrame.lookAt((heliCF * seat).Position, (heliCF * CFrame.new(30, 2, 2.6)).Position)
	TweenService:Create(fade, TweenInfo.new(0.6), { BackgroundTransparency = 1 }):Play()

	-- 4. взлёт: поднимаемся высоко над лабиринтом и смотрим на него целиком
	subtitle.Text = "Взлетаем... Вот он — весь лабиринт."
	local liftTime = 10
	local high = heliCF.Position:Lerp(mazeCenter, 0.35) + V(0, 420, 0)
	runFor(liftTime, function(a)
		local e = a * a * (3 - 2 * a)
		local pos = heliCF.Position:Lerp(high, e)
		local toMaze = (mazeCenter - pos) * V(1, 0, 1)
		local hc = CFrame.lookAt(pos, pos + V(toMaze.Z, 0, -toMaze.X)) * CFrame.Angles(-0.08 * math.sin(a * math.pi), 0, 0)
		setCF(hc, 1 / 60)
		local eye = (hc * seat).Position
		cam.CFrame = CFrame.lookAt(eye, mazeCenter) * CFrame.Angles(math.noise(os.clock() * 5) * 0.006, 0, 0)
	end)
	task.wait(2.5)

	-- 5. улетаем
	subtitle.Text = "Прощай, лабиринт."
	local away = (high - mazeCenter) * V(1, 0, 1)
	away = away.Magnitude > 1 and away.Unit or V(1, 0, 0)
	runFor(5, function(a)
		local pos = high + away * 600 * a * a + V(0, 60 * a, 0)
		local hc = CFrame.lookAt(pos, pos + V(-away.Z, 0, away.X))
		setCF(hc, 1 / 60)
		cam.CFrame = CFrame.lookAt((hc * seat).Position, mazeCenter)
	end)
	rotor:Destroy()
	for _, d in ipairs(temp) do
		if d.Parent then
			d:Destroy()
		end
	end
	TweenService:Create(fade, TweenInfo.new(1.2), { BackgroundTransparency = 0 }):Play()
	task.wait(1.3)
	subtitle.Text = ""
	lobbyLabel.ZIndex = 22
	lobbyLabel.Text = "ВЫ ВЫБРАЛИСЬ ИЗ ЛАБИРИНТА!\nДней в лабиринте: " .. day .. "   ·   +" .. coins .. " монет"
	task.wait(4)
	-- ждём, пока сервер вернёт нас в лобби, и только потом убираем чёрный экран
	local waitT = os.clock()
	while inMatch() and os.clock() - waitT < 12 do
		task.wait(0.1)
	end
	local char = player.Character or player.CharacterAdded:Wait()
	local hum = char:WaitForChild("Humanoid", 5)
	task.wait(0.3)
	char = player.Character
	hum = char and char:FindFirstChildOfClass("Humanoid") or hum
	cam.CameraType = Enum.CameraType.Custom
	if hum then
		cam.CameraSubject = hum
	end
	lobbyLabel.Text = ""
	lobbyLabel.ZIndex = 1
	cutscene = false
	TweenService:Create(fade, TweenInfo.new(1.5), { BackgroundTransparency = 1 }):Play()
end)

------------------------------------------------------------------
-- Каждый кадр: интерфейс, прицел, руки, бег
------------------------------------------------------------------
local devCursorOn = false
local fullLightOn = false
local function cursorForced()
	return devCursorOn
end
local function staminaMax()
	return Config.StaminaMax + (player:GetAttribute("Class") == "runner" and 60 or 0)
end
local function className(id)
	for _, c in ipairs(Config.Classes) do
		if c.Id == id then
			return c.Name
		end
	end
	return "Без класса"
end

-- освещение: у каждой группы своё время суток
local atmo = Lighting:FindFirstChildOfClass("Atmosphere")
local cc = Lighting:FindFirstChildOfClass("ColorCorrectionEffect")
local rays = Lighting:FindFirstChildOfClass("SunRaysEffect")
local function applyLighting(phase, a)
	if fullLightOn then
		return
	end
	atmo = atmo or Lighting:FindFirstChildOfClass("Atmosphere")
	cc = cc or Lighting:FindFirstChildOfClass("ColorCorrectionEffect")
	rays = rays or Lighting:FindFirstChildOfClass("SunRaysEffect")
	local clock, night = 14, 0
	if phase == "day" then
		clock = 6.5 + a * 11.5
		night = math.clamp((clock - 16.5) / 2, 0, 1) * 0.5 + math.clamp((7.5 - clock) / 1, 0, 1) * 0.5
	elseif phase == "night" then
		clock = (18.2 + a * 12.1) % 24
		night = 0.5 + 0.5 * math.clamp(math.min(a, 1 - a) / 0.08, 0, 1)
	end
	local function mix(x, y)
		return x:Lerp(y, night)
	end
	Lighting.ClockTime = clock
	Lighting.Brightness = 4 - night * 2.6
	Lighting.ExposureCompensation = 0.35 - night * 0.1
	Lighting.Ambient = mix(RGB(120, 115, 105), RGB(48, 52, 72))
	Lighting.OutdoorAmbient = mix(RGB(185, 180, 170), RGB(70, 80, 110))
	if atmo then
		atmo.Density = 0.25 + night * 0.12
		atmo.Haze = 1.2 + night * 1.2
		atmo.Color = mix(RGB(200, 190, 170), RGB(60, 70, 100))
		atmo.Decay = mix(RGB(110, 100, 90), RGB(20, 22, 40))
	end
	if cc then
		cc.TintColor = mix(RGB(255, 245, 230), RGB(190, 205, 255))
		cc.Saturation = 0.1 - night * 0.35
		cc.Contrast = 0.12
	end
	if rays then
		rays.Intensity = 0.12 * (1 - night)
	end
end

