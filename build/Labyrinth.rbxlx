player.CharacterAdded:Connect(function(c)
	task.wait(1)
	if not cutscene then
		local cam = workspace.CurrentCamera
		cam.CameraType = Enum.CameraType.Custom
		local h = c:FindFirstChildOfClass("Humanoid")
		if h then
			cam.CameraSubject = h
		end
	end
	crouched = false
	Viewmodel.rebuild()
	Viewmodel.setItem(equipped or "fists", true)
end)

local stamina = Config.StaminaMax
local exhausted = false
local vmState = { visible = false, moving = false, sprinting = false }
-- руки обновляются строго после камеры и тряски, чтобы не дрожали
RunService:BindToRenderStep("LabyrinthViewmodel", Enum.RenderPriority.Camera.Value + 2, function(dt)
	Viewmodel.update(dt, vmState.visible, vmState.moving, vmState.sprinting)
end)

local function formatTime(t)
	t = math.max(0, math.floor(t))
	return string.format("%d:%02d", t // 60, t % 60)
end

RunService.RenderStepped:Connect(function(dt)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local playing = inMatch() and not cutscene

	-- камера: ранен — вид от третьего лица на своё тело
	local isDown = player:GetAttribute("Downed") == true and inMatch()
	if spectating and not (spectating.Parent and spectating.Character) then
		spectating = nil
		if hum then
			workspace.CurrentCamera.CameraSubject = hum
		end
	end
	player.CameraMode = (playing and not isDown and not spectating) and Enum.CameraMode.LockFirstPerson or Enum.CameraMode.Classic
	if isDown then
		player.CameraMinZoomDistance = 9
		player.CameraMaxZoomDistance = 16
	else
		player.CameraMinZoomDistance = 0.5
		if not playing then
			player.CameraMaxZoomDistance = 18
		end
	end
	Radial.update()
	updatePings()
	updateMap()

	-- лобби
	titleLabel.Visible = false
	if not cutscene then
		lobbyLabel.Text = ""
	end
	updateLiftPanel()
	coinWidget.Visible = not inMatch() and not cutscene
	lobbyBar.Visible = coinWidget.Visible
	coinsLabel.Text = tostring(player:GetAttribute("Coins") or 0)
	classLabel.Text = "Класс: " .. className(player:GetAttribute("Class"))
	updateMusic(dt)

	-- фаза дня (у каждой группы своя)
	phaseLabel.Visible = inMatch()
	local phase = player:GetAttribute("Phase") or "day"
	local pStart = player:GetAttribute("PhaseStart") or workspace:GetServerTimeNow()
	local pLen = player:GetAttribute("PhaseLen") or 300
	local elapsed = workspace:GetServerTimeNow() - pStart
	local left = pLen - elapsed
	local day = player:GetAttribute("Day") or 1
	local diff = Config.Difficulty[player:GetAttribute("Difficulty") or "normal"]
	local tagText = diff and ("[" .. diff.Name .. "]  ") or ""
	if phase == "day" then
		phaseLabel.Text = tagText .. "☀  День " .. day .. "  ·  врата закроются через " .. formatTime(left)
		phaseLabel.TextColor3 = left < Config.WarningTime and RGB(255, 120, 90) or RGB(240, 230, 200)
	else
		phaseLabel.Text = tagText .. "☾  Ночь  ·  врата закрыты  ·  рассвет через " .. formatTime(left)
		phaseLabel.TextColor3 = RGB(170, 190, 255)
	end
	applyLighting(inMatch() and phase or nil, math.clamp(elapsed / pLen, 0, 1))

	-- курсор только в меню
	UserInputService.MouseIconEnabled = not playing or craft.Visible or shopPanel.Visible or notePanel.Visible or Radial.isOpen() or settingsPanel.Visible or adminPanel.Visible or cursorForced()

	-- ранение
	local downed = player:GetAttribute("Downed") == true
	downedPanel.Visible = downed and inMatch()
	local sleeping, hidden = player:GetAttribute("Sleeping") == true, player:GetAttribute("Hidden") == true
	restPanel.Visible = (sleeping or hidden) and inMatch()
	if restPanel.Visible then
		restPanel.BackgroundTransparency = sleeping and 0.15 or 0.75
		for _, f in ipairs(leafFrames) do
			f.Visible = hidden
		end
		restText.Text = sleeping and "Zzz... Ты спишь. Ночь пройдёт, когда уснут все.  (E у кровати — встать)" or "Ты в зарослях лиан. Скрежетники тебя не видят.  (E — вылезти)"
	end
	if downed then
		local pn = (player:GetAttribute("PingNext") or 0) - workspace:GetServerTimeNow()
		downedText.Text = "ТЫ РАНЕН\nДруг может поднять тебя бинтом (E) или утащить за ногу (F)\n"
			.. (pn > 0 and ("Сигнал снова через " .. math.ceil(pn) .. " с") or "R — позвать на помощь (друзья увидят тебя и стрелки)")
			.. "\nЖди друга. Если ранены все — все вернутся в лобби."
	end
	if hum and inMatch() then
		hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
	end

	-- здоровье и выносливость
	hpBack.Visible, stBack.Visible, hotbar.Visible = inMatch(), inMatch(), inMatch() and not cutscene
	resPanel.Visible = inMatch() and #resPanel:GetChildren() > 2
	if hum then
		hpFill.Size = UDim2.fromScale(math.clamp(hum.Health / hum.MaxHealth, 0, 1), 1)
		hpText.Text = math.floor(hum.Health) .. " / " .. hum.MaxHealth
		local ar = Items.Armor[player:GetAttribute("Armor") or 0]
		armorText.Visible = inMatch()
		armorText.Text = ar and ("🛡 " .. ar.Name) or ""
		local moving = hum.MoveDirection.Magnitude > 0.1
		local dragging = player:GetAttribute("Dragging") == true
		local sprinting = playing and sprintHeld and moving and not exhausted and stamina > 0 and not crouched and not dragging
		if sprinting then
			stamina = math.max(0, stamina - Config.StaminaDrain * dt)
			exhausted = stamina <= 0
		else
			stamina = math.min(staminaMax(), stamina + Config.StaminaRegen * dt)
			if exhausted and stamina > 30 then
				exhausted = false
			end
		end
		local cls = player:GetAttribute("Class")
		local sprint = Config.SprintSpeed * (cls == "runner" and 1.3 or 1)
		if downed then
			hum.WalkSpeed = 0
		elseif crouched then
			hum.WalkSpeed = Config.CrouchSpeed
		else
			hum.WalkSpeed = (sprinting and sprint or Config.WalkSpeed) * (dragging and 0.75 or 1)
		end
		stFill.Size = UDim2.fromScale(stamina / staminaMax(), 1)
		vmState.visible, vmState.moving, vmState.sprinting = playing and not downed, moving, sprinting

	else
		vmState.visible = false
	end

	-- строительство
	local eqKind = equipped and Items.Tools[equipped] and Items.Tools[equipped].Kind
	BuildMode.update((playing and not downed and (eqKind == "blueprint" or eqKind == "hammer" or eqKind == "deploy")) and eqKind or nil, rayParams(), equipped)

	-- прицел
	cross.Visible = playing
	spread = math.max(0, spread - dt * 4)
	local gap = 10 + spread * 10
	for _, t in ipairs(ticks) do
		t.frame.Position = UDim2.new(0.5, t.dir[1] * gap, 0.5, t.dir[2] * gap)
	end
	local color = RGB(240, 240, 240)
	targetLabel.Text = ""
	targetHP.Visible = false
	if playing then
		local def = Items.Tools[equipped or "fists"] or Items.Tools.fists
		local r = aimRay(def.Range)
		if r then
			local model = r.Instance:FindFirstAncestorWhichIsA("Model")
			local mon = model
			while mon and not CollectionService:HasTag(mon, "Monster") and mon.Parent and mon.Parent:IsA("Model") do
				mon = mon.Parent
			end
			if mon and CollectionService:HasTag(mon, "Monster") then
				color = RGB(255, 70, 60)
				targetLabel.Text = Config.Monster.Name
				targetHP.Visible = true
				targetHPFill.Size = UDim2.fromScale(math.clamp((mon:GetAttribute("HP") or 1) / (mon:GetAttribute("MaxHP") or 1), 0, 1), 1)
			else
				local nodeModel = model
				while nodeModel and nodeModel:GetAttribute("Node") == nil and nodeModel.Parent and nodeModel.Parent:IsA("Model") do
					nodeModel = nodeModel.Parent
				end
				local kind = nodeModel and nodeModel:GetAttribute("Node")
				if kind and not nodeModel:GetAttribute("Depleted") then
					local nd = Items.Nodes[kind]
					local okTool = def.Kind == nd.Tool and def.Tier >= nd.Tier
					color = okTool and RGB(255, 210, 90) or RGB(160, 160, 160)
					local need = nd.Tool == "axe" and "топор" or ("кирка ур. " .. nd.Tier)
					targetLabel.Text = nd.Name .. (okTool and "" or ("  ·  нужен(а) " .. need))
				end
			end
		end
	end
	ringStroke.Color = color
	for _, t in ipairs(ticks) do
		t.frame.BackgroundColor3 = color
	end
end)

------------------------------------------------------------------
-- Тестовые кнопки
------------------------------------------------------------------
if Config.DevTools then
	-- рамка админки: заголовок (свернуть/развернуть) и прокручиваемый список кнопок
	local holder = make("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 68), Size = UDim2.fromOffset(200, 34), BackgroundTransparency = 1 }, gui)
	local head = make("TextButton", { Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = RGB(120, 70, 20), BackgroundTransparency = 0.1, Font = Enum.Font.GothamBlack, TextSize = 14, TextColor3 = RGB(255, 230, 180), Text = "АДМИН-ПАНЕЛЬ ▾" }, holder)
	corner(head, 6)
	local bar = make("ScrollingFrame", { Position = UDim2.fromOffset(0, 34), Size = UDim2.new(1, 0, 0, 300), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 5, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollingDirection = Enum.ScrollingDirection.Y }, holder)
	local collapsed = false
	head.Activated:Connect(function()
		collapsed = not collapsed
		head.Text = collapsed and "АДМИН-ПАНЕЛЬ ▸" or "АДМИН-ПАНЕЛЬ ▾"
	end)
	-- на телефоне — слева сверху (под кнопками Roblox, над джойстиком), на ПК — справа
	RunService.RenderStepped:Connect(function()
		local touch = UserInputService.TouchEnabled and (not UserInputService.KeyboardEnabled or UserInputService:GetLastInputType() == Enum.UserInputType.Touch)
		local vp = workspace.CurrentCamera.ViewportSize / math.max(0.01, gui:FindFirstChildOfClass("UIScale") and gui:FindFirstChildOfClass("UIScale").Scale or 1)
		if touch then
			holder.AnchorPoint = Vector2.new(0, 0)
			holder.Position = UDim2.fromOffset(12, 64)
			bar.Size = UDim2.new(1, 0, 0, math.max(80, vp.Y * 0.42))
		else
			holder.AnchorPoint = Vector2.new(1, 0)
			holder.Position = UDim2.new(1, -16, 0, 68)
			bar.Size = UDim2.new(1, 0, 0, math.max(120, vp.Y - 200))
		end
		holder.Visible = bar:GetAttribute("On") == true
		bar.Visible = not collapsed
	end)
	-- админ-кнопки видны только после ввода кода в Настройки → Админ-панель
	-- уровень 1 (код друзей) — часть кнопок, уровень 2 (главный код) — все
	local levelOf = {}
	local function refreshAdmin()
		local lvl = player:GetAttribute("Admin") or 0
		if lvl == true then
			lvl = 2
		end
		bar:SetAttribute("On", lvl >= 1)
		for b, need in pairs(levelOf) do
			b.Visible = lvl >= need
		end
	end
	player:GetAttributeChangedSignal("Admin"):Connect(refreshAdmin)
	make("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }, bar)
	local order = 0
	local function btn(text, fn, need, color)
		order += 1
		local b = make("TextButton", { Size = UDim2.new(1, -8, 0, 30), BackgroundColor3 = color or RGB(30, 30, 34), BackgroundTransparency = 0.25, Font = UI_FONT, TextSize = 13, TextColor3 = RGB(230, 230, 230), Text = text, LayoutOrder = order }, bar)
		corner(b, 6)
		levelOf[b] = need or 1
		b.MouseButton1Click:Connect(function()
			fn(b)
		end)
		return b
	end
	-- курсор (M)
	local unlocker = make("TextButton", { Size = UDim2.new(0, 1, 0, 1), BackgroundTransparency = 1, Text = "", Modal = true, Visible = false }, gui)
	local cursorB = btn("Курсор: ВЫКЛ (M)", function(b)
		cursorFree = not cursorFree
		b.Text = cursorFree and "Курсор: ВКЛ (M)" or "Курсор: ВЫКЛ (M)"
	end)
	local _ = unlocker
	-- полный свет (L): переписываем свет каждый кадр, т.к. сервер меняет время суток
	local fullB = btn("Полный свет: ВЫКЛ (L)", function(b)
		fullLightOn = not fullLightOn
		b.Text = fullLightOn and "Полный свет: ВКЛ (L)" or "Полный свет: ВЫКЛ (L)"
	end)
	RunService.RenderStepped:Connect(function()
		fullB.Text = fullLightOn and "Полный свет: ВКЛ (L)" or "Полный свет: ВЫКЛ (L)"
		cursorB.Text = cursorFree and "Курсор: ВКЛ (M)" or "Курсор: ВЫКЛ (M)"
		if fullLightOn then
			Lighting.ClockTime = 13
			Lighting.Brightness = 3
			Lighting.Ambient = RGB(200, 200, 200)
			Lighting.OutdoorAmbient = RGB(200, 200, 200)
			local a = Lighting:FindFirstChildOfClass("Atmosphere")
			if a then
				a.Density = 0.1
			end
		end
	end)
	-- полёт (N)
	local flying, flyConn = false, nil
	local function setFly(on)
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hum or not hrp then
			return
		end
		flying = on
		flyingNow = on
		remote("Dev"):FireServer("ghost", on)
		hum.PlatformStand = on
		if flyConn then
			flyConn:Disconnect()
			flyConn = nil
		end
		if on then
			flyConn = RunService.RenderStepped:Connect(function(dt)
				local cam = workspace.CurrentCamera
				local mv = Vector3.zero
				local K = Enum.KeyCode
				if UserInputService:IsKeyDown(K.W) then
					mv += cam.CFrame.LookVector
				end
				if UserInputService:IsKeyDown(K.S) then
					mv -= cam.CFrame.LookVector
				end
				if UserInputService:IsKeyDown(K.D) then
					mv += cam.CFrame.RightVector
				end
				if UserInputService:IsKeyDown(K.A) then
					mv -= cam.CFrame.RightVector
				end
				if UserInputService:IsKeyDown(K.Space) then
					mv += Vector3.yAxis
				end
				if UserInputService:IsKeyDown(K.LeftControl) then
					mv -= Vector3.yAxis
				end
				local pos = hrp.Position
				if mv.Magnitude > 0 then
					pos += mv.Unit * (UserInputService:IsKeyDown(K.LeftShift) and 140 or 55) * dt
				end
				local flat = V(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
				hrp.CFrame = CFrame.lookAt(pos, pos + (flat.Magnitude > 0.01 and flat or V(0, 0, -1)))
				hrp.AssemblyLinearVelocity = Vector3.zero
				for _, d in ipairs(char:GetDescendants()) do
					if d:IsA("BasePart") then
						d.CanCollide = false
					end
				end
			end)
		end
	end
	local flyB = btn("Полёт: ВЫКЛ (N)", function(b)
		setFly(not flying)
		b.Text = flying and "Полёт: ВКЛ (N)" or "Полёт: ВЫКЛ (N)"
	end)
	btn("Сменить день/ночь", function()
		remote("Dev"):FireServer("phase")
	end)
	btn("+30 ресурсов и Ключ", function()
		remote("Dev"):FireServer("res")
	end)
	btn("Телепорт к выходу", function()
		remote("Dev"):FireServer("toexit")
	end)
	-- только главная админка
	btn("+500 монет", function()
		remote("Dev"):FireServer("coins")
	end, 2)
	btn("Ранить себя (тест)", function()
		remote("Dev"):FireServer("down")
	end, 2)
	btn("Невидимость", function(b)
		remote("Dev"):FireServer("invisible")
		task.delay(0.4, function()
			b.Text = player:GetAttribute("Invisible") and "Невидимость: ВКЛ" or "Невидимость"
		end)
	end, 2, RGB(60, 40, 90))
	-- наблюдение за игроками: камера переходит к следующему игроку
	local others = {}
	local function nextPlayer()
		others = {}
		for _, q in ipairs(Players:GetPlayers()) do
			if q ~= player and q.Character and q.Character:FindFirstChildOfClass("Humanoid") then
				table.insert(others, q)
			end
		end
		if #others == 0 then
			notify("На сервере больше никого нет")
			return nil
		end
		spectateIndex = spectateIndex % #others + 1
		return others[spectateIndex]
	end
	btn("Наблюдать: следующий", function()
		local q = nextPlayer()
		if q then
			spectating = q
			workspace.CurrentCamera.CameraSubject = q.Character:FindFirstChildOfClass("Humanoid")
			notify("Наблюдаешь за " .. q.DisplayName)
		end
	end, 2, RGB(30, 60, 90))
	btn("Перестать наблюдать", function()
		spectating = nil
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			workspace.CurrentCamera.CameraSubject = hum
		end
	end, 2, RGB(30, 60, 90))
	-- меню игроков: все, кто сейчас на сервере; ТП к нему, к себе, кик, тюрьма
	local plPanel = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(700, 420), BackgroundColor3 = RGB(22, 24, 28), Visible = false, ZIndex = 30 }, gui)
	corner(plPanel, 14)
	make("UIStroke", { Color = RGB(200, 140, 60), Thickness = 2 }, plPanel)
	make("TextButton", { Size = UDim2.fromOffset(1, 1), BackgroundTransparency = 1, Text = "", Modal = true }, plPanel)
	make("TextLabel", { Position = UDim2.fromOffset(0, 10), Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, Font = Enum.Font.FredokaOne, TextSize = 24, TextColor3 = RGB(255, 210, 140), Text = "ИГРОКИ НА СЕРВЕРЕ", ZIndex = 31 }, plPanel)
	local plList = make("ScrollingFrame", { Position = UDim2.fromOffset(14, 48), Size = UDim2.new(1, -28, 1, -110), BackgroundTransparency = 1, ScrollBarThickness = 6, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 31 }, plPanel)
	make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, plList)
	local closeP = make("TextButton", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -12), Size = UDim2.fromOffset(160, 40), BackgroundColor3 = RGB(90, 40, 30), Font = UI_FONT, TextSize = 17, TextColor3 = RGB(255, 255, 255), Text = "Закрыть", ZIndex = 31 }, plPanel)
	corner(closeP, 8)
	closeP.Activated:Connect(function()
		plPanel.Visible = false
	end)
	-- выдача предметов: список всего, что есть в игре
	local givePanel = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(520, 440), BackgroundColor3 = RGB(26, 26, 30), Visible = false, ZIndex = 40 }, gui)
	corner(givePanel, 14)
	make("UIStroke", { Color = RGB(220, 180, 80), Thickness = 2 }, givePanel)
	make("TextButton", { Size = UDim2.fromOffset(1, 1), BackgroundTransparency = 1, Text = "", Modal = true }, givePanel)
	local giveTitle = make("TextLabel", { Position = UDim2.fromOffset(0, 10), Size = UDim2.new(1, 0, 0, 28), BackgroundTransparency = 1, Font = Enum.Font.FredokaOne, TextSize = 22, TextColor3 = RGB(255, 220, 140), Text = "", ZIndex = 41 }, givePanel)
	local giveGrid = make("ScrollingFrame", { Position = UDim2.fromOffset(12, 46), Size = UDim2.new(1, -24, 1, -104), BackgroundTransparency = 1, ScrollBarThickness = 6, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 41 }, givePanel)
	make("UIGridLayout", { CellSize = UDim2.fromOffset(118, 40), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder }, giveGrid)
	local giveClose = make("TextButton", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -12), Size = UDim2.fromOffset(160, 40), BackgroundColor3 = RGB(90, 40, 30), Font = UI_FONT, TextSize = 17, TextColor3 = RGB(255, 255, 255), Text = "Готово", ZIndex = 41 }, givePanel)
	corner(giveClose, 8)
	giveClose.Activated:Connect(function()
		givePanel.Visible = false
	end)
	function openGive(q)
		giveTitle.Text = "Выдать: " .. q.DisplayName
		for _, c in ipairs(giveGrid:GetChildren()) do
			if c:IsA("TextButton") then
				c:Destroy()
			end
		end
		local entries = {}
		for id, def in pairs(Items.Tools) do
			if def.Kind ~= "fists" and def.Kind ~= "held" then
				table.insert(entries, { id = id, name = def.Name, color = RGB(50, 70, 100) })
			end
		end
		for id, def in pairs(Items.Resources) do
			table.insert(entries, { id = id, name = def.Name .. (id == "key" and "" or " ×10"), color = RGB(60, 90, 50) })
		end
		for tier, a in ipairs(Items.Armor) do
			table.insert(entries, { id = "armor:" .. tier, name = a.Name, color = RGB(90, 60, 110) })
		end
		table.sort(entries, function(a, b)
			return a.name < b.name
		end)
		for k, e in ipairs(entries) do
			local b = make("TextButton", { BackgroundColor3 = e.color, Font = UI_FONT, TextSize = 12, TextWrapped = true, TextColor3 = RGB(255, 255, 255), Text = e.name, LayoutOrder = k, ZIndex = 42 }, giveGrid)
			corner(b, 6)
			b.Activated:Connect(function()
				remote("Dev"):FireServer("give", { uid = q.UserId, item = e.id })
				sound(Config.Sounds.Pickup, 0.5, 1.2)
			end)
		end
		givePanel.Visible = true
	end
	local function renderPlayers()
		for _, c in ipairs(plList:GetChildren()) do
			if c:IsA("Frame") then
				c:Destroy()
			end
		end
		local n = 0
		for _, q in ipairs(Players:GetPlayers()) do
			do
				n += 1
				local row = make("Frame", { Size = UDim2.new(1, -8, 0, 46), BackgroundColor3 = RGB(36, 38, 44), LayoutOrder = n, ZIndex = 31 }, plList)
				corner(row, 8)
				local jailed = q:GetAttribute("Jailed") == true
				make("TextLabel", { Position = UDim2.fromOffset(10, 0), Size = UDim2.new(0, 150, 1, 0), BackgroundTransparency = 1, Font = UI_FONT, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, TextColor3 = jailed and RGB(255, 120, 110) or RGB(240, 240, 235), Text = q.DisplayName .. (q == player and " (ты)" or "") .. (jailed and " (в тюрьме)" or ""), ZIndex = 32 }, row)
				local x = 166
				local function act(text, color, fn)
					local b = make("TextButton", { Position = UDim2.fromOffset(x, 7), Size = UDim2.fromOffset(88, 32), BackgroundColor3 = color, Font = UI_FONT, TextSize = 13, TextColor3 = RGB(255, 255, 255), Text = text, ZIndex = 32 }, row)
					corner(b, 6)
					b.Activated:Connect(fn)
					x += 94
				end
				act("Выдать", RGB(130, 100, 30), function()
					openGive(q)
				end)
				if q ~= player then
					act("ТП к нему", RGB(40, 90, 140), function()
						remote("Dev"):FireServer("tpto", q.UserId)
						plPanel.Visible = false
					end)
					act("К себе", RGB(40, 120, 90), function()
						remote("Dev"):FireServer("bring", q.UserId)
					end)
					act("Кикнуть", RGB(150, 70, 30), function()
						remote("Dev"):FireServer("kick", q.UserId)
						task.delay(0.6, renderPlayers)
					end)
					act(jailed and "Выпустить" or "В тюрьму", RGB(120, 30, 30), function()
						remote("Dev"):FireServer("jail", q.UserId)
						task.delay(0.6, renderPlayers)
					end)
				end
			end
		end
		if n <= 1 then
			local row = make("Frame", { Size = UDim2.new(1, -8, 0, 46), BackgroundTransparency = 1, ZIndex = 31 }, plList)
			make("TextLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Font = UI_FONT, TextSize = 16, TextColor3 = RGB(200, 200, 200), Text = "Кроме тебя, на сервере никого нет", ZIndex = 32 }, row)
		end
	end
	btn("👥 Игроки (ТП, выдать, кик, тюрьма)", function()
		renderPlayers()
		plPanel.Visible = true
	end, 2, RGB(30, 60, 90))
	RunService.RenderStepped:Connect(function()
		if plPanel.Visible then
			UserInputService.MouseIconEnabled = true
		end
	end)
	btn("☢ Ядерка на поляну", function()
		remote("Dev"):FireServer("nuke")
	end, 2, RGB(120, 60, 20))
	btn("🌊 Цунами", function()
		remote("Dev"):FireServer("tsunami")
	end, 2, RGB(20, 70, 120))
	btn("💰 Денежный дождь", function()
		remote("Dev"):FireServer("money")
	end, 2, RGB(120, 100, 20))
	refreshAdmin()
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not player:GetAttribute("Admin") then
			return
		end
		if input.KeyCode == Enum.KeyCode.N then
			setFly(not flying)
			flyB.Text = flying and "Полёт: ВКЛ (N)" or "Полёт: ВЫКЛ (N)"
		end
	end)
end

------------------------------------------------------------------
-- Для всех: M — освободить мышь; L — полный свет (код 444 или админка)
------------------------------------------------------------------
local freeMouse = make("TextButton", { Size = UDim2.fromOffset(1, 1), BackgroundTransparency = 1, Text = "", Modal = true, Visible = false }, gui)
local lightB = make("TextButton", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -66, 0, 12), Size = UDim2.fromOffset(46, 46), BackgroundColor3 = RGB(20, 22, 26), BackgroundTransparency = 0.3, Font = Enum.Font.GothamBlack, TextSize = 24, TextColor3 = RGB(255, 230, 120), Text = "💡", Visible = false }, gui)
corner(lightB, 100)
local function canLight()
	return player:GetAttribute("Light") == true or (player:GetAttribute("Admin") or 0) >= 1
end
local function toggleLight()
	if canLight() then
		fullLightOn = not fullLightOn
		notify(fullLightOn and "Свет: ВКЛ (L)" or "Свет: ВЫКЛ (L)")
	end
end
lightB.Activated:Connect(toggleLight)
RunService.RenderStepped:Connect(function()
	freeMouse.Visible = cursorFree
	lightB.Visible = canLight()
	lightB.BackgroundColor3 = fullLightOn and RGB(150, 120, 30) or RGB(20, 22, 26)
end)
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.M then
		cursorFree = not cursorFree
		notify(cursorFree and "Мышь свободна (M — снова спрятать)" or "Мышь снова управляет камерой")
	elseif input.KeyCode == Enum.KeyCode.L then
		toggleLight()
	end
end)
player:GetAttributeChangedSignal("Light"):Connect(function()
	if player:GetAttribute("Light") then
		notify("Код принят! Теперь у тебя есть свет: кнопка 💡 или L.")
	end
end)

-- подсказка управления (на телефоне не нужна)
local keysHint = make("TextLabel", {
	AnchorPoint = Vector2.new(1, 1),
	Position = UDim2.new(1, -16, 1, -14),
	Size = UDim2.new(0, 760, 0, 20),
	BackgroundTransparency = 1,
	Font = TEXT_FONT,
	TextSize = 13,
	TextXAlignment = Enum.TextXAlignment.Right,
	TextColor3 = RGB(200, 195, 180),
	Text = "ЛКМ — удар · E (зажать) — добыть/собрать · C — крафт · 1–9 — предмет · Ctrl — пригнуться · Shift — бег · H — ягоды · R — меню · Tab — карта",
}, gui)

------------------------------------------------------------------
-- Телефон и планшет: интерфейс подстраивается под экран, кнопки на экране
------------------------------------------------------------------
local uiScale = make("UIScale", {}, gui)
local function rescale()
	local vp = workspace.CurrentCamera.ViewportSize
	uiScale.Scale = math.clamp(math.min(vp.X / 1280, vp.Y / 760), 0.55, 1)
end
rescale()
workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)

local function touchMode()
	return UserInputService.TouchEnabled and (not UserInputService.KeyboardEnabled or UserInputService:GetLastInputType() == Enum.UserInputType.Touch)
end
keysHint.Visible = not touchMode()
if UserInputService.TouchEnabled then
	local pad = make("Frame", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -24, 1, -190), Size = UDim2.fromOffset(250, 330), BackgroundTransparency = 1 }, gui)
	local function tbtn(text, pos, size, color, fn)
		local b = make("TextButton", { AnchorPoint = Vector2.new(0.5, 0.5), Position = pos, Size = size, BackgroundColor3 = color, BackgroundTransparency = 0.25, Font = Enum.Font.GothamBlack, TextSize = 15, TextWrapped = true, TextColor3 = RGB(255, 255, 255), Text = text }, pad)
		corner(b, 100)
		make("UIStroke", { Color = RGB(255, 255, 255), Thickness = 2, Transparency = 0.4 }, b)
		b.Activated:Connect(function()
			fn(b)
		end)
		return b
	end
	-- большая кнопка удара/действия
	tbtn("УДАР\nРУБИТЬ", UDim2.fromOffset(185, 270), UDim2.fromOffset(110, 110), RGB(190, 60, 50), function()
		doSwing()
	end)
	local sprintB
	sprintB = tbtn("БЕГ", UDim2.fromOffset(70, 290), UDim2.fromOffset(70, 70), RGB(70, 110, 160), function()
		sprintHeld = not sprintHeld
		sprintB.BackgroundColor3 = sprintHeld and RGB(80, 170, 90) or RGB(70, 110, 160)
	end)
	tbtn("ПРИСЕСТЬ", UDim2.fromOffset(70, 205), UDim2.fromOffset(70, 70), RGB(90, 90, 100), function()
		if inMatch() and not cutscene then
			setCrouch(not crouched)
		end
	end)
	tbtn("КРАФТ", UDim2.fromOffset(150, 170), UDim2.fromOffset(66, 66), RGB(150, 110, 50), function()
		if inMatch() and not cutscene then
			openHandCraft()
		end
	end)
	tbtn("МЕНЮ", UDim2.fromOffset(225, 160), UDim2.fromOffset(66, 66), RGB(110, 80, 160), function()
		if not inMatch() or cutscene then
			return
		end
		local kind = equipped and Items.Tools[equipped] and Items.Tools[equipped].Kind
		if player:GetAttribute("Downed") then
			remote("Ping"):FireServer()
		elseif kind == "blueprint" then
			BuildMode.pieceMenu(Radial)
		elseif kind == "hammer" then
			BuildMode.hammerMenu(Radial, remote("Upgrade"))
		elseif kind == "deploy" then
			BuildMode.rotate()
		end
	end)
	tbtn("КАРТА", UDim2.fromOffset(150, 95), UDim2.fromOffset(60, 60), RGB(60, 130, 90), function()
		if inMatch() and not cutscene then
			toggleMap()
		end
	end)
	tbtn("ЕДА", UDim2.fromOffset(225, 85), UDim2.fromOffset(60, 60), RGB(170, 50, 80), function()
		remote("Eat"):FireServer()
	end)
	tbtn("УБРАТЬ", UDim2.fromOffset(70, 120), UDim2.fromOffset(60, 60), RGB(70, 70, 76), function()
		equip(nil)
		refreshHotbar()
	end)
	RunService.RenderStepped:Connect(function()
		local t = touchMode()
		pad.Visible = t and inMatch() and not cutscene
		keysHint.Visible = not t
	end)
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">MonsterView</string>
            <string name="Source"><![CDATA[-- Внешний вид Скрежетника (рисуется на клиенте): тело-слизень, костяные шипы,
-- 8 механических ног с настоящей походкой (каждая нога сама ищет, куда наступить),
-- хвост с жалом. В узком месте ноги поджимаются и поднимаются выше, чтобы не
-- проходить сквозь стены. Сервер управляет только невидимым корпусом.

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local MonsterView = {}

local V = Vector3.new
local RGB = Color3.fromRGB
local UP = V(0, 1, 0)

local FLESH = RGB(118, 124, 92)
local FLESH2 = RGB(92, 98, 72)
local METAL = RGB(38, 40, 44)
local BONE = RGB(200, 196, 176)
local GLOW = RGB(90, 170, 255)

local GROUND = 5.6 -- от центра корпуса до земли
local L1, L2 = 7.5, 8.5 -- бедро и голень
local HIPS = { -3.6, -1.3, 1.3, 3.6 }

local folder = Instance.new("Folder")
folder.Name = "MonsterViews"
folder.Parent = workspace

local views = {}

local function newPart(model, size, color, material, shape)
	local p = Instance.new("Part")
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	if shape then
		p.Shape = shape
	end
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = model
	return p
end

local function build(monster)
	local root = monster:WaitForChild("HumanoidRootPart", 5)
	if not root then
		return
	end
	local m = Instance.new("Model")
	m.Name = "Grieverview"
	m.Parent = folder
	local v = { monster = monster, root = root, model = m, body = {}, legs = {}, tail = {}, parts = {}, t = math.random() * 10 }

	local function body(size, color, material, cf, shape, refl)
		local p = newPart(m, size, color, material, shape)
		p.Reflectance = refl or 0
		table.insert(v.body, { part = p, cf = cf })
		return p
	end
	local ball = Enum.PartType.Ball
	-- тело-слизень: несколько влажных «сегментов»
	body(V(7.4, 7.4, 7.4), FLESH, nil, CFrame.new(0, 1.2, 3.2), ball, 0.12)
	body(V(6.6, 6.6, 6.6), FLESH2, nil, CFrame.new(0, 1.5, 0), ball, 0.12)
	body(V(5.4, 5.4, 5.4), FLESH, nil, CFrame.new(0, 1.5, -3.2), ball, 0.12)
	body(V(4.2, 4.2, 4.2), FLESH2, nil, CFrame.new(0, 1.2, -5.8), ball, 0.1)
	-- вены
	for k = 1, 6 do
		local a = k * 1.05
		body(V(0.18, 0.18, 4.5), RGB(70, 30, 40), nil, CFrame.new(math.sin(a) * 3.3, 1.4 + math.cos(a) * 3.2, 1.5) * CFrame.Angles(0, 0, a))
	end
	-- металлические пластины и шипы на спине
	for k = 0, 6 do
		local z = -4 + k * 1.35
		local h = 2.6 + (k % 2) * 1.2
		body(V(0.35, h, 0.35), METAL, Enum.Material.Metal, CFrame.new(((k % 2) * 2 - 1) * 0.8, 4.4 + h / 2 - 0.6, z) * CFrame.Angles(math.rad(-25), 0, math.rad(((k % 2) * 2 - 1) * 12)))
	end
	body(V(3.2, 0.4, 5), METAL, Enum.Material.DiamondPlate, CFrame.new(0, 4.6, -1) * CFrame.Angles(math.rad(-6), 0, 0))
	-- голова: пасть с зубами и синий «глаз»-огонёк
	body(V(2.6, 1.6, 1.4), RGB(20, 10, 12), nil, CFrame.new(0, 0.6, -7.6))
	for k = -2, 2 do
		body(V(0.25, 0.9, 0.25), BONE, nil, CFrame.new(k * 0.5, 1.3, -8.15) * CFrame.Angles(0, 0, math.rad(180)))
		body(V(0.22, 0.7, 0.22), BONE, nil, CFrame.new(k * 0.5 + 0.25, -0.05, -8.15))
	end
	local eye = body(V(0.8, 0.8, 0.8), GLOW, Enum.Material.Neon, CFrame.new(1.2, 3.1, -6.2), ball)
	local light = Instance.new("PointLight")
	light.Color = GLOW
	light.Range = 16
	light.Brightness = 2
	light.Parent = eye
	for k = -1, 1, 2 do
		body(V(0.35, 0.35, 0.35), RGB(160, 255, 120), Enum.Material.Neon, CFrame.new(k * 0.9, 2.2, -7.6), ball)
	end
	-- ноги
	for side = -1, 1, 2 do
		for i, z in ipairs(HIPS) do
			local leg = {
				side = side,
				z = z,
				group = ((i + (side > 0 and 1 or 0)) % 2),
				femur = newPart(m, V(0.7, 0.7, L1), METAL, Enum.Material.Metal),
				tibia = newPart(m, V(0.45, 0.45, L2), METAL, Enum.Material.Metal),
				knee = newPart(m, V(1.1, 1.1, 1.1), RGB(25, 25, 28), Enum.Material.Metal, ball),
				hip = newPart(m, V(1.2, 1.2, 1.2), FLESH2, nil, ball),
				claw = newPart(m, V(0.3, 0.3, 1.8), BONE),
				spike = newPart(m, V(0.25, 0.25, 1.6), METAL, Enum.Material.Metal),
			}
			table.insert(v.legs, leg)
		end
	end
	-- хвост с жалом
	for k = 1, 8 do
		local s = 1.25 - k * 0.09
		local p = newPart(m, V(s, s, 1.8), k % 2 == 0 and METAL or FLESH2, k % 2 == 0 and Enum.Material.Metal or nil)
		table.insert(v.tail, p)
	end
	v.sting = newPart(m, V(0.3, 0.3, 2.4), RGB(150, 20, 30), Enum.Material.Neon)
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			table.insert(v.parts, d)
			d:SetAttribute("C0", d.Color)
		end
	end
	v.room = { [-1] = 9, [1] = 9 }
	v.roomT = 0
	v.attacks = monster:GetAttribute("Attacks") or 0
	monster:GetAttributeChangedSignal("Attacks"):Connect(function()
		v.attackT = 0
	end)
	monster:GetAttributeChangedSignal("Flash"):Connect(function()
		for _, p in ipairs(v.parts) do
			if p.Material ~= Enum.Material.Neon then
				p.Color = RGB(200, 40, 40)
			end
		end
		task.delay(0.12, function()
			for _, p in ipairs(v.parts) do
				p.Color = p:GetAttribute("C0")
			end
		end)
	end)
	views[monster] = v
end

local function rayParams(v)
	local p = RaycastParams.new()
	p.FilterType = Enum.RaycastFilterType.Exclude
	local list = { v.monster, folder }
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl.Character then
			table.insert(list, pl.Character)
		end
	end
	p.FilterDescendantsInstances = list
	p.IgnoreWater = true
	return p
end

local function seg(_, a, b)
	local len = (b - a).Magnitude
	if len < 0.01 then
		return CFrame.new(a)
	end
	return CFrame.lookAt(a, b) * CFrame.new(0, 0, -len / 2)
end

local function solveKnee(hip, foot, out)
	local dir = foot - hip
	local d = math.clamp(dir.Magnitude, 0.5, L1 + L2 - 0.05)
	local u = dir.Unit
	local a = (L1 * L1 - L2 * L2 + d * d) / (2 * d)
	local h = math.sqrt(math.max(0, L1 * L1 - a * a))
	local pole = UP + out
	local perp = pole - u * pole:Dot(u)
	if perp.Magnitude < 0.01 then
		perp = UP
	end
	return hip + u * a + perp.Unit * h, hip + u * d
end

local function update(v, dt)
	local root = v.root
	if not root.Parent then
		return
	end
	v.t += dt
	local cf = root.CFrame
	local vel = root.AssemblyLinearVelocity * V(1, 0, 1)
	local speed = vel.Magnitude
	local params = v.params

	-- сколько места по бокам (раз в 0.2 c)
	v.roomT -= dt
	if v.roomT <= 0 or not params then
		v.roomT = 0.2
		params = rayParams(v)
		v.params = params
		for side = -1, 1, 2 do
			local r = workspace:Raycast(cf.Position, cf.RightVector * side * 14, params)
			local room = r and (r.Position - cf.Position).Magnitude or 14
			v.room[side] = math.clamp(room - 1.6, 3.4, 9)
		end
	end

	-- тело: покачивание и дыхание, выпад при атаке
	local lunge = 0
	if v.attackT then
		v.attackT += dt / 0.45
		if v.attackT >= 1 then
			v.attackT = nil
		else
			lunge = math.sin(v.attackT * math.pi)
		end
	end
	local bob = math.sin(v.t * (speed > 1 and 9 or 2)) * (speed > 1 and 0.25 or 0.12)
	local bodyCF = cf * CFrame.new(0, bob, -lunge * 2) * CFrame.Angles(lunge * 0.25, 0, math.sin(v.t * 4.5) * 0.03 * math.min(speed, 10) / 10)
	local parts, cfs = {}, {}
	local function put(p, c)
		table.insert(parts, p)
		table.insert(cfs, c)
	end
	for _, b in ipairs(v.body) do
		put(b.part, bodyCF * b.cf)
	end

	-- ноги
	local stepping = { [0] = 0, [1] = 0 }
	for _, leg in ipairs(v.legs) do
		if leg.stepT then
			stepping[leg.group] += 1
		end
	end
	local stepLen = speed > 12 and 5 or 3.6
	local stepTime = speed > 12 and 0.13 or 0.2
	for _, leg in ipairs(v.legs) do
		local out = v.room[leg.side]
		local hip = (bodyCF * CFrame.new(leg.side * 2.4, 1.8, leg.z)).Position
		-- где нога хочет стоять
		local restLocal = V(leg.side * out, 0, leg.z * 1.45)
		local rest = (cf * CFrame.new(restLocal)).Position + vel * 0.12
		local flat = V(rest.X, cf.Position.Y, rest.Z)
		local toRest = flat - cf.Position
		local r = toRest.Magnitude > 0.1 and workspace:Raycast(cf.Position, toRest, params)
		if r then
			flat = r.Position - toRest.Unit * 1.2
		end
		local g = workspace:Raycast(flat + V(0, 1, 0), V(0, -14, 0), params)
		local target = g and g.Position or (flat - V(0, GROUND, 0))
		if not leg.foot then
			leg.foot = target
		end
		if not leg.stepT and stepping[1 - leg.group] == 0 and (leg.foot - target).Magnitude > stepLen then
			leg.stepT, leg.from = 0, leg.foot
			stepping[leg.group] += 1
		end
		local foot = leg.foot
		if leg.stepT then
			leg.stepT += dt / stepTime
			local a = math.min(1, leg.stepT)
			foot = leg.from:Lerp(target, a) + V(0, math.sin(a * math.pi) * 2.6, 0)
			if a >= 1 then
				leg.stepT = nil
				leg.foot = target
				foot = target
			end
		end
		-- передние ноги поднимаются для удара
		if lunge > 0 and leg.z == HIPS[1] then
			foot = foot:Lerp((bodyCF * CFrame.new(leg.side * 2, 5, -9)).Position, lunge)
		end
		local outDir = cf.RightVector * leg.side * (out / 9) * 0.7
		local knee, tip = solveKnee(hip, foot, outDir)
		put(leg.femur, seg(leg.femur, hip, knee))
		put(leg.tibia, seg(leg.tibia, knee, tip))
		put(leg.knee, CFrame.new(knee))
		put(leg.hip, CFrame.new(hip))
		put(leg.claw, seg(leg.claw, tip + V(0, 1.4, 0) + (tip - knee).Unit * 0.2, tip - V(0, 0.4, 0)))
		put(leg.spike, CFrame.lookAt(knee, knee + UP + outDir) * CFrame.new(0, 0, -0.8))
	end

	-- хвост: загибается вверх и вперёд, жало покачивается
	local p = (bodyCF * CFrame.new(0, 3.2, 6.2)).Position
	local back = bodyCF.LookVector * -1
	for k, part in ipairs(v.tail) do
		local ang = k * 0.32 + math.sin(v.t * 2 + k * 0.6) * 0.08 + lunge * 0.4
		local dir = (back * math.cos(ang) + UP * math.sin(ang) * 1.3).Unit
		if k > 5 then
			dir = (dir - back * (k - 5) * 0.6).Unit
		end
		local q = p + dir * 1.6
		put(part, seg(part, p, q))
		p = q
	end
	put(v.sting, CFrame.lookAt(p, p + (bodyCF.LookVector + UP * 0.3).Unit) * CFrame.new(0, 0, -1.1))

	workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
end

local function fade(v, mode)
	if v.dying then
		return
	end
	v.dying = true
	local t0 = os.clock()
	local dur = mode == "retreat" and 2.5 or 1.2
	task.spawn(function()
		while v.model.Parent do
			local a = math.min(1, (os.clock() - t0) / dur)
			for _, p in ipairs(v.parts) do
				p.Transparency = a
			end
			if a >= 1 then
				break
			end
			RunService.RenderStepped:Wait()
		end
	end)
end

function MonsterView.start()
	local function added(monster)
		if monster:IsA("Model") and not views[monster] then
			task.spawn(function()
				local ok, err = pcall(build, monster)
				if not ok then
					warn("[Labyrinth] MonsterView:", err)
				end
			end)
		end
	end
	for _, m in ipairs(CollectionService:GetTagged("Monster")) do
		added(m)
	end
	CollectionService:GetInstanceAddedSignal("Monster"):Connect(added)
	RunService.RenderStepped:Connect(function(dt)
		local cam = workspace.CurrentCamera
		for monster, v in pairs(views) do
			if not monster.Parent then
				v.model:Destroy()
				views[monster] = nil
			else
				if monster:GetAttribute("Dead") then
					fade(v, monster:GetAttribute("Dead"))
				end
				local far = cam and (v.root.Position - cam.CFrame.Position).Magnitude > 400
				if not far then
					local ok, err = pcall(update, v, dt)
					if not ok and not v.warned then
						v.warned = true
						warn("[Labyrinth] MonsterView:", err)
					end
				end
			end
		end
	end)
end

return MonsterView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">Radial</string>
            <string name="Source"><![CDATA[-- Круговое меню (как в Rust): кольцо из секторов, выбран тот, на который смотрит мышь.
-- Отпусти клавишу или нажми ЛКМ — выбор применяется.

local UserInputService = game:GetService("UserInputService")

local Radial = {}

local RGB = Color3.fromRGB
local V2 = Vector2.new

local root, center, centerTitle, centerSub, modal
local segs = {}
local options, onPick, selected

function Radial.init(gui)
	root = Instance.new("Frame")
	root.Name = "Radial"
	root.AnchorPoint = V2(0.5, 0.5)
	root.Position = UDim2.fromScale(0.5, 0.5)
	root.Size = UDim2.fromOffset(420, 420)
	root.BackgroundTransparency = 1
	root.Visible = false
	root.ZIndex = 30
	root.Parent = gui
	center = Instance.new("Frame")
	center.AnchorPoint = V2(0.5, 0.5)
	center.Position = UDim2.fromScale(0.5, 0.5)
	center.Size = UDim2.fromOffset(150, 150)
	center.BackgroundColor3 = RGB(16, 18, 22)
	center.BackgroundTransparency = 0.15
	center.ZIndex = 30
	center.Parent = root
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(1, 0)
	c.Parent = center
	local stroke = Instance.new("UIStroke")
	stroke.Color = RGB(200, 210, 160)
	stroke.Thickness = 2
	stroke.Parent = center
	centerTitle = Instance.new("TextLabel")
	centerTitle.Size = UDim2.new(1, -16, 0, 50)
	centerTitle.Position = UDim2.fromOffset(8, 30)
	centerTitle.BackgroundTransparency = 1
	centerTitle.Font = Enum.Font.GothamBlack
	centerTitle.TextSize = 17
	centerTitle.TextWrapped = true
	centerTitle.TextColor3 = RGB(245, 240, 220)
	centerTitle.ZIndex = 31
	centerTitle.Parent = center
	centerSub = Instance.new("TextLabel")
	centerSub.Size = UDim2.new(1, -16, 0, 50)
	centerSub.Position = UDim2.fromOffset(8, 80)
	centerSub.BackgroundTransparency = 1
	centerSub.Font = Enum.Font.Gotham
	centerSub.TextSize = 12
	centerSub.TextWrapped = true
	centerSub.TextColor3 = RGB(200, 200, 190)
	centerSub.ZIndex = 31
	centerSub.Parent = center
	-- кнопка-«модал» освобождает мышь в виде от первого лица
	modal = Instance.new("TextButton")
	modal.Size = UDim2.fromScale(1, 1)
	modal.BackgroundTransparency = 1
	modal.Text = ""
	modal.Modal = true
	modal.ZIndex = 29
	modal.Parent = root
	modal.MouseButton1Click:Connect(function()
		Radial.confirm()
	end)
end

function Radial.isOpen()
	return root and root.Visible
end

-- opts: { {label=, sub=, color=}, ... }
function Radial.open(opts, pick)
	if not root then
		return
	end
	for _, s in ipairs(segs) do
		s:Destroy()
	end
	segs = {}
	options, onPick, selected = opts, pick, nil
	local n = #opts
	for k, o in ipairs(opts) do
		-- сектор: «треугольник» — повёрнутая плашка, смотрящая от центра
		local a = (k - 1) / n * math.pi * 2 - math.pi / 2
		local f = Instance.new("TextButton")
		f.AutoButtonColor = false
		f.AnchorPoint = V2(0.5, 0.5)
		f.Position = UDim2.new(0.5, math.cos(a) * 150, 0.5, math.sin(a) * 150)
		f.Size = UDim2.fromOffset(n > 6 and 104 or 120, 64)
		f.BackgroundColor3 = o.color or RGB(40, 44, 50)
		f.BackgroundTransparency = 0.2
		f.Font = Enum.Font.GothamBold
		f.TextSize = 13
		f.TextWrapped = true
		f.TextColor3 = RGB(240, 240, 235)
		f.Text = o.label
		f.ZIndex = 31
		f.Parent = root
		local cr = Instance.new("UICorner")
		cr.CornerRadius = UDim.new(0, 10)
		cr.Parent = f
		local st = Instance.new("UIStroke")
		st.Thickness = 0
		st.Color = RGB(255, 230, 120)
		st.Parent = f
		-- «остриё» треугольника к центру
		local tip = Instance.new("Frame")
		tip.AnchorPoint = V2(0.5, 0.5)
		tip.Size = UDim2.fromOffset(16, 16)
		tip.Rotation = 45
		tip.Position = UDim2.new(0.5, -math.cos(a) * 40, 0.5, -math.sin(a) * 40)
		tip.BackgroundColor3 = o.color or RGB(40, 44, 50)
		tip.BackgroundTransparency = 0.2
		tip.ZIndex = 30
		tip.Parent = f
		f.MouseButton1Click:Connect(function()
			selected = k
			Radial.confirm()
		end)
		table.insert(segs, f)
	end
	root.Visible = true
end

function Radial.close()
	if root then
		root.Visible = false
	end
	options, onPick = nil, nil
end

function Radial.confirm()
	local o, pick, k = options, onPick, selected
	Radial.close()
	if o and pick and k and o[k] then
		pick(k, o[k])
	end
end

function Radial.update()
	if not Radial.isOpen() or not options then
		return
	end
	local mouse = UserInputService:GetMouseLocation()
	local abs = root.AbsolutePosition + root.AbsoluteSize / 2
	local d = mouse - abs
	selected = nil
	if d.Magnitude > 50 then
		local a = math.atan2(d.Y, d.X) + math.pi / 2
		local n = #options
		selected = math.floor((a / (math.pi * 2)) * n + 0.5) % n + 1
	end
	for k, f in ipairs(segs) do
		local on = k == selected
		f.UIStroke.Thickness = on and 3 or 0
		f.BackgroundTransparency = on and 0 or 0.25
		f.Size = on and UDim2.fromOffset(#segs > 6 and 116 or 132, 72) or UDim2.fromOffset(#segs > 6 and 104 or 120, 64)
	end
	local o = selected and options[selected]
	centerTitle.Text = o and o.label or "Наведи мышь"
	centerSub.Text = o and (o.sub or "") or ""
end

return Radial
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Viewmodel</string>
            <string name="Source"><![CDATA[-- Руки от первого лица — это копии рук твоего персонажа (с футболкой и цветом кожи).
-- Анимации: кирка бьёт сверху вниз, топор рубит наискось, меч рубит вбок, копьё колет вперёд,
-- кулаки бьют по очереди, факел просто держится. Покачивание при ходьбе и инерция поворота.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ItemModels = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ItemModels"))
local Items = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Items"))

local player = Players.LocalPlayer

local Viewmodel = {}

local V = Vector3.new
local RGB = Color3.fromRGB

local vm -- модель с руками
local arms = { right = {}, left = {} } -- списки {part, len}
local armLen = { right = 2.4, left = 2.4 }
local itemModel, itemId
local swingT, swingKind, punchLeft
local equipT = 1
local cardT, cardPart
local sway = CFrame.new()
local lastCam
local bobT = 0

local R15 = { right = { "RightUpperArm", "RightLowerArm", "RightHand" }, left = { "LeftUpperArm", "LeftLowerArm", "LeftHand" } }
local R6 = { right = { "Right Arm" }, left = { "Left Arm" } }

local function prep(p)
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Massless = true
	for _, d in ipairs(p:GetChildren()) do
		if d:IsA("Motor6D") or d:IsA("Attachment") or d:IsA("Weld") or d:IsA("WeldConstraint") then
			d:Destroy()
		end
	end
end

function Viewmodel.rebuild()
	if vm then
		vm:Destroy()
	end
	vm = Instance.new("Model")
	vm.Name = "Viewmodel"
	arms = { right = {}, left = {} }
	local char = player.Character
	local names = char and (char:FindFirstChild("RightUpperArm") and R15 or R6)
	local ok = false
	if char and names then
		ok = pcall(function()
			for _, side in ipairs({ "right", "left" }) do
				local total = 0
				for _, n in ipairs(names[side]) do
					local src = char:FindFirstChild(n)
					if not src then
						error("нет части " .. n)
					end
					src.Archivable = true
					local c = src:Clone()
					prep(c)
					c.Parent = vm
					table.insert(arms[side], { part = c, len = c.Size.Y })
					total += c.Size.Y
				end
				armLen[side] = total
			end
			-- одежда и цвет кожи применяются через Humanoid
			local hum = Instance.new("Humanoid")
			hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
			hum.Parent = vm
			for _, cls in ipairs({ "Shirt", "BodyColors" }) do
				local src = char:FindFirstChildOfClass(cls)
				if src then
					src.Archivable = true
					src:Clone().Parent = vm
				end
			end
		end)
	end
	if not ok then
		-- запасные квадратные руки
		for _, d in ipairs(vm:GetChildren()) do
			d:Destroy()
		end
		arms = { right = {}, left = {} }
		for _, side in ipairs({ "right", "left" }) do
			local p = Instance.new("Part")
			p.Size = V(1, 2.2, 1)
			p.Color = RGB(230, 190, 150)
			p.Material = Enum.Material.SmoothPlastic
			prep(p)
			p.Parent = vm
			arms[side] = { { part = p, len = 2.2 } }
			armLen[side] = 2.2
		end
	end
	vm.Parent = workspace.CurrentCamera
	if itemId then
		Viewmodel.setItem(itemId, true)
	end
end

function Viewmodel.setItem(id, silent)
	if itemModel then
		itemModel:Destroy()
		itemModel = nil
	end
	itemId = id
	if id and id ~= "fists" and vm then
		itemModel = ItemModels.build(id)
		itemModel.Parent = vm
	end
	if not silent then
		equipT = 0
	end
end

local function kindOf()
	local d = itemId and Items.Tools[itemId]
	return d and d.Kind or "fists"
end

-- удар; kind можно передать для добычи на E (инструмент выбирается автоматически)
function Viewmodel.swing(kind)
	if swingT then
		return false
	end
	kind = kind or kindOf()
	if kind == "torch" or kind == "blueprint" or kind == "held" or kind == "deploy" then
		return false
	end
	if kind == "hammer" then
		kind = "axe"
	end
	swingT, swingKind = 0, kind
	punchLeft = not punchLeft
	return true
end

-- достать ключ-карту из кармана и приложить к считывателю
function Viewmodel.card()
	cardT = 0
	if cardPart then
		cardPart:Destroy()
	end
	local c = Instance.new("Part")
	c.Name = "KeyCard"
	c.Size = Vector3.new(1.1, 0.06, 1.6)
	c.Color = RGB(240, 240, 235)
	c.Material = Enum.Material.SmoothPlastic
	c.Anchored = true
	c.CanCollide = false
	c.CanQuery = false
	c.CastShadow = false
	local stripe = Instance.new("Part")
	stripe.Name = "Stripe"
	stripe.Size = Vector3.new(1.12, 0.07, 0.3)
	stripe.Color = RGB(255, 200, 60)
	stripe.Material = Enum.Material.Neon
	stripe.Anchored = true
	stripe.CanCollide = false
	stripe.CanQuery = false
	stripe.Parent = c
	c.Parent = vm or workspace.CurrentCamera
	cardPart = c
end

local function setVisible(on)
	if not vm then
		return
	end
	for _, d in ipairs(vm:GetDescendants()) do
		if d:IsA("BasePart") then
			if d:GetAttribute("T0") == nil then
				d:SetAttribute("T0", d.Transparency)
			end
			d.Transparency = on and d:GetAttribute("T0") or 1
			d.LocalTransparencyModifier = 0
		elseif d:IsA("Light") or d:IsA("Fire") then
			d.Enabled = on
		end
	end
end

local function smooth01(a)
	return a * a * (3 - 2 * a)
end

local function ease(a)
	return a * a * (3 - 2 * a)
end

-- поза удара: rot — поворот плеча, push — сдвиг (для копья/кулаков)
local function pose(kind, t)
	if not t then
		return CFrame.new(), CFrame.new()
	end
	if kind == "pickaxe" or kind == "axe" then
		local a
		if t < 0.35 then
			a = 1.0 * ease(t / 0.35) -- замах вверх
		elseif t < 0.55 then
			a = 1.0 - 1.9 * ease((t - 0.35) / 0.2) -- удар вниз
		else
			a = -0.9 * (1 - ease((t - 0.55) / 0.45))
		end
		local roll = kind == "axe" and a * 0.45 or 0
		return CFrame.Angles(a, kind == "axe" and -a * 0.25 or 0, roll), CFrame.new()
	elseif kind == "sword" then
		local y
		if t < 0.3 then
			y = -1.1 * ease(t / 0.3) -- отвести вправо
		elseif t < 0.55 then
			y = -1.1 + 2.4 * ease((t - 0.3) / 0.25) -- рубануть влево
		else
			y = 1.3 * (1 - ease((t - 0.55) / 0.45))
		end
		return CFrame.Angles(0.25, y, -y * 0.35), CFrame.new()
	elseif kind == "spear" then
		local z
		if t < 0.3 then
			z = 0.6 * ease(t / 0.3) -- отвести назад
		elseif t < 0.5 then
			z = 0.6 - 3.2 * ease((t - 0.3) / 0.2) -- выпад вперёд
		else
			z = -2.6 * (1 - ease((t - 0.5) / 0.5))
		end
		return CFrame.new(), CFrame.new(0, 0, z)
	else -- кулаки
		local z = -1.6 * math.sin(math.min(t, 1) * math.pi)
		return CFrame.Angles(0.1, 0, 0), CFrame.new(0, 0.2, z)
	end
end

-- как предмет лежит в ладони (рукоять снизу, рабочая часть вверх-вперёд в кадре)
local function hold(kind)
	if kind == "pickaxe" then
		return CFrame.Angles(math.rad(-125), 0, 0) * CFrame.new(0, -0.9, 0)
	elseif kind == "axe" then
		return CFrame.Angles(math.rad(-125), 0, 0) * CFrame.new(0, -0.8, 0)
	elseif kind == "sword" then
		return CFrame.Angles(math.rad(-105), 0, 0) * CFrame.new(0, -0.15, 0)
	elseif kind == "spear" then
		return CFrame.Angles(math.pi, 0, 0) * CFrame.new(0, -2.6, 0)
	elseif kind == "torch" or kind == "blueprint" or kind == "held" then
		return CFrame.Angles(math.rad(-100), 0, 0) * CFrame.new(0, -0.3, 0)
	elseif kind == "hammer" then
		return CFrame.Angles(math.rad(-125), 0, 0) * CFrame.new(0, -0.6, 0)
	end
	return CFrame.new()
end

local function placeArm(side, shoulder)
	local y = 0
	for _, seg in ipairs(arms[side]) do
		seg.part.CFrame = shoulder * CFrame.new(0, -(y + seg.len / 2), 0)
		y += seg.len
	end
	return shoulder * CFrame.new(0, -armLen[side] + 0.3, 0)
end

-- вызывать каждый кадр ПОСЛЕ камеры
function Viewmodel.update(dt, visible, moving, sprinting)
	if not vm or vm.Parent ~= workspace.CurrentCamera then
		Viewmodel.rebuild()
	end
	visible = visible or cardT ~= nil
	setVisible(visible)
	if not visible then
		return
	end
	local camCF = workspace.CurrentCamera.CFrame

	if lastCam then
		local x, y = camCF:ToObjectSpace(lastCam):ToEulerAnglesXYZ()
		sway = sway:Lerp(CFrame.Angles(math.clamp(x, -0.12, 0.12) * 0.5, math.clamp(y, -0.12, 0.12) * 0.5, 0), 0.25)
	end
	lastCam = camCF
	sway = sway:Lerp(CFrame.new(), math.min(1, dt * 6))

	bobT += dt * (moving and (sprinting and 12 or 8) or 1.4)
	local amp = moving and (sprinting and 0.11 or 0.06) or 0.012
	local bob = CFrame.new(math.cos(bobT) * amp, math.abs(math.sin(bobT)) * amp * 1.2, 0) * CFrame.Angles(0, 0, sprinting and math.cos(bobT) * 0.04 or 0)

	equipT = math.min(1, equipT + dt * 4)
	local eq = 1 - (1 - equipT) ^ 3
	local equipOff = CFrame.new(0, -(1 - eq) * 1.8, 0) * CFrame.Angles(-(1 - eq) * 0.7, 0, 0)

	if swingT then
		swingT += dt / 0.42
		if swingT >= 1 then
			swingT = nil
		end
	end
	local kind = swingT and swingKind or kindOf()
	local rot, push = pose(kind, swingT)
	local base = camCF * sway * bob * equipOff

	-- руки: ось -Y части направлена от плеча к кисти; поворот на ~78° вокруг X направляет руку вперёд
	local rAim, lAim
	-- руки подняты так, чтобы кисти всегда были в кадре
	if kind == "spear" then
		rAim = CFrame.Angles(math.rad(92), math.rad(-6), 0)
		lAim = CFrame.Angles(math.rad(94), math.rad(18), 0)
	elseif kind == "fists" then
		rAim = CFrame.Angles(math.rad(96), math.rad(-14), 0)
		lAim = CFrame.Angles(math.rad(96), math.rad(14), 0)
	else
		rAim = CFrame.Angles(math.rad(92), math.rad(-14), 0)
		lAim = CFrame.Angles(math.rad(86), math.rad(22), 0)
	end
	local rPush, lPush = push, CFrame.new()
	if kind == "fists" and swingT and punchLeft then
		rPush, lPush = CFrame.new(), push
	end
	local rShoulder = base * CFrame.new(1.0, -1.15, 0.35) * rPush * (kind == "fists" and CFrame.new() or rot) * rAim
	local lShoulder = base * CFrame.new(-1.0, -1.2, 0.35) * lPush * (kind == "spear" and push or CFrame.new()) * lAim
	local grip = placeArm("right", rShoulder)
	placeArm("left", lShoulder)

	if cardT then
		-- рука идёт снизу из кармана, вытягивается вперёд и прикладывает карту
		cardT += dt / 1.6
		local up = smooth01(math.min(1, cardT / 0.45))
		local poke = cardT > 0.55 and math.sin(math.min(1, (cardT - 0.55) / 0.35) * math.pi) * 0.6 or 0
		local sh = base * CFrame.new(0.7, -1.6 + up * 0.55, 0.2 - poke) * CFrame.Angles(math.rad(40 + 58 * up), math.rad(-22 * up), 0)
		local g = placeArm("right", sh)
		if itemModel then
			for _, d in ipairs(itemModel:GetDescendants()) do
				if d:IsA("BasePart") then
					d.LocalTransparencyModifier = 1
				end
			end
		end
		if cardPart then
			cardPart.CFrame = g * CFrame.new(0, -0.4, -0.2) * CFrame.Angles(0, 0, math.rad(90))
			local stripe = cardPart:FindFirstChild("Stripe")
			if stripe then
				stripe.CFrame = cardPart.CFrame * CFrame.new(0, 0, -0.5)
			end
		end
		if cardT >= 1 then
			cardT = nil
			if cardPart then
				cardPart:Destroy()
				cardPart = nil
			end
		end
		return
	end
	if itemModel then
		itemModel:PivotTo(grip * hold(kindOf()))
	end
end

return Viewmodel
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="25">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>