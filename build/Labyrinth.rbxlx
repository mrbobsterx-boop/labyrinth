      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Building</string>
          <string name="Source"><![CDATA[-- Строительство как в Rust: сетка 8x8, фундамент, стены, проём с дверью, окно,
-- перекрытие и лестница. Ставятся чертежом (из досок), улучшаются молотком:
-- чертёж → дерево → камень → металл.
-- Здесь общие для сервера и клиента вещи: список деталей, уровни и привязка к сетке.

local Building = {}

local V = Vector3.new
local RGB = Color3.fromRGB

Building.Grid = 8
Building.WallH = 8
local G = Building.Grid

Building.Pieces = {
	{ Id = "foundation", Name = "Фундамент", Cost = { planks = 6 }, Size = V(8, 3, 8) },
	{ Id = "wall", Name = "Стена", Cost = { planks = 4 }, Size = V(8, 8, 0.8), Edge = true },
	{ Id = "doorway", Name = "Дверной проём", Cost = { planks = 5 }, Size = V(8, 8, 0.8), Edge = true },
	{ Id = "door", Name = "Дверь (в проём)", Cost = { planks = 3 }, Size = V(3.6, 6.2, 0.4), Door = true },
	{ Id = "window", Name = "Стена с окном", Cost = { planks = 4 }, Size = V(8, 8, 0.8), Edge = true },
	{ Id = "floor", Name = "Перекрытие / крыша", Cost = { planks = 4 }, Size = V(8, 0.8, 8) },
	{ Id = "stairs", Name = "Лестница", Cost = { planks = 5 }, Size = V(7.6, 8, 8) },
}
Building.ById = {}
for i, p in ipairs(Building.Pieces) do
	p.Index = i
	Building.ById[p.Id] = p
end

Building.Tiers = {
	[0] = { Name = "Чертёж", Color = RGB(214, 190, 136), Material = Enum.Material.WoodPlanks, HP = 40, Frame = RGB(160, 124, 78), FrameMat = Enum.Material.Wood },
	[1] = { Name = "Дерево", Color = RGB(150, 104, 62), Material = Enum.Material.WoodPlanks, HP = 150, Cost = { wood = 6 }, Frame = RGB(84, 56, 32), FrameMat = Enum.Material.Wood },
	[2] = { Name = "Камень", Color = RGB(146, 142, 132), Material = Enum.Material.Cobblestone, HP = 400, Cost = { stone = 8 }, Frame = RGB(104, 100, 94), FrameMat = Enum.Material.Slate },
	[3] = { Name = "Металл", Color = RGB(112, 118, 126), Material = Enum.Material.DiamondPlate, HP = 900, Cost = { iron = 4 }, Frame = RGB(62, 66, 72), FrameMat = Enum.Material.Metal },
}

-- CFrame детали по параметрам привязки
-- cell-детали: {cx, cz, y, rot}; y — поверхность, на которую ставим (у фундамента — его верх)
-- edge-детали: {ex, ez, axis, y}
function Building.cframe(id, O, a)
	if id == "foundation" then
		return CFrame.new(O + V((a.cx + 0.5) * G, a.y - 1.5, (a.cz + 0.5) * G))
	elseif id == "floor" then
		return CFrame.new(O + V((a.cx + 0.5) * G, a.y + 0.4, (a.cz + 0.5) * G))
	elseif id == "stairs" then
		return CFrame.new(O + V((a.cx + 0.5) * G, a.y + 4, (a.cz + 0.5) * G)) * CFrame.Angles(0, (a.rot or 0) * math.pi / 2, 0)
	else
		if id == "door" then
			return Building.cframe("wall", O, a) * CFrame.new(0, -0.9, 0)
		end
		if a.axis == "X" then
			return CFrame.new(O + V((a.ex + 0.5) * G, a.y + 4, a.ez * G))
		else
			return CFrame.new(O + V(a.ex * G, a.y + 4, (a.ez + 0.5) * G)) * CFrame.Angles(0, math.pi / 2, 0)
		end
	end
end

-- уникальный ключ места (две детали в одно место поставить нельзя)
function Building.key(id, a)
	local y = math.floor(a.y * 2 + 0.5)
	if id == "door" then
		return "D:" .. a.ex .. ":" .. a.ez .. ":" .. a.axis .. ":" .. y
	elseif Building.ById[id].Edge then
		return "E:" .. a.ex .. ":" .. a.ez .. ":" .. a.axis .. ":" .. y
	elseif id == "stairs" then
		return "S:" .. a.cx .. ":" .. a.cz .. ":" .. y
	else
		return "C:" .. a.cx .. ":" .. a.cz .. ":" .. y
	end
end

-- верх детали — сюда ставится следующая
function Building.top(id, a)
	if id == "foundation" then
		return a.y
	elseif id == "floor" then
		return a.y + 0.8
	else
		return a.y + Building.WallH
	end
end

local function pieceOf(inst)
	while inst and inst ~= workspace do
		if inst:IsA("Model") and inst:GetAttribute("BKind") then
			return inst
		end
		inst = inst.Parent
	end
end
Building.pieceOf = pieceOf

local function dominant(v)
	if math.abs(v.X) > math.abs(v.Z) then
		return v.X > 0 and 1 or -1, 0
	end
	return 0, v.Z > 0 and 1 or -1
end

-- куда встанет деталь, если смотреть в точку pos (hitInst — во что попали)
-- pieces — список уже стоящих деталей (Model с атрибутами)
function Building.snap(id, O, pos, hitInst, look, pieces)
	local piece = pieceOf(hitInst)
	local rel = pos - O
	local flat = V(look.X, 0, look.Z)
	flat = flat.Magnitude > 0.01 and flat.Unit or V(0, 0, -1)
	local pk = piece and piece:GetAttribute("BKind")
	local def = Building.ById[id]
	if id == "door" then
		if pk == "doorway" or pk == "door" then
			return { ex = piece:GetAttribute("EX"), ez = piece:GetAttribute("EZ"), axis = piece:GetAttribute("Axis"), y = piece:GetAttribute("Base") }
		end
		return nil
	elseif id == "foundation" then
		if pk == "foundation" then
			local dx, dz = dominant(flat)
			return { cx = piece:GetAttribute("CX") + dx, cz = piece:GetAttribute("CZ") + dz, y = piece:GetAttribute("Top") }
		end
		if piece then
			return nil
		end
		local cx, cz = math.floor(rel.X / G), math.floor(rel.Z / G)
		local y = pos.Y + 0.8
		-- рядом уже есть фундамент — встаём с ним вровень
		for _, p in ipairs(pieces) do
			if p:GetAttribute("BKind") == "foundation" then
				local px, pz = p:GetAttribute("CX"), p:GetAttribute("CZ")
				if math.abs(px - cx) + math.abs(pz - cz) == 1 and math.abs(p:GetAttribute("Top") - y) < 4 then
					y = p:GetAttribute("Top")
					break
				end
			end
		end
		return { cx = cx, cz = cz, y = y }
	elseif def.Edge then
		if pk == "foundation" or pk == "floor" then
			local cx, cz = piece:GetAttribute("CX"), piece:GetAttribute("CZ")
			local u, w = rel.X - cx * G, rel.Z - cz * G
			local y = piece:GetAttribute("Top")
			local best = math.min(u, G - u, w, G - w)
			if best == u then
				return { ex = cx, ez = cz, axis = "Z", y = y }
			elseif best == G - u then
				return { ex = cx + 1, ez = cz, axis = "Z", y = y }
			elseif best == w then
				return { ex = cx, ez = cz, axis = "X", y = y }
			else
				return { ex = cx, ez = cz + 1, axis = "X", y = y }
			end
		elseif pk and Building.ById[pk].Edge then
			-- стена на стену (второй этаж без перекрытия)
			return { ex = piece:GetAttribute("EX"), ez = piece:GetAttribute("EZ"), axis = piece:GetAttribute("Axis"), y = piece:GetAttribute("Top") }
		end
		return nil
	elseif id == "floor" then
		if pk and Building.ById[pk].Edge then
			local q = rel + flat * 4
			return { cx = math.floor(q.X / G), cz = math.floor(q.Z / G), y = piece:GetAttribute("Top") }
		elseif pk == "floor" then
			local dx, dz = dominant(flat)
			return { cx = piece:GetAttribute("CX") + dx, cz = piece:GetAttribute("CZ") + dz, y = piece:GetAttribute("Base") }
		end
		return nil
	elseif id == "stairs" then
		if pk == "foundation" or pk == "floor" then
			local dx, dz = dominant(flat)
			-- клин поднимается от игрока вперёд (высокий край клина — его +Z)
			local rot = (dz == -1 and 2) or (dx == -1 and 3) or (dz == 1 and 0) or 1
			return { cx = piece:GetAttribute("CX"), cz = piece:GetAttribute("CZ"), y = piece:GetAttribute("Top"), rot = rot }
		end
		return nil
	end
end

return Building
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- Настройки игры «ЛАБИРИНТ». Здесь меняется всё: размер лабиринта, длина дня и ночи, монстры.

local Config = {}

Config.GameTitle = "ЛАБИРИНТ"

-- Тестовые кнопки (полный свет, полёт, день/ночь, ресурсы). Перед публикацией поставь false!
Config.DevTools = true

Config.Maze = {
	Cells = 61, -- сетка 61 x 61 клеток, лабиринт круглый (как в фильме)
	Radius = 17, -- внутренний круг (обычные коридоры), в клетках
	OuterRadius = 29, -- внешнее кольцо: коридоры вдвое шире, стены выше (≈ 1850 studs в поперечнике)
	OuterWallHeight = 92,
	CellSize = 32, -- ширина коридора
	WallHeight = 56,
	WallThickness = 4,
	ClearingCells = 13, -- поляна в центре 13 x 13 клеток (416 x 416)
	ExtraOpenings = 0.07,
	Mines = 11,
	Chests = 42,
	Cracks = 44, -- узкие щели в стенах (пролезть можно только пригнувшись)
}
Config.GateWidth = 32
Config.SlotSpacing = 6000 -- у каждой группы свой лабиринт, далеко друг от друга

-- Сложность: выбирается лифтом в лобби
Config.Difficulty = {
	easy = { Name = "ЛЕГКО", Color = { 90, 200, 110 }, Day = 360, Night = 120, Monsters = 2, PerPlayer = 0.5, Damage = 14, Speed = 17, Health = 200, Coins = 1 },
	normal = { Name = "ОБЫЧНО", Color = { 230, 190, 70 }, Day = 300, Night = 150, Monsters = 4, PerPlayer = 1, Damage = 22, Speed = 19, Health = 260, Coins = 2 },
	hard = { Name = "ТЯЖЕЛО", Color = { 220, 70, 60 }, Day = 240, Night = 180, Monsters = 7, PerPlayer = 1.5, Damage = 30, Speed = 21, Health = 340, Coins = 3 },
}
Config.WarningTime = 30

-- Игрок
Config.WalkSpeed = 16
Config.SprintSpeed = 24
Config.CrouchSpeed = 7
Config.StaminaMax = 100
Config.StaminaDrain = 22
Config.StaminaRegen = 14
Config.BerryHeal = 20
Config.DownedTime = 45 -- сколько секунд раненый ждёт помощи
Config.ReviveHealth = 40

-- Монеты: за каждый прожитый день и за побег (умножаются на сложность)
Config.CoinsPerDay = 10
Config.CoinsEscape = 100

-- Классы у торговца в лобби
Config.Classes = {
	{ Id = "none", Name = "Без класса", Price = 0, Desc = "Обычный выживший." },
	{ Id = "runner", Name = "Бегун", Price = 100, Desc = "+30% скорость бега, +60 выносливости." },
	{ Id = "lumber", Name = "Лесоруб", Price = 120, Desc = "Начинает с каменным топором. Дерева в 2 раза больше." },
	{ Id = "miner", Name = "Шахтёр", Price = 150, Desc = "Начинает с каменной киркой. Добыча руды +50%." },
	{ Id = "warrior", Name = "Воин", Price = 250, Desc = "+40 здоровья. Начинает с копьём." },
}

-- Скрежетники — ночные монстры лабиринта (урон, скорость, здоровье — из сложности)
Config.Monster = {
	Name = "Скрежетник",
	AttackCooldown = 1.3,
	AttackRange = 7,
	PatrolSpeed = 10,
	SightRange = 110,
	HearRange = 35,
}

Config.Elevator = {
	Countdown = 15,
	RideTime = 9,
	MaxPlayers = 5,
}

Config.NodeRespawn = 90

Config.Sounds = {
	Hit = "rbxasset://sounds/action_jump_land.mp3",
	Swing = "rbxasset://sounds/swoosh.wav",
	Pickup = "rbxasset://sounds/electronicpingshort.wav",
	Click = "rbxasset://sounds/button.wav",
	Hurt = "rbxasset://sounds/uuhhh.mp3",
	Rumble = "rbxasset://sounds/action_falling.mp3",
	Step = "rbxasset://sounds/action_footsteps_plastic.mp3",
}

-- Музыка: спокойные треки по очереди, между ними тишина.
-- Если какой-то трек не играет — замени его ID на трек из Toolbox (вкладка Audio).
Config.Music = {
	Playlist = {
		"rbxassetid://87225814557507", -- Midnight Chorus
		"rbxassetid://114227963529142", -- Stellar Strings
		"rbxassetid://76744235703007", -- Aurora's Harp
		"rbxassetid://131749976124955", -- Twilight Crickets
		"rbxassetid://135250174849411", -- Celestial Whispers
		"rbxassetid://94680453165710", -- Ethereal Constellations
	},
	Pause = 20, -- секунд тишины между треками
	Volume = 0.4,
}

Config.Animations = {
	Walk = "rbxassetid://507777826",
	Run = "rbxassetid://507767714",
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Deployables</string>
          <string name="Source"><![CDATA[-- Модели предметов, которые ставятся в мир: верстак, кровать, сундук.
-- Одни и те же модели — и настоящие (сервер), и прозрачный предпросмотр (клиент).

local Deployables = {}

local V = Vector3.new
local RGB = Color3.fromRGB
local M = Enum.Material
local WOOD = RGB(92, 64, 40)

Deployables.Names = {
	workbench = "Верстак",
	bed = "Кровать",
	chest = "Сундук",
}

local function box(m, name, cf, size, color, material)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material
	p.Parent = m
	return p
end

-- cf — точка на земле, модель «смотрит» по -Z
function Deployables.build(id, cf)
	local m = Instance.new("Model")
	m.Name = id
	m.WorldPivot = cf
	if id == "workbench" then
		box(m, "Top", cf * CFrame.new(0, 3.45, 0), V(8, 0.5, 4), RGB(110, 80, 50), M.WoodPlanks)
		for _, x in ipairs({ -3.5, 3.5 }) do
			for _, z in ipairs({ -1.5, 1.5 }) do
				box(m, "Leg", cf * CFrame.new(x, 1.6, z), V(0.6, 3.2, 0.6), WOOD, M.Wood)
			end
		end
		box(m, "Shelf", cf * CFrame.new(0, 1, 0), V(7.4, 0.3, 3.4), WOOD, M.WoodPlanks)
		box(m, "Vise", cf * CFrame.new(3, 4.1, -1), V(1.1, 0.9, 1), RGB(70, 72, 76), M.Metal)
		box(m, "Saw", cf * CFrame.new(-1.7, 3.75, 0.9), V(2.5, 0.1, 0.8), RGB(170, 170, 175), M.Metal)
		box(m, "Hammer", cf * CFrame.new(0.8, 3.8, -1.05), V(1.6, 0.25, 0.3), WOOD, M.Wood)
	elseif id == "bed" then
		box(m, "Frame", cf * CFrame.new(0, 0.6, 0), V(4, 1.2, 7.5), RGB(100, 70, 44), M.Wood)
		box(m, "Mattress", cf * CFrame.new(0, 1.45, 0.2), V(3.6, 0.6, 7), RGB(200, 190, 170), M.Fabric)
		box(m, "Blanket", cf * CFrame.new(0, 1.8, 1.3), V(3.7, 0.25, 4.6), RGB(120, 50, 45), M.Fabric)
		box(m, "Pillow", cf * CFrame.new(0, 1.9, -2.6), V(2.6, 0.5, 1.2), RGB(235, 230, 220), M.Fabric)
		box(m, "Headboard", cf * CFrame.new(0, 2, -3.6), V(4, 2.8, 0.4), RGB(100, 70, 44), M.Wood)
	elseif id == "chest" then
		box(m, "Body", cf * CFrame.new(0, 1, 0), V(4.4, 2, 2.6), RGB(110, 76, 46), M.WoodPlanks)
		box(m, "Lid", cf * CFrame.new(0, 2.3, 0), V(4.6, 0.6, 2.8), RGB(90, 60, 36), M.WoodPlanks)
		box(m, "Lock", cf * CFrame.new(0, 1.9, -1.45), V(0.6, 0.7, 0.2), RGB(200, 170, 60), M.Metal)
	end
	return m
end

-- размер «коробки» для проверки, влезает ли предмет
Deployables.Size = {
	workbench = V(8, 4.4, 4),
	bed = V(4, 3, 7.6),
	chest = V(4.6, 2.6, 2.8),
}

return Deployables
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">ItemModels</string>
          <string name="Source"><![CDATA[-- 3D-модели инструментов и оружия. Используются и в руках персонажа (видят другие игроки),
-- и в виде от первого лица (руки игрока).
-- Модель строится вдоль оси Y: рукоять в начале координат, рабочая часть вверху.

local Items = require(script.Parent.Items)

local ItemModels = {}

local V = Vector3.new
local RGB = Color3.fromRGB
local WOOD = RGB(110, 76, 46)

local function part(model, name, size, cf, color, material)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.Anchored = true
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = model
	return p
end

-- build(id, base): base — CFrame рукояти. Возвращает Model с PrimaryPart "Grip".
function ItemModels.build(id, base)
	base = base or CFrame.new()
	local def = Items.Tools[id]
	local m = Instance.new("Model")
	m.Name = "Item_" .. id
	if not def or def.Kind == "fists" then
		local grip = part(m, "Grip", V(0.1, 0.1, 0.1), base, WOOD)
		grip.Transparency = 1
		m.PrimaryPart = grip
		return m
	end
	local c = def.Color and RGB(def.Color[1], def.Color[2], def.Color[3]) or RGB(150, 150, 150)
	local metal = (id:find("iron") or id:find("crystal")) and Enum.Material.Metal or Enum.Material.Slate
	if id:find("crystal") then
		metal = Enum.Material.Neon
	end

	if def.Kind == "pickaxe" then
		local grip = part(m, "Grip", V(0.25, 3.2, 0.25), base * CFrame.new(0, 1.2, 0), WOOD, Enum.Material.Wood)
		-- голова кирки лежит в плоскости удара (острия вперёд и назад)
		part(m, "Head", V(0.35, 0.35, 2.4), base * CFrame.new(0, 2.7, 0), c, metal)
		part(m, "Collar", V(0.45, 0.5, 0.45), base * CFrame.new(0, 2.7, 0), RGB(70, 60, 50), Enum.Material.Metal)
		for _, sz in ipairs({ -1, 1 }) do
			part(m, "Tip", V(0.22, 0.22, 0.7), base * CFrame.new(0, 2.55, sz * 1.4) * CFrame.Angles(math.rad(25 * sz), 0, 0), c, metal)
		end
		m.PrimaryPart = grip
	elseif def.Kind == "axe" then
		local grip = part(m, "Grip", V(0.25, 3, 0.25), base * CFrame.new(0, 1.1, 0), WOOD, Enum.Material.Wood)
		part(m, "Head", V(0.25, 1, 1.3), base * CFrame.new(0, 2.25, -0.55), c, metal)
		part(m, "Edge", V(0.12, 1.3, 0.25), base * CFrame.new(0, 2.25, -1.25), RGB(200, 200, 205), Enum.Material.Metal)
		m.PrimaryPart = grip
	elseif def.Kind == "sword" then
		local grip = part(m, "Grip", V(0.25, 0.9, 0.25), base * CFrame.new(0, 0.2, 0), RGB(50, 34, 24), Enum.Material.Wood)
		part(m, "Pommel", V(0.35, 0.25, 0.35), base * CFrame.new(0, -0.35, 0), c, metal)
		part(m, "Guard", V(1.1, 0.18, 0.3), base * CFrame.new(0, 0.72, 0), RGB(90, 80, 60), Enum.Material.Metal)
		local blade = part(m, "Blade", V(0.12, 3.3, 0.38), base * CFrame.new(0, 2.45, 0), c, metal)
		blade.Reflectance = 0.15
		part(m, "BladeTip", V(0.12, 0.45, 0.26), base * CFrame.new(0, 4.25, 0), c, metal)
		if id:find("crystal") then
			local l = Instance.new("PointLight")
			l.Color = c
			l.Range = 8
			l.Brightness = 1.2
			l.Parent = blade
		end
		m.PrimaryPart = grip
	elseif def.Kind == "spear" then
		local grip = part(m, "Grip", V(0.2, 6, 0.2), base * CFrame.new(0, 1.5, 0), WOOD, Enum.Material.Wood)
		part(m, "Tip", V(0.14, 1, 0.38), base * CFrame.new(0, 5, 0), c, metal)
		part(m, "Binding", V(0.28, 0.4, 0.28), base * CFrame.new(0, 4.4, 0), RGB(140, 120, 80), Enum.Material.Fabric)
		m.PrimaryPart = grip
	elseif def.Kind == "torch" then
		local grip = part(m, "Grip", V(0.28, 2.2, 0.28), base * CFrame.new(0, 0.6, 0), WOOD, Enum.Material.Wood)
		local head = part(m, "Flame", V(0.5, 0.55, 0.5), base * CFrame.new(0, 1.9, 0), RGB(255, 140, 40), Enum.Material.Neon)
		local l = Instance.new("PointLight")
		l.Color = RGB(255, 170, 90)
		l.Range = 26
		l.Brightness = 1.6
		l.Shadows = true
		l.Parent = head
		local fire = Instance.new("Fire")
		fire.Size = 2
		fire.Heat = 4
		fire.Parent = head
		m.PrimaryPart = grip
	end
	if def.Kind == "held" then
		local grip
		if def.Res == "key" then
			grip = part(m, "Grip", V(1, 1.5, 0.08), base * CFrame.new(0, 0.6, 0), RGB(240, 240, 235), Enum.Material.SmoothPlastic)
			part(m, "Stripe", V(1.02, 0.3, 0.1), base * CFrame.new(0, 1, 0), RGB(255, 200, 60), Enum.Material.Neon)
			part(m, "Chip", V(0.35, 0.3, 0.1), base * CFrame.new(-0.2, 0.45, 0), RGB(210, 170, 60), Enum.Material.Metal)
		elseif def.Res == "map" then
			grip = part(m, "Grip", V(0.5, 1.6, 0.5), base * CFrame.new(0, 0.6, 0), RGB(225, 210, 170), Enum.Material.SmoothPlastic)
			part(m, "Tie", V(0.55, 0.15, 0.55), base * CFrame.new(0, 0.6, 0), RGB(140, 50, 40), Enum.Material.Fabric)
		elseif def.Res == "bandage" then
			grip = part(m, "Grip", V(0.8, 0.7, 0.8), base * CFrame.new(0, 0.4, 0), RGB(235, 230, 220), Enum.Material.Fabric)
			part(m, "Cross", V(0.82, 0.25, 0.1), base * CFrame.new(0, 0.4, -0.38), RGB(210, 40, 40), Enum.Material.SmoothPlastic)
		else
			grip = part(m, "Grip", V(0.5, 0.5, 0.5), base * CFrame.new(0, 0.4, 0), c, Enum.Material.SmoothPlastic)
			for k = 0, 4 do
				local a = k / 5 * math.pi * 2
				part(m, "Berry", V(0.4, 0.4, 0.4), base * CFrame.new(math.cos(a) * 0.3, 0.55, math.sin(a) * 0.3), c, Enum.Material.SmoothPlastic)
			end
		end
		m.PrimaryPart = grip
	elseif def.Kind == "blueprint" then
		-- свёрнутый синий чертёж
		local grip = part(m, "Grip", V(0.5, 1.8, 0.5), base * CFrame.new(0, 0.5, 0), RGB(60, 100, 180), Enum.Material.Fabric)
		part(m, "Sheet", V(0.08, 1.6, 1.4), base * CFrame.new(0.3, 0.9, -0.5), RGB(90, 140, 220), Enum.Material.SmoothPlastic)
		part(m, "Line", V(0.1, 1.2, 0.06), base * CFrame.new(0.32, 0.9, -0.5), RGB(230, 240, 255), Enum.Material.Neon)
		m.PrimaryPart = grip
	elseif def.Kind == "hammer" then
		local grip = part(m, "Grip", V(0.25, 2.2, 0.25), base * CFrame.new(0, 0.8, 0), WOOD, Enum.Material.Wood)
		part(m, "Head", V(0.5, 0.5, 1.3), base * CFrame.new(0, 2, -0.1), c, Enum.Material.Metal)
		m.PrimaryPart = grip
	end
	-- точка опоры модели = рукоять (base), чтобы PivotTo ставил рукоять в руку
	if m.PrimaryPart then
		m.PrimaryPart.PivotOffset = m.PrimaryPart.CFrame:ToObjectSpace(base)
	end
	return m
end

return ItemModels
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Items</string>
          <string name="Source"><![CDATA[-- Ресурсы, инструменты, оружие и рецепты.

local Items = {}

Items.Resources = {
	wood = { Name = "Дерево", Order = 1 },
	stone = { Name = "Камень", Order = 2 },
	fiber = { Name = "Трава", Order = 3 },
	iron = { Name = "Железо", Order = 4 },
	crystal = { Name = "Кристалл", Order = 5 },
	fang = { Name = "Клык Скрежетника", Order = 6 },
	berry = { Name = "Ягоды (H — съесть)", Order = 7 },
	bandage = { Name = "Бинт (поднять друга)", Order = 8 },
	planks = { Name = "Доски", Order = 9 },
	map = { Name = "Карта лабиринта (Tab)", Order = 10 },
	key = { Name = "КЛЮЧ-КАРТА ВЫХОДА", Order = 11 },
}

-- Kind: pickaxe / axe / sword / spear / torch / blueprint / hammer / deploy. Tier — что может добывать.
Items.Tools = {
	fists = { Name = "Кулаки", Kind = "fists", Tier = 0, Damage = 5, Range = 7 },
	wood_pickaxe = { Name = "Деревянная кирка", Kind = "pickaxe", Tier = 1, Damage = 6, Range = 9, Color = { 120, 85, 50 } },
	stone_pickaxe = { Name = "Каменная кирка", Kind = "pickaxe", Tier = 2, Damage = 8, Range = 9, Color = { 120, 120, 125 } },
	iron_pickaxe = { Name = "Железная кирка", Kind = "pickaxe", Tier = 3, Damage = 11, Range = 9, Color = { 190, 190, 200 } },
	wood_axe = { Name = "Деревянный топор", Kind = "axe", Tier = 1, Damage = 9, Range = 9, Color = { 120, 85, 50 } },
	stone_axe = { Name = "Каменный топор", Kind = "axe", Tier = 2, Damage = 14, Range = 9, Color = { 120, 120, 125 } },
	spear = { Name = "Копьё", Kind = "spear", Tier = 0, Damage = 22, Range = 13, Color = { 120, 120, 125 } },
	stone_sword = { Name = "Каменный меч", Kind = "sword", Tier = 0, Damage = 26, Range = 9, Color = { 130, 130, 135 } },
	iron_sword = { Name = "Железный меч", Kind = "sword", Tier = 0, Damage = 40, Range = 9.5, Color = { 200, 200, 210 } },
	crystal_blade = { Name = "Кристальный клинок", Kind = "sword", Tier = 0, Damage = 65, Range = 10, Color = { 170, 90, 255 } },
	torch = { Name = "Факел", Kind = "torch", Tier = 0, Damage = 0, Range = 0, Color = { 255, 150, 60 } },
	blueprint = { Name = "Чертёж (строить)", Kind = "blueprint", Tier = 0, Damage = 0, Range = 0, Color = { 70, 110, 190 } },
	hammer = { Name = "Молоток (улучшать)", Kind = "hammer", Tier = 0, Damage = 4, Range = 10, Color = { 110, 110, 115 } },
	-- предметы, которые можно просто держать в руке (берутся из инвентаря, если есть)
	res_key = { Name = "Ключ-карта", Kind = "held", Res = "key", Tier = 0, Damage = 0, Range = 0, Color = { 240, 240, 235 } },
	res_map = { Name = "Карта (ЛКМ — открыть)", Kind = "held", Res = "map", Tier = 0, Damage = 0, Range = 0, Color = { 225, 210, 170 } },
	res_bandage = { Name = "Бинт", Kind = "held", Res = "bandage", Tier = 0, Damage = 0, Range = 0, Color = { 235, 230, 220 } },
	res_berry = { Name = "Ягоды (ЛКМ — съесть)", Kind = "held", Res = "berry", Tier = 0, Damage = 0, Range = 0, Color = { 200, 30, 50 } },
	deploy_workbench = { Name = "Верстак (поставить)", Kind = "deploy", Deploy = "workbench", Tier = 0, Damage = 0, Range = 0 },
	deploy_bed = { Name = "Кровать (поставить)", Kind = "deploy", Deploy = "bed", Tier = 0, Damage = 0, Range = 0 },
	deploy_chest = { Name = "Сундук (поставить)", Kind = "deploy", Deploy = "chest", Tier = 0, Damage = 0, Range = 0 },
}

-- Броня: надевается сама (лучшая из имеющихся), уменьшает урон
Items.Armor = {
	{ Id = "leather", Name = "Кожаная броня", Reduce = 0.2, Color = { 120, 82, 48 } },
	{ Id = "iron", Name = "Железная броня", Reduce = 0.4, Color = { 170, 172, 178 } },
	{ Id = "crystal", Name = "Кристальная броня", Reduce = 0.55, Color = { 160, 90, 240 } },
}

-- Station: nil — крафт из инвентаря (C), "bench" — нужен верстак рядом (Level — его уровень)
Items.Recipes = {
	{ Id = "deploy_workbench", Name = "Верстак", Cost = { wood = 12, stone = 4 } },
	{ Id = "bandage", Name = "Бинт", Cost = { fiber = 3 }, Res = "bandage" },
	{ Id = "torch", Cost = { wood = 3, fiber = 1 } },
	{ Id = "planks", Name = "Доски ×4", Cost = { wood = 3 }, Res = "planks", Amount = 4 },
	{ Id = "blueprint", Cost = { planks = 4 } },
	{ Id = "hammer", Cost = { wood = 3, stone = 2 } },
	{ Id = "deploy_bed", Name = "Кровать (ночью — проспать ночь)", Cost = { planks = 8, fiber = 6 } },
	{ Id = "deploy_chest", Name = "Сундук-хранилище", Cost = { planks = 10 } },
	{ Id = "stone_pickaxe", Station = "bench", Level = 1, Cost = { wood = 5, stone = 8 } },
	{ Id = "stone_axe", Station = "bench", Level = 1, Cost = { wood = 5, stone = 6 } },
	{ Id = "spear", Station = "bench", Level = 1, Cost = { wood = 8, stone = 3, fiber = 2 } },
	{ Id = "stone_sword", Station = "bench", Level = 1, Cost = { wood = 4, stone = 12 } },
	{ Id = "upgrade2", Station = "bench", Level = 1, Name = "Улучшить верстак до 2 уровня", Cost = { wood = 20, stone = 20, iron = 6 } },
	{ Id = "armor_leather", Name = "Кожаная броня (−20% урона)", Station = "bench", Level = 1, Cost = { fiber = 10, wood = 6, fang = 1 }, Armor = 1 },
	{ Id = "iron_pickaxe", Station = "bench", Level = 2, Cost = { wood = 6, iron = 10 } },
	{ Id = "armor_iron", Name = "Железная броня (−40% урона)", Station = "bench", Level = 2, Cost = { iron = 14, fiber = 4 }, Armor = 2 },
	{ Id = "armor_crystal", Name = "Кристальная броня (−55% урона)", Station = "bench", Level = 2, Cost = { crystal = 8, iron = 6, fang = 3 }, Armor = 3 },
	{ Id = "iron_sword", Station = "bench", Level = 2, Cost = { wood = 6, iron = 14 } },
	{ Id = "crystal_blade", Station = "bench", Level = 2, Cost = { iron = 8, crystal = 6, fang = 3 } },
}

-- Что добывается и чем
Items.Nodes = {
	tree = { Name = "Дерево", Tool = "axe", Tier = 1, Health = 40, Drop = "wood", Amount = 2, Action = "Рубить" },
	stone = { Name = "Камень", Tool = "pickaxe", Tier = 1, Health = 40, Drop = "stone", Amount = 2, Action = "Добыть" },
	iron = { Name = "Железная руда", Tool = "pickaxe", Tier = 2, Health = 60, Drop = "iron", Amount = 2, Action = "Добыть" },
	crystal = { Name = "Кристалл", Tool = "pickaxe", Tier = 3, Health = 80, Drop = "crystal", Amount = 2, Action = "Добыть" },
}

function Items.toolName(id)
	local t = Items.Tools[id]
	return t and t.Name or id
end

return Items
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="9">
        <Properties>
          <string name="Name">R6Animate</string>
          <string name="Source"><![CDATA[-- Анимации квадратного (R6) персонажа: стоять, идти, прыгать, падать.
-- Копируется в персонажа сервером (лежит в ReplicatedStorage и сам там не работает).

local char = script.Parent
if not char:IsA("Model") or not char:FindFirstChildOfClass("Humanoid") then
	return
end
local hum = char:FindFirstChildOfClass("Humanoid")
local animator = hum:FindFirstChildOfClass("Animator")
if not animator then
	animator = Instance.new("Animator")
	animator.Parent = hum
end

local function load(id, looped)
	local a = Instance.new("Animation")
	a.AnimationId = id
	local ok, track = pcall(function()
		return animator:LoadAnimation(a)
	end)
	if ok and track then
		track.Looped = looped
		return track
	end
	return nil
end

local idle = load("rbxassetid://180435571", true)
local walk = load("rbxassetid://180426354", true)
local jump = load("rbxassetid://125750702", false)
local fall = load("rbxassetid://180436148", true)

if idle then
	idle:Play()
end

hum.Running:Connect(function(speed)
	if speed > 0.5 then
		if walk and not walk.IsPlaying then
			walk:Play(0.2)
		end
		if walk then
			walk:AdjustSpeed(math.clamp(speed / 14, 0.5, 2))
		end
		if idle then
			idle:Stop(0.2)
		end
	else
		if walk then
			walk:Stop(0.2)
		end
		if idle and not idle.IsPlaying then
			idle:Play(0.2)
		end
	end
end)
hum.Jumping:Connect(function(active)
	if active and jump then
		jump:Play(0.1)
	end
end)
hum.FreeFalling:Connect(function(active)
	if fall then
		if active then
			fall:Play(0.2)
		else
			fall:Stop(0.2)
		end
	end
end)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="10">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="11">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Build</string>
          <string name="Source"><![CDATA[-- Постройки игроков: детали дома (по сетке), кровать, сундук.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Parts = require(script.Parent.Parts)
local Building = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Building"))
local Deployables = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Deployables"))

local Build = {}

local V = Vector3.new
local RGB = Color3.fromRGB
local M = Enum.Material

local function prompt(part, action, object, hold, dist)
	local p = Instance.new("ProximityPrompt")
	p.ActionText = action
	p.ObjectText = object or ""
	p.HoldDuration = hold or 0
	p.MaxActivationDistance = dist or 10
	p.RequiresLineOfSight = false
	p.Parent = part
	return p
end

-- украшения детали под уровень: рамка из брусьев, доски, раскосы, кладка, заклёпки
local function decorate(model, tier)
	local old = model:FindFirstChild("Deco")
	if old then
		old:Destroy()
	end
	local t = Building.Tiers[tier]
	local deco = Instance.new("Model")
	deco.Name = "Deco"
	local kind = model:GetAttribute("BKind")
	local function bit(cf, size, color, mat, shape)
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Size = size
		p.CFrame = cf
		p.Color = color
		p.Material = mat
		if shape then
			p.Shape = shape
		end
		p.Parent = deco
		return p
	end
	for _, core in ipairs(model:GetChildren()) do
		if core:IsA("Part") and core.Name ~= "Door" and core.Name ~= "Handle" and core.Name ~= "Bar" then
			-- плоскость детали: две длинные оси, третья — толщина
			local sz = core.Size
			local cf = core.CFrame
			local thinY = sz.Y < sz.X and sz.Y < sz.Z
			-- переводим в «стеновые» координаты: u — ширина, v — высота, w — толщина
			local base, u, v, w
			if thinY then
				base = cf * CFrame.Angles(math.pi / 2, 0, 0)
				u, v, w = sz.X, sz.Z, sz.Y
			else
				base = cf
				u, v, w = sz.X, sz.Y, sz.Z
			end
			local b = tier == 0 and 0.35 or (tier == 3 and 0.55 or 0.6)
			local depth = w + (tier == 0 and 0.15 or 0.3)
			local fc, fm = t.Frame, t.FrameMat
			-- рамка по краю
			bit(base * CFrame.new(0, v / 2 - b / 2, 0), V(u, b, depth), fc, fm)
			bit(base * CFrame.new(0, -v / 2 + b / 2, 0), V(u, b, depth), fc, fm)
			bit(base * CFrame.new(-u / 2 + b / 2, 0, 0), V(b, v - b * 2, depth), fc, fm)
			bit(base * CFrame.new(u / 2 - b / 2, 0, 0), V(b, v - b * 2, depth), fc, fm)
			local big = u >= 6 and v >= 6
			if tier <= 1 then
				-- доски: тонкие щели между досками на обеих сторонах
				local n = math.floor(v / 1.6)
				for k = 1, n - 1 do
					local y = -v / 2 + k * (v / n)
					bit(base * CFrame.new(0, y, 0), V(u - b * 2, 0.08, w + 0.06), fc, fm)
				end
				-- раскос крест-накрест на стенах
				if tier == 1 and big and not thinY then
					local diag = math.sqrt((u - b * 2) ^ 2 + (v - b * 2) ^ 2)
					local ang = math.atan2(v - b * 2, u - b * 2)
					bit(base * CFrame.Angles(0, 0, ang), V(diag, 0.5, depth), fc, fm)
					bit(base * CFrame.Angles(0, 0, -ang), V(diag, 0.5, depth), fc, fm)
				end
				if tier == 0 then
					-- чертёж: голубые «линии разметки»
					bit(base * CFrame.new(0, 0, 0), V(u - 0.4, 0.06, w + 0.08), RGB(110, 170, 230), Enum.Material.Neon)
				end
			elseif tier == 2 then
				-- каменная кладка: швы рядами, со сдвигом через ряд
				local rows = math.max(1, math.floor(v / 1.4))
				for r = 1, rows - 1 do
					bit(base * CFrame.new(0, -v / 2 + r * (v / rows), 0), V(u - b * 2, 0.1, w + 0.06), RGB(80, 78, 74), Enum.Material.Concrete)
				end
				for r = 0, rows - 1 do
					local y = -v / 2 + (r + 0.5) * (v / rows)
					local off = (r % 2 == 0) and 0 or 1
					for x = -u / 2 + 2 + off, u / 2 - 1.5, 2.6 do
						bit(base * CFrame.new(x, y, 0), V(0.1, v / rows, w + 0.06), RGB(80, 78, 74), Enum.Material.Concrete)
					end
				end
			else
				-- металл: заклёпки по углам и центральная полоса
				for _, sx in ipairs({ -1, 1 }) do
					for _, sy in ipairs({ -1, 1 }) do
						for _, sw in ipairs({ -1, 1 }) do
							bit(base * CFrame.new(sx * (u / 2 - b / 2), sy * (v / 2 - b / 2), sw * depth / 2), V(0.3, 0.3, 0.3), RGB(170, 175, 182), Enum.Material.Metal, Enum.PartType.Ball)
						end
					end
				end
				if big then
					bit(base, V(u - b * 2, 0.8, w + 0.12), RGB(80, 84, 90), Enum.Material.Metal)
				end
			end
		end
	end
	-- у фундамента — массивные угловые столбы
	if kind == "foundation" then
		local core = model:FindFirstChild("Slab")
		if core then
			for _, sx in ipairs({ -1, 1 }) do
				for _, sz in ipairs({ -1, 1 }) do
					bit(core.CFrame * CFrame.new(sx * 3.6, -0.2, sz * 3.6), V(1.2, core.Size.Y + 0.6, 1.2), t.Frame, t.FrameMat)
				end
			end
		end
	end
	deco.Parent = model
end

local TIER_FX = { [1] = RGB(150, 110, 70), [2] = RGB(170, 170, 165), [3] = RGB(200, 210, 225) }

-- перекрасить деталь под уровень (animate — с анимацией улучшения)
function Build.setTier(model, tier, animate)
	local t = Building.Tiers[tier]
	model:SetAttribute("Tier", tier)
	model:SetAttribute("HP", t.HP)
	for _, d in ipairs(model:GetChildren()) do
		if d:IsA("BasePart") and d.Name ~= "Handle" then
			d.Color = t.Color
			d.Material = t.Material
			d.Transparency = tier == 0 and 0.25 or 0
			if animate then
				-- «толчок»: деталь чуть раздувается и встаёт на место, летит пыль
				local size = d.Size
				d.Size = size * 1.06
				TweenService:Create(d, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Size = size }):Play()
			end
		end
	end
	if model:GetAttribute("BKind") ~= "door" and model:GetAttribute("BKind") ~= "stairs" then
		decorate(model, tier)
		if animate then
			-- новая отделка «нарастает» поверх старой
			for k, d in ipairs(model:FindFirstChild("Deco"):GetChildren()) do
				local tr = d.Transparency
				d.Transparency = 1
				task.delay(k * 0.015, function()
					TweenService:Create(d, TweenInfo.new(0.25), { Transparency = tr }):Play()
				end)
			end
		end
	end
	if animate then
		local main = model:FindFirstChildWhichIsA("BasePart")
		if main then
			local fx = Instance.new("ParticleEmitter")
			fx.Color = ColorSequence.new(TIER_FX[tier] or RGB(200, 200, 200))
			fx.Size = NumberSequence.new(1.2, 0)
			fx.Lifetime = NumberRange.new(0.5, 0.9)
			fx.Speed = NumberRange.new(6, 12)
			fx.SpreadAngle = Vector2.new(180, 180)
			fx.Rate = 0
			fx.Parent = main
			fx:Emit(30)
			task.delay(1.5, function()
				fx:Destroy()
			end)
		end
	end
end

-- деталь «собирается»: части поднимаются из земли, доски слетаются к центру
local function buildAnimation(model)
	local parts = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			table.insert(parts, d)
		end
	end
	for k, d in ipairs(parts) do
		local final, tr = d.CFrame, d.Transparency
		d.CFrame = final - V(0, 2.5, 0)
		d.Transparency = 1
		task.delay(math.min(0.6, (k - 1) * 0.025), function()
			TweenService:Create(d, TweenInfo.new(0.45, Enum.EasingStyle.Back), { CFrame = final, Transparency = tr }):Play()
		end)
	end
	local cf = model:GetBoundingBox()
	for k = 1, 5 do
		local plank = Instance.new("Part")
		plank.Anchored = true
		plank.CanCollide = false
		plank.CanQuery = false
		plank.Size = V(3, 0.3, 0.8)
		plank.Color = RGB(205, 180, 125)
		plank.Material = M.WoodPlanks
		local a = k / 5 * math.pi * 2
		plank.CFrame = cf * CFrame.new(math.cos(a) * 6, 4, math.sin(a) * 6) * CFrame.Angles(a, a * 2, 0)
		plank.Parent = model
		TweenService:Create(plank, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { CFrame = cf, Transparency = 1 }):Play()
		task.delay(0.45, function()
			plank:Destroy()
		end)
	end
end

-- деталь по сетке. a — параметры привязки (см. Building.cframe)
function Build.piece(parent, id, O, a)
	local def = Building.ById[id]
	local cf = Building.cframe(id, O, a)
	local m = Instance.new("Model")
	m.Name = def.Name
	m:SetAttribute("BKind", id)
	m:SetAttribute("Key", Building.key(id, a))
	m:SetAttribute("Base", a.y)
	m:SetAttribute("Top", Building.top(id, a))
	if def.Edge or def.Door then
		m:SetAttribute("EX", a.ex)
		m:SetAttribute("EZ", a.ez)
		m:SetAttribute("Axis", a.axis)
	else
		m:SetAttribute("CX", a.cx)
		m:SetAttribute("CZ", a.cz)
	end
	local c = RGB(200, 180, 120)
	local function part(name, rel, size)
		return Parts.box(m, name, cf * rel, size, c, M.WoodPlanks)
	end
	if id == "foundation" or id == "floor" then
		part("Slab", CFrame.new(), def.Size)
	elseif id == "wall" then
		part("Wall", CFrame.new(), def.Size)
	elseif id == "window" then
		part("Wall", CFrame.new(0, -2.5, 0), V(8, 3, 0.8))
		part("Wall", CFrame.new(0, 3, 0), V(8, 2, 0.8))
		part("Wall", CFrame.new(-2.75, 0.5, 0), V(2.5, 3, 0.8))
		part("Wall", CFrame.new(2.75, 0.5, 0), V(2.5, 3, 0.8))
		Parts.box(m, "Bar", cf * CFrame.new(0, 0.5, 0), V(0.25, 3, 0.25), RGB(60, 50, 40), M.Wood)
	elseif id == "doorway" then
		part("Wall", CFrame.new(-2.9, 0, 0), V(2.2, 8, 0.8))
		part("Wall", CFrame.new(2.9, 0, 0), V(2.2, 8, 0.8))
		part("Wall", CFrame.new(0, 3.1, 0), V(3.6, 1.8, 0.8))
	elseif id == "door" then
		-- дверь на петлях (левый край), E — открыть/закрыть
		local hinge = cf * CFrame.new(-1.8, 0, 0)
		local door = part("Door", CFrame.new(), def.Size)
		local handle = Parts.box(m, "Handle", hinge * CFrame.new(3.1, 0, -0.35), V(0.25, 0.6, 0.25), RGB(40, 40, 40), M.Metal, { CanCollide = false })
		local open = false
		local pr = prompt(door, "Открыть", "Дверь", 0, 8)
		local dRel, hRel = hinge:ToObjectSpace(door.CFrame), hinge:ToObjectSpace(handle.CFrame)
		pr.Triggered:Connect(function()
			open = not open
			pr.ActionText = open and "Закрыть" or "Открыть"
			local h = hinge * CFrame.Angles(0, open and math.rad(100) or 0, 0)
			TweenService:Create(door, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { CFrame = h * dRel }):Play()
			TweenService:Create(handle, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { CFrame = h * hRel }):Play()
		end)
	elseif id == "stairs" then
		local w = Instance.new("WedgePart")
		w.Name = "Steps"
		w.Anchored = true
		w.Size = def.Size
		w.CFrame = cf
		w.Parent = m
	end
	CollectionService:AddTag(m, "BuildPiece")
	Build.setTier(m, 0)
	m.Parent = parent
	buildAnimation(m)
	return m
end

-- кровать: лечь и проспать ночь
function Build.bed(parent, cf)
	local m = Deployables.build("bed", cf)
	m.Name = "Bed"
	local pr = prompt(m:FindFirstChild("Mattress"), "Лечь спать", "Кровать", 0.4, 8)
	m:SetAttribute("SleepCF", cf * CFrame.new(0, 2.6, 0.4))
	m.Parent = parent
	return m, pr
end

-- сундук-хранилище
function Build.chest(parent, cf)
	local m = Deployables.build("chest", cf)
	m.Name = "StorageChest"
	local body = m:FindFirstChild("Body")
	local put = prompt(body, "Положить всё", "Сундук (пусто)", 0.3, 9)
	local take = prompt(body, "Забрать всё", "Сундук", 0.3, 9)
	take.KeyboardKeyCode = Enum.KeyCode.F
	take.UIOffset = Vector2.new(0, 70)
	m.Parent = parent
	return m, put, take
end

return Build
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="13">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Главный серверный скрипт «ЛАБИРИНТ».
-- Лобби (3 лифта сложности, торговец классами) -> лифт -> своя поляна и свой лабиринт для группы.
-- День: врата открыты, добывай и исследуй. Ночь: врата закрыты, Скрежетники.
-- Раненого поднимает друг бинтом. Найди Ключ и выход — улетай на вертолёте.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")
local PhysicsService = game:GetService("PhysicsService")
local DataStoreService = game:GetService("DataStoreService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Items = require(Shared:WaitForChild("Items"))
local ItemModels = require(Shared:WaitForChild("ItemModels"))
local World = require(script.Parent.World)
local Monster = require(script.Parent.Monster)
local Build = require(script.Parent.Build)
local Building = require(Shared:WaitForChild("Building"))

local V = Vector3.new

------------------------------------------------------------------
-- Remotes
------------------------------------------------------------------
local remotes = ReplicatedStorage:FindFirstChild("Remotes") or Instance.new("Folder")
remotes.Name = "Remotes"
remotes.Parent = ReplicatedStorage
local R = {}
for _, name in ipairs({
	"Swing", "Equip", "Craft", "Eat", "OpenCraft", "Notify", "PlayElevator", "Arrive", "Hurt", "HitMarker",
	"Outro", "Dev", "Crouch", "Note", "LiftSettings", "ShopOpen", "ShopBuy", "ShopSelect", "Build",
	"ExitIntro", "CardInsert", "MapData", "MazeShift", "Ping", "Upgrade", "Place", "Admin", "Prank",
}) do
	local r = remotes:FindFirstChild(name) or Instance.new("RemoteEvent")
	r.Name = name
	r.Parent = remotes
	R[name] = r
end

------------------------------------------------------------------
-- Группы столкновений: пригнувшийся игрок проходит сквозь «крышку» щели
------------------------------------------------------------------
pcall(function()
	PhysicsService:RegisterCollisionGroup("CrawlCover")
	PhysicsService:RegisterCollisionGroup("Crawler")
	PhysicsService:CollisionGroupSetCollidable("CrawlCover", "Crawler", false)
end)

------------------------------------------------------------------
-- Освещение (время суток каждый игрок видит своё — его рисует клиент)
------------------------------------------------------------------
for _, c in ipairs(Lighting:GetChildren()) do
	if c:IsA("PostEffect") or c:IsA("Atmosphere") then
		c:Destroy()
	end
end
-- Небо НЕ удаляем: если вставить красивое небо из Toolbox в Lighting, оно останется
if not Lighting:FindFirstChildOfClass("Sky") then
	local sky = Instance.new("Sky")
	sky.StarCount = 4000
	sky.MoonAngularSize = 14
	sky.SunAngularSize = 16
	sky.Parent = Lighting
end
Lighting.GlobalShadows = true
Lighting.EnvironmentDiffuseScale = 0.6
Lighting.EnvironmentSpecularScale = 0.6
Lighting.ClockTime = 14
local atmo = Instance.new("Atmosphere")
atmo.Density = 0.3
atmo.Haze = 1.2
atmo.Parent = Lighting
for _, cls in ipairs({ "BloomEffect", "SunRaysEffect", "ColorCorrectionEffect", "DepthOfFieldEffect" }) do
	local e = Instance.new(cls)
	if cls == "BloomEffect" then
		e.Intensity, e.Size, e.Threshold = 0.5, 30, 1.1
	elseif cls == "SunRaysEffect" then
		e.Intensity, e.Spread = 0.12, 0.7
	elseif cls == "DepthOfFieldEffect" then
		e.FarIntensity, e.FocusDistance, e.InFocusRadius, e.NearIntensity = 0.12, 70, 100, 0
	end
	e.Parent = Lighting
end

------------------------------------------------------------------
-- Профиль: монеты и классы (сохраняются в опубликованной игре)
------------------------------------------------------------------
local profileStore
pcall(function()
	profileStore = DataStoreService:GetDataStore("LabyrinthProfile")
end)
local profiles = {}

local function syncProfile(p)
	local pr = profiles[p]
	p:SetAttribute("Coins", pr.coins)
	p:SetAttribute("Class", pr.class)
	p:SetAttribute("OwnedClasses", HttpService:JSONEncode(pr.owned))
end

-- сохранение: несколько попыток; если профиль не загрузился — НЕ сохраняем,
-- чтобы не затереть монеты и классы игрока нулями
local function saveProfile(p, wait)
	local pr = profiles[p]
	if not pr or not profileStore or pr.loadFailed then
		return
	end
	local data = HttpService:JSONEncode({ coins = pr.coins, owned = pr.owned, class = pr.class })
	local key = "u" .. p.UserId
	local function run()
		for attempt = 1, 3 do
			local ok = pcall(function()
				profileStore:SetAsync(key, data)
			end)
			if ok then
				pr.dirty = false
				return
			end
			task.wait(2 * attempt)
		end
		warn("[Labyrinth] не удалось сохранить профиль", p.Name)
	end
	if wait then
		run()
	else
		task.spawn(run)
	end
end

local function loadProfile(p)
	local pr = { coins = 0, owned = { "none" }, class = "none" }
	if profileStore then
		local loaded = false
		for attempt = 1, 3 do
			local ok, json = pcall(function()
				return profileStore:GetAsync("u" .. p.UserId)
			end)
			if ok then
				loaded = true
				if typeof(json) == "string" then
					local ok2, data = pcall(function()
						return HttpService:JSONDecode(json)
					end)
					if ok2 and typeof(data) == "table" then
						pr.coins = tonumber(data.coins) or 0
						pr.owned = typeof(data.owned) == "table" and data.owned or { "none" }
						pr.class = typeof(data.class) == "string" and data.class or "none"
					end
				end
				break
			end
			task.wait(2 * attempt)
		end
		if not loaded then
			pr.loadFailed = true
			task.delay(3, function()
				if p.Parent then
					R.Notify:FireClient(p, "Не удалось загрузить сохранение. Монеты в этот раз не сохранятся — перезайди позже.")
				end
			end)
		end
	end
	profiles[p] = pr
	syncProfile(p)
end

local function addCoins(p, n)
	local pr = profiles[p]
	if pr then
		pr.coins += n
		pr.dirty = true
		syncProfile(p)
	end
end

-- автосохранение раз в минуту (только у кого что-то поменялось)
task.spawn(function()
	while true do
		task.wait(60)
		for p, pr in pairs(profiles) do
			if pr.dirty and p.Parent then
				saveProfile(p)
			end
		end
	end
end)

-- сервер выключается (например, вышло обновление) — сохраняем всех
game:BindToClose(function()
	local left = 0
	for p in pairs(profiles) do
		left += 1
		task.spawn(function()
			saveProfile(p, true)
			left -= 1
		end)
	end
	local t0 = os.clock()
	while left > 0 and os.clock() - t0 < 25 do
		task.wait(0.2)
	end
end)

------------------------------------------------------------------
-- Игроки и инвентарь
------------------------------------------------------------------
local lobby = World.BuildLobby()
local state = {} -- [player] = {...}
local sessions = {}
local usedSlots = {}

local function notify(p, text)
	R.Notify:FireClient(p, text)
end

local function sessionOf(p)
	local st = state[p]
	return st and st.session
end

local function notifySession(s, text)
	for _, p in ipairs(s.players) do
		notify(p, text)
	end
end

local updateHeld
local applyInvisible
local putInJail
local function addRes(p, k, n)
	local st = state[p]
	st.res[k] = math.max(0, (st.res[k] or 0) + n)
	p:SetAttribute("Res_" .. k, st.res[k])
	-- закончился предмет, который держали в руке
	local eq = st.equipped and Items.Tools[st.equipped]
	if eq and eq.Kind == "held" and eq.Res == k and st.res[k] <= 0 then
		st.equipped = nil
		p:SetAttribute("Equipped", nil)
		if updateHeld then
			updateHeld(p)
		end
	end
end

-- броня: видна на персонаже, уменьшает урон
local function armorVisual(p)
	local st = state[p]
	local char = p.Character
	if not st or not char then
		return
	end
	local old = char:FindFirstChild("ArmorModel")
	if old then
		old:Destroy()
	end
	local a = st.armor and Items.Armor[st.armor]
	local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
	if not a or not torso then
		return
	end
	local m = Instance.new("Model")
	m.Name = "ArmorModel"
	local col = Color3.fromRGB(a.Color[1], a.Color[2], a.Color[3])
	local mat = st.armor == 1 and Enum.Material.Leather or (st.armor == 3 and Enum.Material.Glass or Enum.Material.Metal)
	local function piece(partName, size, offset)
		local base = char:FindFirstChild(partName)
		if not base then
			return
		end
		local pt = Instance.new("Part")
		pt.Name = "Armor"
		pt.Size = size
		pt.Color = col
		pt.Material = mat
		pt.CanCollide = false
		pt.CanQuery = false
		pt.Massless = true
		pt.CFrame = base.CFrame * offset
		local w = Instance.new("WeldConstraint")
		w.Part0 = base
		w.Part1 = pt
		w.Parent = pt
		pt.Parent = m
	end
	piece(torso.Name, V(2.15, 1.7, 1.2), CFrame.new(0, 0.1, 0))
	piece("Left Arm", V(1.15, 0.7, 1.15), CFrame.new(0, 0.7, 0))
	piece("Right Arm", V(1.15, 0.7, 1.15), CFrame.new(0, 0.7, 0))
	piece("Left Leg", V(1.1, 0.8, 1.1), CFrame.new(0, -0.2, 0))
	piece("Right Leg", V(1.1, 0.8, 1.1), CFrame.new(0, -0.2, 0))
	m.Parent = char
end

local function giveArmor(p, tier, silent)
	local st = state[p]
	if not st then
		return
	end
	if (st.armor or 0) >= tier then
		if not silent then
			notify(p, "У тебя уже есть броня не хуже")
		end
		return false
	end
	st.armor = tier
	p:SetAttribute("Armor", tier)
	armorVisual(p)
	notify(p, "Надета: " .. Items.Armor[tier].Name .. " (урон меньше на " .. math.floor(Items.Armor[tier].Reduce * 100) .. "%)")
	return true
end

local function syncInventory(p)
	local st = state[p]
	for k in pairs(Items.Resources) do
		p:SetAttribute("Res_" .. k, st.res[k] or 0)
	end
	p:SetAttribute("Tools", HttpService:JSONEncode(st.tools))
	p:SetAttribute("Equipped", st.equipped)
end

local function freshInventory(p)
	local st = state[p]
	st.res, st.tools, st.equipped, st.gotSupply = {}, { "wood_pickaxe", "wood_axe" }, nil, false
	st.armor = nil
	p:SetAttribute("Armor", 0)
	local cls = profiles[p] and profiles[p].class or "none"
	if cls == "lumber" then
		table.insert(st.tools, "stone_axe")
	elseif cls == "miner" then
		table.insert(st.tools, "stone_pickaxe")
	elseif cls == "warrior" then
		table.insert(st.tools, "spear")
	end
	syncInventory(p)
end

local function hrpOf(p)
	local c = p.Character
	return c and c:FindFirstChild("HumanoidRootPart"), c
end

local function place(p, cf, anchored)
	local hrp, char = hrpOf(p)
	if hrp then
		hrp.Anchored = anchored == true
		char:PivotTo(cf)
		hrp.AssemblyLinearVelocity = Vector3.zero
	end
end

local function inSafeZone(s, pos)
	if s.exit then
		local lp = s.exit.zone.cf:PointToObjectSpace(pos)
		if math.abs(lp.X) < s.exit.zone.size.X / 2 and math.abs(lp.Z) < s.exit.zone.size.Z / 2 then
			return true
		end
	end
	local h = World.CLEARING_HALF - 3
	local rel = pos - s.O
	return math.abs(rel.X) < h and math.abs(rel.Z) < h and rel.Y > -20 and rel.Y < 300
end

local function classOf(p)
	return profiles[p] and profiles[p].class or "none"
end

-- предмет в руке (виден другим игрокам)
function updateHeld(p)
	local st = state[p]
	local char = p.Character
	if not char or not st then
		return
	end
	local old = char:FindFirstChild("HeldItem")
	if old then
		old:Destroy()
	end
	local hand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
	if not st.equipped or not hand then
		return
	end
	local m = ItemModels.build(st.equipped)
	m.Name = "HeldItem"
	m:PivotTo(hand.CFrame * CFrame.new(0, -hand.Size.Y / 2, -0.1) * CFrame.Angles(-math.pi / 2, 0, 0))
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = false
			local w = Instance.new("WeldConstraint")
			w.Part0 = hand
			w.Part1 = d
			w.Parent = d
		end
	end
	m.Parent = char
end

R.Equip.OnServerEvent:Connect(function(p, id)
	local st = state[p]
	if not st or (id ~= nil and typeof(id) ~= "string") then
		return
	end
	local def = id and Items.Tools[id]
	-- предмет из инвентаря (ключ-карта, карта, бинт, ягоды) можно держать, если он есть
	local heldOk = def and def.Kind == "held" and (st.res[def.Res] or 0) > 0
	if id ~= nil and not table.find(st.tools, id) and not heldOk then
		return
	end
	st.equipped = id
	p:SetAttribute("Equipped", id)
	updateHeld(p)
end)

------------------------------------------------------------------
-- Ранение и подъём
------------------------------------------------------------------
local respawnAtClearing
local returnToLobby

-- тряпичная кукла: суставы становятся шарнирами, тело падает и болтается
local function setRagdoll(char, on)
	local torso = char and char:FindFirstChild("Torso")
	if not torso then
		return
	end
	for _, d in ipairs(char:GetDescendants()) do
		if d.Name == "RagJoint" or d.Name == "RagAtt" then
			d:Destroy()
		end
	end
	for _, m in ipairs(torso:GetChildren()) do
		if m:IsA("Motor6D") and m.Part0 and m.Part1 then
			if on then
				local a0 = Instance.new("Attachment")
				a0.Name = "RagAtt"
				a0.CFrame = m.C0
				a0.Parent = m.Part0
				local a1 = Instance.new("Attachment")
				a1.Name = "RagAtt"
				a1.CFrame = m.C1
				a1.Parent = m.Part1
				local bs = Instance.new("BallSocketConstraint")
				bs.Name = "RagJoint"
				bs.Attachment0 = a0
				bs.Attachment1 = a1
				bs.LimitsEnabled = true
				bs.UpperAngle = m.Name == "Neck" and 35 or 75
				bs.TwistLimitsEnabled = true
				bs.TwistLowerAngle = -40
				bs.TwistUpperAngle = 40
				bs.Parent = torso
			end
			m.Enabled = not on
			if m.Part1.Name ~= "Head" then
				m.Part1.CanCollide = on
			end
		end
	end
end

local function stopDrag(dragger)
	local dst = state[dragger]
	local victim = dst and dst.dragging
	if not victim then
		return
	end
	dst.dragging = nil
	dragger:SetAttribute("Dragging", false)
	if dst.dragRope then
		dst.dragRope:Destroy()
		dst.dragRope = nil
	end
	for _, a in ipairs(dst.dragAtts or {}) do
		a:Destroy()
	end
	dst.dragAtts = nil
	local vst = state[victim]
	if vst then
		vst.draggedBy = nil
	end
	local char = victim.Character
	if char then
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("BasePart") then
				pcall(function()
					d:SetNetworkOwner(victim)
				end)
			end
		end
	end
end

local function startDrag(dragger, victim)
	local dst, vst = state[dragger], state[victim]
	local dh = hrpOf(dragger)
	local leg = victim.Character and (victim.Character:FindFirstChild("Right Leg") or victim.Character:FindFirstChild("RightLowerLeg"))
	if not dst or not vst or not dh or not leg then
		return
	end
	if vst.draggedBy then
		notify(dragger, "Его уже тащит " .. vst.draggedBy.DisplayName)
		return
	end
	dst.dragging = victim
	vst.draggedBy = dragger
	dragger:SetAttribute("Dragging", true)
	local a0 = Instance.new("Attachment")
	a0.Name = "DragAtt"
	a0.Position = V(0.6, -1, 1.2)
	a0.Parent = dh
	local a1 = Instance.new("Attachment")
	a1.Name = "DragAtt"
	a1.Position = V(0, -leg.Size.Y / 2 + 0.2, 0)
	a1.Parent = leg
	local rope = Instance.new("RopeConstraint")
	rope.Attachment0 = a0
	rope.Attachment1 = a1
	rope.Length = 3.5
	rope.Restitution = 0
	rope.Parent = dh
	dst.dragRope, dst.dragAtts = rope, { a0, a1 }
	-- физику тела считает тот, кто тащит, — так оно не дёргается
	for _, d in ipairs(victim.Character:GetDescendants()) do
		if d:IsA("BasePart") then
			pcall(function()
				d:SetNetworkOwner(dragger)
			end)
		end
	end
	notify(dragger, "Ты тащишь " .. victim.DisplayName .. " за ногу. F — отпустить.")
end

local function setDownedVisual(p, on)
	local _, char = hrpOf(p)
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.PlatformStand = on
		hum.WalkSpeed = on and 0 or Config.WalkSpeed
		hum.JumpPower = on and 0 or 50
	end
	setRagdoll(char, on)
	if not on then
		local hrp = hrpOf(p)
		if hrp then
			hrp.CFrame = CFrame.new(hrp.Position + V(0, 2.5, 0)) * CFrame.Angles(0, select(2, hrp.CFrame:ToEulerAnglesYXZ()), 0)
		end
	end
end

local function revive(p, by)
	local st = state[p]
	if not st or not st.downed then
		return
	end
	st.downed = false
	p:SetAttribute("Downed", false)
	if st.revivePrompt then
		st.revivePrompt:Destroy()
		st.revivePrompt = nil
	end
	if st.dragPrompt then
		st.dragPrompt:Destroy()
		st.dragPrompt = nil
	end
	if st.draggedBy then
		stopDrag(st.draggedBy)
	end
	setDownedVisual(p, false)
	local _, char = hrpOf(p)
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.Health = Config.ReviveHealth
	end
	notify(p, by and (by.DisplayName .. " поднял тебя!") or "Ты пришёл в себя")
end

local function checkAllDowned(s)
	for _, p in ipairs(s.players) do
		local st = state[p]
		if st and not st.downed then
			return
		end
	end
	-- поднять некому — все возвращаются в лобби
	notifySession(s, "Все ранены, и помочь некому... Вы возвращаетесь в лобби.")
	local list = table.clone(s.players)
	task.delay(3, function()
		for _, p in ipairs(list) do
			if state[p] and state[p].session == s then
				returnToLobby(p)
			end
		end
	end)
end

local function down(p)
	local st = state[p]
	local s = st and st.session
	if not s or st.downed then
		return
	end
	st.downed = true
	st.downedAt = os.clock()
	stopDrag(p)
	p:SetAttribute("Downed", true)
	p:SetAttribute("DownedEnd", workspace:GetServerTimeNow() + Config.DownedTime)
	setDownedVisual(p, true)
	local hrp = hrpOf(p)
	if hrp then
		local pr = Instance.new("ProximityPrompt")
		pr.ActionText = "Поднять (нужен бинт)"
		pr.ObjectText = p.DisplayName .. " ранен"
		pr.HoldDuration = 2.5
		pr.MaxActivationDistance = 9
		pr.RequiresLineOfSight = false
		pr.Parent = hrp
		st.revivePrompt = pr
		pr.Triggered:Connect(function(by)
			local bst = state[by]
			if by == p or not bst or bst.session ~= s or bst.downed then
				return
			end
			if (bst.res.bandage or 0) < 1 then
				notify(by, "Нужен бинт! Сделай его из травы (C → Бинт). Или тащи друга за ногу (F).")
				return
			end
			addRes(by, "bandage", -1)
			revive(p, by)
		end)
		-- тащить за ногу (F)
		local dp = Instance.new("ProximityPrompt")
		dp.ActionText = "Тащить за ногу"
		dp.ObjectText = p.DisplayName
		dp.KeyboardKeyCode = Enum.KeyCode.F
		dp.GamepadKeyCode = Enum.KeyCode.ButtonY
		dp.HoldDuration = 0.3
		dp.MaxActivationDistance = 9
		dp.RequiresLineOfSight = false
		dp.UIOffset = Vector2.new(0, 80)
		dp.Parent = hrp
		st.dragPrompt = dp
		dp.Triggered:Connect(function(by)
			local bst = state[by]
			if by == p or not bst or bst.session ~= s or bst.downed then
				return
			end
			if bst.dragging == p then
				stopDrag(by)
			elseif not bst.dragging then
				startDrag(by, p)
			end
		end)
	end
	for _, other in ipairs(s.players) do
		if other ~= p then
			notify(other, p.DisplayName .. " ранен! Подойди и подними его бинтом (зажми E).")
		end
	end
	-- таймера нет: ждём, пока друг поднимет; если ранены все — все в лобби
	checkAllDowned(s)
end

local function damage(p, amount)
	local st = state[p]
	local _, char = hrpOf(p)
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not st or not hum or st.downed then
		return
	end
	-- броня уменьшает урон
	local armor = st.armor and Items.Armor[st.armor]
	if armor then
		amount = amount * (1 - armor.Reduce)
	end
	hum.Health = math.max(1, hum.Health - amount)
	R.Hurt:FireClient(p)
	if hum.Health <= 1 then
		down(p)
	end
end

------------------------------------------------------------------
-- Ресурсные узлы
------------------------------------------------------------------
local function setNodeVisible(model, visible)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			if d:GetAttribute("BaseT") == nil then
				d:SetAttribute("BaseT", d.Transparency)
				d:SetAttribute("BaseC", d.CanCollide)
			end
			d.Transparency = visible and d:GetAttribute("BaseT") or 1
			d.CanCollide = visible and d:GetAttribute("BaseC") or false
			d.CanQuery = visible
		elseif d:IsA("Light") or d:IsA("ProximityPrompt") then
			d.Enabled = visible
		end
	end
end

local function hitNode(p, model, def)
	local kind = model:GetAttribute("Node")
	local nd = Items.Nodes[kind]
	if not nd or model:GetAttribute("Depleted") then
		return false
	end
	if def.Kind ~= nd.Tool then
		notify(p, nd.Tool == "axe" and "Нужен топор" or "Нужна кирка")
		return false
	end
	if def.Tier < nd.Tier then
		notify(p, "Слишком твёрдо! Нужна кирка " .. nd.Tier .. " уровня (крафт на верстаке)")
		return false
	end
	local dmg = def.Damage
	local gain = 1
	local cls = classOf(p)
	if cls == "miner" and nd.Tool == "pickaxe" then
		dmg *= 1.5
	end
	if cls == "lumber" and nd.Tool == "axe" then
		gain = 2
	end
	local hp = (model:GetAttribute("HP") or nd.Health) - dmg
	model:SetAttribute("HP", hp)
	addRes(p, nd.Drop, gain)
	R.HitMarker:FireClient(p, "node", nd.Tool)
	if hp <= 0 then
		addRes(p, nd.Drop, nd.Amount * gain)
		model:SetAttribute("Depleted", true)
		setNodeVisible(model, false)
		-- от дерева остаётся пень, потом оно заново вырастает
		local stump
		local trunk = kind == "tree" and model:FindFirstChild("Trunk")
		if trunk then
			local base = trunk.Position - V(0, trunk.Size.Y / 2, 0)
			model.WorldPivot = CFrame.new(base)
			stump = Instance.new("Part")
			stump.Name = "Stump"
			stump.Anchored = true
			stump.Size = V(trunk.Size.X + 0.3, 1.4, trunk.Size.Z + 0.3)
			stump.CFrame = CFrame.new(base + V(0, 0.7, 0))
			stump.Color = trunk.Color
			stump.Material = Enum.Material.Wood
			stump.Parent = model.Parent
		end
		task.delay(Config.NodeRespawn, function()
			if not model.Parent then
				return
			end
			if stump then
				stump:Destroy()
				pcall(function()
					model:ScaleTo(0.15)
				end)
				setNodeVisible(model, true)
				for i = 1, 40 do
					task.wait(0.25)
					pcall(function()
						model:ScaleTo(0.15 + 0.85 * i / 40)
					end)
				end
			else
				setNodeVisible(model, true)
			end
			model:SetAttribute("Depleted", false)
			model:SetAttribute("HP", nd.Health)
		end)
	end
	return true
end

-- лучший свой инструмент нужного вида (для добычи на E)
local function bestTool(p, kind)
	local st = state[p]
	local best
	for _, id in ipairs(st.tools) do
		local t = Items.Tools[id]
		if t and t.Kind == kind and (not best or t.Tier > best.Tier) then
			best = t
		end
	end
	return best
end

------------------------------------------------------------------
-- Монстры
------------------------------------------------------------------
local function alivePlayers(s)
	local list = {}
	for _, p in ipairs(s.players) do
		local st = state[p]
		if st and not st.downed and p.Parent then
			table.insert(list, p)
		end
	end
	return list
end

local function spawnMonsters(s)
	if s.ended or #s.players == 0 then
		return
	end
	local d = s.diff
	local count = math.floor(d.Monsters + d.PerPlayer * #s.players + 0.5)
	local far = {}
	for _, c in ipairs(s.maze.cells) do
		if (c - s.O).Magnitude > World.CLEARING_HALF + 70 then
			table.insert(far, c)
		end
	end
	for _ = 1, count do
		local pos = far[math.random(1, #far)]
		local mon = Monster.new({
			parent = s.folder,
			spawn = CFrame.new(pos + V(0, 10, 0)),
			patrol = s.maze.cells,
			getPlayers = function()
				return alivePlayers(s)
			end,
			inSafeZone = function(pos2)
				return inSafeZone(s, pos2)
			end,
			damage = damage,
			health = d.Health,
			speed = d.Speed,
			dmg = d.Damage,
		})
		s.monsters[mon.model] = mon
	end
end

local function clearMonsters(s, retreat)
	for model, mon in pairs(s.monsters) do
		mon:Die(retreat)
		s.monsters[model] = nil
	end
end

------------------------------------------------------------------
-- Удар (ЛКМ)
------------------------------------------------------------------
R.Swing.OnServerEvent:Connect(function(p, hit, hitPos)
	local st = state[p]
	local s = st and st.session
	if not s or st.downed then
		return
	end
	local def = Items.Tools[st.equipped or "fists"] or Items.Tools.fists
	if def.Kind == "torch" then
		return -- факел только светит
	end
	local now = os.clock()
	if now - (st.lastSwing or 0) < 0.4 then
		return
	end
	st.lastSwing = now
	if typeof(hit) ~= "Instance" or typeof(hitPos) ~= "Vector3" then
		return
	end
	local _, char = hrpOf(p)
	local head = char and char:FindFirstChild("Head")
	if not head or (head.Position - hitPos).Magnitude > def.Range + 4 then
		return
	end
	-- молоток: улучшение постройки
	local piece = Building.pieceOf(hit)
	if piece and def.Kind == "hammer" and piece:IsDescendantOf(s.folder) then
		local tier = (piece:GetAttribute("Tier") or 0) + 1
		local t = Building.Tiers[tier]
		if not t then
			notify(p, "Это уже металл — сильнее не бывает")
			return
		end
		for k, n in pairs(t.Cost) do
			if (st.res[k] or 0) < n then
				notify(p, "Для улучшения до «" .. t.Name .. "» нужно: " .. Items.Resources[k].Name .. " " .. n)
				return
			end
		end
		for k, n in pairs(t.Cost) do
			addRes(p, k, -n)
		end
		Build.setTier(piece, tier, true)
		R.HitMarker:FireClient(p, "node", "axe")
		notify(p, piece.Name .. " → " .. t.Name)
		return
	end
	local model = hit:FindFirstAncestorOfClass("Model")
	while model and not s.monsters[model] and model.Parent and model.Parent:IsA("Model") do
		model = model.Parent
	end
	local mon = model and s.monsters[model]
	if mon then
		local died = mon:TakeDamage(def.Damage, head.Position)
		R.HitMarker:FireClient(p, died and "kill" or "monster")
		if died then
			s.monsters[model] = nil
			addRes(p, "fang", 2)
			notifySession(s, p.DisplayName .. " победил Скрежетника!")
		end
		return
	end
	local nodeModel = hit:FindFirstAncestorWhichIsA("Model")
	while nodeModel and nodeModel:GetAttribute("Node") == nil and nodeModel.Parent and nodeModel.Parent:IsA("Model") do
		nodeModel = nodeModel.Parent
	end
	if nodeModel and nodeModel:GetAttribute("Node") then
		hitNode(p, nodeModel, def)
	end
end)

R.Eat.OnServerEvent:Connect(function(p)
	local st = state[p]
	local _, char = hrpOf(p)
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not st or st.downed or not hum or (st.res.berry or 0) < 1 or hum.Health >= hum.MaxHealth then
		return
	end
	addRes(p, "berry", -1)
	hum.Health = math.min(hum.MaxHealth, hum.Health + Config.BerryHeal)
end)

------------------------------------------------------------------
-- Крафт: из инвентаря (C) и на верстаке
------------------------------------------------------------------
local connectBed, connectChest
local sendMap
local function recipeById(id)
	for _, r in ipairs(Items.Recipes) do
		if r.Id == id then
			return r
		end
	end
end

local function nearestBench(s, pos)
	local best, bd
	for _, b in ipairs(s.benches) do
		if b.model.Parent then
			local d = (b.top.Position - pos).Magnitude
			if d < 16 and (not bd or d < bd) then
				best, bd = b, d
			end
		end
	end
	return best
end

local function connectBench(s, bench)
	bench.prompt.Triggered:Connect(function(p)
		if sessionOf(p) == s then
			R.OpenCraft:FireClient(p, bench.model:GetAttribute("Level") or 1)
		end
	end)
end

------------------------------------------------------------------
-- Кровать, сундук, прятки в лианах
------------------------------------------------------------------
local function wake(p)
	local st = state[p]
	if not st or not st.sleeping then
		return
	end
	st.sleeping = nil
	p:SetAttribute("Sleeping", false)
	local hrp, char = hrpOf(p)
	if hrp then
		hrp.Anchored = false
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.PlatformStand = false
		end
		char:PivotTo(hrp.CFrame * CFrame.new(0, 1, 0) * CFrame.Angles(math.rad(-90), 0, 0) + V(0, 1.5, 0))
	end
end

local function checkSleep(s)
	if s.phase ~= "night" then
		return
	end
	local awake = 0
	for _, q in ipairs(s.players) do
		local st = state[q]
		if st and not st.downed and not st.sleeping then
			awake += 1
		end
	end
	if awake == 0 and #s.players > 0 then
		notifySession(s, "Все уснули... Ночь проходит.")
		s.skip = true
	end
end

function connectBed(s, bed, pr)
	pr.Triggered:Connect(function(p)
		local st = state[p]
		if not st or st.session ~= s or st.downed then
			return
		end
		if st.sleeping then
			wake(p)
			return
		end
		if s.phase ~= "night" then
			notify(p, "Спать можно только ночью")
			return
		end
		local hrp, char = hrpOf(p)
		if not hrp then
			return
		end
		st.sleeping = bed
		p:SetAttribute("Sleeping", true)
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.PlatformStand = true
		end
		hrp.Anchored = true
		char:PivotTo(bed:GetAttribute("SleepCF") * CFrame.Angles(math.rad(90), 0, 0))
		notify(p, "Ты спишь. Если уснут все — ночь пройдёт. E у кровати — встать.")
		checkSleep(s)
	end)
end

function connectChest(s, chest, put, take)
	local store = {}
	local function label()
		local n = 0
		for _, v in pairs(store) do
			n += v
		end
		put.ObjectText = n > 0 and ("Сундук (" .. n .. " шт.)") or "Сундук (пусто)"
	end
	put.Triggered:Connect(function(p)
		local st = state[p]
		if not st or st.session ~= s then
			return
		end
		for k, n in pairs(st.res) do
			if k ~= "key" and n > 0 then
				store[k] = (store[k] or 0) + n
				addRes(p, k, -n)
			end
		end
		label()
		notify(p, "Ресурсы сложены в сундук")
	end)
	take.Triggered:Connect(function(p)
		local st = state[p]
		if not st or st.session ~= s then
			return
		end
		for k, n in pairs(store) do
			addRes(p, k, n)
		end
		store = {}
		label()
		notify(p, "Ты забрал всё из сундука")
	end)
	local _ = chest
end

local function unhide(p)
	local st = state[p]
	if not st or not st.hidden then
		return
	end
	local spot = st.hidden
	st.hidden = nil
	p:SetAttribute("Hidden", false)
	spot:SetAttribute("Occupied", false)
	local pr = spot:FindFirstChildOfClass("ProximityPrompt")
	if pr then
		pr.ActionText = "Спрятаться"
	end
	local hrp, char = hrpOf(p)
	if hrp then
		hrp.Anchored = false
		local out = (spot:GetAttribute("Out") or spot.Position + V(0, 0, 6))
		char:PivotTo(CFrame.lookAt(out + V(0, 1, 0), out + V(0, 1, 0) + (out - spot.Position) * V(1, 0, 1)))
	end
end

------------------------------------------------------------------
-- Строительство (чертёж)
------------------------------------------------------------------
R.Build.OnServerEvent:Connect(function(p, id, a)
	local st = state[p]
	local s = st and st.session
	local def = typeof(id) == "string" and Building.ById[id]
	local hrp = hrpOf(p)
	if not s or not def or not hrp or st.downed or st.equipped ~= "blueprint" or typeof(a) ~= "table" then
		return
	end
	-- проверка параметров
	local ok = typeof(a.y) == "number" and a.y == a.y and math.abs(a.y) < 400
	if def.Edge or def.Door then
		ok = ok and typeof(a.ex) == "number" and typeof(a.ez) == "number" and (a.axis == "X" or a.axis == "Z")
		ok = ok and a.ex % 1 == 0 and a.ez % 1 == 0
	else
		ok = ok and typeof(a.cx) == "number" and typeof(a.cz) == "number" and a.cx % 1 == 0 and a.cz % 1 == 0
	end
	if not ok then
		return
	end
	local args = { cx = a.cx, cz = a.cz, ex = a.ex, ez = a.ez, axis = a.axis, y = a.y, rot = (typeof(a.rot) == "number" and a.rot % 1 == 0) and a.rot % 4 or 0 }
	local key = Building.key(id, args)
	if s.pieces[key] and s.pieces[key].Parent then
		notify(p, "Здесь уже стоит постройка")
		return
	end
	if id == "door" then
		local frame = s.pieces[Building.key("doorway", args)]
		if not frame or not frame.Parent or frame:GetAttribute("BKind") ~= "doorway" then
			notify(p, "Дверь ставится в дверной проём")
			return
		end
	end
	local cf = Building.cframe(id, s.O, args)
	if (cf.Position - hrp.Position).Magnitude > 32 then
		return
	end
	if (cf.Position - s.O).Magnitude < 16 then
		notify(p, "Слишком близко к лифту")
		return
	end
	-- не строим внутри стен, деревьев и игроков
	-- selene: allow(undefined_variable)
	local op = OverlapParams.new()
	op.FilterType = Enum.RaycastFilterType.Exclude
	op.FilterDescendantsInstances = { s.buildFolder }
	op.RespectCanCollide = true
	local size = def.Size - V(0.6, 0.6, 0.6)
	if id == "foundation" then
		size = V(7.4, 1.2, 7.4)
		cf = cf * CFrame.new(0, 0.8, 0)
	end
	for _, part in ipairs(workspace:GetPartBoundsInBox(cf, V(math.max(0.2, size.X), math.max(0.2, size.Y), math.max(0.2, size.Z)), op)) do
		if not part:IsA("Terrain") then
			notify(p, "Мешает: " .. part.Name)
			return
		end
	end
	for k, n in pairs(def.Cost) do
		if (st.res[k] or 0) < n then
			notify(p, "Не хватает: " .. Items.Resources[k].Name .. " (" .. n .. "). Доски делаются в крафте (C).")
			return
		end
	end
	for k, n in pairs(def.Cost) do
		addRes(p, k, -n)
	end
	s.pieces[key] = Build.piece(s.buildFolder, id, s.O, args)
	R.HitMarker:FireClient(p, "node", "axe")
end)

-- поставить верстак / кровать / сундук (с предпросмотром на клиенте)
local Deployables = require(Shared:WaitForChild("Deployables"))
R.Place.OnServerEvent:Connect(function(p, toolId, cf)
	local st = state[p]
	local s = st and st.session
	local def = typeof(toolId) == "string" and Items.Tools[toolId]
	local hrp = hrpOf(p)
	if not s or not def or def.Kind ~= "deploy" or not table.find(st.tools, toolId) or typeof(cf) ~= "CFrame" or not hrp or st.downed then
		return
	end
	if (cf.Position - hrp.Position).Magnitude > 24 then
		return
	end
	-- только поворот вокруг вертикали
	local _, yaw = cf:ToEulerAnglesYXZ()
	cf = CFrame.new(cf.Position) * CFrame.Angles(0, yaw, 0)
	local size = Deployables.Size[def.Deploy]
	local op = OverlapParams.new()
	op.RespectCanCollide = true
	for _, part in ipairs(workspace:GetPartBoundsInBox(cf * CFrame.new(0, size.Y / 2 + 0.3, 0), size - V(0.3, 0.3, 0.3), op)) do
		if not part:IsA("Terrain") then
			notify(p, "Здесь не помещается: мешает " .. part.Name)
			return
		end
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { p.Character }
	local g = workspace:Raycast(cf.Position + V(0, 2, 0), V(0, -5, 0), params)
	if not g then
		notify(p, "Ставить можно только на землю или пол")
		return
	end
	table.remove(st.tools, table.find(st.tools, toolId))
	if st.equipped == toolId then
		st.equipped = nil
		p:SetAttribute("Equipped", nil)
		updateHeld(p)
	end
	p:SetAttribute("Tools", HttpService:JSONEncode(st.tools))
	if def.Deploy == "workbench" then
		local b = World.BuildWorkbench(s.folder, cf)
		table.insert(s.benches, b)
		connectBench(s, b)
		notifySession(s, p.DisplayName .. " поставил верстак")
	elseif def.Deploy == "bed" then
		local bed, pr = Build.bed(s.folder, cf)
		connectBed(s, bed, pr)
		notify(p, "Кровать поставлена. Ночью ляг спать — если уснут все, ночь пройдёт.")
	elseif def.Deploy == "chest" then
		local chest, put, take = Build.chest(s.folder, cf)
		connectChest(s, chest, put, take)
		notify(p, "Сундук поставлен: E — положить всё, F — забрать всё.")
	end
	R.HitMarker:FireClient(p, "node", "axe")
end)

-- круговое меню молотка: сразу до выбранного уровня, или снести
R.Upgrade.OnServerEvent:Connect(function(p, piece, tier)
	local st = state[p]
	local s = st and st.session
	local hrp = hrpOf(p)
	if not s or not hrp or st.downed or st.equipped ~= "hammer" or typeof(piece) ~= "Instance" or not piece:IsDescendantOf(s.buildFolder) then
		return
	end
	local cf = piece:GetBoundingBox()
	if (cf.Position - hrp.Position).Magnitude > 20 then
		return
	end
	if tier == "remove" then
		local def = Building.ById[piece:GetAttribute("BKind")]
		for k, n in pairs(def and def.Cost or {}) do
			addRes(p, k, math.floor(n / 2))
		end
		s.pieces[piece:GetAttribute("Key")] = nil
		piece:Destroy()
		notify(p, "Снесено (вернулась половина досок)")
		return
	end
	local cur = piece:GetAttribute("Tier") or 0
	local t = typeof(tier) == "number" and Building.Tiers[tier]
	if not t or tier <= cur then
		notify(p, "Уже не хуже, чем «" .. Building.Tiers[cur].Name .. "»")
		return
	end
	for k, n in pairs(t.Cost) do
		if (st.res[k] or 0) < n then
			notify(p, "Для «" .. t.Name .. "» нужно: " .. Items.Resources[k].Name .. " " .. n)
			return
		end
	end
	for k, n in pairs(t.Cost) do
		addRes(p, k, -n)
	end
	Build.setTier(piece, tier, true)
	R.HitMarker:FireClient(p, "node", "axe")
	notify(p, piece.Name .. " → " .. t.Name)
end)

-- раненый подаёт сигнал: 15 секунд друзья видят, где он, и стрелки к нему
R.Ping.OnServerEvent:Connect(function(p)
	local st = state[p]
	if not st or not st.downed then
		return
	end
	local now = os.clock()
	if now - (st.lastPing or -100) < 20 then
		return
	end
	st.lastPing = now
	p:SetAttribute("PingUntil", workspace:GetServerTimeNow() + 15)
	p:SetAttribute("PingNext", workspace:GetServerTimeNow() + 20)
	for _, q in ipairs(st.session and st.session.players or {}) do
		if q ~= p then
			notify(q, p.DisplayName .. " зовёт на помощь! Иди по стрелкам.")
		end
	end
end)

R.Craft.OnServerEvent:Connect(function(p, id)
	local st = state[p]
	local s = st and st.session
	local r = typeof(id) == "string" and recipeById(id)
	local hrp = hrpOf(p)
	if not s or not r or not hrp or st.downed then
		return
	end
	local bench
	if r.Station == "bench" then
		bench = nearestBench(s, hrp.Position)
		if not bench then
			notify(p, "Нужен верстак рядом. Сделай его: C → Верстак, потом поставь.")
			return
		end
		if r.Level > (bench.model:GetAttribute("Level") or 1) then
			notify(p, "Нужен верстак " .. r.Level .. " уровня")
			return
		end
	end
	if r.Id == "upgrade2" and (bench.model:GetAttribute("Level") or 1) >= 2 then
		notify(p, "Этот верстак уже 2 уровня")
		return
	end
	if Items.Tools[r.Id] and table.find(st.tools, r.Id) then
		notify(p, "У тебя уже есть: " .. Items.toolName(r.Id))
		return
	end
	-- инструмент того же вида, но лучше — уже есть
	local newDef = Items.Tools[r.Id]
	local function power(d)
		return d.Kind == "sword" and d.Damage or d.Tier
	end
	local unique = newDef and (newDef.Kind == "torch" or newDef.Kind == "deploy" or newDef.Kind == "blueprint" or newDef.Kind == "hammer")
	if newDef and not unique then
		for _, t in ipairs(st.tools) do
			local d = Items.Tools[t]
			if d and d.Kind == newDef.Kind and power(d) >= power(newDef) then
				notify(p, "У тебя уже есть лучше: " .. d.Name)
				return
			end
		end
	end
	if r.Armor and (st.armor or 0) >= r.Armor then
		notify(p, "У тебя уже есть броня не хуже")
		return
	end
	for k, n in pairs(r.Cost) do
		if (st.res[k] or 0) < n then
			notify(p, "Не хватает: " .. Items.Resources[k].Name)
			return
		end
	end
	for k, n in pairs(r.Cost) do
		addRes(p, k, -n)
	end
	if r.Place then
		local look = hrp.CFrame.LookVector * V(1, 0, 1)
		local pos = hrp.Position + look.Unit * 7
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { p.Character }
		local hit = workspace:Raycast(pos + V(0, 6, 0), V(0, -30, 0), params)
		local ground = hit and hit.Position or (pos - V(0, 3, 0))
		local cf = CFrame.lookAt(ground, ground - look)
		if r.Place == "workbench" then
			local b = World.BuildWorkbench(s.folder, cf)
			table.insert(s.benches, b)
			connectBench(s, b)
			notifySession(s, p.DisplayName .. " поставил верстак")
		elseif r.Place == "bed" then
			local bed, pr = Build.bed(s.folder, cf)
			connectBed(s, bed, pr)
			notify(p, "Кровать поставлена. Ночью ляг спать — если уснут все, ночь пройдёт быстрее.")
		elseif r.Place == "chest" then
			local chest, put, take = Build.chest(s.folder, cf)
			connectChest(s, chest, put, take)
			notify(p, "Сундук поставлен: E — положить всё, F — забрать всё.")
		end
	elseif r.Id == "upgrade2" then
		bench.model:SetAttribute("Level", 2)
		bench.label.Text = "Верстак · ур. 2"
		notifySession(s, p.DisplayName .. " улучшил верстак до 2 уровня!")
	elseif r.Armor then
		giveArmor(p, r.Armor)
	elseif r.Res then
		addRes(p, r.Res, r.Amount or 1)
		notify(p, "Создано: " .. Items.Resources[r.Res].Name)
	else
		-- новый инструмент заменяет старый того же вида (каменная кирка вместо деревянной)
		local slot
		for i = #st.tools, 1, -1 do
			local d = Items.Tools[st.tools[i]]
			if d and newDef and d.Kind == newDef.Kind and not unique then
				if st.equipped == st.tools[i] then
					st.equipped = r.Id
				end
				table.remove(st.tools, i)
				slot = i
			end
		end
		table.insert(st.tools, slot or #st.tools + 1, r.Id)
		p:SetAttribute("Tools", HttpService:JSONEncode(st.tools))
		if st.equipped == r.Id then
			p:SetAttribute("Equipped", r.Id)
			updateHeld(p)
		end
		notify(p, "Создано: " .. Items.toolName(r.Id) .. (slot and " (заменил старый)" or (newDef and newDef.Kind == "deploy") and " — возьми в руку, R — повернуть, ЛКМ — поставить" or " (выбери цифрой)"))
	end
end)

------------------------------------------------------------------
-- Врата
------------------------------------------------------------------
local function moveGates(s, close, duration)
	s.gatesClosed = close
	for _, g in ipairs(s.gates) do
		for _, leaf in ipairs(g.leaves) do
			local from = leaf.part.CFrame
			local to = close and leaf.closed or leaf.open
			local children = {}
			for _, ch in ipairs(leaf.part:GetChildren()) do
				if ch:IsA("BasePart") then
					children[ch] = from:ToObjectSpace(ch.CFrame)
				end
			end
			task.spawn(function()
				local t0 = os.clock()
				while leaf.part.Parent do
					local a = math.clamp((os.clock() - t0) / duration, 0, 1)
					local e = a * a * (3 - 2 * a)
					local cf = from:Lerp(to, e)
					leaf.part.CFrame = cf
					for ch, rel in pairs(children) do
						ch.CFrame = cf * rel
					end
					if a >= 1 then
						break
					end
					RunService.Heartbeat:Wait()
				end
			end)
		end
		local snd = Instance.new("Sound")
		snd.SoundId = Config.Sounds.Rumble
		snd.Volume = 3
		snd.PlaybackSpeed = 0.25
		snd.RollOffMaxDistance = 500
		snd.Parent = g.leaves[1].part
		snd:Play()
		task.delay(duration + 1, function()
			snd:Destroy()
		end)
	end
end

------------------------------------------------------------------
-- Сессии (одна группа = один лабиринт)
------------------------------------------------------------------
local function setPhase(s, phase, len)
	s.phase, s.phaseStart, s.phaseLen = phase, os.clock(), len
	local now = workspace:GetServerTimeNow()
	for _, p in ipairs(s.players) do
		p:SetAttribute("Phase", phase)
		p:SetAttribute("PhaseStart", now)
		p:SetAttribute("PhaseLen", len)
		p:SetAttribute("Day", s.day)
	end
end

local function endSession(s)
	if s.ended then
		return
	end
	s.ended = true
	clearMonsters(s, false)
	for _, p in ipairs(table.clone(s.players)) do
		local st = state[p]
		if st and p.Parent then
			st.session = nil
			st.downed = false
			st.hidden, st.sleeping = nil, nil
			p:SetAttribute("Downed", false)
			p:SetAttribute("Hidden", false)
			p:SetAttribute("Sleeping", false)
			p:SetAttribute("InMatch", false)
			freshInventory(p)
			p:LoadCharacter()
		end
	end
	s.folder:Destroy()
	World.ClearTerrain(s.O, s.exit and s.exit.pit)
	usedSlots[s.slot] = nil
	sessions[s] = nil
end

local function leaveSession(p)
	local st = state[p]
	local s = st and st.session
	if not s then
		return
	end
	st.session = nil
	local i = table.find(s.players, p)
	if i then
		table.remove(s.players, i)
	end
	if #s.players == 0 then
		endSession(s)
	end
end

-- вернуть игрока в лобби (умер, и поднять некому)
function returnToLobby(p)
	local st = state[p]
	if not st then
		return
	end
	if st.revivePrompt then
		st.revivePrompt:Destroy()
		st.revivePrompt = nil
	end
	if st.dragPrompt then
		st.dragPrompt:Destroy()
		st.dragPrompt = nil
	end
	if st.draggedBy then
		stopDrag(st.draggedBy)
	end
	stopDrag(p)
	st.downed = false
	st.hidden, st.sleeping = nil, nil
	leaveSession(p)
	p:SetAttribute("Downed", false)
	p:SetAttribute("Hidden", false)
	p:SetAttribute("Sleeping", false)
	p:SetAttribute("InMatch", false)
	freshInventory(p)
	p:LoadCharacter()
end

-- упал в пропасть или в пустоту — возвращаем обратно
task.spawn(function()
	while true do
		task.wait(0.5)
		for _, p in ipairs(Players:GetPlayers()) do
			local st = state[p]
			local hrp = hrpOf(p)
			if st and hrp and not p:GetAttribute("Jailed") then
				local s = st.session
				local floorY = s and s.O.Y or World.LOBBY.Y
				if hrp.Position.Y < floorY - 30 then
					if s then
						local nearExit = s.exit and (hrp.Position - s.exit.exitOut.Position).Magnitude < 200
						if nearExit then
							place(p, s.exit.exitOut * CFrame.new(0, 4, 6), false)
						else
							place(p, s.clearing.liftSpawn, false)
						end
					else
						place(p, lobby.spawn.CFrame + V(0, 4, 0), false)
					end
					notify(p, "Ты упал! Возвращаем обратно.")
				end
			end
		end
	end
end)

-- карта лабиринта: стены отправляются клиентам (рисуются по Tab)
function sendMap(s)
	local walls = {}
	for _, w in ipairs(s.maze.mapWalls) do
		table.insert(walls, { w[1] == "X" and 1 or 2, math.floor(w[2] * 10) / 10, math.floor(w[3] * 10) / 10, math.floor(w[4] * 10) / 10, w[5] })
	end
	for _, q in ipairs(s.players) do
		R.MapData:FireClient(q, walls, s.O, World.CLEARING_HALF, World.RADIUS, s.exit.exitOut.Position - s.O)
	end
end

local function connectPrompts(s, root, chests)
	for _, pr in ipairs(root:GetDescendants()) do
		if pr:IsA("ProximityPrompt") then
			if CollectionService:HasTag(pr, "NodePrompt") then
				pr.Triggered:Connect(function(p)
					local st = state[p]
					if not st or st.session ~= s or st.downed then
						return
					end
					local model = pr.Parent:FindFirstAncestorWhichIsA("Model")
					local nd = model and Items.Nodes[model:GetAttribute("Node")]
					if not nd then
						return
					end
					local tool = bestTool(p, nd.Tool)
					if not tool then
						notify(p, nd.Tool == "axe" and "Нужен топор" or "Нужна кирка")
						return
					end
					hitNode(p, model, tool)
				end)
			elseif CollectionService:HasTag(pr, "BerryPrompt") then
				pr.Triggered:Connect(function(p)
					if sessionOf(p) ~= s then
						return
					end
					local now = os.clock()
					if (pr:GetAttribute("Next") or 0) > now then
						notify(p, "Ягоды ещё не выросли")
						return
					end
					pr:SetAttribute("Next", now + 40)
					addRes(p, "berry", 3)
					notify(p, "+3 ягоды (H — съесть, лечит)")
				end)
			elseif CollectionService:HasTag(pr, "NotePrompt") then
				pr.Triggered:Connect(function(p)
					if sessionOf(p) == s then
						R.Note:FireClient(p, pr:GetAttribute("Title") or "Записка", pr:GetAttribute("Text") or "")
					end
				end)
			elseif CollectionService:HasTag(pr, "LootPrompt") then
				pr.Triggered:Connect(function(p)
					local st = state[p]
					if not st or st.session ~= s then
						return
					end
					if pr:GetAttribute("Looted") then
						notify(p, "Пусто")
						return
					end
					pr:SetAttribute("Looted", true)
					pr.Enabled = false
					local pool = { { "wood", 3, 6 }, { "stone", 3, 6 }, { "fiber", 2, 4 }, { "berry", 2, 3 }, { "bandage", 1, 1 }, { "iron", 1, 3 } }
					local got = {}
					for _ = 1, 2 do
						local e = pool[math.random(1, #pool)]
						local n = math.random(e[2], e[3])
						addRes(p, e[1], n)
						table.insert(got, "+" .. n .. " " .. Items.Resources[e[1]].Name)
					end
					notify(p, (pr.ObjectText ~= "" and pr.ObjectText or "Находка") .. ": " .. table.concat(got, ", "))
				end)
			elseif CollectionService:HasTag(pr, "MapPrompt") then
				pr.Triggered:Connect(function(p)
					local st = state[p]
					if not st or st.session ~= s or s.mazeFixed.mapFound then
						return
					end
					s.mazeFixed.mapFound = true
					pr.Parent:Destroy()
					for _, q in ipairs(s.players) do
						addRes(q, "map", 1)
					end
					sendMap(s)
					notifySession(s, p.DisplayName .. " нашёл КАРТУ ЛАБИРИНТА! Нажми Tab, чтобы открыть. Карта сама меняется вместе со стенами.")
				end)
			elseif CollectionService:HasTag(pr, "HidePrompt") then
				local spot = pr.Parent
				pr.Triggered:Connect(function(p)
					local st = state[p]
					if not st or st.session ~= s or st.downed then
						return
					end
					if st.hidden then
						unhide(p)
						return
					end
					if spot:GetAttribute("Occupied") then
						notify(p, "Тут уже кто-то прячется")
						return
					end
					local hrp, char = hrpOf(p)
					if not hrp then
						return
					end
					-- откуда залезли — туда и вылезем
					local flat = (hrp.Position - spot.Position) * V(1, 0, 1)
					spot:SetAttribute("Out", spot.Position * V(1, 0, 1) + V(0, hrp.Position.Y - 1, 0) + (flat.Magnitude > 0.1 and flat.Unit or V(0, 0, 1)) * 6)
					spot:SetAttribute("Occupied", true)
					st.hidden = spot
					p:SetAttribute("Hidden", true)
					pr.ActionText = "Вылезти"
					hrp.Anchored = true
					char:PivotTo(CFrame.lookAt(spot.Position, spot.Position - flat))
					notify(p, "Ты спрятался в лианах. Скрежетники тебя не видят. E — вылезти.")
				end)
			elseif CollectionService:HasTag(pr, "FiberPrompt") then
				pr.Triggered:Connect(function(p)
					if sessionOf(p) ~= s then
						return
					end
					local now = os.clock()
					if (pr:GetAttribute("Next") or 0) > now then
						notify(p, "Трава ещё не отросла")
						return
					end
					pr:SetAttribute("Next", now + 30)
					addRes(p, "fiber", 2)
					notify(p, "+2 травы (для бинтов, факелов, копья)")
				end)
			end
		end
	end
	for _, c in ipairs(chests or {}) do
		c.prompt.Triggered:Connect(function(p)
			local st = state[p]
			if not st or st.session ~= s then
				return
			end
			if c.model:GetAttribute("Opened") then
				notify(p, "Сундук пуст")
				return
			end
			c.model:SetAttribute("Opened", true)
			c.prompt.Enabled = false
			c.lid.CFrame = c.lid.CFrame * CFrame.new(0, 0.6, 1.2) * CFrame.Angles(math.rad(70), 0, 0)
			local got = {}
			local function gain(k, n)
				addRes(p, k, n)
				table.insert(got, "+" .. n .. " " .. Items.Resources[k].Name)
			end
			if c.model:GetAttribute("Golden") then
				local glow = c.model:FindFirstChild("KeyGlow")
				if glow then
					glow:Destroy()
				end
				gain("key", 1)
				s.mazeFixed.keyTaken = true
				gain("crystal", 3)
				gain("iron", 5)
				notifySession(s, p.DisplayName .. " нашёл КЛЮЧ-КАРТУ! Найдите выход и вставьте её в считыватель.")
			else
				local depth = c.model:GetAttribute("Depth") or 5
				local pool = { { "wood", 4, 8 }, { "stone", 4, 8 }, { "berry", 2, 4 }, { "fiber", 2, 4 }, { "bandage", 1, 2 } }
				if depth > 6 then
					table.insert(pool, { "iron", 2, 5 })
				end
				if depth > 14 then
					table.insert(pool, { "crystal", 1, 3 })
				end
				for _ = 1, 2 do
					local e = pool[math.random(1, #pool)]
					gain(e[1], math.random(e[2], e[3]))
				end
				-- иногда в сундуке броня
				if math.random() < 0.12 then
					local tier = depth > 14 and 2 or 1
					if giveArmor(p, tier, true) then
						table.insert(got, Items.Armor[tier].Name)
					end
				end
				if math.random() < 0.2 then
					local tool = ({ "spear", "stone_sword", "torch" })[math.random(1, 3)]
					if not table.find(st.tools, tool) then
						table.insert(st.tools, tool)
						p:SetAttribute("Tools", HttpService:JSONEncode(st.tools))
						table.insert(got, Items.toolName(tool))
					end
				end
			end
			notify(p, "Сундук: " .. table.concat(got, ", "))
		end)
	end
end

local function connectExit(s)
	local ex = s.exit
	-- подошёл к туннелю — ролик: идём по мосту к двери лаборатории
	ex.trigger.Touched:Connect(function(hit)
		local p = Players:GetPlayerFromCharacter(hit.Parent)
		local st = p and state[p]
		if not st or st.session ~= s or st.introSeen or st.downed or s.won then
			return
		end
		st.introSeen = true
		local hrp = hrpOf(p)
		if hrp then
			hrp.Anchored = true
		end
		R.ExitIntro:FireClient(p, ex.introPts, ex.reader.Position)
		task.delay(7.5, function()
			if st.session == s and not s.won then
				place(p, ex.doorFront, false)
			end
		end)
	end)
	ex.exitPrompt.Triggered:Connect(function(p)
		local st = state[p]
		if not st or st.session ~= s or s.won or st.downed then
			return
		end
		if (st.res.key or 0) < 1 then
			for _, q in ipairs(s.players) do
				if state[q] and (state[q].res.key or 0) > 0 then
					notify(p, "Ключ-карта у " .. q.DisplayName .. " — пусть приложит её сам.")
					return
				end
			end
			notify(p, "Нужна ключ-карта — она в золотом сундуке в самом дальнем тупике.")
			return
		end
		s.won = true
		clearMonsters(s, true)
		local hrp = hrpOf(p)
		if hrp then
			hrp.Anchored = true
		end
		R.CardInsert:FireClient(p, ex.reader.Position)
		task.delay(1.8, function()
			ex.readerLight.Color = Color3.fromRGB(60, 255, 90)
			notifySession(s, p.DisplayName .. " приложил ключ-карту! Дверь открывается...")
			TweenService:Create(ex.exitDoor, TweenInfo.new(3, Enum.EasingStyle.Sine), { CFrame = ex.exitDoor.CFrame + V(0, 15.5, 0) }):Play()
			local coins = Config.CoinsEscape * s.diff.Coins
			for _, q in ipairs(s.players) do
				addCoins(q, coins)
				local qh = hrpOf(q)
				if qh then
					qh.Anchored = true
				end
				R.Outro:FireClient(q, {
					exitOut = ex.exitOut,
					doorFront = ex.doorFront,
					doorEye = ex.doorEye,
					labStart = ex.labStart,
					labEnd = ex.labEnd,
					backDoor = ex.labBackDoor,
					pad = ex.helipad,
					mazeCenter = s.O,
					players = s.players,
					day = s.day,
					coins = coins,
				})
			end
			task.delay(48, function()
				endSession(s)
			end)
		end)
	end)
end

-- каждую ночь лабиринт перестраивается: другие коридоры, сундуки, шахты
local function regenMaze(s)
	local old = s.maze.model
	s.maze = World.BuildMazeLayout(s.folder, math.random(1, 1e6), s.O, s.mazeFixed)
	old:Destroy()
	connectPrompts(s, s.maze.model, s.maze.chests)
	sendMap(s)
	-- новые стены раздавили постройки — убираем их
	local op = OverlapParams.new()
	op.FilterType = Enum.RaycastFilterType.Include
	op.FilterDescendantsInstances = { s.maze.model }
	for key, piece in pairs(s.pieces) do
		if piece.Parent then
			local cf, size = piece:GetBoundingBox()
			for _, hitPart in ipairs(workspace:GetPartBoundsInBox(cf, size - V(0.5, 0.5, 0.5), op)) do
				if hitPart.Name == "MazeWall" then
					piece:Destroy()
					s.pieces[key] = nil
					break
				end
			end
		end
	end
	-- игроков, оказавшихся в стене, выталкиваем в ближайший коридор
	for _, q in ipairs(s.players) do
		local hrp = hrpOf(q)
		if hrp and not inSafeZone(s, hrp.Position) then
			R.MazeShift:FireClient(q)
			local stuck = false
			for _, hitPart in ipairs(workspace:GetPartBoundsInBox(hrp.CFrame, V(2, 4, 2), op)) do
				if hitPart.Name == "MazeWall" or hitPart.Name == "CrawlCover" then
					stuck = true
				end
			end
			if stuck then
				local best, bd
				for _, c in ipairs(s.maze.cells) do
					local d = (c - hrp.Position).Magnitude
					if not bd or d < bd then
						best, bd = c, d
					end
				end
				if best then
					place(q, CFrame.new(best + V(0, 4, 0)), false)
				end
			end
		end
	end
end

local function connectSessionPrompts(s)
	s.clearing.supplyPrompt.Triggered:Connect(function(p)
		local st = state[p]
		if not st or st.session ~= s then
			return
		end
		if st.gotSupply then
			notify(p, "Ты уже забрал свои припасы")
			return
		end
		st.gotSupply = true
		addRes(p, "wood", 14)
		addRes(p, "stone", 6)
		addRes(p, "fiber", 3)
		addRes(p, "berry", 3)
		notify(p, "Припасы: +14 дерева, +6 камня, +3 травы, +3 ягоды. Нажми C — крафт.")
	end)
	connectPrompts(s, s.clearing.model, {})
	connectPrompts(s, s.maze.model, s.maze.chests)
	connectExit(s)
end

local function sessionLoop(s)
	while not s.ended do
		setPhase(s, "day", s.diff.Day)
		for _, q in ipairs(s.players) do
			wake(q)
		end
		if s.gatesClosed then
			moveGates(s, false, 6)
			notifySession(s, "Рассвет. Врата открываются. День " .. s.day .. ".")
		end
		clearMonsters(s, true)
		local t0 = os.clock()
		local warned = false
		while not s.ended and os.clock() - t0 < s.diff.Day and not s.skip do
			if not warned and s.diff.Day - (os.clock() - t0) <= Config.WarningTime then
				warned = true
				notifySession(s, "Скоро закат! Врата закроются через " .. Config.WarningTime .. " секунд — возвращайтесь на поляну!")
			end
			task.wait(0.25)
		end
		s.skip = false
		if s.ended then
			break
		end
		setPhase(s, "night", s.diff.Night)
		moveGates(s, true, 8)
		task.delay(9, function()
			if s.phase == "night" and not s.ended and not s.won then
				regenMaze(s)
				notifySession(s, "Земля дрожит... Стены лабиринта сдвинулись. Коридоры теперь другие.")
			end
		end)
		notifySession(s, "Ночь. Врата закрылись. В лабиринте — Скрежетники...")
		task.delay(11, function()
			if s.phase == "night" and not s.won then
				spawnMonsters(s)
			end
		end)
		t0 = os.clock()
		while not s.ended and os.clock() - t0 < s.diff.Night and not s.skip do
			task.wait(0.25)
		end
		s.skip = false
		if s.ended then
			break
		end
		s.day += 1
		-- монеты за прожитую ночь
		for _, p in ipairs(s.players) do
			local st = state[p]
			if st and not st.downed then
				local c = Config.CoinsPerDay * s.diff.Coins
				addCoins(p, c)
				notify(p, "Ты пережил ночь! +" .. c .. " монет")
			end
		end
	end
end

local function openLiftGrate(s)
	local grate = s.clearing.grate
	local closed = s.clearing.grateClosed
	task.spawn(function()
		for i = 1, 30 do
			grate:PivotTo(closed + V(0, 15 * i / 30, 0))
			task.wait(0.03)
		end
		-- решётка остаётся открытой, чтобы никто не оказался заперт в лифте
	end)
end

local function startSession(riders, diffId)
	local slot
	for i = 1, 50 do
		if not usedSlots[i] then
			slot = i
			break
		end
	end
	if not slot then
		for _, p in ipairs(riders) do
			notify(p, "Все лабиринты заняты, попробуйте позже")
		end
		return
	end
	usedSlots[slot] = true
	local O = V(slot * Config.SlotSpacing, 0, 0)
	local s = {
		slot = slot,
		O = O,
		diff = Config.Difficulty[diffId],
		diffId = diffId,
		players = riders,
		monsters = {},
		benches = {},
		day = 1,
		gatesClosed = true,
	}
	sessions[s] = s
	s.folder = Instance.new("Folder")
	s.folder.Name = "Session_" .. slot
	s.folder.Parent = workspace
	s.pieces = {}
	s.buildFolder = Instance.new("Folder")
	s.buildFolder.Name = "Buildings"
	s.buildFolder.Parent = s.folder
	local seed = math.random(1, 1e6)
	World.BuildTerrain(O)
	s.clearing = World.BuildClearing(s.folder, seed, O)
	World.BuildClearingTerrain(O, s.clearing.lakeCenter)
	s.gates = World.BuildClearingWalls(s.folder, O)
	s.mazeFixed = { keyTaken = false, mapFound = false }
	s.maze = World.BuildMazeLayout(s.folder, seed + 7, O, s.mazeFixed)
	s.mazeFixed.exit = s.maze.exit
	s.exit = World.BuildExit(s.folder, O, s.maze.exit)
	World.BuildOuterForest(s.folder, O, seed, { s.exit.zone })
	connectSessionPrompts(s)
	for _, p in ipairs(riders) do
		local st = state[p]
		st.session = s
		st.introSeen = false
		st.downed = false
		freshInventory(p)
		p:SetAttribute("InMatch", true)
		p:SetAttribute("Difficulty", diffId)
		p:SetAttribute("SessionO", O)
	end
	-- лифт приехал
	for i, p in ipairs(riders) do
		local off = V(((i - 1) % 3 - 1) * 4, 0, math.floor((i - 1) / 3) * 4)
		place(p, s.clearing.liftSpawn + off, true)
		R.Arrive:FireClient(p, s.clearing.liftPos, riders)
	end
	openLiftGrate(s)
	moveGates(s, false, 0.1)
	task.delay(7, function()
		for _, p in ipairs(s.players) do
			local hrp = hrpOf(p)
			if hrp then
				hrp.Anchored = false
			end
		end
	end)
	task.spawn(sessionLoop, s)
end

function respawnAtClearing(p)
	local st = state[p]
	if not st then
		return
	end
	st.downed = false
	p:SetAttribute("Downed", false)
	if st.revivePrompt then
		st.revivePrompt:Destroy()
		st.revivePrompt = nil
	end
	if st.dragPrompt then
		st.dragPrompt:Destroy()
		st.dragPrompt = nil
	end
	if st.draggedBy then
		stopDrag(st.draggedBy)
	end
	stopDrag(p)
	p:LoadCharacter()
end

------------------------------------------------------------------
-- Лифты в лобби: настройки хозяина (только друзья, сколько игроков), отсчёт
------------------------------------------------------------------
local lifts = {}
for id, e in pairs(lobby.elevators) do
	lifts[id] = { id = id, label = e.label, zone = e.zone, outside = e.outside, host = nil, friendsOnly = false, max = Config.Elevator.MaxPlayers, countdownEnd = nil, riding = false, goNow = false }
end
local friendCache = {}
local function isFriend(a, b)
	local key = math.min(a.UserId, b.UserId) .. "_" .. math.max(a.UserId, b.UserId)
	if friendCache[key] == nil then
		local ok, res = pcall(function()
			return a:IsFriendsWith(b.UserId)
		end)
		friendCache[key] = ok and res or false
	end
	return friendCache[key]
end

local function inZone(zone, pos)
	local rel = zone.CFrame:PointToObjectSpace(pos)
	local h = zone.Size / 2
	return math.abs(rel.X) < h.X and math.abs(rel.Y) < h.Y + 4 and math.abs(rel.Z) < h.Z
end

R.LiftSettings.OnServerEvent:Connect(function(p, action, value)
	for _, lift in pairs(lifts) do
		if lift.host == p then
			if action == "friends" and typeof(value) == "boolean" then
				lift.friendsOnly = value
			elseif action == "max" and typeof(value) == "number" then
				lift.max = math.clamp(math.floor(value), 1, Config.Elevator.MaxPlayers)
			elseif action == "go" then
				lift.goNow = true
			elseif action == "diff" and typeof(value) == "string" and Config.Difficulty[value] then
				lift.diff = value
			end
		end
	end
end)

task.spawn(function()
	while true do
		task.wait(0.4)
		for _, lift in pairs(lifts) do
			if not lift.riding then
				local inside = {}
				for _, p in ipairs(Players:GetPlayers()) do
					local st = state[p]
					local hrp = hrpOf(p)
					if st and not st.session and hrp and inZone(lift.zone, hrp.Position) then
						table.insert(inside, p)
					end
				end
				if lift.host and not table.find(inside, lift.host) then
					lift.host = nil
				end
				if not lift.host and inside[1] then
					lift.host = inside[1]
					lift.friendsOnly = false
					lift.max = Config.Elevator.MaxPlayers
					lift.diff = "normal"
				end
				-- кто не проходит по правилам — выходит из лифта
				local allowed = {}
				for _, p in ipairs(inside) do
					local ok = true
					if p ~= lift.host then
						if lift.friendsOnly and not isFriend(p, lift.host) then
							ok = false
							notify(p, "Этот лифт только для друзей " .. lift.host.DisplayName)
						elseif #allowed >= lift.max then
							ok = false
							notify(p, "Лифт заполнен (" .. lift.max .. " игроков)")
						end
					end
					if ok then
						table.insert(allowed, p)
					else
						place(p, lift.outside, false)
					end
				end
				if #allowed > 0 then
					lift.countdownEnd = lift.countdownEnd or (os.clock() + Config.Elevator.Countdown)
				else
					lift.countdownEnd = nil
					lift.goNow = false
				end
				local left = lift.countdownEnd and math.max(0, math.ceil(lift.countdownEnd - os.clock())) or -1
				local dname = Config.Difficulty[lift.diff or "normal"].Name
				if lift.label then
					lift.label.Text = #allowed > 0 and (dname .. "  " .. #allowed .. "/" .. lift.max .. "  ·  " .. left .. "с") or "ЛИФТ"
				end
				for _, p in ipairs(Players:GetPlayers()) do
					if table.find(allowed, p) then
						p:SetAttribute("LiftId", lift.id)
						p:SetAttribute("LiftHost", p == lift.host)
						p:SetAttribute("LiftHostName", lift.host and lift.host.DisplayName or "")
						p:SetAttribute("LiftFriends", lift.friendsOnly)
						p:SetAttribute("LiftMax", lift.max)
						p:SetAttribute("LiftCount", #allowed)
						p:SetAttribute("LiftCountdown", left)
						p:SetAttribute("LiftDiff", lift.diff or "normal")
					elseif p:GetAttribute("LiftId") == lift.id then
						p:SetAttribute("LiftId", nil)
					end
				end
				if #allowed > 0 and (left <= 0 or lift.goNow) then
					lift.riding = true
					lift.countdownEnd = nil
					lift.goNow = false
					lift.host = nil
					for _, p in ipairs(allowed) do
						p:SetAttribute("LiftId", nil)
						local hrp = hrpOf(p)
						if hrp then
							hrp.Anchored = true
						end
						R.PlayElevator:FireClient(p, allowed, Config.Elevator.RideTime, lift.diff or "normal")
					end
					task.spawn(function()
						task.wait(Config.Elevator.RideTime)
						local riders = {}
						for _, p in ipairs(allowed) do
							if p.Parent then
								table.insert(riders, p)
							end
						end
						if #riders > 0 then
							startSession(riders, lift.diff or "normal")
						end
						lift.riding = false
					end)
				end
			end
		end
	end
end)

------------------------------------------------------------------
-- Торговец классами
------------------------------------------------------------------
lobby.merchantPrompt.Triggered:Connect(function(p)
	R.ShopOpen:FireClient(p)
end)

local function classById(id)
	for _, c in ipairs(Config.Classes) do
		if c.Id == id then
			return c
		end
	end
end

R.ShopBuy.OnServerEvent:Connect(function(p, id)
	local pr = profiles[p]
	local c = typeof(id) == "string" and classById(id)
	if not pr or not c then
		return
	end
	if table.find(pr.owned, id) then
		pr.class = id
	elseif pr.coins >= c.Price then
		pr.coins -= c.Price
		table.insert(pr.owned, id)
		pr.class = id
		notify(p, "Куплен класс «" .. c.Name .. "»!")
	else
		notify(p, "Не хватает монет: нужно " .. c.Price)
		return
	end
	syncProfile(p)
	saveProfile(p)
end)

------------------------------------------------------------------
-- Пригнуться (Ctrl): пролезать в щели
------------------------------------------------------------------
R.Crouch.OnServerEvent:Connect(function(p, on)
	local _, char = hrpOf(p)
	if not char or typeof(on) ~= "boolean" then
		return
	end
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CollisionGroup = on and "Crawler" or "Default"
		end
	end
	p:SetAttribute("Crouched", on)
	-- поза приседа видна всем: туловище ниже и наклонено, ноги согнуты
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local torso = char:FindFirstChild("Torso")
	local joints = {
		hrp and hrp:FindFirstChild("RootJoint"),
		torso and torso:FindFirstChild("Right Hip"),
		torso and torso:FindFirstChild("Left Hip"),
	}
	for k, j in ipairs(joints) do
		if j and j:IsA("Motor6D") then
			local c0 = j:GetAttribute("C0Base")
			if not c0 then
				c0 = j.C0
				j:SetAttribute("C0Base", c0)
			end
			if not on then
				j.C0 = c0
			elseif k == 1 then
				j.C0 = CFrame.new(0, -1, 0) * CFrame.Angles(math.rad(-20), 0, 0) * c0
			else
				local pivot = c0.Position
				j.C0 = CFrame.new(pivot) * CFrame.Angles(math.rad(55), 0, 0) * CFrame.new(-pivot) * c0
			end
		end
	end
end)

------------------------------------------------------------------
-- Игроки
------------------------------------------------------------------
-- Квадратный персонаж (R6) из аватара игрока: одежда и цвета сохраняются
local animTemplate = Shared:WaitForChild("R6Animate")
local descCache = {}
local function morphR6(p, oldChar)
	local desc = descCache[p]
	if not desc then
		local ok, d = pcall(function()
			return Players:GetHumanoidDescriptionFromUserId(math.max(1, p.UserId))
		end)
		desc = ok and d or Instance.new("HumanoidDescription")
		descCache[p] = desc
	end
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R6)
	end)
	if not ok or not model or not oldChar.Parent then
		return false
	end
	model.Name = p.Name
	model:SetAttribute("Morphed", true)
	local oldAnim = model:FindFirstChild("Animate")
	if oldAnim then
		oldAnim:Destroy()
	end
	local anim = animTemplate:Clone()
	anim.Name = "Animate"
	anim.Disabled = false
	anim.Parent = model
	model:PivotTo(oldChar:GetPivot())
	p.Character = model
	model.Parent = workspace
	oldChar:Destroy()
	return true
end

local function onCharacter(p, char)
	local st = state[p]
	local hrp = char:WaitForChild("HumanoidRootPart", 5)
	local hum = char:WaitForChild("Humanoid", 5)
	if not hrp or not hum or not st then
		return
	end
	if hum.RigType == Enum.HumanoidRigType.R15 and not char:GetAttribute("Morphed") then
		if morphR6(p, char) then
			return -- CharacterAdded сработает ещё раз уже для квадратного персонажа
		end
	end
	hum.BreakJointsOnDeath = false
	hum.RequiresNeck = false
	hum.WalkSpeed = Config.WalkSpeed
	if classOf(p) == "warrior" then
		hum.MaxHealth = 140
		hum.Health = 140
	end
	-- смерть от чего-то другого (например, падение) = ранение
	hum.HealthChanged:Connect(function(h)
		if h <= 0 and st.session and not st.downed then
			hum.Health = 1
			down(p)
		end
	end)
	p:SetAttribute("Crouched", false)
	task.delay(0.5, function()
		armorVisual(p)
		if p:GetAttribute("Invisible") then
			applyInvisible(p)
		end
		-- из тюрьмы не сбежать перезаходом в персонажа
		if p:GetAttribute("Jailed") then
			putInJail(p)
		end
	end)
	p:SetAttribute("Hidden", false)
	p:SetAttribute("Sleeping", false)
	st.hidden, st.sleeping = nil, nil
	task.wait()
	if st.session then
		place(p, st.session.clearing.liftSpawn, false)
	else
		char:PivotTo(lobby.spawn.CFrame + V(math.random(-4, 4), 4, math.random(-2, 2)))
	end
	updateHeld(p)
end

local function onPlayer(p)
	state[p] = { res = {}, tools = {} }
	loadProfile(p)
	freshInventory(p)
	p:SetAttribute("InMatch", false)
	p.CharacterAdded:Connect(function(char)
		onCharacter(p, char)
	end)
	if p.Character then
		task.spawn(onCharacter, p, p.Character)
	end
end
Players.PlayerAdded:Connect(onPlayer)
for _, p in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayer, p)
end
Players.PlayerRemoving:Connect(function(p)
	local st = state[p]
	if st then
		stopDrag(p)
		if st.draggedBy then
			stopDrag(st.draggedBy)
		end
	end
	leaveSession(p)
	saveProfile(p)
	state[p] = nil
	profiles[p] = nil
end)

------------------------------------------------------------------
-- Тестовые кнопки
------------------------------------------------------------------
-- админ-панель: коды проверяются только на сервере
-- одна админ-панель (полная), код 3535
local ADMIN_CODES = { ["3535"] = 2 }
local adminTries = {}
R.Admin.OnServerEvent:Connect(function(p, code)
	local n = (adminTries[p] or 0) + 1
	adminTries[p] = n
	if n > 10 or typeof(code) ~= "string" then
		return
	end
	local clean = code:gsub("%s", "")
	-- код 444: свой «фонарик» — можно включать полный свет (L)
	if clean == "444" then
		p:SetAttribute("Light", true)
		return
	end
	local lvl = ADMIN_CODES[clean]
	if lvl and lvl > (p:GetAttribute("Admin") or 0) then
		p:SetAttribute("Admin", lvl)
	end
end)

------------------------------------------------------------------
-- Приколы главной админки
------------------------------------------------------------------
-- невидимость: ни тела, ни ника, монстры не трогают
function applyInvisible(p)
	local char = p.Character
	if not char then
		return
	end
	local on = p:GetAttribute("Invisible") == true
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") or d:IsA("Decal") then
			if d:GetAttribute("T0") == nil then
				d:SetAttribute("T0", d.Transparency)
			end
			d.Transparency = on and 1 or d:GetAttribute("T0")
		end
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = on and Enum.HumanoidDisplayDistanceType.None or Enum.HumanoidDisplayDistanceType.Viewer
		hum.NameDisplayDistance = on and 0 or 100
	end
	p:SetAttribute("DevGhost", on)
end

-- тюрьма: каменная клетка далеко-далеко в пустоте
local JAIL = V(-6000, 400, -6000)
local function buildJail()
	local m = Instance.new("Model")
	m.Name = "Jail"
	local function box(cf, size, color, mat, transp)
		local pt = Instance.new("Part")
		pt.Anchored = true
		pt.Size = size
		pt.CFrame = cf
		pt.Color = color
		pt.Material = mat
		pt.Transparency = transp or 0
		pt.Parent = m
		return pt
	end
	local stone, dark = Color3.fromRGB(70, 70, 74), Color3.fromRGB(40, 40, 44)
	box(CFrame.new(JAIL), V(24, 2, 24), stone, Enum.Material.Slate)
	box(CFrame.new(JAIL + V(0, 16, 0)), V(24, 2, 24), stone, Enum.Material.Slate)
	for _, d in ipairs({ V(1, 0, 0), V(-1, 0, 0), V(0, 0, 1), V(0, 0, -1) }) do
		local wallCF = CFrame.new(JAIL + d * 11 + V(0, 8, 0))
		local size = d.X ~= 0 and V(2, 14, 24) or V(24, 14, 2)
		if d.Z == -1 then
			-- стена из решётки: всё видно, но не выйти
			box(wallCF, size, dark, Enum.Material.Glass, 0.7)
			for k = -10, 10, 2 do
				box(CFrame.new(JAIL + d * 11 + V(k, 8, 0)), V(0.4, 14, 0.4), dark, Enum.Material.Metal)
			end
		else
			box(wallCF, size, stone, Enum.Material.Slate)
		end
	end
	local lamp = box(CFrame.new(JAIL + V(0, 14.6, 0)), V(4, 0.4, 4), Color3.fromRGB(255, 230, 180), Enum.Material.Neon)
	local l = Instance.new("PointLight")
	l.Range = 24
	l.Parent = lamp
	local sign = box(CFrame.new(JAIL + V(0, 13, -9.8)), V(12, 2.4, 0.2), Color3.fromRGB(20, 20, 20), Enum.Material.SmoothPlastic)
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Back
	sg.Parent = sign
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.TextScaled = true
	t.Font = Enum.Font.GothamBlack
	t.TextColor3 = Color3.fromRGB(255, 80, 70)
	t.Text = "ТЮРЬМА"
	t.Parent = sg
	m.Parent = workspace
end
buildJail()

function putInJail(p)
	local hrp = hrpOf(p)
	if hrp then
		place(p, CFrame.new(JAIL + V(0, 4, 0)), false)
	end
end

-- центр «главного острова»: поляна сессии админа или лобби
local function prankTarget(p)
	local s = sessionOf(p)
	if s then
		return s.O, s.players, s
	end
	local list = {}
	for _, q in ipairs(Players:GetPlayers()) do
		if not sessionOf(q) then
			table.insert(list, q)
		end
	end
	return World.LOBBY, list, nil
end

local function prankAll(list, kind, msg)
	for _, q in ipairs(list) do
		R.Prank:FireClient(q, kind)
		if msg then
			notify(q, msg)
		end
	end
end

local function nuke(p)
	local center, list = prankTarget(p)
	prankAll(list, "siren", "☢ ВНИМАНИЕ! ЯДЕРНЫЙ УДАР ЧЕРЕЗ 5 СЕКУНД! ☢")
	local folder = Instance.new("Folder")
	folder.Name = "Nuke"
	folder.Parent = workspace
	local rocket = Instance.new("Part")
	rocket.Anchored = true
	rocket.CanCollide = false
	rocket.Size = V(3, 12, 3)
	rocket.Color = Color3.fromRGB(60, 70, 60)
	rocket.Material = Enum.Material.Metal
	rocket.CFrame = CFrame.new(center + V(0, 500, 0))
	rocket.Parent = folder
	local fireTail = Instance.new("Fire")
	fireTail.Size = 8
	fireTail.Parent = rocket
	TweenService:Create(rocket, TweenInfo.new(5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { CFrame = CFrame.new(center + V(0, 8, 0)) }):Play()
	task.delay(5, function()
		rocket:Destroy()
		prankAll(list, "flash")
		local ex = Instance.new("Explosion")
		ex.Position = center + V(0, 5, 0)
		ex.BlastRadius = 90
		ex.BlastPressure = 250000
		ex.DestroyJointRadiusPercent = 0
		ex.Parent = workspace
		-- огненный шар и гриб
		local ball = Instance.new("Part")
		ball.Shape = Enum.PartType.Ball
		ball.Anchored = true
		ball.CanCollide = false
		ball.CanQuery = false
		ball.Material = Enum.Material.Neon
		ball.Color = Color3.fromRGB(255, 150, 40)
		ball.Size = V(10, 10, 10)
		ball.CFrame = CFrame.new(center + V(0, 10, 0))
		ball.Parent = folder
		TweenService:Create(ball, TweenInfo.new(3, Enum.EasingStyle.Quad), { Size = V(220, 220, 220), Transparency = 1 }):Play()
		local stem = Instance.new("Part")
		stem.Anchored = true
		stem.CanCollide = false
		stem.CanQuery = false
		stem.Material = Enum.Material.Slate
		stem.Color = Color3.fromRGB(120, 100, 90)
		stem.Size = V(20, 10, 20)
		stem.CFrame = CFrame.new(center + V(0, 5, 0))
		stem.Parent = folder
		TweenService:Create(stem, TweenInfo.new(5), { Size = V(30, 160, 30), CFrame = CFrame.new(center + V(0, 80, 0)) }):Play()
		local cap = Instance.new("Part")
		cap.Shape = Enum.PartType.Ball
		cap.Anchored = true
		cap.CanCollide = false
		cap.CanQuery = false
		cap.Material = Enum.Material.Slate
		cap.Color = Color3.fromRGB(150, 120, 100)
		cap.Size = V(30, 20, 30)
		cap.CFrame = CFrame.new(center + V(0, 20, 0))
		cap.Parent = folder
		TweenService:Create(cap, TweenInfo.new(5), { Size = V(140, 70, 140), CFrame = CFrame.new(center + V(0, 170, 0)) }):Play()
		task.delay(8, function()
			for _, d in ipairs(folder:GetChildren()) do
				if d:IsA("BasePart") then
					TweenService:Create(d, TweenInfo.new(4), { Transparency = 1 }):Play()
				end
			end
			task.delay(4.5, function()
				folder:Destroy()
			end)
		end)
	end)
end

local function tsunami(p)
	local center, list, s = prankTarget(p)
	if not s then
		notify(p, "Цунами работает только в матче (на поляне)")
		return
	end
	prankAll(list, "rumble", "🌊 ЦУНАМИ! Держитесь!")
	local E = World.CLEARING_HALF
	local wave = Instance.new("Part")
	wave.Anchored = true
	wave.CanCollide = false
	wave.CanQuery = false
	wave.Material = Enum.Material.Glass
	wave.Color = Color3.fromRGB(40, 110, 150)
	wave.Transparency = 0.25
	wave.Size = V(E * 2 + 60, 46, 26)
	local from, to = center + V(0, 23, -E - 40), center + V(0, 23, E + 40)
	wave.CFrame = CFrame.new(from)
	wave.Parent = workspace
	local foam = Instance.new("Part")
	foam.Anchored = true
	foam.CanCollide = false
	foam.CanQuery = false
	foam.Material = Enum.Material.Neon
	foam.Color = Color3.fromRGB(230, 245, 255)
	foam.Size = V(E * 2 + 60, 4, 30)
	foam.CFrame = CFrame.new(from + V(0, 24, 0))
	foam.Parent = workspace
	local t0 = os.clock()
	local dur = 9
	local hitBy = {}
	while true do
		local a = math.min(1, (os.clock() - t0) / dur)
		local pos = from:Lerp(to, a)
		wave.CFrame = CFrame.new(pos)
		foam.CFrame = CFrame.new(pos + V(0, 24, 0))
		for _, q in ipairs(list) do
			local hrp = hrpOf(q)
			if hrp and math.abs(hrp.Position.Z - pos.Z) < 16 and math.abs(hrp.Position.X - pos.X) < E + 30 and not hitBy[q] then
				hitBy[q] = true
				hrp.AssemblyLinearVelocity = V(0, 45, 90)
			end
		end
		if a >= 1 then
			break
		end
		RunService.Heartbeat:Wait()
	end
	wave:Destroy()
	foam:Destroy()
	-- поляну затопило: настоящая вода, можно плавать
	local region = CFrame.new(center + V(0, 4, 0))
	pcall(function()
		workspace.Terrain:FillBlock(region, V(E * 2 - 8, 8, E * 2 - 8), Enum.Material.Water)
	end)
	prankAll(list, nil, "Поляну затопило! Вода уйдёт через 25 секунд.")
	task.delay(25, function()
		pcall(function()
			workspace.Terrain:FillBlock(region, V(E * 2 - 8, 8, E * 2 - 8), Enum.Material.Air)
		end)
	end)
end

-- денежный дождь: монеты падают на центр, кто подобрал — тому монеты по-настоящему
local function moneyRain(p)
	local center, list = prankTarget(p)
	prankAll(list, "coins", "💰 С неба падают монеты! Собирай у центра!")
	local folder = Instance.new("Folder")
	folder.Name = "MoneyRain"
	folder.Parent = workspace
	task.spawn(function()
		for _ = 1, 45 do
			local a, r = math.random() * math.pi * 2, 6 + math.random() * 30
			local c = Instance.new("Part")
			c.Name = "RainCoin"
			c.Shape = Enum.PartType.Cylinder
			c.Size = V(0.4, 2.4, 2.4)
			c.Color = Color3.fromRGB(255, 205, 60)
			c.Material = Enum.Material.Neon
			c.CFrame = CFrame.new(center + V(math.cos(a) * r, 70 + math.random() * 30, math.sin(a) * r)) * CFrame.Angles(0, 0, math.pi / 2)
			c.Parent = folder
			local taken = false
			c.Touched:Connect(function(hit)
				local q = Players:GetPlayerFromCharacter(hit.Parent)
				if q and not taken then
					taken = true
					addCoins(q, 10)
					notify(q, "+10 монет!")
					c:Destroy()
				end
			end)
			task.wait(0.15)
		end
	end)
	task.delay(45, function()
		folder:Destroy()
	end)
end

R.Dev.OnServerEvent:Connect(function(p, action, value)
	local lvl = p:GetAttribute("Admin") or 0
	if not Config.DevTools or lvl < 1 then
		return
	end
	local s = sessionOf(p)
	-- уровень 1 (друзья)
	if action == "ghost" and typeof(value) == "boolean" then
		p:SetAttribute("DevGhost", value)
	elseif action == "phase" and s then
		s.skip = true
	elseif action == "res" then
		for k in pairs(Items.Resources) do
			addRes(p, k, k == "key" and 1 or 30)
		end
		notify(p, "[Админ] +30 всех ресурсов и Ключ")
	elseif action == "toexit" and s and s.exit then
		place(p, s.exit.exitOut * CFrame.new(0, 4, 8), false)
	elseif lvl < 2 then
		return
	-- уровень 2 (главная)
	elseif action == "coins" then
		addCoins(p, 500)
	elseif action == "down" and s then
		down(p)
	elseif action == "invisible" then
		p:SetAttribute("Invisible", not p:GetAttribute("Invisible"))
		applyInvisible(p)
		notify(p, p:GetAttribute("Invisible") and "Ты невидим: ни тела, ни ника" or "Ты снова видим")
	elseif action == "tpto" and typeof(value) == "number" then
		local target = Players:GetPlayerByUserId(value)
		local th = target and hrpOf(target)
		if th then
			place(p, th.CFrame * CFrame.new(0, 0, 6), false)
		end
	elseif action == "bring" and typeof(value) == "number" then
		-- телепортировать игрока к себе
		local target = Players:GetPlayerByUserId(value)
		local mh = hrpOf(p)
		if target and target ~= p and mh and not target:GetAttribute("Jailed") then
			place(target, mh.CFrame * CFrame.new(0, 0, -6), false)
			notify(target, "Админ телепортировал тебя к себе")
		end
	elseif action == "give" and typeof(value) == "table" and typeof(value.uid) == "number" and typeof(value.item) == "string" then
		-- выдать игроку предмет или ресурс
		local target = Players:GetPlayerByUserId(value.uid)
		local tst = target and state[target]
		if not tst then
			return
		end
		local id = value.item
		if Items.Tools[id] and Items.Tools[id].Kind ~= "held" and Items.Tools[id].Kind ~= "fists" then
			if not table.find(tst.tools, id) then
				table.insert(tst.tools, id)
				target:SetAttribute("Tools", HttpService:JSONEncode(tst.tools))
			end
			notify(target, "Админ выдал тебе: " .. Items.toolName(id))
		elseif Items.Resources[id] then
			addRes(target, id, id == "key" and 1 or 10)
			notify(target, "Админ выдал тебе: " .. Items.Resources[id].Name .. (id == "key" and "" or " ×10"))
		elseif id:sub(1, 6) == "armor:" then
			local tier = tonumber(id:sub(7))
			if tier and Items.Armor[tier] then
				tst.armor = nil
				giveArmor(target, tier)
			end
		else
			return
		end
		notify(p, "Выдано игроку " .. target.DisplayName)
	elseif action == "kick" and typeof(value) == "number" then
		-- выгнать с сервера (зайти снова можно)
		local target = Players:GetPlayerByUserId(value)
		if target and target ~= p then
			target:Kick("Тебя выгнал админ. Можешь зайти снова.")
		end
	elseif action == "jail" and typeof(value) == "number" then
		-- посадить в тюрьму / выпустить
		local target = Players:GetPlayerByUserId(value)
		if target and target ~= p then
			if target:GetAttribute("Jailed") then
				target:SetAttribute("Jailed", false)
				target:LoadCharacter()
				notify(target, "Тебя выпустили из тюрьмы!")
				notify(p, target.DisplayName .. " на свободе")
			else
				leaveSession(target)
				local tst = state[target]
				if tst then
					tst.downed = false
				end
				target:SetAttribute("InMatch", false)
				target:SetAttribute("Downed", false)
				target:SetAttribute("Jailed", true)
				-- новый персонаж сразу появится в тюрьме
				target:LoadCharacter()
				notify(target, "Админ посадил тебя в тюрьму!")
				notify(p, target.DisplayName .. " в тюрьме")
			end
		end
	elseif action == "nuke" then
		nuke(p)
	elseif action == "tsunami" then
		task.spawn(tsunami, p)
	elseif action == "money" then
		moneyRain(p)
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Monster</string>
          <string name="Source"><![CDATA[-- Скрежетник — ночной монстр лабиринта. Патрулирует, видит и слышит игроков,
-- гонится, бьёт когтями. Не заходит на поляну.

local PathfindingService = game:GetService("PathfindingService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local S = Config.Monster

local Monster = {}
Monster.__index = Monster

local V = Vector3.new
local RGB = Color3.fromRGB
local SKIN = RGB(26, 24, 28)

-- Сервер держит только «скелет»: невидимый корпус + Humanoid (ходьба и поиск пути).
-- Само тело (слизень, 8 механических ног, жало) рисует клиент — MonsterView.lua,
-- поэтому ноги двигаются плавно и не грузят сеть.
local function buildRig()
	local m = Instance.new("Model")
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = V(6, 4, 12)
	root.Transparency = 1
	root.CanCollide = true
	root.Color = SKIN
	root.Parent = m
	m.PrimaryPart = root
	local head = Instance.new("Part")
	head.Name = "Head"
	head.Size = V(2, 2, 2)
	head.Transparency = 1
	head.CanCollide = false
	head.CanQuery = false
	head.Massless = true
	head.CFrame = root.CFrame * CFrame.new(0, 1, -6)
	head.Parent = m
	local w = Instance.new("WeldConstraint")
	w.Part0 = root
	w.Part1 = head
	w.Parent = head
	local hum = Instance.new("Humanoid")
	hum.RigType = Enum.HumanoidRigType.R15
	hum.HipHeight = 3.6
	hum.RequiresNeck = false
	hum.Parent = m
	return m
end

-- opts: parent, spawn (CFrame), patrol ({Vector3}), getPlayers(), inSafeZone(pos) -> bool,
-- damage(player, amount), health, speed, dmg
function Monster.new(opts)
	local self = setmetatable({}, Monster)
	self.opts = opts
	self.maxHealth = opts.health or 260
	self.chaseSpeed = opts.speed or 19
	self.dmg = opts.dmg or 22
	self.alive = true
	self.state = "patrol"
	self.lastAttack = 0
	local model = buildRig()
	model.Name = S.Name
	self.model = model
	self.humanoid = model:FindFirstChildOfClass("Humanoid")
	self.root = model:FindFirstChild("HumanoidRootPart")
	self.head = model:FindFirstChild("Head") or self.root
	local hum = self.humanoid
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.BreakJointsOnDeath = false
	hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
	hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
	hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
	hum.MaxHealth = self.maxHealth
	hum.Health = self.maxHealth
	hum.WalkSpeed = S.PatrolSpeed
	model:SetAttribute("MaxHP", self.maxHealth)
	model:SetAttribute("HP", self.maxHealth)
	model:PivotTo(opts.spawn)
	model.Parent = opts.parent
	CollectionService:AddTag(model, "Monster")
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and not d.Anchored then
			pcall(function()
				d:SetNetworkOwner(nil)
			end)
		end
	end
	self.path = PathfindingService:CreatePath({ AgentRadius = 4, AgentHeight = 8, AgentCanJump = false, WaypointSpacing = 6 })

	-- шаги и рычание
	local step = Instance.new("Sound")
	step.SoundId = Config.Sounds.Step
	step.Looped = true
	step.Volume = 1.4
	step.PlaybackSpeed = 0.45
	step.RollOffMaxDistance = 80
	step.Parent = self.root
	self.step = step
	hum.Running:Connect(function(speed)
		local moving = speed > 0.5
		if moving and not step.IsPlaying then
			step:Play()
		elseif not moving then
			step:Stop()
		end
	end)
	task.spawn(function()
		self:Loop()
	end)
	return self
end

function Monster:LineOfSight(from, to, char)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { self.model }
	local r = workspace:Raycast(from, to - from, params)
	return r == nil or r.Instance:IsDescendantOf(char)
end

function Monster:Navigate(goal)
	local pos = self.root.Position
	local flat = V(goal.X - pos.X, 0, goal.Z - pos.Z)
	if flat.Magnitude < 4 then
		self.humanoid:MoveTo(pos)
		self.waypoints = nil
		return true
	end
	local now = os.clock()
	if not self.waypoints or (self.goal - goal).Magnitude > 6 or now - self.pathTime > 2 then
		self.goal, self.pathTime = goal, now
		local ok = pcall(function()
			self.path:ComputeAsync(pos, goal)
		end)
		if ok and self.path.Status == Enum.PathStatus.Success then
			self.waypoints, self.wp = self.path:GetWaypoints(), 2
		else
			self.waypoints = nil
		end
	end
	if self.waypoints and self.waypoints[self.wp] then
		local w = self.waypoints[self.wp]
		if V(w.Position.X - pos.X, 0, w.Position.Z - pos.Z).Magnitude < 3 then
			self.wp += 1
			w = self.waypoints[self.wp] or w
		end
		self.humanoid:MoveTo(w.Position)
	else
		self.humanoid:MoveTo(goal)
	end
	return false
end

function Monster:Think()
	local now = os.clock()
	local best, bestD
	for _, p in ipairs(self.opts.getPlayers()) do
		local char = p.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hrp and hum and hum.Health > 0 and p:GetAttribute("DevGhost") ~= true and p:GetAttribute("Downed") ~= true and p:GetAttribute("Hidden") ~= true and not self.opts.inSafeZone(hrp.Position) then
			local d = (hrp.Position - self.root.Position).Magnitude
			local sees = d < S.SightRange and self:LineOfSight(self.head.Position, hrp.Position, char)
			local hears = d < S.HearRange and hrp.AssemblyLinearVelocity.Magnitude > 18
			if (sees or hears) and (not best or d < bestD) then
				best, bestD = p, d
			end
		end
	end

	if best then
		self.state = "chase"
		self.target = best
		self.lastSeen = now
	elseif self.state == "chase" and now - (self.lastSeen or 0) > 5 then
		self.state = "patrol"
		self.patrolGoal = nil
	end

	if self.state == "chase" and self.target and self.target.Character then
		local hrp = self.target.Character:FindFirstChild("HumanoidRootPart")
		if not hrp or self.opts.inSafeZone(hrp.Position) or self.target:GetAttribute("Downed") == true or self.target:GetAttribute("Hidden") == true then
			self.state = "patrol"
			return
		end
		self.humanoid.WalkSpeed = self.chaseSpeed
		local d = (hrp.Position - self.root.Position).Magnitude
		if d < S.AttackRange and now - self.lastAttack > S.AttackCooldown then
			self.lastAttack = now
			self:Attack(self.target)
		end
		if d < 16 then
			self.waypoints = nil
			self.humanoid:MoveTo(hrp.Position)
		else
			self:Navigate(hrp.Position)
		end
		return
	end

	self.humanoid.WalkSpeed = S.PatrolSpeed
	if not self.patrolGoal or now - (self.patrolSince or 0) > 30 then
		local cells = self.opts.patrol
		self.patrolGoal = cells[math.random(1, #cells)]
		self.patrolSince = now
	end
	if self:Navigate(self.patrolGoal) then
		self.patrolGoal = nil
	end
end

function Monster:Attack(player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then
		return
	end
	-- рывок вперёд
	local root = self.root
	local look = (char.HumanoidRootPart.Position - root.Position) * V(1, 0, 1)
	if look.Magnitude > 0.1 then
		self.model:PivotTo(CFrame.lookAt(root.Position, root.Position + look))
	end
	self.model:SetAttribute("Attacks", (self.model:GetAttribute("Attacks") or 0) + 1)
	self.opts.damage(player, self.dmg)
end

function Monster:TakeDamage(amount, fromPos)
	if not self.alive then
		return
	end
	local hum = self.humanoid
	hum.Health = math.max(0, hum.Health - amount)
	self.model:SetAttribute("HP", hum.Health)
	self.model:SetAttribute("Flash", (self.model:GetAttribute("Flash") or 0) + 1)
	-- отброс
	if fromPos then
		local dir = (self.root.Position - fromPos) * V(1, 0, 1)
		if dir.Magnitude > 0.1 then
			self.root.AssemblyLinearVelocity = dir.Unit * 30 + V(0, 8, 0)
		end
	end
	self.state = "chase"
	self.lastSeen = os.clock()
	if hum.Health <= 0 then
		self:Die()
		return true
	end
	return false
end

-- исчезает (утро или смерть)
function Monster:Die(retreat)
	if not self.alive then
		return
	end
	self.alive = false
	self.step:Stop()
	self.humanoid:MoveTo(self.root.Position)
	self.model:SetAttribute("Dead", retreat and "retreat" or "kill")
	self.root.Anchored = true
	task.delay(3, function()
		self.model:Destroy()
	end)
end

function Monster:Loop()
	while self.alive and self.model.Parent do
		task.wait(0.15)
		if self.alive then
			local ok, err = pcall(function()
				self:Think()
			end)
			if not ok then
				warn("[Labyrinth] Ошибка ИИ:", err)
			end
		end
	end
end

return Monster
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Parts</string>
          <string name="Source"><![CDATA[-- Помощники для постройки уровня из простых деталей (Part).

local CollectionService = game:GetService("CollectionService")

local Parts = {}

local V = Vector3.new
local GLASS = Color3.fromRGB(38, 46, 58)
local BOARD = Color3.fromRGB(62, 48, 36)

function Parts.box(parent, name, cf, size, color, material, props)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = size
	p.CFrame = cf
	p.Color = color or Color3.fromRGB(120, 120, 120)
	p.Material = material or Enum.Material.SmoothPlastic
	if props then
		for k, v in pairs(props) do
			p[k] = v
		end
	end
	p.Parent = parent
	return p
end

-- Деталь между двумя углами (a и b — локальные координаты относительно origin)
function Parts.span(parent, name, origin, a, b, color, material, props)
	local minV = V(math.min(a.X, b.X), math.min(a.Y, b.Y), math.min(a.Z, b.Z))
	local maxV = V(math.max(a.X, b.X), math.max(a.Y, b.Y), math.max(a.Z, b.Z))
	return Parts.box(parent, name, CFrame.new(origin + (minV + maxV) / 2), maxV - minV, color, material, props)
end

-- Стена с проёмами.
-- axis "X": стена идёт вдоль X на z = fixed. axis "Z": вдоль Z на x = fixed.
-- openings: { {c = центр, w = ширина, b = высота низа проёма, h = высота проёма, glass = true, boarded = true}, ... }
function Parts.wall(parent, origin, axis, fixed, a1, a2, y0, height, openings, color, material, thickness)
	thickness = thickness or 1
	local half = thickness / 2

	local function seg(s, e, yb, yt)
		if e - s < 0.05 or yt - yb < 0.05 then
			return
		end
		if axis == "X" then
			Parts.span(parent, "Wall", origin, V(s, yb, fixed - half), V(e, yt, fixed + half), color, material)
		else
			Parts.span(parent, "Wall", origin, V(fixed - half, yb, s), V(fixed + half, yt, e), color, material)
		end
	end

	local ops = table.clone(openings or {})
	table.sort(ops, function(p, q)
		return p.c < q.c
	end)

	local cursor = a1
	for _, op in ipairs(ops) do
		local l, r = op.c - op.w / 2, op.c + op.w / 2
		local b = op.b or 0
		seg(cursor, l, y0, y0 + height)
		seg(l, r, y0, y0 + b)
		seg(l, r, y0 + b + op.h, y0 + height)

		if op.glass then
			local yb, yt = y0 + b, y0 + b + op.h
			if axis == "X" then
				Parts.span(parent, "Window", origin, V(l, yb, fixed - 0.1), V(r, yt, fixed + 0.1), GLASS, Enum.Material.Glass, { Transparency = 0.5 })
			else
				Parts.span(parent, "Window", origin, V(fixed - 0.1, yb, l), V(fixed + 0.1, yt, r), GLASS, Enum.Material.Glass, { Transparency = 0.5 })
			end
			if op.boarded then
				local center = (axis == "X") and V(op.c, (yb + yt) / 2, fixed + half + 0.1)
					or V(fixed + half + 0.1, (yb + yt) / 2, op.c)
				local turn = (axis == "X") and CFrame.new() or CFrame.Angles(0, math.pi / 2, 0)
				for _, ang in ipairs({ 25, -20 }) do
					Parts.box(
						parent,
						"Board",
						CFrame.new(origin + center) * turn * CFrame.Angles(0, 0, math.rad(ang)),
						V(op.w * 1.2, 0.7, 0.2),
						BOARD,
						Enum.Material.WoodPlanks
					)
				end
			end
		end
		cursor = r
	end
	seg(cursor, a2, y0, y0 + height)
end

-- Лестница: видимые ступени (без коллизии) + невидимый пандус, по которому удобно ходить
-- и игроку, и Топотуну (pathfinding).
function Parts.stairs(parent, origin, x1, x2, zStart, yStart, zEnd, yEnd, steps, color, material)
	local dz = (zEnd - zStart) / steps
	local dy = (yEnd - yStart) / steps
	for k = 1, steps do
		local za = zStart + dz * (k - 1)
		local zb = zStart + dz * k
		Parts.span(parent, "Step", origin, V(x1, yStart - 1, za), V(x2, yStart + dy * k, zb), color, material, { CanCollide = false })
		-- невидимый твёрдый блок на ступень ниже: снизу и сбоку под лестницу не пройти,
		-- а ходить по ней всё равно удобно (по пандусу)
		if k > 1 then
			Parts.span(parent, "StairFill", origin, V(x1, yStart - 1, za), V(x2, yStart + dy * (k - 1), zb), color, material, { Transparency = 1 })
		end
	end
	local run = math.abs(zEnd - zStart)
	local rise = yEnd - yStart
	local length = math.sqrt(run * run + rise * rise) + 0.6
	local mid = V((x1 + x2) / 2, (yStart + yEnd) / 2 + dy / 2, (zStart + zEnd) / 2)
	local sign = (zEnd < zStart) and 1 or -1
	local angle = math.atan2(rise, run) * sign
	Parts.box(
		parent,
		"StairRamp",
		CFrame.new(origin + mid) * CFrame.Angles(angle, 0, 0) * CFrame.new(0, -0.5, 0),
		V(math.abs(x2 - x1), 1, length),
		color,
		material,
		{ Transparency = 1 }
	)
end

function Parts.light(part, range, brightness, color, flicker)
	local l = Instance.new("PointLight")
	l.Range = range
	l.Brightness = brightness
	l.Color = color or Color3.fromRGB(255, 170, 90)
	l.Shadows = true
	l.Parent = part
	if flicker then
		CollectionService:AddTag(l, "FlickerLight")
	end
	return l
end

function Parts.deadTree(parent, pos, rng)
	local wood = Color3.fromRGB(36, 31, 28)
	local h = rng:NextNumber(12, 22)
	Parts.box(parent, "Trunk", CFrame.new(pos + V(0, h / 2, 0)) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0), V(1.6, h, 1.6), wood, Enum.Material.Wood)
	for _ = 1, rng:NextInteger(3, 6) do
		local len = rng:NextNumber(4, 9)
		local y = rng:NextNumber(h * 0.45, h * 0.95)
		local base = CFrame.new(pos + V(0, y, 0)) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0) * CFrame.Angles(0, 0, rng:NextNumber(0.5, 1.15))
		Parts.box(parent, "Branch", base * CFrame.new(0, len / 2, 0), V(0.55, len, 0.55), wood, Enum.Material.Wood)
	end
end

return Parts
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[-- Постройка мира: лобби (3 лифта сложности, торговец классами), поляна (лес, река, лифт),
-- стены с воротами и лабиринт (шахты, сундуки, щели, выход с вертолётной площадкой).
-- Каждая группа игроков получает свой лабиринт со своим смещением O.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Parts = require(script.Parent.Parts)
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Items = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Items"))
local Deployables = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Deployables"))

local World = {}

local V = Vector3.new
local RGB = Color3.fromRGB
local M = Enum.Material

local MZ = Config.Maze
local N, C = MZ.Cells, MZ.CellSize
local MID = (N - 1) // 2
local HALF = N * C / 2
local CLEAR_LO, CLEAR_HI = MID - (MZ.ClearingCells - 1) // 2, MID + (MZ.ClearingCells - 1) // 2
local CLEAR_HALF = MZ.ClearingCells * C / 2

World.LOBBY = V(0, 50, 0)
World.CLEARING_HALF = CLEAR_HALF
World.HALF = HALF

local WALL = RGB(84, 86, 82)
local WALL_DARK = RGB(60, 62, 60)
local IVY = RGB(52, 82, 44)
local WOOD = RGB(92, 64, 40)
local METAL = RGB(70, 72, 76)
local NOCOLLIDE = { CanCollide = false }

local function inClearing(i, j)
	return i >= CLEAR_LO and i <= CLEAR_HI and j >= CLEAR_LO and j <= CLEAR_HI
end

local function tag(inst, name)
	CollectionService:AddTag(inst, name)
end

local function prompt(part, action, object, hold, dist)
	local p = Instance.new("ProximityPrompt")
	p.ActionText = action
	p.ObjectText = object or ""
	p.HoldDuration = hold or 0
	p.MaxActivationDistance = dist or 10
	p.RequiresLineOfSight = false
	p.Parent = part
	return p
end

------------------------------------------------------------------
-- Ресурсные узлы (деревья, камни, руда) — добываются ударом или зажатой E
------------------------------------------------------------------
local function node(parent, kind, pos, rng)
	local def = Items.Nodes[kind]
	local m = Instance.new("Model")
	m.Name = def.Name
	m:SetAttribute("Node", kind)
	m:SetAttribute("HP", def.Health)
	local main
	if kind == "tree" then
		local h = rng:NextNumber(20, 30)
		local bark = RGB(rng:NextInteger(74, 92), rng:NextInteger(52, 64), rng:NextInteger(34, 44))
		main = Parts.box(m, "Trunk", CFrame.new(pos + V(0, h / 2, 0)) * CFrame.Angles(0, rng:NextNumber(0, 3), 0), V(2.4, h, 2.4), bark, M.Wood)
		-- корни и пара веток
		for k = 0, 3 do
			local a = k / 4 * math.pi * 2 + rng:NextNumber(-0.3, 0.3)
			Parts.box(m, "Root", CFrame.new(pos + V(math.cos(a) * 1.4, 0.5, math.sin(a) * 1.4)) * CFrame.Angles(0, -a, 0) * CFrame.Angles(0, 0, 0.5), V(2.4, 0.8, 0.9), bark, M.Wood, NOCOLLIDE)
		end
		for _ = 1, 2 do
			local a = rng:NextNumber(0, math.pi * 2)
			local y = h * rng:NextNumber(0.45, 0.65)
			Parts.box(m, "Branch", CFrame.new(pos + V(0, y, 0)) * CFrame.Angles(0, a, 0) * CFrame.Angles(0, 0, 0.9) * CFrame.new(0, 2.2, 0), V(0.7, 4.5, 0.7), bark, M.Wood, NOCOLLIDE)
		end
		-- пышная крона в два тона: тёмная внутри, светлая снаружи
		local g = rng:NextInteger(86, 112)
		local dark = RGB(rng:NextInteger(30, 44), g - 18, rng:NextInteger(30, 40))
		local light = RGB(rng:NextInteger(52, 70), g + 14, rng:NextInteger(40, 54))
		Parts.box(m, "Leaves", CFrame.new(pos + V(0, h * 0.78, 0)), V(13, 10, 13), dark, M.LeafyGrass, { Shape = Enum.PartType.Ball, CanCollide = false })
		for k = 1, 6 do
			local a = k / 6 * math.pi * 2 + rng:NextNumber(-0.4, 0.4)
			local r = rng:NextNumber(3.5, 5)
			local s = rng:NextNumber(6.5, 9)
			Parts.box(m, "Leaves", CFrame.new(pos + V(math.cos(a) * r, h * 0.72 + rng:NextNumber(-1, 3), math.sin(a) * r)), V(s, s * 0.85, s), k % 2 == 0 and light or dark, M.LeafyGrass, { Shape = Enum.PartType.Ball, CanCollide = false })
		end
		Parts.box(m, "Leaves", CFrame.new(pos + V(rng:NextNumber(-1, 1), h * 0.95, rng:NextNumber(-1, 1))), V(8, 6.5, 8), light, M.LeafyGrass, { Shape = Enum.PartType.Ball, CanCollide = false })
	else
		local rock = RGB(100, 100, 104)
		for _ = 1, 3 do
			local s = rng:NextNumber(2.6, 4.4)
			local cf = CFrame.new(pos + V(rng:NextNumber(-1.6, 1.6), s * 0.4, rng:NextNumber(-1.6, 1.6)))
				* CFrame.Angles(rng:NextNumber(0, 3), rng:NextNumber(0, 3), rng:NextNumber(0, 3))
			local r = Parts.box(m, "Rock", cf, V(s, s * 0.8, s), rock, M.Slate)
			main = main or r
		end
		if kind ~= "stone" then
			local c = kind == "iron" and RGB(170, 100, 60) or RGB(170, 90, 255)
			local mat = kind == "iron" and M.CorrodedMetal or M.Neon
			for _ = 1, 5 do
				local cf = CFrame.new(pos + V(rng:NextNumber(-2, 2), rng:NextNumber(0.8, 3), rng:NextNumber(-2, 2)))
					* CFrame.Angles(rng:NextNumber(0, 3), rng:NextNumber(0, 3), rng:NextNumber(0, 3))
				Parts.box(m, "Ore", cf, kind == "crystal" and V(0.5, 1.8, 0.5) or V(0.9, 0.9, 0.9), c, mat, NOCOLLIDE)
			end
			if kind == "crystal" then
				Parts.light(m:FindFirstChild("Ore"), 12, 1, c, false)
			end
		end
	end
	local p = prompt(main, def.Action, def.Name, 0.7, 11)
	tag(p, "NodePrompt")
	m.Parent = parent
	tag(m, "Node")
	return m
end
World.node = node

------------------------------------------------------------------
-- Верстак (крафтится игроком и ставится перед собой)
------------------------------------------------------------------
function World.BuildWorkbench(parent, cf)
	local wb = Deployables.build("workbench", cf)
	wb.Name = "Workbench"
	local top = wb:FindFirstChild("Top")
	local p = prompt(top, "Крафт", "Верстак", 0, 10)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.new(0, 200, 0, 36)
	bb.StudsOffset = V(0, 3, 0)
	bb.MaxDistance = 60
	bb.Parent = top
	local bl = Instance.new("TextLabel")
	bl.Size = UDim2.fromScale(1, 1)
	bl.BackgroundTransparency = 1
	bl.TextColor3 = RGB(255, 230, 180)
	bl.TextStrokeTransparency = 0.3
	bl.Font = Enum.Font.GothamBold
	bl.TextScaled = true
	bl.Text = "Верстак · ур. 1"
	bl.Parent = bb
	wb:SetAttribute("Level", 1)
	wb.Parent = parent
	tag(wb, "Workbench")
	return { model = wb, prompt = p, label = bl, top = top }
end

------------------------------------------------------------------
-- Классический Roblox-человечек (торговец)
------------------------------------------------------------------
local function classicNPC(parent, cf, name)
	local m = Instance.new("Model")
	m.Name = name
	-- торговец-путешественник: шляпа-сафари, рубашка цвета хаки, жилет, ремень, рюкзак
	local skin, khaki, vest, pants = RGB(245, 205, 48), RGB(196, 170, 112), RGB(120, 92, 58), RGB(92, 74, 52)
	local torso = Parts.box(m, "Torso", cf * CFrame.new(0, 3, 0), V(2, 2, 1), khaki, M.Fabric)
	local head = Parts.box(m, "Head", cf * CFrame.new(0, 4.5, 0), V(2, 1, 1), skin, M.SmoothPlastic)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Head
	mesh.Scale = V(1.25, 1.25, 1.25)
	mesh.Parent = head
	local face = Instance.new("Decal")
	face.Name = "face"
	face.Texture = "rbxasset://textures/face.png"
	face.Face = Enum.NormalId.Front
	face.Parent = head
	Parts.box(m, "Left Arm", cf * CFrame.new(-1.5, 3, 0), V(1, 2, 1), khaki, M.Fabric)
	Parts.box(m, "Right Arm", cf * CFrame.new(1.5, 3, 0), V(1, 2, 1), khaki, M.Fabric)
	Parts.box(m, "LeftHand", cf * CFrame.new(-1.5, 2.2, 0), V(1.02, 0.5, 1.02), skin, M.SmoothPlastic, NOCOLLIDE)
	Parts.box(m, "RightHand", cf * CFrame.new(1.5, 2.2, 0), V(1.02, 0.5, 1.02), skin, M.SmoothPlastic, NOCOLLIDE)
	Parts.box(m, "Left Leg", cf * CFrame.new(-0.5, 1, 0), V(1, 2, 1), pants, M.Fabric)
	Parts.box(m, "Right Leg", cf * CFrame.new(0.5, 1, 0), V(1, 2, 1), pants, M.Fabric)
	for _, x in ipairs({ -0.5, 0.5 }) do
		Parts.box(m, "Boot", cf * CFrame.new(x, 0.35, -0.05), V(1.05, 0.7, 1.15), RGB(60, 40, 28), M.Leather, NOCOLLIDE)
	end
	-- жилет с карманами, ремень с пряжкой
	Parts.box(m, "Vest", cf * CFrame.new(0, 3.1, 0), V(2.06, 1.8, 1.06), vest, M.Leather, NOCOLLIDE)
	Parts.box(m, "VestOpen", cf * CFrame.new(0, 3.1, -0.54), V(0.6, 1.8, 0.04), khaki, M.Fabric, NOCOLLIDE)
	for _, x in ipairs({ -0.65, 0.65 }) do
		Parts.box(m, "Pocket", cf * CFrame.new(x, 3.2, -0.55), V(0.5, 0.45, 0.05), RGB(100, 76, 46), M.Leather, NOCOLLIDE)
	end
	Parts.box(m, "Belt", cf * CFrame.new(0, 2.1, 0), V(2.08, 0.3, 1.08), RGB(50, 34, 22), M.Leather, NOCOLLIDE)
	Parts.box(m, "Buckle", cf * CFrame.new(0, 2.1, -0.56), V(0.4, 0.3, 0.06), RGB(230, 190, 70), M.Metal, NOCOLLIDE)
	-- шляпа-сафари
	Parts.box(m, "HatBrim", cf * CFrame.new(0, 5.15, 0) * CFrame.Angles(0, 0, math.pi / 2), V(0.15, 3, 3), RGB(214, 190, 130), M.Fabric, { Shape = Enum.PartType.Cylinder, CanCollide = false })
	Parts.box(m, "HatTop", cf * CFrame.new(0, 5.55, 0), V(1.7, 0.9, 1.7), RGB(214, 190, 130), M.Fabric, { Shape = Enum.PartType.Ball, CanCollide = false })
	Parts.box(m, "HatBand", cf * CFrame.new(0, 5.3, 0) * CFrame.Angles(0, 0, math.pi / 2), V(0.25, 1.75, 1.75), RGB(80, 56, 34), M.Fabric, { Shape = Enum.PartType.Cylinder, CanCollide = false })
	-- рюкзак со скатанным спальником
	Parts.box(m, "Backpack", cf * CFrame.new(0, 3.1, 0.85), V(1.6, 1.8, 0.7), RGB(70, 90, 60), M.Fabric, NOCOLLIDE)
	Parts.box(m, "Bedroll", cf * CFrame.new(0, 4.1, 0.85) * CFrame.Angles(0, 0, math.pi / 2), V(0.6, 1.9, 0.6), RGB(160, 60, 50), M.Fabric, { Shape = Enum.PartType.Cylinder, CanCollide = false })
	local hum = Instance.new("Humanoid")
	hum.DisplayName = name
	hum.Parent = m
	m.PrimaryPart = torso
	m.Parent = parent
	return m, torso
end

------------------------------------------------------------------
-- Лобби: три лифта (легко / обычно / тяжело), торговец классами, декор
------------------------------------------------------------------
function World.BuildLobby()
	local m = Instance.new("Model")
	m.Name = "Lobby"
	local o = World.LOBBY
	local concrete = RGB(74, 76, 78)
	Parts.span(m, "Floor", o, V(-62, -1, -27), V(62, 0, 27), RGB(56, 58, 60), M.Concrete)
	Parts.span(m, "Ceiling", o, V(-62, 20, -45), V(62, 21, 27), concrete, M.Concrete)
	Parts.wall(m, o, "X", 27, -62, 62, 0, 20, nil, concrete, M.Concrete, 1)
	Parts.wall(m, o, "Z", -62, -27, 27, 0, 20, nil, concrete, M.Concrete, 1)
	Parts.wall(m, o, "Z", 62, -27, 27, 0, 20, nil, concrete, M.Concrete, 1)
	-- северная стена с тремя проёмами лифтов
	local lifts = { { id = "easy", x = -36 }, { id = "normal", x = 0 }, { id = "hard", x = 36 } }
	local ops = {}
	for _, l in ipairs(lifts) do
		table.insert(ops, { c = l.x, w = 14, b = 0, h = 13 })
	end
	Parts.wall(m, o, "X", -27, -62, 62, 0, 20, ops, concrete, M.Concrete, 1)

	local elevators = {}
	for _, l in ipairs(lifts) do
		local col = RGB(230, 220, 190)
		local x = l.x
		Parts.span(m, "LiftFloor", o, V(x - 9, -1, -45), V(x + 9, 0, -27), RGB(40, 40, 42), M.DiamondPlate)
		Parts.span(m, "LiftWall", o, V(x - 9.5, 0, -45), V(x - 9, 20, -27), METAL, M.DiamondPlate)
		Parts.span(m, "LiftWall", o, V(x + 9, 0, -45), V(x + 9.5, 20, -27), METAL, M.DiamondPlate)
		Parts.span(m, "LiftWall", o, V(x - 9.5, 0, -45.5), V(x + 9.5, 20, -45), METAL, M.DiamondPlate)
		local lamp = Parts.span(m, "LiftLight", o, V(x - 6, 19.2, -42), V(x + 6, 19.5, -30), RGB(255, 235, 200), M.Neon)
		Parts.light(lamp, 24, 1.1, RGB(255, 225, 190), false)
		-- цветная полоса и табличка над входом
		Parts.span(m, "LiftStripe", o, V(x - 7, 13, -26.6), V(x + 7, 13.6, -26.2), col, M.Neon)
		local sign = Parts.span(m, "LiftSign", o, V(x - 7, 14, -26.6), V(x + 7, 18, -26.2), RGB(20, 20, 22), M.SmoothPlastic)
		local sg = Instance.new("SurfaceGui")
		sg.Face = Enum.NormalId.Back
		sg.PixelsPerStud = 25
		sg.Parent = sign
		local t = Instance.new("TextLabel")
		t.Size = UDim2.fromScale(1, 1)
		t.BackgroundTransparency = 1
		t.Font = Enum.Font.GothamBlack
		t.TextScaled = true
		t.TextColor3 = col
		t.Text = "ЛИФТ"
		t.Parent = sg
		for k = -3, 3 do
			Parts.span(m, "Hazard", o, V(x + k * 2 - 0.5, 0, -27), V(x + k * 2 + 0.5, 0.05, -25), (k % 2 == 0) and RGB(220, 180, 30) or RGB(20, 20, 20), M.SmoothPlastic)
		end
		local zone = Parts.span(m, "LiftZone", o, V(x - 8.5, 0, -44.5), V(x + 8.5, 12, -27.5), nil, nil, { Transparency = 1, CanCollide = false, CanQuery = false })
		elevators[l.id] = { zone = zone, door = o + V(x, 0, -27), outside = CFrame.lookAt(o + V(x, 3, -20), o + V(x, 3, 0)), label = t }
	end

	-- лампы
	for x = -48, 48, 24 do
		for _, z in ipairs({ -10, 12 }) do
			local lamp = Parts.span(m, "Lamp", o, V(x - 2.5, 19.4, z - 1), V(x + 2.5, 19.9, z + 1), RGB(255, 235, 200), M.Neon)
			Parts.light(lamp, 30, 0.9, RGB(255, 225, 190), (x + z) % 3 == 0)
		end
	end

	-- правила
	local board = Parts.span(m, "Rules", o, V(61.4, 4, -12), V(61.6, 15, 12), RGB(28, 30, 34), M.SmoothPlastic)
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Left
	sg.PixelsPerStud = 25
	sg.Parent = board
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.TextColor3 = RGB(230, 225, 210)
	t.Font = Enum.Font.GothamBold
	t.TextScaled = true
	t.TextWrapped = true
	t.Text = "ПРАВИЛА ПОЛЯНЫ\n\n1. Днём врата открыты — исследуй лабиринт.\n2. На закате врата закрываются. Вернись!\n3. Ночью в лабиринте Скрежетники.\n4. Раненого друга подними бинтом.\n5. Найди Ключ в золотом сундуке и выход.\n6. Ctrl — пригнуться и пролезть в щель."
	t.Parent = sg

	-- ларёк торговца классами: деревянный навес, гирлянда ламп, вывеска, клетка, ящики
	local base = CFrame.lookAt(o + V(-52, 0, 4), o + V(0, 0, 4)) -- -Z смотрит в зал
	local LOG, PLANK, TRIM = RGB(120, 78, 44), RGB(98, 62, 36), RGB(240, 200, 70)
	local function bp(name, rel, size, color, mat, props)
		return Parts.box(m, name, base * rel, size, color, mat, props)
	end
	bp("BoothFloor", CFrame.new(0, 0.2, 0), V(22, 0.4, 12), RGB(80, 60, 44), M.WoodPlanks)
	bp("BoothGlow", CFrame.new(0, 0.05, -6.6), V(24, 0.1, 1.2), RGB(60, 255, 230), M.Neon, NOCOLLIDE)
	for _, x in ipairs({ -10, -6, 6, 10 }) do
		bp("BoothPost", CFrame.new(x, 7, -5), V(1.4, 14, 1.4), LOG, M.Wood, { Shape = Enum.PartType.Cylinder, Orientation = V(0, 0, 90) })
		bp("BoothPost", CFrame.new(x, 7, 5), V(1.4, 14, 1.4), LOG, M.Wood, { Shape = Enum.PartType.Cylinder, Orientation = V(0, 0, 90) })
	end
	bp("BoothBack", CFrame.new(0, 7, 5.6), V(22, 14, 0.6), PLANK, M.WoodPlanks)
	bp("BoothRoof", CFrame.new(0, 14.4, 0) * CFrame.Angles(math.rad(-8), 0, 0), V(25, 0.8, 14), RGB(110, 70, 40), M.WoodPlanks)
	-- зубчатая жёлтая кромка крыши
	for k = -6, 6 do
		bp("RoofTrim", CFrame.new(k * 1.9, 13.5, -7.3) * CFrame.Angles(0, 0, math.rad(45)), V(1.3, 1.3, 0.3), TRIM, M.SmoothPlastic, NOCOLLIDE)
	end
	bp("RoofBeam", CFrame.new(0, 13.9, -7.1), V(25, 0.6, 0.6), TRIM, M.SmoothPlastic, NOCOLLIDE)
	-- прилавок из бревна
	local counter = bp("Counter", CFrame.new(0, 1.8, -3.8), V(18, 3.6, 2.2), PLANK, M.WoodPlanks)
	bp("CounterLog", CFrame.new(0, 3.9, -3.8) * CFrame.Angles(0, math.pi / 2, 0), V(19, 1.6, 1.6), LOG, M.Wood, { Shape = Enum.PartType.Cylinder })
	for _, x in ipairs({ -9.6, 9.6 }) do
		bp("LogEnd", CFrame.new(x, 3.9, -3.8) * CFrame.Angles(0, math.pi / 2, 0), V(0.3, 1.7, 1.7), TRIM, M.Wood, { Shape = Enum.PartType.Cylinder, CanCollide = false })
	end
	-- лампы-шары под крышей
	for _, x in ipairs({ -9, -5, 5, 9 }) do
		local bulb = bp("BoothBulb", CFrame.new(x, 12.6, -5.6), V(1.8, 1.8, 1.8), RGB(255, 245, 220), M.Neon, { Shape = Enum.PartType.Ball, CanCollide = false })
		Parts.light(bulb, 16, 1.2, RGB(255, 235, 200), false)
	end
	-- вывеска
	local signBoard = bp("BoothSign", CFrame.new(0, 17.2, -6.2) * CFrame.Angles(math.rad(-6), 0, 0), V(18, 5, 0.6), RGB(90, 56, 32), M.WoodPlanks)
	local ss = Instance.new("SurfaceGui")
	ss.Face = Enum.NormalId.Front
	ss.PixelsPerStud = 30
	ss.Parent = signBoard
	local st1 = Instance.new("TextLabel")
	st1.Size = UDim2.fromScale(1, 0.62)
	st1.BackgroundTransparency = 1
	st1.Font = Enum.Font.FredokaOne
	st1.TextScaled = true
	st1.TextColor3 = RGB(255, 70, 120)
	st1.TextStrokeTransparency = 0
	st1.TextStrokeColor3 = RGB(60, 20, 20)
	st1.Text = "КЛАССЫ"
	st1.Parent = ss
	local st2 = Instance.new("TextLabel")
	st2.Position = UDim2.fromScale(0.05, 0.62)
	st2.Size = UDim2.fromScale(0.9, 0.32)
	st2.BackgroundTransparency = 1
	st2.Font = Enum.Font.GothamBold
	st2.TextScaled = true
	st2.TextColor3 = RGB(255, 245, 225)
	st2.Text = "Стань сильнее с новым классом"
	st2.Parent = ss
	-- декор: птичья клетка, ящики, бумаги, красный флаг
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		bp("CageBar", CFrame.new(5 + math.cos(a) * 1.5, 6.4, 2 + math.sin(a) * 1.5), V(0.15, 4.4, 0.15), RGB(150, 110, 60), M.Wood, NOCOLLIDE)
	end
	bp("CageTop", CFrame.new(5, 8.8, 2), V(3.4, 0.5, 3.4), RGB(150, 110, 60), M.Wood, { Shape = Enum.PartType.Ball, CanCollide = false })
	bp("CageBase", CFrame.new(5, 4.2, 2), V(3.6, 0.3, 3.6), RGB(120, 84, 48), M.Wood)
	bp("CageStand", CFrame.new(5, 2.1, 2), V(0.4, 4.2, 0.4), RGB(90, 60, 36), M.Wood)
	bp("Crate", CFrame.new(-7, 1.2, 3), V(2.4, 2.4, 2.4), RGB(180, 150, 100), M.WoodPlanks)
	bp("Crate", CFrame.new(-7.2, 3.3, 3.1) * CFrame.Angles(0, 0.4, 0), V(1.8, 1.8, 1.8), RGB(190, 160, 110), M.WoodPlanks)
	bp("Paper", CFrame.new(-3, 4.75, -3.6) * CFrame.Angles(0, 0.3, 0), V(1.2, 0.05, 1.5), RGB(240, 230, 200), M.SmoothPlastic, NOCOLLIDE)
	bp("Paper", CFrame.new(3.4, 4.75, -3.7) * CFrame.Angles(0, -0.5, 0), V(1.2, 0.05, 1.5), RGB(240, 230, 200), M.SmoothPlastic, NOCOLLIDE)
	bp("BannerPole", CFrame.new(13.5, 8, -4), V(0.5, 16, 0.5), RGB(70, 50, 30), M.Wood)
	bp("Banner", CFrame.new(13.5, 11, -2.2), V(0.2, 7, 3.4), RGB(200, 50, 45), M.Fabric, NOCOLLIDE)
	local _, npcTorso = classicNPC(m, base * CFrame.new(0, 0.4, 1), "Торговец классами")
	local mp = prompt(counter, "Классы", "Торговец", 0, 14)
	local _ = npcTorso

	-- декор: ящики, бочки, растения, скамейки
	local rng = Random.new(42)
	for _, p in ipairs({ V(50, 0, 20), V(54, 0, 22), V(52, 4, 21), V(-20, 0, 22), V(20, 0, 23) }) do
		Parts.span(m, "Crate", o, p + V(-2, 0, -2), p + V(2, 4, 2), RGB(110, 85, 55), M.WoodPlanks)
	end
	for _, x in ipairs({ -30, -10, 10, 30 }) do
		Parts.span(m, "Bench", o, V(x - 5, 1.6, 20), V(x + 5, 2.1, 23), WOOD, M.WoodPlanks)
		Parts.span(m, "BenchLeg", o, V(x - 4.5, 0, 20.5), V(x - 4, 1.6, 22.5), METAL, M.Metal)
		Parts.span(m, "BenchLeg", o, V(x + 4, 0, 20.5), V(x + 4.5, 1.6, 22.5), METAL, M.Metal)
	end
	for _, p in ipairs({ V(-56, 0, -22), V(56, 0, -22), V(-56, 0, 24), V(42, 0, 24) }) do
		Parts.span(m, "Pot", o, p + V(-1.5, 0, -1.5), p + V(1.5, 2, 1.5), RGB(80, 60, 50), M.Slate)
		Parts.box(m, "Plant", CFrame.new(o + p + V(0, 4, 0)), V(4, 4.5, 4), RGB(50, 110, 55), M.LeafyGrass, { Shape = Enum.PartType.Ball })
	end
	local _ = rng

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "LobbySpawn"
	spawn.Anchored = true
	spawn.Size = V(12, 1, 6)
	spawn.CFrame = CFrame.new(o + V(0, -0.4, 14))
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Parent = m
	m.Parent = workspace
	return { model = m, spawn = spawn, elevators = elevators, merchantPrompt = mp }
end

------------------------------------------------------------------
-- Рельеф
------------------------------------------------------------------
local RAD = MZ.OuterRadius * C -- радиус круглого лабиринта в studs
World.RADIUS = RAD
local LAKE_R, SAND_R = 62, 76

local function safe(fn)
	local ok, err = pcall(fn)
	if not ok then
		warn("[Labyrinth] рельеф:", err)
	end
end

-- огромная земля вокруг (одинаковая для этого места, строится один раз)
local terrainBuilt = {}
function World.BuildTerrain(O)
	if terrainBuilt[O.X] then
		return
	end
	terrainBuilt[O.X] = true
	local terrain = workspace.Terrain
	local size = Config.SlotSpacing - 160
	safe(function()
		terrain:FillBlock(CFrame.new(O + V(0, -4, 0)), V(size, 8, size), M.Grass)
	end)
	-- внутри круглого лабиринта — утоптанная земля
	safe(function()
		terrain:FillCylinder(CFrame.new(O + V(0, -2, 0)), 4, RAD + 24, M.Ground)
	end)
	-- холмы и горы до самого горизонта
	local rng = Random.new(O.X + 11)
	for k = 1, 46 do
		local a = k / 46 * math.pi * 2 + rng:NextNumber(-0.06, 0.06)
		local dist = rng:NextNumber(RAD + 520, size / 2 - 220)
		local r = rng:NextNumber(120, 240)
		local c = O + V(math.cos(a) * dist, -r * 0.5, math.sin(a) * dist)
		safe(function()
			terrain:FillBall(c, r, M.Grass)
		end)
		if k % 3 == 0 then
			safe(function()
				terrain:FillBall(c + V(0, r * 0.3, 0), r * 0.6, M.Rock)
			end)
		end
	end
	safe(function()
		if not terrain:FindFirstChildOfClass("Clouds") then
			local clouds = Instance.new("Clouds")
			clouds.Cover = 0.55
			clouds.Density = 0.6
			clouds.Parent = terrain
		end
		terrain.WaterColor = RGB(40, 100, 115)
		terrain.WaterTransparency = 0.45
		terrain.WaterWaveSize = 0.12
		terrain.WaterReflectance = 0.7
	end)
end

-- трава поляны и озеро (озеро каждый раз в своей четверти поляны)
function World.BuildClearingTerrain(O, lake)
	local terrain = workspace.Terrain
	local E = CLEAR_HALF
	safe(function()
		terrain:FillBlock(CFrame.new(O + V(0, -6, 0)), V(E * 2, 12, E * 2), M.Grass)
	end)
	safe(function()
		terrain:FillBlock(CFrame.new(O + V(0, 4, 0)), V(E * 2, 8, E * 2), M.Air)
	end)
	if lake then
		safe(function()
			terrain:FillCylinder(CFrame.new(lake + V(0, -2, 0)), 4, SAND_R, M.Sand)
		end)
		safe(function()
			terrain:FillCylinder(CFrame.new(lake + V(0, 1, 0)), 6, LAKE_R, M.Air)
		end)
		safe(function()
			terrain:FillCylinder(CFrame.new(lake + V(0, -6, 0)), 10, LAKE_R, M.Water)
		end)
	end
end

-- после игры пропасть у выхода снова засыпаем
function World.ClearTerrain(O, pit)
	local _ = O
	if pit then
		safe(function()
			workspace.Terrain:FillBlock(pit.cf * CFrame.new(0, -2, 0), pit.size - V(0, 4, 0), M.Grass)
		end)
	end
end

-- лес вокруг всего лабиринта, до самых холмов
function World.BuildOuterForest(parent, O, seed, avoid)
	local m = Instance.new("Model")
	m.Name = "OuterForest"
	local rng = Random.new(seed + 5)
	local far = RAD + 1100
	local placed, tries = 0, 0
	while placed < 1100 and tries < 9000 do
		tries += 1
		local r = RAD + 30 + (rng:NextNumber() ^ 1.5) * (far - RAD - 30)
		local a = rng:NextNumber(0, math.pi * 2)
		local p = O + V(math.cos(a) * r, 0, math.sin(a) * r)
		local blocked = false
		for _, z in ipairs(avoid or {}) do
			local lp = z.cf:PointToObjectSpace(p)
			if math.abs(lp.X) < z.size.X / 2 and math.abs(lp.Z) < z.size.Z / 2 then
				blocked = true
			end
		end
		if not blocked then
			placed += 1
			local h = rng:NextNumber(30, 56)
			local s1 = rng:NextNumber(16, 24)
			Parts.box(m, "Trunk", CFrame.new(p + V(0, h / 2, 0)), V(3, h, 3), RGB(78, 56, 38), M.Wood)
			if rng:NextNumber() < 0.4 then
				Parts.box(m, "Crown", CFrame.new(p + V(0, h * 0.62, 0)), V(s1 * 1.1, h * 0.75, s1 * 1.1), RGB(28, 66, 40), M.LeafyGrass, { Shape = Enum.PartType.Ball, CanCollide = false })
			else
				local leaf = RGB(rng:NextInteger(30, 52), rng:NextInteger(74, 108), rng:NextInteger(34, 50))
				Parts.box(m, "Crown", CFrame.new(p + V(0, h * 0.75, 0)), V(s1, s1 * 0.85, s1), leaf, M.LeafyGrass, { Shape = Enum.PartType.Ball, CanCollide = false })
				if r < RAD + 300 then
					Parts.box(m, "Crown", CFrame.new(p + V(rng:NextNumber(-3, 3), h * 0.95, rng:NextNumber(-3, 3))), V(s1 * 0.7, s1 * 0.6, s1 * 0.7), leaf, M.LeafyGrass, { Shape = Enum.PartType.Ball, CanCollide = false })
				end
			end
		end
	end
	m.Parent = parent
end

------------------------------------------------------------------
-- Записки прошлых выживших и заброшенные лагеря
------------------------------------------------------------------
local NOTES = {
	{ "Дневник, день 3", "Стены не двигаются. Я проверил: зарубки на камне те же. Это мы теряем рассудок, а не лабиринт меняется." },
	{ "Нацарапано углём", "НЕ БЕГИТЕ НОЧЬЮ. Они слышат шаги. Идите тихо — и, может быть, доживёте до утра." },
	{ "Обрывок карты", "Выход есть! Огромные ворота у самой внешней стены. Но без ключ-карты они не откроются." },
	{ "Записка шахтёра", "Камень — деревянной киркой. Железо — только каменной. Кристаллы светятся в самых дальних шахтах, нужна железная." },
	{ "Медицинская памятка", "Если друг упал — не бросай его. Три пучка высокой травы — и у тебя бинт. Подними его, пока не поздно." },
	{ "Подпись: М.", "Скрежетники огромные. В узкие щели в стенах они не пролезают. Пригнись (Ctrl) — и ты спасён." },
	{ "Дрожащий почерк", "Вчера ночью я слышал вертолёт за стеной. Значит, снаружи кто-то есть. Значит, отсюда можно выбраться." },
	{ "Список", "Нас было пятеро. Осталось двое. Мы больше не ходим в лабиринт после того, как солнце касается стен." },
	{ "Правило поляны", "Пока врата закрыты — поляна безопасна. Опоздал хоть на секунду — ночуешь с ними." },
	{ "Чья-то догадка", "Каждый раз, когда приезжает лифт, коридоры другие. Карты бесполезны. Запоминай приметы: мох, кости, шахты." },
	{ "Рецепт", "Верстак — двенадцать брёвен и четыре камня. Без него не будет ни мечей, ни нормальной кирки." },
	{ "Последняя запись", "Золотой сундук. Самый дальний тупик. Над ним светится ключ. Я почти дошёл, но стемнело..." },
}

local function note(parent, cf, rng, index)
	local n = NOTES[(index - 1) % #NOTES + 1]
	local paper = Parts.box(parent, "Note", cf, V(1.2, 0.05, 1.6), RGB(230, 220, 190), M.SmoothPlastic, NOCOLLIDE)
	paper.CanQuery = true
	local p = prompt(paper, "Прочитать", "Записка", 0, 8)
	p:SetAttribute("Title", n[1])
	p:SetAttribute("Text", n[2])
	tag(p, "NotePrompt")
	local _ = rng
	return paper
end

local function lootCrate(parent, pos, rng, name)
	local crate = Parts.box(parent, name or "SupplyBox", CFrame.new(pos + V(0, 1.1, 0)) * CFrame.Angles(0, rng:NextNumber(0, 6), 0), V(2.6, 2.2, 2.2), RGB(115, 90, 58), M.WoodPlanks)
	local p = prompt(crate, "Обыскать", name == "Backpack" and "Рюкзак" or "Ящик", 0.8, 9)
	tag(p, "LootPrompt")
	return crate
end

-- заброшенный лагерь: палатка, потухший костёр, рюкзак, записка
local function camp(parent, center, rng, noteIndex)
	local base = CFrame.new(center) * CFrame.Angles(0, rng:NextNumber(0, 6), 0)
	local cloth = RGB(rng:NextInteger(90, 140), rng:NextInteger(70, 100), 50)
	for _, side in ipairs({ -1, 1 }) do
		Parts.box(parent, "Tent", base * CFrame.new(side * 2.2, 2.3, -4) * CFrame.Angles(0, 0, side * math.rad(-40)), V(0.2, 6, 7), cloth, M.Fabric)
	end
	Parts.box(parent, "AshPit", base * CFrame.new(3, 0.15, 3), V(3, 0.3, 3), RGB(40, 36, 34), M.Slate, NOCOLLIDE)
	for k = 0, 3 do
		Parts.box(parent, "BurntLog", base * CFrame.new(3, 0.4, 3) * CFrame.Angles(0, k * math.pi / 4, math.pi / 2), V(0.6, 2.6, 0.6), RGB(30, 26, 24), M.Wood, NOCOLLIDE)
	end
	lootCrate(parent, (base * CFrame.new(-3, 0, 2)).Position, rng, "Backpack")
	note(parent, base * CFrame.new(0.5, 0.1, 1) * CFrame.Angles(0, 0.4, 0), rng, noteIndex)
end

-- заросли лиан: занавес из свисающих стеблей и шапка листвы сверху
local function vineHide(parent, pos, rng)
	local m = Instance.new("Model")
	m.Name = "VineHide"
	local center = Parts.box(m, "HideCenter", CFrame.new(pos + V(0, 3, 0)), V(4, 6, 4), IVY, M.LeafyGrass, NOCOLLIDE)
	center.Transparency = 1
	Parts.box(m, "Canopy", CFrame.new(pos + V(0, 10, 0)), V(10, 5, 10), IVY, M.LeafyGrass, { Shape = Enum.PartType.Ball, CanCollide = false })
	for k = 1, 30 do
		local a = k / 30 * math.pi * 2 + rng:NextNumber(-0.1, 0.1)
		local r = rng:NextNumber(2.6, 3.8)
		local len = rng:NextNumber(7, 10)
		local top = 10
		local c = RGB(rng:NextInteger(40, 66), rng:NextInteger(78, 110), rng:NextInteger(36, 52))
		Parts.box(m, "Vine", CFrame.new(pos + V(math.cos(a) * r, top - len / 2, math.sin(a) * r)) * CFrame.Angles(rng:NextNumber(-0.06, 0.06), a, rng:NextNumber(-0.06, 0.06)), V(rng:NextNumber(0.25, 0.5), len, rng:NextNumber(0.6, 1.4)), c, M.LeafyGrass, NOCOLLIDE)
	end
	for _ = 1, 8 do
		local a = rng:NextNumber(0, math.pi * 2)
		Parts.box(m, "Leaves", CFrame.new(pos + V(math.cos(a) * 3.4, rng:NextNumber(1, 7), math.sin(a) * 3.4)), V(2.2, 1.6, 2.2), IVY, M.LeafyGrass, { Shape = Enum.PartType.Ball, CanCollide = false })
	end
	local p = prompt(center, "Спрятаться", "Заросли лиан", 0.3, 9)
	tag(p, "HidePrompt")
	m.Parent = parent
	return m
end

------------------------------------------------------------------
-- Поляна
------------------------------------------------------------------
local function mine(parent, center, facing, kinds, rng, nodes)
	local b = CFrame.lookAt(center, center + facing)
	local beam = RGB(80, 58, 36)
	for _, x in ipairs({ -10, 10 }) do
		Parts.box(parent, "MineSupport", b * CFrame.new(x, 7, -11), V(1.4, 14, 1.4), beam, M.Wood)
	end
	Parts.box(parent, "MineBeam", b * CFrame.new(0, 14.5, -11), V(21.5, 1.4, 1.4), beam, M.Wood)
	local lantern = Parts.box(parent, "MineLantern", b * CFrame.new(0, 13, -11), V(0.9, 1.3, 0.9), RGB(255, 170, 80), M.Neon)
	Parts.light(lantern, 30, 1.3, RGB(255, 170, 90), true)
	Parts.box(parent, "MineCart", b * CFrame.new(8, 1.2, 5), V(3.4, 2.2, 5), RGB(80, 70, 60), M.CorrodedMetal)
	for k, kind in ipairs(kinds) do
		local off = ({ V(-7, 0, 2), V(5, 0, -3), V(-3, 0, 8), V(7, 0, 9) })[k]
		table.insert(nodes, node(parent, kind, (b * CFrame.new(off)).Position, rng))
	end
end

function World.BuildClearing(parent, seed, O)
	local m = Instance.new("Model")
	m.Name = "Clearing"
	local rng = Random.new(seed)
	local refs = { model = m, nodes = {} }
	local E = CLEAR_HALF

	-- тропинки от лифта к четырём воротам
	Parts.span(m, "Path", O, V(-3.5, 0, -E + 2), V(3.5, 0.06, E - 2), RGB(120, 100, 70), M.Ground)
	Parts.span(m, "Path", O, V(-E + 2, 0, -3.5), V(E - 2, 0.06, 3.5), RGB(120, 100, 70), M.Ground)

	-- лифт в центре поляны
	local e = O
	Parts.span(m, "LiftFloor", e, V(-9, 0, -9), V(9, 0.6, 9), RGB(40, 40, 42), M.DiamondPlate)
	Parts.span(m, "LiftRoof", e, V(-9.5, 16, -9.5), V(9.5, 17, 9.5), METAL, M.DiamondPlate)
	for _, x in ipairs({ -9, 9 }) do
		Parts.span(m, "LiftWall", e, V(x - 0.3, 0.6, -9), V(x + 0.3, 16, 9), METAL, M.DiamondPlate)
	end
	Parts.span(m, "LiftWall", e, V(-9, 0.6, 8.7), V(9, 16, 9.3), METAL, M.DiamondPlate)
	local liftLight = Parts.span(m, "LiftLight", e, V(-6, 15.6, -6), V(6, 15.9, 6), RGB(255, 230, 190), M.Neon)
	Parts.light(liftLight, 22, 1, nil, false)
	local grate = Instance.new("Model")
	grate.Name = "LiftGrate"
	for x = -8, 8, 1.6 do
		Parts.box(grate, "Bar", CFrame.new(e + V(x, 8.3, -9)), V(0.25, 15.4, 0.25), RGB(50, 50, 54), M.Metal)
	end
	for y = 2, 15, 4 do
		Parts.box(grate, "Bar", CFrame.new(e + V(0, y, -9)), V(17.4, 0.25, 0.25), RGB(50, 50, 54), M.Metal)
	end
	grate.Parent = m
	refs.grate = grate
	refs.grateClosed = grate:GetPivot()
	refs.liftSpawn = CFrame.lookAt(e + V(0, 3.5, 0), e + V(0, 3.5, -30))
	refs.liftPos = e

	-- припасы прямо в лифте: ящик, бочка, мешки
	local crate = Parts.span(m, "SupplyCrate", O, V(-8.6, 0.6, 3.6), V(-5.6, 4, 8.4), RGB(120, 95, 60), M.WoodPlanks)
	for _, y in ipairs({ 1.2, 3.4 }) do
		Parts.span(m, "CrateBand", O, V(-8.7, y, 3.5), V(-5.5, y + 0.3, 8.5), RGB(60, 60, 64), M.Metal, NOCOLLIDE)
	end
	refs.supplyPrompt = prompt(crate, "Взять припасы", "Припасы в лифте", 0, 10)
	note(m, CFrame.new(O + V(-7, 4.1, 6)), rng, 9)
	Parts.box(m, "Barrel", CFrame.new(O + V(6.5, 2.4, 6.5)), V(3.6, 3.6, 3.6), RGB(90, 70, 50), M.Wood, { Shape = Enum.PartType.Cylinder, Orientation = V(0, 0, 90) })
	Parts.box(m, "Sack", CFrame.new(O + V(6.8, 1.3, 2.5)) * CFrame.Angles(0, 0.4, 0), V(2.4, 1.4, 1.8), RGB(170, 150, 110), M.Fabric)
	Parts.box(m, "Sack", CFrame.new(O + V(7.2, 1.3, -2.5)) * CFrame.Angles(0, -0.3, 0), V(2.4, 1.4, 1.8), RGB(160, 140, 105), M.Fabric)

	-- поляна делится на 4 четверти, в каждой своё (порядок случайный)
	local kinds = { "lake", "forest", "mine", "meadow" }
	for k = #kinds, 2, -1 do
		local j = rng:NextInteger(1, k)
		kinds[k], kinds[j] = kinds[j], kinds[k]
	end
	local quads = { V(-1, 0, -1), V(1, 0, -1), V(-1, 0, 1), V(1, 0, 1) }
	local QC = E / 2
	local lakeC
	refs.quadrants = {}
	-- случайная точка внутри четверти (не на тропинках, не у лифта)
	local function spotIn(q, margin, avoid)
		for _ = 1, 80 do
			local p = V(q.X * rng:NextNumber(14, E - margin), 0, q.Z * rng:NextNumber(14, E - margin))
			local ok = true
			if lakeC and (O + p - lakeC).Magnitude < SAND_R + 6 then
				ok = false
			end
			for _, a in ipairs(avoid or {}) do
				if (p - a.p).Magnitude < a.r then
					ok = false
				end
			end
			if ok then
				return O + p
			end
		end
		return O + V(q.X * QC, 0, q.Z * QC)
	end
	for k, kind in ipairs(kinds) do
		local q = quads[k]
		local qc = O + q * QC
		refs.quadrants[kind] = qc
		if kind == "lake" then
			lakeC = qc + V(-q.X * 4, 0, -q.Z * 4)
			refs.lakeCenter = lakeC
			-- причал к центру озера
			local dock = lakeC - q * 50
			Parts.box(m, "Dock", CFrame.lookAt(dock + V(0, 0.6, 0), lakeC + V(0, 0.6, 0)) * CFrame.new(0, 0, -6), V(6, 0.6, 24), WOOD, M.WoodPlanks)
			for _, x in ipairs({ -2.6, 2.6 }) do
				for _, z in ipairs({ -2, -10, -17 }) do
					Parts.box(m, "DockPost", CFrame.lookAt(dock, lakeC) * CFrame.new(x, -1, z), V(0.8, 4, 0.8), RGB(70, 50, 34), M.Wood)
				end
			end
			-- камыш и трава по берегу (из неё — бинты)
			for _ = 1, 14 do
				local a = rng:NextNumber(0, math.pi * 2)
				local p = lakeC + V(math.cos(a), 0, math.sin(a)) * rng:NextNumber(LAKE_R + 3, SAND_R + 6)
				if math.abs(p.X - O.X) < E - 6 and math.abs(p.Z - O.Z) < E - 6 then
					local base = Parts.box(m, "TallGrass", CFrame.new(p + V(0, 1.4, 0)), V(2.6, 2.8, 2.6), RGB(110, 140, 70), M.Grass, NOCOLLIDE)
					base.Transparency = 0.2
					tag(prompt(base, "Сорвать траву", "Высокая трава", 0.4, 9), "FiberPrompt")
				end
			end
		elseif kind == "forest" then
			-- густая роща: деревья отрастают после вырубки
			local placedT = {}
			for _ = 1, 700 do
				if #placedT >= 95 then
					break
				end
				local p = spotIn(q, 8)
				local ok = true
				for _, t in ipairs(placedT) do
					if (t - p).Magnitude < 8.5 then
						ok = false
						break
					end
				end
				if ok then
					table.insert(placedT, p)
					table.insert(refs.nodes, node(m, "tree", p, rng))
				end
			end
		elseif kind == "mine" then
			-- скалы, вход в шахту и много камня с железом
			for _ = 1, 14 do
				local p = spotIn(q, 16)
				local sz = rng:NextNumber(8, 20)
				Parts.box(m, "Cliff", CFrame.new(p + V(0, sz * 0.3, 0)) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, 6), rng:NextNumber(-0.3, 0.3)), V(sz, sz * 0.8, sz * 0.9), RGB(98, 96, 92), M.Slate)
			end
			mine(m, qc, ((O - qc) * V(1, 0, 1)).Unit, { "stone", "stone", "iron", "iron" }, rng, refs.nodes)
			for k2 = 1, 16 do
				table.insert(refs.nodes, node(m, k2 % 4 == 0 and "iron" or "stone", spotIn(q, 10, { { p = qc - O, r = 18 } }), rng))
			end
		else
			-- луг: костёр с брёвнами, ягоды, высокая трава, цветы
			local fc = qc
			local fireBase = Parts.box(m, "Campfire", CFrame.new(fc + V(0, 0.3, 0)), V(4, 0.6, 4), RGB(50, 34, 26), M.Slate)
			local fire = Instance.new("Fire")
			fire.Size = 6
			fire.Heat = 9
			fire.Parent = fireBase
			Parts.light(fireBase, 40, 1.5, RGB(255, 150, 70), true)
			for k2 = 0, 5 do
				local a = k2 / 6 * math.pi * 2
				Parts.box(m, "Log", CFrame.new(fc + V(math.cos(a) * 6, 0.8, math.sin(a) * 6)) * CFrame.Angles(0, -a, 0) * CFrame.Angles(0, 0, math.pi / 2), V(1.6, 4.5, 1.6), WOOD, M.Wood, { Shape = Enum.PartType.Cylinder })
			end
			local avoidFire = { { p = fc - O, r = 12 } }
			for _ = 1, 22 do
				local p = spotIn(q, 10, avoidFire)
				local bush = Parts.box(m, "BerryBush", CFrame.new(p + V(0, 1.8, 0)), V(5, 3.8, 5), RGB(46, 84, 40), M.LeafyGrass, { Shape = Enum.PartType.Ball })
				for _ = 1, 7 do
					Parts.box(m, "Berry", CFrame.new(p + V(rng:NextNumber(-2, 2), rng:NextNumber(1.2, 3.4), rng:NextNumber(-2, 2))), V(0.55, 0.55, 0.55), RGB(200, 30, 50), M.SmoothPlastic, {
						Shape = Enum.PartType.Ball,
						CanCollide = false,
					})
				end
				tag(prompt(bush, "Собрать ягоды", "Куст", 0.5, 10), "BerryPrompt")
			end
			for _ = 1, 20 do
				local p = spotIn(q, 8, avoidFire)
				local base = Parts.box(m, "TallGrass", CFrame.new(p + V(0, 1.4, 0)), V(2.6, 2.8, 2.6), RGB(110, 140, 70), M.Grass, NOCOLLIDE)
				base.Transparency = 0.2
				for _ = 1, 5 do
					Parts.box(m, "Blade", CFrame.new(p + V(rng:NextNumber(-1.2, 1.2), 1.8, rng:NextNumber(-1.2, 1.2))) * CFrame.Angles(rng:NextNumber(-0.2, 0.2), 0, rng:NextNumber(-0.2, 0.2)), V(0.2, 3.6, 0.2), RGB(120, 150, 70), M.Grass, NOCOLLIDE)
				end
				tag(prompt(base, "Сорвать траву", "Высокая трава", 0.4, 9), "FiberPrompt")
			end
			for _ = 1, 120 do
				local p = spotIn(q, 4)
				local c = ({ RGB(230, 210, 80), RGB(200, 80, 120), RGB(240, 240, 240), RGB(150, 120, 230) })[rng:NextInteger(1, 4)]
				Parts.box(m, "Flower", CFrame.new(p + V(0, 0.4, 0)), V(0.7, 0.3, 0.7), c, M.SmoothPlastic, NOCOLLIDE)
			end
		end
	end
	-- немного деревьев и камней у стен по всей поляне
	for _ = 1, 10 do
		local q = quads[rng:NextInteger(1, 4)]
		if refs.quadrants.lake ~= O + q * QC then
			table.insert(refs.nodes, node(m, "stone", spotIn(q, 8), rng))
		end
	end

	m.Parent = parent
	return refs
end

------------------------------------------------------------------
-- Стены поляны с воротами
------------------------------------------------------------------
function World.BuildClearingWalls(parent, O)
	local m = Instance.new("Model")
	m.Name = "ClearingWalls"
	local h = MZ.WallHeight + 12
	local t = 8
	local GW = Config.GateWidth
	local GH = h - 14
	local gates = {}
	local E = CLEAR_HALF
	local op = { { c = 0, w = GW, b = 0, h = GH } }
	Parts.wall(m, O, "X", -E, -E - t / 2, E + t / 2, 0, h, op, WALL_DARK, M.Slate, t)
	Parts.wall(m, O, "X", E, -E - t / 2, E + t / 2, 0, h, op, WALL_DARK, M.Slate, t)
	Parts.wall(m, O, "Z", -E, -E, E, 0, h, op, WALL_DARK, M.Slate, t)
	Parts.wall(m, O, "Z", E, -E, E, 0, h, op, WALL_DARK, M.Slate, t)
	-- плющ на стенах поляны
	local rng = Random.new(O.X + 3)
	for _ = 1, 30 do
		local side = rng:NextInteger(1, 4)
		local a = rng:NextNumber(-E + 20, E - 20)
		local len, hh = rng:NextNumber(10, 26), rng:NextNumber(14, 40)
		local inset = E - t / 2 - 0.2
		local p, size
		if side == 1 then
			p, size = V(a, h - hh / 2, -inset), V(len, hh, 0.4)
		elseif side == 2 then
			p, size = V(a, h - hh / 2, inset), V(len, hh, 0.4)
		elseif side == 3 then
			p, size = V(-inset, h - hh / 2, a), V(0.4, hh, len)
		else
			p, size = V(inset, h - hh / 2, a), V(0.4, hh, len)
		end
		if math.abs(a) > GW / 2 + 6 then
			Parts.box(m, "Ivy", CFrame.new(O + p), size, IVY, M.LeafyGrass, NOCOLLIDE)
		end
	end

	for _, g in ipairs({
		{ name = "Север", pos = V(0, 0, -E), axis = "X" },
		{ name = "Юг", pos = V(0, 0, E), axis = "X" },
		{ name = "Запад", pos = V(-E, 0, 0), axis = "Z" },
		{ name = "Восток", pos = V(E, 0, 0), axis = "Z" },
	}) do
		local along = g.axis == "X" and V(1, 0, 0) or V(0, 0, 1)
		local leaves = {}
		for _, side in ipairs({ -1, 1 }) do
			local size = g.axis == "X" and V(GW / 2, GH, 6) or V(6, GH, GW / 2)
			local closed = CFrame.new(O + g.pos + along * side * (GW / 4) + V(0, GH / 2, 0))
			local leaf = Parts.box(m, "GateLeaf", closed, size, RGB(66, 62, 58), M.Slate)
			for y = -GH / 2 + 5, GH / 2 - 5, 9 do
				Parts.box(leaf, "Band", closed * CFrame.new(0, y, 0), g.axis == "X" and V(GW / 2, 1.2, 6.4) or V(6.4, 1.2, GW / 2), METAL, M.Metal, NOCOLLIDE)
			end
			table.insert(leaves, { part = leaf, closed = closed, open = closed + along * side * (GW / 2 + 1) })
		end
		for _, side in ipairs({ -1, 1 }) do
			local inward = -g.pos.Unit
			local tp = O + g.pos + along * side * (GW / 2 + 4) + inward * 5 + V(0, 14, 0)
			local torch = Parts.box(m, "GateTorch", CFrame.new(tp), V(1, 1.5, 1), RGB(255, 140, 50), M.Neon)
			Parts.light(torch, 34, 1.4, RGB(255, 150, 70), true)
			local f = Instance.new("Fire")
			f.Size = 3
			f.Parent = torch
		end
		table.insert(gates, { name = g.name, leaves = leaves })
	end
	m.Parent = parent
	return gates
end

------------------------------------------------------------------
-- Лабиринт
------------------------------------------------------------------
------------------------------------------------------------------
-- Геометрия лабиринта: внутренний круг (клетки 32) и внешнее кольцо
-- (клетки 64 — «увеличенный» лабиринт: коридоры шире, стены выше).
-- Внешние клетки — это блоки 2x2 мелких клеток, поэтому стены сходятся ровно.
------------------------------------------------------------------
local R1, R2 = MZ.Radius, MZ.OuterRadius
local C2 = C * 2
local NC = math.ceil(N / 2)
local H1, H2 = MZ.WallHeight, MZ.OuterWallHeight

local function blockDist(I, J)
	local x, y = 2 * I + 0.5 - MID, 2 * J + 0.5 - MID
	return math.sqrt(x * x + y * y)
end

-- "inner" / "outer" / "out" для большого блока
local function regionC(I, J)
	if I < 0 or J < 0 or I >= NC or J >= NC then
		return "out"
	end
	local d = blockDist(I, J)
	if d <= R1 then
		return "inner"
	elseif d <= R2 then
		return "outer"
	end
	return "out"
end

-- "in" / "outer" / "clear" / "out" для мелкой клетки
local function regionF(i, j)
	if i < 0 or j < 0 or i >= N or j >= N then
		return "out"
	end
	if inClearing(i, j) then
		return "clear"
	end
	local r = regionC(i // 2, j // 2)
	if r == "inner" then
		return "in"
	end
	return r
end

local function fineKey(i, j)
	return "f" .. i .. "," .. j
end
local function coarseKey(I, J)
	return "c" .. I .. "," .. J
end
local function finePos(i, j)
	return V((i - MID) * C, 0, (j - MID) * C)
end
local function coarsePos(I, J)
	return V((2 * I + 0.5 - MID) * C, 0, (2 * J + 0.5 - MID) * C)
end

local DIRS = { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }

-- лабиринт как граф: узлы — клетки обеих зон, рёбра — проходы
local function generate(rng)
	local open = {} -- ключ ребра -> true
	local function ekey(a, b)
		return a < b and (a .. "|" .. b) or (b .. "|" .. a)
	end
	local function dfs(cells, start, nbrs)
		local visited = { [start] = true }
		local stack = { start }
		while #stack > 0 do
			local cur = stack[#stack]
			local cand = {}
			for _, nb in ipairs(nbrs(cur)) do
				if not visited[nb] then
					table.insert(cand, nb)
				end
			end
			if #cand == 0 then
				table.remove(stack)
			else
				local nb = cand[rng:NextInteger(1, #cand)]
				open[ekey(cur, nb)] = true
				visited[nb] = true
				table.insert(stack, nb)
			end
		end
		-- немного лишних проходов, чтобы были петли
		for _, c in ipairs(cells) do
			for _, nb in ipairs(nbrs(c)) do
				if rng:NextNumber() < MZ.ExtraOpenings * 0.5 then
					open[ekey(c, nb)] = true
				end
			end
		end
	end
	local nodes = {}
	-- внутренняя зона
	local fineCells, fineIJ = {}, {}
	for i = 0, N - 1 do
		for j = 0, N - 1 do
			if regionF(i, j) == "in" then
				local k = fineKey(i, j)
				table.insert(fineCells, k)
				fineIJ[k] = { i, j }
				nodes[k] = { key = k, pos = finePos(i, j), size = C, zone = "in", i = i, j = j }
			end
		end
	end
	dfs(fineCells, fineKey(MID, CLEAR_LO - 1), function(k)
		local ij = fineIJ[k]
		local list = {}
		for _, d in ipairs(DIRS) do
			if regionF(ij[1] + d[1], ij[2] + d[2]) == "in" then
				table.insert(list, fineKey(ij[1] + d[1], ij[2] + d[2]))
			end
		end
		return list
	end)
	-- внешнее кольцо
	local coarseCells, coarseIJ = {}, {}
	for I = 0, NC - 1 do
		for J = 0, NC - 1 do
			if regionC(I, J) == "outer" then
				local k = coarseKey(I, J)
				table.insert(coarseCells, k)
				coarseIJ[k] = { I, J }
				nodes[k] = { key = k, pos = coarsePos(I, J), size = C2, zone = "outer", I = I, J = J }
			end
		end
	end
	dfs(coarseCells, coarseCells[1], function(k)
		local ij = coarseIJ[k]
		local list = {}
		for _, d in ipairs(DIRS) do
			if regionC(ij[1] + d[1], ij[2] + d[2]) == "outer" then
				table.insert(list, coarseKey(ij[1] + d[1], ij[2] + d[2]))
			end
		end
		return list
	end)
	-- проходы между кругом и кольцом: по одному в каждом из 10 секторов
	local bins = {}
	for _, k in ipairs(fineCells) do
		local ij = fineIJ[k]
		for _, d in ipairs(DIRS) do
			local ni, nj = ij[1] + d[1], ij[2] + d[2]
			if regionF(ni, nj) == "outer" then
				local a = math.atan2(nj - MID, ni - MID)
				local bin = math.floor((a + math.pi) / (math.pi * 2) * 10) % 10
				bins[bin] = bins[bin] or {}
				table.insert(bins[bin], { k, coarseKey(ni // 2, nj // 2), ni, nj, ij[1], ij[2] })
			end
		end
	end
	local gates = {}
	for b = 0, 9 do
		local list = bins[b]
		if list and #list > 0 then
			local g = list[rng:NextInteger(1, #list)]
			open[ekey(g[1], g[2])] = true
			gates[g[5] .. "," .. g[6] .. ">" .. g[3] .. "," .. g[4]] = true
		end
	end
	-- соседи для поиска путей
	local adj = {}
	for k, n in pairs(nodes) do
		adj[k] = {}
		if n.zone == "in" then
			for _, d in ipairs(DIRS) do
				local ni, nj = n.i + d[1], n.j + d[2]
				local r = regionF(ni, nj)
				local nk = (r == "in" and fineKey(ni, nj)) or (r == "outer" and coarseKey(ni // 2, nj // 2)) or nil
				if nk and open[ekey(k, nk)] and (r == "in" or gates[n.i .. "," .. n.j .. ">" .. ni .. "," .. nj]) then
					table.insert(adj[k], nk)
				end
			end
		end
	end
	for k, n in pairs(nodes) do
		if n.zone == "outer" then
			for _, d in ipairs(DIRS) do
				local nk = coarseKey(n.I + d[1], n.J + d[2])
				if regionC(n.I + d[1], n.J + d[2]) == "outer" and open[ekey(k, nk)] then
					table.insert(adj[k], nk)
				end
			end
		end
	end
	for k, list in pairs(adj) do
		for _, nk in ipairs(list) do
			if nodes[nk].zone ~= nodes[k].zone and not table.find(adj[nk], k) then
				table.insert(adj[nk], k)
			end
		end
	end
	return {
		nodes = nodes,
		adj = adj,
		open = open,
		gates = gates,
		ekey = ekey,
	}
end

-- выход: большая клетка на краю кольца, наружу — свободное место
local function exitCandidates()
	local list = {}
	for I = 0, NC - 1 do
		for J = 0, NC - 1 do
			if regionC(I, J) == "outer" then
				for _, d in ipairs(DIRS) do
					local clear = regionC(I + d[1], J + d[2]) == "out"
					for k = 1, 6 do
						for l = -2, 2 do
							local ci = I + d[1] * k + (d[1] == 0 and l or 0)
							local cj = J + d[2] * k + (d[2] == 0 and l or 0)
							if regionC(ci, cj) ~= "out" then
								clear = false
							end
						end
					end
					if clear then
						table.insert(list, { I = I, J = J, di = d[1], dj = d[2] })
					end
				end
			end
		end
	end
	return list
end

local function chest(parent, pos, facing, golden)
	local m = Instance.new("Model")
	m.Name = golden and "GoldenChest" or "Chest"
	pos = pos + V(0, 0.4, 0)
	local b = CFrame.lookAt(pos, pos + facing)
	local wood = golden and RGB(90, 60, 30) or RGB(100, 70, 40)
	local trim = golden and RGB(230, 180, 60) or RGB(70, 70, 74)
	local body = Parts.box(m, "Body", b * CFrame.new(0, 1.1, 0), V(4, 2.2, 2.6), wood, M.WoodPlanks)
	local lid = Parts.box(m, "Lid", b * CFrame.new(0, 2.5, 0), V(4.1, 0.7, 2.7), wood, M.WoodPlanks)
	for _, x in ipairs({ -1.4, 1.4 }) do
		Parts.box(m, "Band", b * CFrame.new(x, 1.5, 0), V(0.3, 3, 2.8), trim, M.Metal, NOCOLLIDE)
	end
	Parts.box(m, "Lock", b * CFrame.new(0, 2.1, -1.4), V(0.6, 0.7, 0.2), trim, M.Metal, NOCOLLIDE)
	if golden then
		Parts.light(body, 20, 1.4, RGB(255, 200, 90), true)
		-- над золотым сундуком висит ключ
		local key = Parts.box(m, "KeyGlow", b * CFrame.new(0, 5, 0), V(0.4, 1.6, 0.8), RGB(255, 210, 90), M.Neon, NOCOLLIDE)
		Parts.light(key, 14, 1, RGB(255, 210, 90), false)
	end
	local p = prompt(body, "Открыть", golden and "Золотой сундук" or "Сундук", 0.8, 10)
	m:SetAttribute("Golden", golden == true)
	m.Parent = parent
	tag(m, "Chest")
	return { model = m, lid = lid, prompt = p, base = b }
end

-- Стены лабиринта и всё внутри. Каждую ночь строится заново, выход остаётся на месте.
-- fixed: { exit = {I,J,di,dj}, keyTaken, mapFound }
function World.BuildMazeLayout(parent, seed, O, fixed)
	fixed = fixed or {}
	local rng = Random.new(seed)
	local m = Instance.new("Model")
	m.Name = "Maze"
	local g = generate(rng)
	local nodes, adj, open, gates, ekey = g.nodes, g.adj, g.open, g.gates, g.ekey
	local refs = { model = m, nodes = {}, chests = {}, cells = {}, mapWalls = {} }
	local T = MZ.WallThickness

	local list = {}
	for k, n in pairs(nodes) do
		table.insert(list, k)
		table.insert(refs.cells, O + n.pos)
	end
	table.sort(list)

	-- расстояния от ворот поляны
	local dist = {}
	local queue = {}
	for _, st in ipairs({ { MID, CLEAR_LO - 1 }, { MID, CLEAR_HI + 1 }, { CLEAR_LO - 1, MID }, { CLEAR_HI + 1, MID } }) do
		local k = fineKey(st[1], st[2])
		if nodes[k] then
			dist[k] = 0
			table.insert(queue, k)
		end
	end
	local head = 1
	while head <= #queue do
		local cur = queue[head]
		head += 1
		for _, nb in ipairs(adj[cur]) do
			if dist[nb] == nil then
				dist[nb] = dist[cur] + 1
				table.insert(queue, nb)
			end
		end
	end

	-- выход выбирается один раз — самый дальний подходящий
	local ex = fixed.exit
	if not ex then
		local best = -1
		for _, c in ipairs(exitCandidates()) do
			local d = dist[coarseKey(c.I, c.J)] or 0
			if d > best then
				ex, best = c, d
			end
		end
	end
	refs.exit = ex

	-- все отрезки стен: потом соседние склеиваются в длинные
	local segs = {}
	local function addSeg(axis, fixedC, a, b, h, crack)
		table.insert(segs, { axis = axis, fixed = fixedC, a = a, b = b, h = h, crack = crack })
	end
	-- мелкая сетка: стены внутреннего круга и граница с кольцом
	for i = -1, N - 1 do
		for j = -1, N - 1 do
			for _, d in ipairs({ { 1, 0 }, { 0, 1 } }) do
				local ai, aj, bi, bj = i, j, i + d[1], j + d[2]
				local ra, rb = regionF(ai, aj), regionF(bi, bj)
				local wall, h, crack = false, H1, false
				if ra ~= "clear" and rb ~= "clear" then
					if ra == "in" and rb == "in" then
						wall = not open[ekey(fineKey(ai, aj), fineKey(bi, bj))]
						crack = wall and rng:NextNumber() < 0.045
					elseif (ra == "in" and rb == "outer") or (ra == "outer" and rb == "in") then
						local fi, fj, oi, oj = ai, aj, bi, bj
						if ra == "outer" then
							fi, fj, oi, oj = bi, bj, ai, aj
						end
						wall = not gates[fi .. "," .. fj .. ">" .. oi .. "," .. oj]
						h = H2
					elseif (ra == "in" and rb == "out") or (ra == "out" and rb == "in") then
						wall, h = true, H2
					end
				end
				if wall then
					if d[1] == 1 then -- стена между клетками по X: идёт вдоль Z
						local x = (ai - MID) * C + C / 2
						addSeg("Z", x, (aj - MID) * C - C / 2, (aj - MID) * C + C / 2, h, crack)
					else
						local z = (aj - MID) * C + C / 2
						addSeg("X", z, (ai - MID) * C - C / 2, (ai - MID) * C + C / 2, h, crack)
					end
				end
			end
		end
	end
	-- крупная сетка: стены внешнего кольца
	local function isExit(I, J, di, dj)
		return ex and ex.I == I and ex.J == J and ex.di == di and ex.dj == dj
	end
	for I = -1, NC - 1 do
		for J = -1, NC - 1 do
			for _, d in ipairs({ { 1, 0 }, { 0, 1 } }) do
				local bI, bJ = I + d[1], J + d[2]
				local ra, rb = regionC(I, J), regionC(bI, bJ)
				local wall = false
				if ra == "outer" and rb == "outer" then
					wall = not open[ekey(coarseKey(I, J), coarseKey(bI, bJ))]
				elseif ra == "outer" and rb == "out" then
					wall = not isExit(I, J, d[1], d[2])
				elseif ra == "out" and rb == "outer" then
					wall = not isExit(bI, bJ, -d[1], -d[2])
				end
				if wall then
					if d[1] == 1 then
						local x = (2 * I + 1.5 - MID) * C
						addSeg("Z", x, (2 * J - MID) * C - C / 2, (2 * J + 1 - MID) * C + C / 2, H2, false)
					else
						local z = (2 * J + 1.5 - MID) * C
						addSeg("X", z, (2 * I - MID) * C - C / 2, (2 * I + 1 - MID) * C + C / 2, H2, false)
					end
				end
			end
		end
	end

	local function ivy(axis, fixedC, a, b, h)
		if rng:NextNumber() < 0.5 then
			local len = math.min(b - a, rng:NextNumber(8, 22))
			local cpos = rng:NextNumber(a + len / 2, b - len / 2)
			local hgt = rng:NextNumber(12, h * 0.7)
			local side = rng:NextNumber() < 0.5 and -1 or 1
			if axis == "X" then
				Parts.span(m, "Ivy", O, V(cpos - len / 2, h - hgt, fixedC + side * (T / 2) - 0.2), V(cpos + len / 2, h, fixedC + side * (T / 2) + 0.2), IVY, M.LeafyGrass, NOCOLLIDE)
			else
				Parts.span(m, "Ivy", O, V(fixedC + side * (T / 2) - 0.2, h - hgt, cpos - len / 2), V(fixedC + side * (T / 2) + 0.2, h, cpos + len / 2), IVY, M.LeafyGrass, NOCOLLIDE)
			end
		end
	end
	local function wallPart(name, axis, fixedC, a, b, y0, y1, th)
		if axis == "X" then
			return Parts.span(m, name, O, V(a, y0, fixedC - th / 2), V(b, y1, fixedC + th / 2), WALL, M.Slate)
		end
		return Parts.span(m, name, O, V(fixedC - th / 2, y0, a), V(fixedC + th / 2, y1, b), WALL, M.Slate)
	end
	-- стена со щелью (пролезть только пригнувшись)
	local function crackWall(axis, fixedC, from, to, h)
		local mid = (from + to) / 2
		wallPart("MazeWall", axis, fixedC, from - T / 2, mid - 3, 0, h, T)
		wallPart("MazeWall", axis, fixedC, mid + 3, to + T / 2, 0, h, T)
		wallPart("MazeWall", axis, fixedC, mid - 3, mid + 3, 9, h, T)
		wallPart("CrawlCover", axis, fixedC, mid - 3, mid + 3, 4, 9, T).CollisionGroup = "CrawlCover"
		for _, side in ipairs({ -1, 1 }) do
			for k = 0, 6 do
				local a = k / 6 * math.pi
				local along = -math.cos(a) * 3.6
				local up = math.sin(a) * 5.2
				local face = fixedC + side * (T / 2 + 0.25)
				local p = axis == "X" and V(mid + along, up, face) or V(face, up, mid + along)
				Parts.box(m, "CrackStone", CFrame.new(O + p) * CFrame.Angles(0, 0, rng:NextNumber(-0.6, 0.6)), axis == "X" and V(rng:NextNumber(0.8, 1.2), rng:NextNumber(0.6, 0.9), 0.5) or V(0.5, rng:NextNumber(0.6, 0.9), rng:NextNumber(0.8, 1.2)), WALL, M.Slate, NOCOLLIDE)
			end
			local mp = axis == "X" and V(mid, 0.1, fixedC + side * (T / 2 + 1.5)) or V(fixedC + side * (T / 2 + 1.5), 0.1, mid)
			Parts.box(m, "CrackMoss", CFrame.new(O + mp), axis == "X" and V(7, 0.2, 2.5) or V(2.5, 0.2, 7), IVY, M.LeafyGrass, NOCOLLIDE)
		end
	end
	-- склеиваем отрезки на одной линии одной высоты
	table.sort(segs, function(p, q)
		if p.axis ~= q.axis then
			return p.axis < q.axis
		elseif p.fixed ~= q.fixed then
			return p.fixed < q.fixed
		elseif p.h ~= q.h then
			return p.h < q.h
		end
		return p.a < q.a
	end)
	local run
	-- факелы на стенах лабиринта, чтобы в коридорах было светлее
	local torchN = 0
	local function wallTorch(axis, fixedC, a, b, th)
		if torchN >= 140 or b - a < 20 or rng:NextNumber() > 0.35 then
			return
		end
		torchN += 1
		local along = (a + b) / 2
		local side = rng:NextNumber() < 0.5 and -1 or 1
		local off = th / 2 + 0.6
		local p = axis == "X" and V(along, 11, fixedC + side * off) or V(fixedC + side * off, 11, along)
		local holder = Parts.box(m, "TorchHolder", CFrame.new(O + p - V(0, 1, 0)), V(0.6, 1.6, 0.6), RGB(50, 44, 40), M.Metal, NOCOLLIDE)
		local flame = Parts.box(m, "WallTorch", CFrame.new(O + p + V(0, 0.4, 0)), V(0.8, 1, 0.8), RGB(255, 160, 70), M.Neon, NOCOLLIDE)
		Parts.light(flame, 34, 1.4, RGB(255, 175, 100), true)
		local _ = holder
	end
	local function flush()
		if run then
			wallTorch(run.axis, run.fixed, run.a, run.b, run.h > H1 and T * 2 or T)
			local th = run.h > H1 and T * 2 or T
			wallPart("MazeWall", run.axis, run.fixed, run.a - T / 2, run.b + T / 2, 0, run.h, th)
			-- карниз сверху, тёмный цоколь со мхом снизу, у высоких стен — пояс посередине
			local cap = wallPart("WallCap", run.axis, run.fixed, run.a - T / 2 - 0.6, run.b + T / 2 + 0.6, run.h - 0.2, run.h + 1.6, th + 1.2)
			cap.Color, cap.Material = WALL_DARK, M.Slate
			local foot = wallPart("WallFoot", run.axis, run.fixed, run.a - T / 2, run.b + T / 2, 0, 3.2, th + 0.8)
			foot.Color, foot.Material = RGB(58, 66, 52), M.Slate
			if run.h > H1 then
				local band = wallPart("WallBand", run.axis, run.fixed, run.a - T / 2, run.b + T / 2, run.h * 0.55, run.h * 0.55 + 2, th + 0.6)
				band.Color, band.Material = WALL_DARK, M.Slate
			end
			table.insert(refs.mapWalls, { run.axis, run.fixed, run.a - T / 2, run.b + T / 2, 0 })
			ivy(run.axis, run.fixed, run.a, run.b, run.h)
			run = nil
		end
	end
	for _, sg in ipairs(segs) do
		if sg.crack then
			flush()
			crackWall(sg.axis, sg.fixed, sg.a, sg.b, sg.h)
			table.insert(refs.mapWalls, { sg.axis, sg.fixed, sg.a - T / 2, sg.b + T / 2, 1 })
		elseif run and run.axis == sg.axis and run.fixed == sg.fixed and run.h == sg.h and math.abs(run.b - sg.a) < 0.01 then
			run.b = sg.b
		else
			flush()
			run = { axis = sg.axis, fixed = sg.fixed, a = sg.a, b = sg.b, h = sg.h }
		end
	end
	flush()

	-- тупики
	local deadEnds = {}
	for _, k in ipairs(list) do
		local n = nodes[k]
		local isEx = ex and n.zone == "outer" and n.I == ex.I and n.J == ex.J
		if dist[k] and dist[k] > 2 and #adj[k] == 1 and not isEx then
			table.insert(deadEnds, { k = k, d = dist[k], pos = O + n.pos, to = O + nodes[adj[k][1]].pos })
		end
	end
	table.sort(deadEnds, function(a, b)
		return a.d > b.d
	end)
	if deadEnds[1] and not fixed.keyTaken then
		local de = table.remove(deadEnds, 1)
		table.insert(refs.chests, chest(m, de.pos, (de.to - de.pos).Unit, true))
	end
	-- карта лабиринта лежит на столе в тупике средней глубины
	if not fixed.mapFound and #deadEnds > 4 then
		local de = table.remove(deadEnds, math.floor(#deadEnds / 2))
		local b = CFrame.lookAt(de.pos, de.pos + (de.to - de.pos).Unit)
		Parts.box(m, "MapTable", b * CFrame.new(0, 1.6, 0), V(5, 0.4, 3), RGB(100, 72, 46), M.WoodPlanks)
		for _, x in ipairs({ -2.1, 2.1 }) do
			for _, z in ipairs({ -1.1, 1.1 }) do
				Parts.box(m, "TableLeg", b * CFrame.new(x, 0.7, z), V(0.4, 1.4, 0.4), RGB(80, 58, 38), M.Wood)
			end
		end
		local sheet = Parts.box(m, "MazeMap", b * CFrame.new(0, 1.85, 0) * CFrame.Angles(0, 0.2, 0), V(2.6, 0.06, 1.8), RGB(225, 210, 170), M.SmoothPlastic, NOCOLLIDE)
		sheet.CanQuery = true
		Parts.light(sheet, 12, 0.8, RGB(255, 230, 170), false)
		tag(prompt(sheet, "Взять карту", "Карта лабиринта", 0.6, 9), "MapPrompt")
	end
	local far, near = {}, {}
	for k, de in ipairs(deadEnds) do
		table.insert(k <= #deadEnds / 2 and far or near, de)
	end
	local function takeMine(lst, kinds)
		if #lst == 0 then
			return
		end
		local de = table.remove(lst, rng:NextInteger(1, #lst))
		mine(m, de.pos, (de.to - de.pos).Unit, kinds, rng, refs.nodes)
	end
	for k = 1, MZ.Mines do
		if k % 2 == 1 then
			takeMine(near, { "stone", "stone", "iron", "iron" })
		else
			takeMine(far, { "iron", "crystal", "crystal", "stone" })
		end
	end
	local rest = {}
	for _, de in ipairs(near) do
		table.insert(rest, de)
	end
	for _, de in ipairs(far) do
		table.insert(rest, de)
	end
	for _ = 1, math.min(MZ.Chests, #rest) do
		local de = table.remove(rest, rng:NextInteger(1, #rest))
		local c = chest(m, de.pos, (de.to - de.pos).Unit, false)
		c.model:SetAttribute("Depth", de.d)
		table.insert(refs.chests, c)
	end

	-- атмосфера: светящийся мох, кости, обломки, высокая трава
	local cells = refs.cells
	for _ = 1, 110 do
		local p = cells[rng:NextInteger(1, #cells)]
		local glow = Parts.box(m, "GlowMoss", CFrame.new(p + V(rng:NextNumber(-12, 12), 0.2, rng:NextNumber(-12, 12))), V(rng:NextNumber(1, 3), 0.3, rng:NextNumber(1, 3)), RGB(90, 255, 170), M.Neon, NOCOLLIDE)
		if rng:NextNumber() < 0.3 then
			Parts.light(glow, 12, 0.5, RGB(90, 255, 170), false)
		end
	end
	for _ = 1, 50 do
		local p = cells[rng:NextInteger(1, #cells)] + V(rng:NextNumber(-10, 10), 0, rng:NextNumber(-10, 10))
		if rng:NextNumber() < 0.5 then
			Parts.box(m, "Bone", CFrame.new(p + V(0, 0.2, 0)) * CFrame.Angles(0, rng:NextNumber(0, 6), 0), V(0.35, 0.35, 2.4), RGB(220, 215, 195), M.SmoothPlastic, NOCOLLIDE)
		else
			Parts.box(m, "Debris", CFrame.new(p + V(0, 0.8, 0)) * CFrame.Angles(rng:NextNumber(0, 3), rng:NextNumber(0, 3), 0), V(rng:NextNumber(1.5, 3), rng:NextNumber(1, 2), rng:NextNumber(1.5, 3)), WALL_DARK, M.Slate)
		end
	end
	for _ = 1, 28 do
		local p = cells[rng:NextInteger(1, #cells)] + V(rng:NextNumber(-9, 9), 0, rng:NextNumber(-9, 9))
		local base = Parts.box(m, "TallGrass", CFrame.new(p + V(0, 1.4, 0)), V(2.6, 2.8, 2.6), RGB(100, 130, 65), M.Grass, NOCOLLIDE)
		base.Transparency = 0.2
		tag(prompt(base, "Сорвать траву", "Высокая трава", 0.4, 9), "FiberPrompt")
	end
	for k = 1, 10 do
		local p = cells[rng:NextInteger(1, #cells)]
		if (p - O).Magnitude > CLEAR_HALF + 60 then
			camp(m, p, rng, k)
		end
	end
	for _ = 1, 34 do
		local p = cells[rng:NextInteger(1, #cells)] + V(rng:NextNumber(-9, 9), 0, rng:NextNumber(-9, 9))
		lootCrate(m, p, rng)
	end
	for k = 10, 16 do
		local p = cells[rng:NextInteger(1, #cells)] + V(rng:NextNumber(-8, 8), 0.1, rng:NextNumber(-8, 8))
		note(m, CFrame.new(p) * CFrame.Angles(0, rng:NextNumber(0, 6), 0), rng, k)
	end
	for _ = 1, 30 do
		local c = cells[rng:NextInteger(1, #cells)]
		if (c - O).Magnitude > CLEAR_HALF + 40 then
			local dir = ({ V(1, 0, 0), V(-1, 0, 0), V(0, 0, 1), V(0, 0, -1) })[rng:NextInteger(1, 4)]
			vineHide(m, c + dir * 9.5, rng)
		end
	end

	m.Parent = parent
	return refs
end

------------------------------------------------------------------
-- Выход: широкий проём во всю клетку кольца → сразу пропасть с мостом →
-- металлическая лаборатория → вертолётная площадка.
-- Строится один раз за игру (лабиринт меняется, а выход — нет).
------------------------------------------------------------------
function World.BuildExit(parent, O, ex)
	local m = Instance.new("Model")
	m.Name = "Exit"
	local T = MZ.WallThickness
	local inner = O + coarsePos(ex.I, ex.J)
	local out = V(ex.di, 0, ex.dj)
	local W = C2
	local mouth = inner + out * (W / 2)
	local b = CFrame.lookAt(mouth, mouth + out) -- -Z смотрит наружу
	local refs = { model = m, exitOut = b }
	local STEEL = RGB(96, 102, 110)
	local STEEL_D = RGB(60, 64, 70)

	-- 1. короткий широкий проход: стены кольца продолжаются до самой пропасти
	-- пропасть короче, перед дверью — широкая площадка, чтобы не упасть
	local pitStart, pitEnd = 10, 34
	local face = -(pitEnd + 14)
	for _, sx in ipairs({ -1, 1 }) do
		Parts.box(m, "ExitWall", b * CFrame.new(sx * (W / 2 + T), H2 / 2, face / 2), V(T * 2, H2, -face), WALL_DARK, M.Slate)
		for d = 6, pitEnd, 12 do
			local lamp = Parts.box(m, "ExitLamp", b * CFrame.new(sx * (W / 2 - 0.6), 14, -d), V(0.8, 1.8, 1.4), RGB(255, 200, 120), M.Neon)
			Parts.light(lamp, 34, 1.3, RGB(255, 190, 120), d > 20)
			Parts.box(m, "Ivy", b * CFrame.new(sx * (W / 2 - 0.3), H2 - 16, -d - 4), V(0.4, 32, 8), IVY, M.LeafyGrass, NOCOLLIDE)
		end
	end
	Parts.box(m, "ExitFloor", b * CFrame.new(0, 0.15, -pitStart / 2), V(W, 0.3, pitStart), RGB(70, 68, 64), M.Concrete)
	refs.trigger = Parts.box(m, "ExitTrigger", b * CFrame.new(0, 6, -4), V(W, 12, 5), RGB(0, 0, 0), M.SmoothPlastic, { Transparency = 1, CanCollide = false, CanQuery = false })

	-- 2. пропасть во всю ширину, вниз — темнота и красный отсвет; широкий мост
	local plen = pitEnd - pitStart
	local pmid = -(pitStart + pitEnd) / 2
	refs.pit = { cf = b * CFrame.new(0, -10, pmid), size = V(W + 8, 28, plen + 2) }
	safe(function()
		workspace.Terrain:FillBlock(refs.pit.cf, refs.pit.size, M.Air)
	end)
	for _, d in ipairs({ -pitStart, -pitEnd }) do
		Parts.box(m, "PitFace", b * CFrame.new(0, -45, d + (d == -pitStart and -0.5 or 0.5)), V(W + 8, 90, 1), RGB(40, 38, 36), M.Slate)
	end
	for _, sx in ipairs({ -1, 1 }) do
		Parts.box(m, "PitSide", b * CFrame.new(sx * (W / 2 + 0.5), -45, pmid), V(1, 90, plen), RGB(40, 38, 36), M.Slate)
	end
	Parts.box(m, "PitBottom", b * CFrame.new(0, -92, pmid), V(W + 8, 2, plen), RGB(10, 8, 8), M.Slate)
	for _, x in ipairs({ -18, 18 }) do
		local glow = Parts.box(m, "PitGlow", b * CFrame.new(x, -88, pmid), V(2, 1, 2), RGB(120, 20, 20), M.Neon, NOCOLLIDE)
		Parts.light(glow, 60, 2, RGB(255, 40, 30), true)
	end
	Parts.box(m, "Bridge", b * CFrame.new(0, 0.3, pmid), V(10, 0.6, plen + 4), RGB(84, 88, 94), M.DiamondPlate)
	for _, sx in ipairs({ -1, 1 }) do
		Parts.box(m, "BridgeRail", b * CFrame.new(sx * 5, 3.4, pmid), V(0.3, 0.3, plen + 4), STEEL_D, M.Metal, NOCOLLIDE)
		for d = pitStart, pitEnd, 6 do
			Parts.box(m, "BridgePost", b * CFrame.new(sx * 5, 1.8, -d), V(0.4, 3.4, 0.4), STEEL_D, M.Metal)
		end
	end

	-- 3. фасад лаборатории закрывает весь проход
	-- площадка перед дверью (со считывателем), на всю ширину прохода
	Parts.box(m, "Landing", b * CFrame.new(0, 0.15, (face - pitEnd) / 2), V(W, 0.3, -face - pitEnd), RGB(78, 76, 72), M.Concrete)
	for _, sx in ipairs({ -1, 1 }) do
		Parts.box(m, "LandingRail", b * CFrame.new(sx * (5.5 + (W / 2 - 6) / 2), 1.8, -pitEnd - 0.3), V(W / 2 - 6, 3.4, 0.4), RGB(60, 64, 70), M.Metal)
	end
	local FW, FH = W + 40, 60
	local doorW, doorH = 20, 18
	Parts.box(m, "LabFacade", b * CFrame.new(-(doorW / 2 + (FW - doorW) / 4), FH / 2, face), V((FW - doorW) / 2, FH, 4), STEEL, M.DiamondPlate)
	Parts.box(m, "LabFacade", b * CFrame.new(doorW / 2 + (FW - doorW) / 4, FH / 2, face), V((FW - doorW) / 2, FH, 4), STEEL, M.DiamondPlate)
	Parts.box(m, "LabFacade", b * CFrame.new(0, doorH + (FH - doorH) / 2, face), V(doorW, FH - doorH, 4), STEEL, M.DiamondPlate)
	for y = 8, FH - 4, 10 do
		Parts.box(m, "FacadeRib", b * CFrame.new(0, y, face + 2.2), V(FW, 0.8, 0.4), STEEL_D, M.Metal, NOCOLLIDE)
	end
	local door = Parts.box(m, "ExitDoor", b * CFrame.new(0, doorH / 2, face + 0.6), V(doorW, doorH, 1.6), RGB(90, 95, 100), M.DiamondPlate)
	for _, x in ipairs({ -doorW / 2 - 1, doorW / 2 + 1 }) do
		Parts.box(m, "HazardStripe", b * CFrame.new(x, doorH / 2, face + 2.2), V(1.2, doorH, 0.2), RGB(230, 180, 40), M.SmoothPlastic, NOCOLLIDE)
	end
	for _, x in ipairs({ -14, 14 }) do
		local lamp = Parts.box(m, "ExitLamp", b * CFrame.new(x, doorH + 3, face + 2.6), V(1.8, 1.8, 1.8), RGB(120, 255, 160), M.Neon)
		Parts.light(lamp, 40, 1.8, RGB(140, 255, 170), true)
	end
	local sign = Parts.box(m, "ExitSign", b * CFrame.new(0, doorH + 8, face + 2.3), V(30, 6, 0.3), RGB(20, 40, 25), M.SmoothPlastic)
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Back
	sg.PixelsPerStud = 25
	sg.Parent = sign
	local tl = Instance.new("TextLabel")
	tl.Size = UDim2.fromScale(1, 1)
	tl.BackgroundTransparency = 1
	tl.Text = "СЕКТОР 7 · ВЫХОД"
	tl.Font = Enum.Font.GothamBlack
	tl.TextScaled = true
	tl.TextColor3 = RGB(140, 255, 170)
	tl.Parent = sg
	local reader = Parts.box(m, "CardReader", b * CFrame.new(doorW / 2 + 3, 4.6, face + 2.4), V(1.6, 2.4, 0.5), RGB(30, 32, 36), M.Metal)
	refs.readerLight = Parts.box(m, "ReaderLight", reader.CFrame * CFrame.new(0, 0.8, 0.3), V(0.5, 0.3, 0.1), RGB(255, 40, 40), M.Neon, NOCOLLIDE)
	Parts.box(m, "ReaderSlot", reader.CFrame * CFrame.new(0, -0.2, 0.3), V(1, 0.12, 0.1), RGB(10, 10, 10), M.SmoothPlastic, NOCOLLIDE)
	refs.reader = reader
	refs.exitDoor = door
	refs.exitPrompt = prompt(reader, "Приложить ключ-карту", "Считыватель", 0.3, 9)
	refs.doorFront = b * CFrame.new(doorW / 2 - 1, 3, face + 7)
	refs.introPts = { (b * CFrame.new(0, 5, 2)).Position, (b * CFrame.new(0, 5, -pitStart + 1)).Position, (b * CFrame.new(0, 5.3, face + 6)).Position }
	refs.doorEye = (b * CFrame.new(0, 5.3, face + 6)).Position

	-- 4. лаборатория: металлический пол, стены из панелей, мигающий свет
	local L0, L1 = face - 2, face - 64
	local LW, LH = 48, 16
	local len = L0 - L1
	local mid = (L0 + L1) / 2
	Parts.box(m, "LabFloor", b * CFrame.new(0, 0.3, mid), V(LW, 0.6, len), RGB(110, 114, 120), M.DiamondPlate)
	for x = -LW / 2 + 6, LW / 2 - 6, 12 do
		Parts.box(m, "FloorGrate", b * CFrame.new(x, 0.62, mid), V(3, 0.05, len - 4), RGB(50, 54, 60), M.Metal, NOCOLLIDE)
	end
	Parts.box(m, "LabCeiling", b * CFrame.new(0, LH, mid), V(LW, 0.8, len), STEEL_D, M.Metal)
	for _, sx in ipairs({ -1, 1 }) do
		Parts.box(m, "LabWall", b * CFrame.new(sx * (LW / 2 + 0.5), LH / 2, mid), V(1, LH, len), RGB(150, 156, 164), M.Metal)
		for d = L0 - 4, L1 + 4, -8 do
			Parts.box(m, "WallPanel", b * CFrame.new(sx * (LW / 2 - 0.1), LH / 2, d), V(0.3, LH - 2, 0.5), STEEL_D, M.Metal, NOCOLLIDE)
		end
		Parts.box(m, "Pipe", b * CFrame.new(sx * (LW / 2 - 0.8), LH - 2, mid) * CFrame.Angles(0, math.pi / 2, 0), V(len, 1, 1), RGB(120, 90, 60), M.Metal, { Shape = Enum.PartType.Cylinder, CanCollide = false })
	end
	local backW = 14
	Parts.box(m, "LabWall", b * CFrame.new(-(backW / 2 + (LW - backW) / 4), LH / 2, L1), V((LW - backW) / 2, LH, 1), RGB(150, 156, 164), M.Metal)
	Parts.box(m, "LabWall", b * CFrame.new(backW / 2 + (LW - backW) / 4, LH / 2, L1), V((LW - backW) / 2, LH, 1), RGB(150, 156, 164), M.Metal)
	Parts.box(m, "LabWall", b * CFrame.new(0, 12 + (LH - 12) / 2, L1), V(backW, LH - 12, 1), RGB(150, 156, 164), M.Metal)
	refs.labBackDoor = Parts.box(m, "LabBackDoor", b * CFrame.new(0, 6, L1), V(backW, 12, 0.8), RGB(90, 95, 100), M.DiamondPlate)
	for d = L0 - 6, L1 + 6, -10 do
		local lamp = Parts.box(m, "LabLamp", b * CFrame.new(0, LH - 0.6, d), V(10, 0.3, 1.2), RGB(230, 245, 255), M.Neon)
		Parts.light(lamp, 26, 1, RGB(220, 235, 255), (d // 10) % 2 == 0)
	end
	local rng = Random.new(ex.I * 31 + ex.J)
	for k = 0, 4 do
		for _, sx in ipairs({ -1, 1 }) do
			local d = L0 - 8 - k * 11
			local dcf = b * CFrame.new(sx * 17, 0.6, d) * CFrame.Angles(0, sx * math.pi / 2, 0)
			Parts.box(m, "Desk", dcf * CFrame.new(0, 2.6, 0), V(8, 0.3, 3.4), RGB(70, 72, 78), M.Metal)
			Parts.box(m, "DeskLeg", dcf * CFrame.new(0, 1.25, 0), V(7.6, 2.5, 0.3), RGB(60, 62, 66), M.Metal)
			Parts.box(m, "Monitor", dcf * CFrame.new(-1.5, 4, 1) * CFrame.Angles(0, math.pi, 0), V(2.6, 1.7, 0.2), rng:NextNumber() < 0.5 and RGB(60, 200, 120) or RGB(70, 140, 230), M.Neon, NOCOLLIDE)
			Parts.box(m, "Paper", dcf * CFrame.new(rng:NextNumber(-2, 2), 2.8, rng:NextNumber(-1, 1)) * CFrame.Angles(0, rng:NextNumber(0, 3), 0), V(1, 0.05, 1.3), RGB(240, 240, 235), M.SmoothPlastic, NOCOLLIDE)
			Parts.box(m, "Chair", dcf * CFrame.new(0, 1.2, -2.6) * CFrame.Angles(0, rng:NextNumber(-0.6, 0.6), rng:NextNumber() < 0.2 and 1.4 or 0), V(1.8, 2.4, 1.8), RGB(40, 40, 46), M.Fabric)
		end
	end
	Parts.box(m, "TankBase", b * CFrame.new(0, 1.2, mid), V(7, 1.2, 7), RGB(60, 62, 66), M.Metal, { Shape = Enum.PartType.Cylinder, Orientation = V(0, 0, 90) })
	Parts.box(m, "TankGlass", b * CFrame.new(0, 5.4, mid), V(7, 6, 6), RGB(150, 220, 200), M.Glass, { Transparency = 0.6, CanCollide = false })
	for _ = 1, 10 do
		Parts.box(m, "Shard", b * CFrame.new(rng:NextNumber(-8, 8), 0.65, mid + rng:NextNumber(-8, 8)) * CFrame.Angles(0, rng:NextNumber(0, 3), 0), V(0.8, 0.05, 0.5), RGB(170, 230, 210), M.Glass, NOCOLLIDE)
	end
	refs.labStart = b * CFrame.new(0, 5.3, face - 4)
	refs.labEnd = b * CFrame.new(0, 5.3, L1 + 4)

	-- 5. снаружи: вертолётная площадка в лесу
	local pad = b * CFrame.new(0, 0, L1 - 70)
	Parts.box(m, "Helipad", pad * CFrame.new(0, 0.2, 0) * CFrame.Angles(0, 0, math.pi / 2), V(0.4, 56, 56), RGB(80, 80, 82), M.Concrete, { Shape = Enum.PartType.Cylinder })
	Parts.box(m, "PadH", pad * CFrame.new(-6, 0.45, 0), V(2, 0.1, 16), RGB(240, 240, 240), M.SmoothPlastic, NOCOLLIDE)
	Parts.box(m, "PadH", pad * CFrame.new(6, 0.45, 0), V(2, 0.1, 16), RGB(240, 240, 240), M.SmoothPlastic, NOCOLLIDE)
	Parts.box(m, "PadH", pad * CFrame.new(0, 0.45, 0), V(10, 0.1, 2), RGB(240, 240, 240), M.SmoothPlastic, NOCOLLIDE)
	Parts.box(m, "Path", b * CFrame.new(0, 0.1, L1 - 35), V(8, 0.2, 70), RGB(120, 100, 70), M.Ground, NOCOLLIDE)
	refs.helipad = pad
	-- зона выхода: здесь нет Скрежетников, и лес не растёт
	refs.zone = { cf = b * CFrame.new(0, 0, (L1 - 100) / 2), size = V(W + 50, 300, -(L1 - 100) + 10) }
	m.Parent = parent
	return refs
end

return World
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="17">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="18">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="19">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">BuildMode</string>
            <string name="Source"><![CDATA[-- Строительство на клиенте:
--  * чертёж: прозрачный предпросмотр детали по сетке, R — круговое меню выбора детали, ЛКМ — поставить;
--  * молоток: R — круговое меню улучшения (дерево / камень / металл / снести), ЛКМ — следующий уровень;
--  * верстак, кровать, сундук: предпросмотр самой модели, зелёный — можно, красный — нельзя,
--    R — повернуть, ЛКМ — поставить.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Building = require(Shared:WaitForChild("Building"))
local Items = require(Shared:WaitForChild("Items"))
local Deployables = require(Shared:WaitForChild("Deployables"))

local player = Players.LocalPlayer
local V = Vector3.new
local RGB = Color3.fromRGB

local BuildMode = {}

local index = 1
local ghost, ghostKey
local current -- {id, a} для чертежа, {tool, cf} для предмета
local hint
local rot = 0
local aimedPiece

local GOOD, BAD = RGB(90, 220, 120), RGB(255, 80, 70)

local function costText(cost)
	local parts = {}
	for k, n in pairs(cost) do
		local have = player:GetAttribute("Res_" .. k) or 0
		table.insert(parts, (Items.Resources[k] and Items.Resources[k].Name or k) .. " " .. have .. "/" .. n)
	end
	return table.concat(parts, ", ")
end

local function enough(cost)
	for k, n in pairs(cost) do
		if (player:GetAttribute("Res_" .. k) or 0) < n then
			return false
		end
	end
	return true
end

local function clearGhost()
	if ghost then
		ghost:Destroy()
		ghost, ghostKey = nil, nil
	end
end

local function styleGhost(m)
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.CastShadow = false
			d.Material = Enum.Material.ForceField
			d.Transparency = 0.15
		end
	end
	m.Parent = workspace.CurrentCamera
end

local function pieceGhost(id)
	if ghostKey == "piece:" .. id then
		return
	end
	clearGhost()
	local def = Building.ById[id]
	local m = Instance.new("Model")
	local p = Instance.new(id == "stairs" and "WedgePart" or "Part")
	p.Size = def.Size
	p.Parent = m
	m.PrimaryPart = p
	styleGhost(m)
	ghost, ghostKey = m, "piece:" .. id
end

local function deployGhost(dep)
	if ghostKey == "deploy:" .. dep then
		return
	end
	clearGhost()
	local m = Deployables.build(dep, CFrame.new())
	styleGhost(m)
	ghost, ghostKey = m, "deploy:" .. dep
end

local function setGhostColor(c, visible)
	if not ghost then
		return
	end
	for _, d in ipairs(ghost:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Color = c
			d.Transparency = visible and 0.15 or 1
		end
	end
end

function BuildMode.init(gui, make)
	hint = make("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -96),
		Size = UDim2.new(0, 600, 0, 46),
		BackgroundColor3 = RGB(15, 18, 24),
		BackgroundTransparency = 0.35,
		Font = Enum.Font.GothamBold,
		TextSize = 15,
		TextColor3 = RGB(230, 236, 245),
		TextWrapped = true,
		Visible = false,
		Text = "",
	}, gui)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 8)
	c.Parent = hint
end

local function pieces()
	return CollectionService:GetTagged("BuildPiece")
end

-- круговое меню: какую деталь строить
function BuildMode.pieceMenu(Radial)
	local opts = {}
	for _, p in ipairs(Building.Pieces) do
		table.insert(opts, { label = p.Name, sub = costText(p.Cost), color = enough(p.Cost) and RGB(48, 70, 52) or RGB(70, 40, 40) })
	end
	Radial.open(opts, function(k)
		index = k
	end)
end

-- круговое меню молотка: до какого уровня улучшить
function BuildMode.hammerMenu(Radial, remote)
	local piece = aimedPiece
	if not piece then
		return false
	end
	local cur = piece:GetAttribute("Tier") or 0
	local opts = {}
	for t = 1, 3 do
		local d = Building.Tiers[t]
		local ok = t > cur and enough(d.Cost)
		table.insert(opts, {
			label = d.Name,
			sub = t <= cur and "уже есть" or costText(d.Cost),
			color = ok and RGB(48, 70, 52) or RGB(60, 50, 50),
			tier = t,
		})
	end
	table.insert(opts, { label = "Снести", sub = "вернётся половина досок", color = RGB(90, 40, 30), tier = "remove" })
	Radial.open(opts, function(_, o)
		remote:FireServer(piece, o.tier)
	end)
	return true
end

function BuildMode.rotate()
	rot = (rot + 1) % 4
end

-- вызывать каждый кадр. mode: "blueprint" / "hammer" / "deploy" / nil
function BuildMode.update(mode, rayParams, toolId)
	current = nil
	aimedPiece = nil
	if mode ~= "blueprint" and mode ~= "deploy" then
		clearGhost()
	end
	if not hint then
		return
	end
	local cam = workspace.CurrentCamera
	local O = player:GetAttribute("SessionO")
	if not mode or not O then
		hint.Visible = false
		clearGhost()
		return
	end
	hint.Visible = true
	local r = workspace:Raycast(cam.CFrame.Position, cam.CFrame.LookVector * 22, rayParams)

	if mode == "hammer" then
		local piece = r and Building.pieceOf(r.Instance)
		aimedPiece = piece
		if piece then
			local tier = piece:GetAttribute("Tier") or 0
			local nextT = Building.Tiers[tier + 1]
			hint.Text = piece.Name .. " · " .. Building.Tiers[tier].Name .. (nextT and ("  ·  ЛКМ: → " .. nextT.Name .. " (" .. costText(nextT.Cost) .. ")") or "  (максимум)") .. "\nR — круговое меню: выбрать уровень или снести"
		else
			hint.Text = "Молоток: наведи на постройку. ЛКМ — следующий уровень, R — меню улучшения"
		end
		return
	end

	if mode == "deploy" then
		local def = Items.Tools[toolId]
		local dep = def and def.Deploy
		if not dep then
			return
		end
		deployGhost(dep)
		hint.Text = "Поставить: " .. Deployables.Names[dep] .. "  ·  R — повернуть  ·  ЛКМ — поставить"
		if not r or r.Normal.Y < 0.7 then
			setGhostColor(BAD, false)
			return
		end
		local look = cam.CFrame.LookVector * V(1, 0, 1)
		local yaw = math.atan2(look.X, look.Z) + rot * math.pi / 2
		local cf = CFrame.new(r.Position) * CFrame.Angles(0, yaw, 0)
		ghost:PivotTo(cf)
		-- влезает ли
		local size = Deployables.Size[dep]
		local op = OverlapParams.new()
		op.FilterType = Enum.RaycastFilterType.Exclude
		op.FilterDescendantsInstances = { ghost, player.Character }
		op.RespectCanCollide = true
		local free = #workspace:GetPartBoundsInBox(cf * CFrame.new(0, size.Y / 2 + 0.3, 0), size - V(0.3, 0.3, 0.3), op) == 0
		local near = (r.Position - cam.CFrame.Position).Magnitude < 20
		setGhostColor((free and near) and GOOD or BAD, true)
		if free and near then
			current = { tool = toolId, cf = cf }
		end
		return
	end

	-- чертёж
	local def = Building.Pieces[index]
	pieceGhost(def.Id)
	local a = r and Building.snap(def.Id, O, r.Position, r.Instance, cam.CFrame.LookVector, pieces())
	hint.Text = def.Name .. "  ·  " .. costText(def.Cost) .. "\nR — выбрать деталь (круговое меню)  ·  ЛКМ — поставить" .. (def.Id == "foundation" and "" or def.Id == "door" and "  ·  наведи на проём" or "  ·  ставится на фундамент / стену")
	if not a then
		setGhostColor(BAD, false)
		return
	end
	ghost:PivotTo(Building.cframe(def.Id, O, a))
	local key = Building.key(def.Id, a)
	local free = true
	for _, p in ipairs(pieces()) do
		if p:GetAttribute("Key") == key then
			free = false
		end
	end
	setGhostColor((free and enough(def.Cost)) and GOOD or BAD, true)
	if free then
		current = { id = def.Id, a = a }
	end
end

-- ЛКМ с чертежом или предметом
function BuildMode.place(buildRemote, placeRemote)
	if current and current.id then
		buildRemote:FireServer(current.id, current.a)
		return true
	elseif current and current.tool then
		placeRemote:FireServer(current.tool, current.cf)
		return true
	end
	return false
end

return BuildMode
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="21">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Клиент «ЛАБИРИНТ»: интерфейс, прицел, руки, удары, тряска камеры, верстак, лифт, победа.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")
local SoundService = game:GetService("SoundService")
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local StarterGui = game:GetService("StarterGui")

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Items = require(Shared:WaitForChild("Items"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Viewmodel = require(script.Parent:WaitForChild("Viewmodel"))
local MonsterView = require(script.Parent:WaitForChild("MonsterView"))
local BuildMode = require(script.Parent:WaitForChild("BuildMode"))
local Radial = require(script.Parent:WaitForChild("Radial"))
local PathfindingService = game:GetService("PathfindingService")
MonsterView.start()

local function remote(n)
	return Remotes:WaitForChild(n)
end

local V = Vector3.new
local RGB = Color3.fromRGB
local UI_FONT = Enum.Font.GothamBold
local TEXT_FONT = Enum.Font.Gotham

------------------------------------------------------------------
-- Помощники
------------------------------------------------------------------
local function make(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do
		o[k] = v
	end
	o.Parent = parent
	return o
end
local function corner(o, r)
	make("UICorner", { CornerRadius = UDim.new(0, r or 8) }, o)
end
local function sound(id, vol, speed)
	if not id or id == "" then
		return
	end
	local s = make("Sound", { SoundId = id, Volume = vol or 1, PlaybackSpeed = speed or 1 }, SoundService)
	s:Play()
	task.delay(4, function()
		s:Destroy()
	end)
end

local gui = make("ScreenGui", { Name = "LabyrinthUI", ResetOnSpawn = false, IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, player:WaitForChild("PlayerGui"))

local function inMatch()
	return player:GetAttribute("InMatch") == true
end
local cutscene = false

------------------------------------------------------------------
-- Тряска камеры
------------------------------------------------------------------
local trauma = 0
local function shake(amount)
	trauma = math.min(1, trauma + amount)
end
local appliedShake = CFrame.new()
-- перед обновлением камеры убираем тряску прошлого кадра, иначе мышь «уплывает» и дёргается
RunService:BindToRenderStep("LabyrinthUnshake", Enum.RenderPriority.Camera.Value - 1, function()
	local cam = workspace.CurrentCamera
	if appliedShake ~= CFrame.new() and cam.CameraType ~= Enum.CameraType.Scriptable then
		cam.CFrame = cam.CFrame * appliedShake:Inverse()
	end
	appliedShake = CFrame.new()
end)
RunService:BindToRenderStep("LabyrinthShake", Enum.RenderPriority.Camera.Value + 1, function(dt)
	if trauma > 0 then
		local t = os.clock() * 30
		local s = trauma * trauma
		local cam = workspace.CurrentCamera
		local sh = CFrame.Angles(math.noise(t, 1) * 0.05 * s, math.noise(t, 2) * 0.05 * s, math.noise(t, 3) * 0.03 * s)
		cam.CFrame = cam.CFrame * sh
		if cam.CameraType ~= Enum.CameraType.Scriptable then
			appliedShake = sh
		end
		trauma = math.max(0, trauma - dt * 2)
	end
end)

------------------------------------------------------------------
-- Прицел: кольцо с четырьмя «усиками», разъезжаются при ударе,
-- красный на монстре, золотой на ресурсе
------------------------------------------------------------------
local cross = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 60, 0, 60), BackgroundTransparency = 1 }, gui)
local ring = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 14, 0, 14), BackgroundTransparency = 1 }, cross)
make("UICorner", { CornerRadius = UDim.new(1, 0) }, ring)
local ringStroke = make("UIStroke", { Thickness = 1.6, Color = RGB(240, 240, 240), Transparency = 0.15 }, ring)
local ticks = {}
for k, d in ipairs({ { 0, -1 }, { 0, 1 }, { -1, 0 }, { 1, 0 } }) do
	local vert = d[1] == 0
	local t = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = vert and UDim2.new(0, 2, 0, 7) or UDim2.new(0, 7, 0, 2),
		BackgroundColor3 = RGB(240, 240, 240),
		BorderSizePixel = 0,
	}, cross)
	ticks[k] = { frame = t, dir = d }
end
local hitX = {}
for _, rot in ipairs({ 45, -45 }) do
	table.insert(hitX, make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0, 22, 0, 2),
		Rotation = rot,
		BackgroundColor3 = RGB(255, 255, 255),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	}, cross))
end
local targetLabel = make("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0.5, 26),
	Size = UDim2.new(0, 360, 0, 22),
	BackgroundTransparency = 1,
	Font = UI_FONT,
	TextSize = 14,
	TextColor3 = RGB(240, 235, 220),
	TextStrokeTransparency = 0.4,
	Text = "",
}, gui)
local targetHP = make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.5, 48), Size = UDim2.new(0, 120, 0, 5), BackgroundColor3 = RGB(40, 10, 10), BorderSizePixel = 0, Visible = false }, gui)
local targetHPFill = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = RGB(220, 50, 40), BorderSizePixel = 0 }, targetHP)
local spread = 0

local lastSwingAnim = 0
local function hitMarker(kind)
	local c = kind == "kill" and RGB(255, 60, 60) or (kind == "monster" and RGB(255, 200, 200) or RGB(255, 220, 120))
	for _, f in ipairs(hitX) do
		f.BackgroundColor3 = c
		f.BackgroundTransparency = 0
		TweenService:Create(f, TweenInfo.new(0.35), { BackgroundTransparency = 1 }):Play()
	end
	sound(Config.Sounds.Hit, 0.5, kind == "node" and 1.6 or 0.9)
	shake(kind == "kill" and 0.5 or 0.18)
end

------------------------------------------------------------------
-- Интерфейс: фаза дня, здоровье, выносливость, ресурсы, хотбар
------------------------------------------------------------------
local phaseLabel = make("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 14),
	Size = UDim2.new(0, 520, 0, 34),
	BackgroundColor3 = RGB(12, 14, 12),
	BackgroundTransparency = 0.35,
	Font = UI_FONT,
	TextSize = 18,
	TextColor3 = RGB(240, 230, 200),
	Text = "",
}, gui)
corner(phaseLabel, 10)

local hpBack = make("Frame", { Position = UDim2.new(0, 20, 1, -46), Size = UDim2.new(0, 260, 0, 14), BackgroundColor3 = RGB(30, 12, 12), BorderSizePixel = 0 }, gui)
corner(hpBack, 6)
local hpFill = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = RGB(200, 50, 45), BorderSizePixel = 0 }, hpBack)
corner(hpFill, 6)
local hpText = make("TextLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Font = UI_FONT, TextSize = 11, TextColor3 = RGB(255, 255, 255), Text = "" }, hpBack)
local armorText = make("TextLabel", { Position = UDim2.new(0, 288, 1, -50), Size = UDim2.new(0, 160, 0, 22), BackgroundTransparency = 1, Font = UI_FONT, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = RGB(190, 210, 240), TextStrokeTransparency = 0.5, Text = "" }, gui)
local stBack = make("Frame", { Position = UDim2.new(0, 20, 1, -26), Size = UDim2.new(0, 260, 0, 6), BackgroundColor3 = RGB(30, 30, 20), BorderSizePixel = 0 }, gui)
corner(stBack, 3)
local stFill = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = RGB(220, 200, 120), BorderSizePixel = 0 }, stBack)
corner(stFill, 3)

local resPanel = make("Frame", { Position = UDim2.new(0, 20, 0, 70), Size = UDim2.new(0, 230, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = RGB(12, 14, 12), BackgroundTransparency = 0.4 }, gui)
corner(resPanel, 10)
make("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8), PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }, resPanel)
make("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, resPanel)

local function refreshRes()
	for _, c in ipairs(resPanel:GetChildren()) do
		if c:IsA("TextLabel") then
			c:Destroy()
		end
	end
	for k, def in pairs(Items.Resources) do
		local n = player:GetAttribute("Res_" .. k) or 0
		if n > 0 then
			make("TextLabel", {
				Size = UDim2.new(1, 0, 0, 20),
				BackgroundTransparency = 1,
				Font = TEXT_FONT,
				TextSize = 15,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextColor3 = k == "key" and RGB(255, 210, 90) or RGB(235, 230, 215),
				Text = def.Name .. ":  " .. n,
				LayoutOrder = def.Order,
			}, resPanel)
		end
	end
	resPanel.Visible = #resPanel:GetChildren() > 2
end

local hotbar = make("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -18), Size = UDim2.new(0, 0, 0, 76), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1 }, gui)
make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, hotbar)
local tools = {}
local equipped = nil
BuildMode.init(gui, make)
Radial.init(gui)
local toggleMap, updateMap, updatePings
local lobbyBar, updateMusic, settingsPanel, adminPanel
local spectating, spectateIndex = nil, 0
local openGive
local musicOn = true

local function equip(id)
	if id == equipped then
		id = nil
	end
	equipped = id
	remote("Equip"):FireServer(id)
	Viewmodel.setItem(id or "fists")
	sound(Config.Sounds.Click, 0.4, 1.4)
end

-- в хотбаре: инструменты + то, что есть в инвентаре и можно держать (ключ-карта, карта, бинт, ягоды)
local HELD = { "res_key", "res_map", "res_bandage", "res_berry" }
local function hotbarList()
	local list = table.clone(tools)
	for _, id in ipairs(HELD) do
		local def = Items.Tools[id]
		if (player:GetAttribute("Res_" .. def.Res) or 0) > 0 then
			table.insert(list, id)
		end
	end
	return list
end

-- маленькая 3D-картинка предмета (топор, факел, верстак...) для ячейки
local ItemModels = require(Shared:WaitForChild("ItemModels"))
local DeployModels = require(Shared:WaitForChild("Deployables"))
local function itemIcon(id, parent)
	local vp = make("ViewportFrame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 2), Size = UDim2.fromOffset(46, 46), BackgroundTransparency = 1, Ambient = RGB(200, 200, 200), LightColor = RGB(255, 255, 255), LightDirection = Vector3.new(-1, -1, -1) }, parent)
	local def = Items.Tools[id]
	local ok, model = pcall(function()
		if def and def.Kind == "deploy" then
			return DeployModels.build(def.Deploy, CFrame.new())
		end
		return ItemModels.build(id)
	end)
	if not ok or not model then
		return vp
	end
	if not def or def.Kind == "fists" then
		model:Destroy()
		make("TextLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Font = Enum.Font.GothamBlack, TextSize = 28, Text = "✊", TextColor3 = RGB(255, 255, 255) }, vp)
		return vp
	end
	model.Parent = vp
	local cf, size = model:GetBoundingBox()
	local cam = Instance.new("Camera")
	cam.FieldOfView = 40
	local dist = math.max(size.X, size.Y, size.Z) * 1.6 + 0.5
	-- предмет повёрнут наискосок, чтобы было понятно, что это
	cam.CFrame = CFrame.lookAt(cf.Position + Vector3.new(dist * 0.55, dist * 0.35, dist * 0.75), cf.Position)
	cam.Parent = vp
	vp.CurrentCamera = cam
	return vp
end

local function refreshHotbar()
	for _, c in ipairs(hotbar:GetChildren()) do
		if c:IsA("TextButton") then
			c:Destroy()
		end
	end
	for i, id in ipairs(hotbarList()) do
		local b = make("TextButton", {
			Size = UDim2.new(0, 96, 0, 76),
			BackgroundColor3 = id == equipped and RGB(70, 90, 50) or RGB(18, 20, 18),
			BackgroundTransparency = 0.25,
			Font = UI_FONT,
			TextSize = 11,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Bottom,
			TextColor3 = RGB(235, 230, 215),
			Text = Items.toolName(id),
			LayoutOrder = i,
		}, hotbar)
		corner(b, 8)
		make("UIPadding", { PaddingBottom = UDim.new(0, 3), PaddingLeft = UDim.new(0, 3), PaddingRight = UDim.new(0, 3) }, b)
		itemIcon(id, b)
		make("TextLabel", { Position = UDim2.fromOffset(2, 0), Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 1, Font = Enum.Font.GothamBlack, TextSize = 13, TextColor3 = RGB(255, 230, 150), Text = tostring(i) }, b)
		if id == equipped then
			make("UIStroke", { Color = RGB(200, 230, 140), Thickness = 2 }, b)
		end
		b.MouseButton1Click:Connect(function()
			equip(id)
			refreshHotbar()
		end)
	end
end

player.AttributeChanged:Connect(function(name)
	if name:sub(1, 4) == "Res_" then
		refreshRes()
		local k = name:sub(5)
		if k == "key" or k == "map" or k == "bandage" or k == "berry" then
			refreshHotbar()
		end
	elseif name == "Tools" then
		local ok, list = pcall(function()
			return HttpService:JSONDecode(player:GetAttribute("Tools") or "[]")
		end)
		tools = ok and list or {}
		refreshHotbar()
	elseif name == "Equipped" then
		local e = player:GetAttribute("Equipped")
		if e ~= equipped then
			equipped = e
			Viewmodel.setItem(e or "fists")
		end
		refreshHotbar()
	elseif name == "InMatch" then
		if not inMatch() then
			equipped = nil
			Viewmodel.setItem("fists", true)
		end
	end
end)
refreshRes()

-- уведомления
local notifyLabel = make("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.72),
	Size = UDim2.new(0.8, 0, 0, 50),
	BackgroundTransparency = 1,
	Font = UI_FONT,
	TextSize = 20,
	TextWrapped = true,
	TextColor3 = RGB(245, 240, 225),
	TextStrokeTransparency = 0.3,
	TextTransparency = 1,
	Text = "",
}, gui)
local notifyToken = 0
local function notify(text)
	notifyToken += 1
	local tk = notifyToken
	notifyLabel.Text = text
	notifyLabel.TextTransparency = 0
	notifyLabel.TextStrokeTransparency = 0.3
	task.delay(4, function()
		if tk == notifyToken then
			TweenService:Create(notifyLabel, TweenInfo.new(0.8), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		end
	end)
end
remote("Notify").OnClientEvent:Connect(notify)

-- лобби
local lobbyLabel = make("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.3),
	Size = UDim2.new(0.8, 0, 0, 80),
	BackgroundTransparency = 1,
	Font = Enum.Font.GothamBlack,
	TextSize = 32,
	TextColor3 = RGB(240, 230, 200),
	TextStrokeTransparency = 0.4,
	Text = "",
}, gui)
local titleLabel = make("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 60),
	Size = UDim2.new(0.8, 0, 0, 70),
	BackgroundTransparency = 1,
	Font = Enum.Font.GothamBlack,
	TextScaled = true,
	TextColor3 = RGB(200, 230, 150),
	TextStrokeTransparency = 0.5,
	Text = Config.GameTitle,
}, gui)

-- красная вспышка при ударе по тебе
local hurtFlash = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = RGB(160, 0, 0), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 5 }, gui)
remote("Hurt").OnClientEvent:Connect(function()
	hurtFlash.BackgroundTransparency = 0.45
	TweenService:Create(hurtFlash, TweenInfo.new(0.6), { BackgroundTransparency = 1 }):Play()
	shake(0.7)
	sound(Config.Sounds.Hurt, 0.7, 1.1)
end)
remote("HitMarker").OnClientEvent:Connect(function(kind, toolKind)
	-- добыча на E: руки сами делают удар нужным инструментом
	if toolKind and os.clock() - lastSwingAnim > 0.3 then
		lastSwingAnim = os.clock()
		Viewmodel.swing(toolKind)
		sound(Config.Sounds.Swing, 0.5, 1)
	end
	hitMarker(kind)
end)

------------------------------------------------------------------
-- Верстак
------------------------------------------------------------------
local craft = make("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.new(0, 520, 0, 470),
	BackgroundColor3 = RGB(28, 24, 20),
	Visible = false,
	ZIndex = 10,
}, gui)
corner(craft, 12)
local craftTitle = make("TextLabel", { Position = UDim2.new(0, 16, 0, 10), Size = UDim2.new(1, -32, 0, 34), BackgroundTransparency = 1, Font = Enum.Font.GothamBlack, TextSize = 22, TextColor3 = RGB(240, 220, 170), TextXAlignment = Enum.TextXAlignment.Left, Text = "ВЕРСТАК", ZIndex = 10 }, craft)
local list = make("ScrollingFrame", { Position = UDim2.new(0, 12, 0, 50), Size = UDim2.new(1, -24, 1, -110), BackgroundTransparency = 1, ScrollBarThickness = 6, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 10 }, craft)
make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, list)
local craftClose = make("TextButton", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -12), Size = UDim2.new(0, 160, 0, 40), BackgroundColor3 = RGB(90, 40, 30), Font = UI_FONT, TextSize = 18, TextColor3 = RGB(255, 240, 230), Text = "Закрыть", Modal = true, ZIndex = 10 }, craft)
corner(craftClose, 8)
craftClose.MouseButton1Click:Connect(function()
	craft.Visible = false
end)

local function costText(cost)
	local parts = {}
	for k, n in pairs(cost) do
		local have = player:GetAttribute("Res_" .. k) or 0
		table.insert(parts, (have >= n and "" or "✗ ") .. Items.Resources[k].Name .. " " .. have .. "/" .. n)
	end
	return table.concat(parts, "   ")
end

local benchLevel = nil -- nil — крафт из инвентаря (C), число — открыт верстак этого уровня
local function renderCraft()
	craftTitle.Text = benchLevel and ("ВЕРСТАК · уровень " .. benchLevel) or "КРАФТ (C) · подойди к верстаку для оружия"
	for _, c in ipairs(list:GetChildren()) do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	for i, r in ipairs(Items.Recipes) do
		local lockText
		if r.Station == "bench" then
			if not benchLevel then
				lockText = "нужен верстак"
			elseif r.Level > benchLevel then
				lockText = "нужен ур. " .. r.Level
			end
		end
		local locked = lockText ~= nil
		local row = make("Frame", { Size = UDim2.new(1, -8, 0, 58), BackgroundColor3 = locked and RGB(30, 28, 26) or RGB(45, 40, 32), LayoutOrder = i, ZIndex = 10 }, list)
		corner(row, 8)
		make("TextLabel", {
			Position = UDim2.new(0, 10, 0, 4),
			Size = UDim2.new(1, -140, 0, 24),
			BackgroundTransparency = 1,
			Font = UI_FONT,
			TextSize = 16,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = locked and RGB(130, 120, 110) or RGB(245, 235, 210),
			Text = (r.Name or Items.toolName(r.Id)) .. (locked and ("  · " .. lockText) or ""),
			ZIndex = 10,
		}, row)
		make("TextLabel", {
			Position = UDim2.new(0, 10, 0, 28),
			Size = UDim2.new(1, -140, 0, 24),
			BackgroundTransparency = 1,
			Font = TEXT_FONT,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = RGB(190, 180, 160),
			Text = costText(r.Cost),
			ZIndex = 10,
		}, row)
		local b = make("TextButton", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.new(0, 110, 0, 38),
			BackgroundColor3 = locked and RGB(50, 50, 50) or RGB(60, 110, 50),
			Font = UI_FONT,
			TextSize = 15,
			TextColor3 = RGB(245, 245, 240),
			Text = locked and "Закрыто" or "Создать",
			AutoButtonColor = not locked,
			ZIndex = 10,
		}, row)
		corner(b, 6)
		b.MouseButton1Click:Connect(function()
			if not locked then
				remote("Craft"):FireServer(r.Id)
				sound(Config.Sounds.Click, 0.6, 1)
				if r.Id == "workbench" then
					craft.Visible = false
				else
					task.delay(0.3, renderCraft)
				end
			end
		end)
	end
end
remote("OpenCraft").OnClientEvent:Connect(function(level)
	benchLevel = level
	renderCraft()
	craft.Visible = true
end)
local function openHandCraft()
	if craft.Visible then
		craft.Visible = false
		return
	end
	benchLevel = nil
	renderCraft()
	craft.Visible = true
end

------------------------------------------------------------------
-- Ввод: удар, предметы 1–9, еда, бег
------------------------------------------------------------------
local lastSwing = 0
local function rayParams()
	local p = RaycastParams.new()
	p.FilterType = Enum.RaycastFilterType.Exclude
	p.FilterDescendantsInstances = { player.Character, workspace.CurrentCamera }
	return p
end

local function aimRay(range)
	local cam = workspace.CurrentCamera
	return workspace:Raycast(cam.CFrame.Position, cam.CFrame.LookVector * (range + 4), rayParams())
end

------------------------------------------------------------------
-- Карта лабиринта (Tab): её нужно найти. Меняется вместе со стенами.
------------------------------------------------------------------
local mapPanel = make("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(600, 600),
	BackgroundColor3 = RGB(214, 196, 150),
	Visible = false,
	ZIndex = 25,
}, gui)
corner(mapPanel, 14)
make("UIStroke", { Color = RGB(90, 70, 40), Thickness = 4 }, mapPanel)
make("TextLabel", { Position = UDim2.fromOffset(0, 6), Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, Font = Enum.Font.GothamBlack, TextSize = 18, TextColor3 = RGB(70, 50, 30), Text = "КАРТА ЛАБИРИНТА  ·  Tab — закрыть", ZIndex = 26 }, mapPanel)
local mapCanvas = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 12), Size = UDim2.fromOffset(550, 550), BackgroundTransparency = 1, ZIndex = 26 }, mapPanel)
local mapMe = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(12, 12), BackgroundColor3 = RGB(220, 30, 30), ZIndex = 29 }, mapCanvas)
corner(mapMe, 6)
local mapData
local function mapScale()
	return mapData and (550 / (mapData.radius * 2 + 80)) or 0.3
end
local function toMap(rel)
	local sc = mapScale()
	return UDim2.fromOffset(275 + rel.X * sc, 275 + rel.Z * sc)
end
local function drawMap()
	for _, c in ipairs(mapCanvas:GetChildren()) do
		if c ~= mapMe then
			c:Destroy()
		end
	end
	if not mapData then
		return
	end
	local sc = mapScale()
	local circle = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(275, 275), Size = UDim2.fromOffset(mapData.radius * 2 * sc, mapData.radius * 2 * sc), BackgroundTransparency = 1, ZIndex = 26 }, mapCanvas)
	corner(circle, 1000)
	make("UIStroke", { Color = RGB(120, 95, 60), Thickness = 2, Transparency = 0.5 }, circle)
	local ch = mapData.clearing
	local clr = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(275, 275), Size = UDim2.fromOffset(ch * 2 * sc, ch * 2 * sc), BackgroundColor3 = RGB(120, 160, 90), BackgroundTransparency = 0.3, ZIndex = 26 }, mapCanvas)
	make("TextLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = RGB(40, 60, 30), Text = "ПОЛЯНА", ZIndex = 27 }, clr)
	for _, w in ipairs(mapData.walls) do
		local axis, fixedC, a, b, crack = w[1], w[2], w[3], w[4], w[5]
		local len = (b - a) * sc
		local thick = math.max(2, 4 * sc)
		local f
		if axis == 1 then
			f = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = toMap(V((a + b) / 2, 0, fixedC)), Size = UDim2.fromOffset(len, thick), BorderSizePixel = 0, ZIndex = 27 }, mapCanvas)
		else
			f = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = toMap(V(fixedC, 0, (a + b) / 2)), Size = UDim2.fromOffset(thick, len), BorderSizePixel = 0, ZIndex = 27 }, mapCanvas)
		end
		f.BackgroundColor3 = crack == 1 and RGB(160, 120, 70) or RGB(60, 45, 30)
	end
	local exitM = make("TextLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = toMap(mapData.exit), Size = UDim2.fromOffset(70, 18), BackgroundColor3 = RGB(40, 140, 70), Font = Enum.Font.GothamBlack, TextSize = 12, TextColor3 = RGB(255, 255, 255), Text = "ВЫХОД", ZIndex = 28 }, mapCanvas)
	corner(exitM, 4)
end
remote("MapData").OnClientEvent:Connect(function(walls, O, clearing, radius, exitRel)
	mapData = { walls = walls, O = O, clearing = clearing, radius = radius, exit = exitRel }
	if mapPanel.Visible then
		drawMap()
	else
		mapData.dirty = true
	end
end)
function toggleMap()
	if mapPanel.Visible then
		mapPanel.Visible = false
		return
	end
	if (player:GetAttribute("Res_map") or 0) < 1 or not mapData then
		notify("У тебя нет карты. Она лежит на столе где-то в лабиринте.")
		return
	end
	mapData.dirty = false
	drawMap()
	mapPanel.Visible = true
end
function updateMap()
	if not mapPanel.Visible then
		return
	end
	if not inMatch() then
		mapPanel.Visible = false
		return
	end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp and mapData then
		mapMe.Position = toMap(hrp.Position - mapData.O)
		mapMe.Visible = true
	end
end

------------------------------------------------------------------
-- Сигнал раненого: подсветка сквозь стены и стрелки на полу к нему
------------------------------------------------------------------
local pingFx = {} -- [player] = {hl, arrows, nextPath}
local function clearPing(who)
	local fx = pingFx[who]
	if fx then
		if fx.hl then
			fx.hl:Destroy()
		end
		for _, a in ipairs(fx.arrows) do
			a:Destroy()
		end
		pingFx[who] = nil
	end
end
local pathObj = PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = false, WaypointSpacing = 6 })
local function drawArrows(fx, points)
	for _, a in ipairs(fx.arrows) do
		a:Destroy()
	end
	fx.arrows = {}
	for k = 1, math.min(#points - 1, 16) do
		local a, b = points[k], points[k + 1]
		if (b - a).Magnitude > 0.5 then
			local arrow = Instance.new("WedgePart")
			arrow.Anchored = true
			arrow.CanCollide = false
			arrow.CanQuery = false
			arrow.CastShadow = false
			arrow.Size = V(2, 0.3, 2.4)
			arrow.Material = Enum.Material.Neon
			arrow.Color = RGB(255, 210, 60)
			local flat = V(b.X - a.X, 0, b.Z - a.Z)
			-- клин «смотрит» острым концом вперёд (-Z)
			arrow.CFrame = CFrame.lookAt(a + V(0, 0.3, 0), a + V(0, 0.3, 0) + flat)
			arrow.Parent = workspace.CurrentCamera
			table.insert(fx.arrows, arrow)
		end
	end
end
function updatePings()
	local now = workspace:GetServerTimeNow()
	local char = player.Character
	local myHrp = char and char:FindFirstChild("HumanoidRootPart")
	for _, who in ipairs(Players:GetPlayers()) do
		local active = who ~= player and inMatch() and (who:GetAttribute("PingUntil") or 0) > now and who:GetAttribute("Downed") == true and who.Character
		if not active then
			clearPing(who)
		else
			local fx = pingFx[who]
			if not fx then
				fx = { arrows = {}, nextPath = 0 }
				local hl = Instance.new("Highlight")
				hl.FillColor = RGB(255, 60, 60)
				hl.OutlineColor = RGB(255, 230, 120)
				hl.FillTransparency = 0.3
				hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				hl.Adornee = who.Character
				hl.Parent = workspace.CurrentCamera
				fx.hl = hl
				pingFx[who] = fx
			end
			local theirs = who.Character:FindFirstChild("HumanoidRootPart")
			if myHrp and theirs and os.clock() >= fx.nextPath and not fx.busy then
				fx.nextPath = os.clock() + 1.5
				fx.busy = true
				local from, to = myHrp.Position, theirs.Position
				task.spawn(function()
					local pts
					local ok = pcall(function()
						pathObj:ComputeAsync(from, to)
					end)
					if ok and pathObj.Status == Enum.PathStatus.Success then
						pts = {}
						for _, w in ipairs(pathObj:GetWaypoints()) do
							table.insert(pts, w.Position)
						end
					else
						pts = {}
						local dir = (to - from) * V(1, 0, 1)
						for k = 0, 8 do
							table.insert(pts, from - V(0, 2.8, 0) + dir.Unit * (4 + k * 5))
						end
					end
					fx.busy = false
					if pingFx[who] == fx then
						drawArrows(fx, pts)
					end
				end)
			end
		end
	end
end

-- раненое тело — тряпичная кукла (физику включаем на своём клиенте)
player:GetAttributeChangedSignal("Downed"):Connect(function()
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then
		return
	end
	if player:GetAttribute("Downed") then
		hum:ChangeState(Enum.HumanoidStateType.Physics)
	else
		hum:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
end)

-- мигающие лампы (туннель, лаборатория, костры)
task.spawn(function()
	while true do
		task.wait(0.09)
		for _, l in ipairs(CollectionService:GetTagged("FlickerLight")) do
			if l:IsA("Light") then
				local base = l:GetAttribute("B0")
				if not base then
					base = l.Brightness
					l:SetAttribute("B0", base)
				end
				local r = math.random()
				l.Brightness = r < 0.06 and base * 0.1 or base * (0.85 + math.random() * 0.25)
			end
		end
	end
end)

local function doSwing()
	if not inMatch() or cutscene or craft.Visible then
		return
	end
	if Radial.isOpen() then
		return
	end
	local def = Items.Tools[equipped or "fists"] or Items.Tools.fists
	if def.Kind == "blueprint" or def.Kind == "deploy" then
		if BuildMode.place(remote("Build"), remote("Place")) then
			sound(Config.Sounds.Click, 0.6, 0.8)
		end
		return
	end
	if def.Kind == "held" then
		if def.Res == "berry" then
			remote("Eat"):FireServer()
			Viewmodel.swing("fists")
		elseif def.Res == "map" then
			toggleMap()
		end
		return
	end
	if def.Kind == "torch" or player:GetAttribute("Downed") or player:GetAttribute("Hidden") or player:GetAttribute("Sleeping") or player:GetAttribute("Dragging") then
		return -- факелом не бьют: он только светит
	end
	if os.clock() - lastSwing < 0.42 then
		return
	end
	lastSwing = os.clock()
	Viewmodel.swing()
	spread = 1
	sound(Config.Sounds.Swing, 0.6, 0.9 + math.random() * 0.3)
	shake(0.08)
	task.delay(0.16, function()
		local r = aimRay(def.Range)
		if r then
			remote("Swing"):FireServer(r.Instance, r.Position)
		end
	end)
end

local sprintHeld = false
local flyingNow = false
local crouched = false
local function setCrouch(on)
	crouched = on
	remote("Crouch"):FireServer(on)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		TweenService:Create(hum, TweenInfo.new(0.25), { CameraOffset = on and Vector3.new(0, -2.4, 0) or Vector3.zero }):Play()
	end
end
UserInputService.InputBegan:Connect(function(input, processed)
	if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
		sprintHeld = true
	end
	if processed then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.KeyCode == Enum.KeyCode.ButtonR2 then
		doSwing()
	elseif input.KeyCode == Enum.KeyCode.R and inMatch() and not cutscene then
		local kind = equipped and Items.Tools[equipped] and Items.Tools[equipped].Kind
		if player:GetAttribute("Downed") then
			remote("Ping"):FireServer()
		elseif kind == "blueprint" then
			BuildMode.pieceMenu(Radial)
		elseif kind == "hammer" then
			BuildMode.hammerMenu(Radial, remote("Upgrade"))
		elseif kind == "deploy" then
			BuildMode.rotate()
			sound(Config.Sounds.Click, 0.4, 1.2)
		end
	elseif input.KeyCode == Enum.KeyCode.Tab and inMatch() and not cutscene then
		toggleMap()
	elseif input.KeyCode == Enum.KeyCode.H then
		remote("Eat"):FireServer()
	elseif input.KeyCode == Enum.KeyCode.C and inMatch() and not cutscene then
		openHandCraft()
	elseif (input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.RightControl) and inMatch() and not cutscene and not flyingNow then
		setCrouch(not crouched)
	elseif input.KeyCode == Enum.KeyCode.Q then
		equip(nil)
		refreshHotbar()
	else
		local n = input.KeyCode.Value - Enum.KeyCode.One.Value + 1
		local hb = hotbarList()
		if n >= 1 and n <= 9 and hb[n] then
			equip(hb[n])
			refreshHotbar()
		end
	end
end)
UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.R and Radial.isOpen() then
		Radial.confirm()
	end
	if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
		sprintHeld = false
	end
end)

------------------------------------------------------------------
-- Лифт: поездка с друзьями
------------------------------------------------------------------
local fade = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = RGB(0, 0, 0), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 20 }, gui)
local subtitle = make("TextLabel", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -90), Size = UDim2.new(0.8, 0, 0, 40), BackgroundTransparency = 1, Font = UI_FONT, TextSize = 24, TextColor3 = RGB(240, 235, 220), TextStrokeTransparency = 0.3, Text = "", ZIndex = 21 }, gui)

local function cloneAvatar(who)
	local char = who.Character
	if not char then
		return nil
	end
	local ok, c = pcall(function()
		char.Archivable = true
		return char:Clone()
	end)
	if not ok or not c then
		return nil
	end
	for _, d in ipairs(c:GetDescendants()) do
		if d:IsA("Script") or d:IsA("LocalScript") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.LocalTransparencyModifier = 0
		end
	end
	local hum = c:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
	return c
end

remote("PlayElevator").OnClientEvent:Connect(function(riders, duration, diffId)
	cutscene = true
	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Scriptable
	local O = V(6000, 200, 0)
	local m = Instance.new("Model")
	m.Name = "ElevatorRide"
	local function p(size, cf, color, mat, props)
		local pt = make("Part", { Anchored = true, CanCollide = false, CanQuery = false, Size = size, CFrame = cf, Color = color, Material = mat or Enum.Material.DiamondPlate }, m)
		if props then
			for k, v in pairs(props) do
				pt[k] = v
			end
		end
		return pt
	end
	local metal = RGB(64, 66, 70)
	p(V(16, 0.5, 16), CFrame.new(O), metal)
	p(V(16, 0.5, 16), CFrame.new(O + V(0, 14, 0)), metal)
	p(V(0.5, 14, 16), CFrame.new(O + V(-8, 7, 0)), metal)
	p(V(0.5, 14, 16), CFrame.new(O + V(8, 7, 0)), metal)
	p(V(16, 14, 0.5), CFrame.new(O + V(0, 7, 8)), metal)
	local lamp = p(V(10, 0.3, 2), CFrame.new(O + V(0, 13.6, 0)), RGB(255, 220, 170), Enum.Material.Neon)
	make("PointLight", { Range = 18, Brightness = 1.2, Color = RGB(255, 220, 170) }, lamp)
	-- решётка спереди и стена шахты за ней (бегущие вниз лампы — лифт едет вверх)
	for x = -7, 7, 1.4 do
		p(V(0.2, 13.5, 0.2), CFrame.new(O + V(x, 7, -8)), RGB(40, 40, 44), Enum.Material.Metal)
	end
	p(V(20, 80, 1), CFrame.new(O + V(0, 7, -12)), RGB(48, 46, 44), Enum.Material.Concrete)
	local strips = {}
	for k = 0, 5 do
		local s = p(V(14, 0.4, 0.4), CFrame.new(O + V(0, k * 12 - 20, -11.4)), RGB(255, 200, 140), Enum.Material.Neon)
		make("PointLight", { Range = 10, Brightness = 1, Color = RGB(255, 190, 120) }, s)
		table.insert(strips, s)
	end
	m.Parent = workspace
	-- друзья в лифте
	local spots = { V(-3.5, 0, 2), V(3.5, 0, 2), V(-4, 0, -3.5), V(4, 0, -3.5), V(0, 0, 5), V(-5.5, 0, 5), V(5.5, 0, 5) }
	local k = 0
	for _, who in ipairs(riders) do
		if who ~= player then
			k += 1
			local av = cloneAvatar(who)
			if av and spots[k] then
				local pos = O + spots[k] + V(0, 3, 0)
				av:PivotTo(CFrame.lookAt(pos, pos + V(0, 0, -1)))
				av.Parent = m
			end
		end
	end
	fade.BackgroundTransparency = 0
	TweenService:Create(fade, TweenInfo.new(1), { BackgroundTransparency = 1 }):Play()
	local diff = Config.Difficulty[diffId or "normal"]
	subtitle.Text = (diff and ("[" .. diff.Name .. "]  ") or "") .. (#riders > 1 and ("Вас " .. #riders .. ". Лифт поднимается... Куда?") or "Лифт поднимается... Куда?")
	local rumble = make("Sound", { SoundId = Config.Sounds.Rumble, Looped = true, Volume = 0.8, PlaybackSpeed = 0.3 }, SoundService)
	rumble:Play()
	local t0 = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function(dt)
		local t = os.clock() - t0
		for _, s in ipairs(strips) do
			local y = s.Position.Y - dt * 22
			if y < O.Y - 30 then
				y += 72
			end
			s.CFrame = CFrame.new(s.Position.X, y, s.Position.Z)
		end
		local jitter = CFrame.Angles(math.noise(t * 8, 1) * 0.01, math.noise(t * 8, 2) * 0.01, 0)
		cam.CFrame = CFrame.lookAt(O + V(0, 5.2, 4), O + V(0, 5.6, -8)) * jitter
		if t > duration - 2 and fade.BackgroundTransparency > 0.99 then
			fade.BackgroundColor3 = RGB(255, 250, 235)
			TweenService:Create(fade, TweenInfo.new(1.5), { BackgroundTransparency = 0 }):Play()
			subtitle.Text = "Свет... Мы наверху."
		end
	end)
	task.wait(duration)
	conn:Disconnect()
	rumble:Destroy()
	m:Destroy()
	subtitle.Text = ""
	-- экран остаётся белым, пока сервер строит лабиринт; дальше — ролик прибытия
	task.delay(25, function()
		if cutscene and not inMatch() then
			cutscene = false
			cam.CameraType = Enum.CameraType.Custom
			TweenService:Create(fade, TweenInfo.new(1), { BackgroundTransparency = 1 }):Play()
		end
	end)
end)

------------------------------------------------------------------
-- Прибытие: решётка лифта поднимается, выходишь и осматриваешься
------------------------------------------------------------------
local function smoothstep(a)
	return a * a * (3 - 2 * a)
end
local function runFor(duration, fn)
	local t0 = os.clock()
	while true do
		local a = math.clamp((os.clock() - t0) / duration, 0, 1)
		fn(a)
		if a >= 1 then
			break
		end
		RunService.RenderStepped:Wait()
	end
end

remote("Arrive").OnClientEvent:Connect(function(liftPos, riders)
	cutscene = true
	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Scriptable
	local eye0 = liftPos + V(0, 5.6, 4)
	local eye1 = liftPos + V(0, 5.8, -16)
	cam.CFrame = CFrame.lookAt(eye0, eye0 + V(0, 0, -10))
	TweenService:Create(fade, TweenInfo.new(1.6), { BackgroundTransparency = 1 }):Play()
	task.delay(1.6, function()
		fade.BackgroundColor3 = RGB(0, 0, 0)
	end)
	subtitle.Text = #riders > 1 and ("Вас " .. #riders .. ". Решётка поднимается...") or "Решётка поднимается..."
	shake(0.5)
	runFor(1.6, function()
		cam.CFrame = CFrame.lookAt(eye0, eye0 + V(0, 0.4, -10)) * CFrame.Angles(math.noise(os.clock() * 6) * 0.01, 0, 0)
	end)
	-- шаг из лифта
	runFor(2.4, function(a)
		local e = smoothstep(a)
		local pos = eye0:Lerp(eye1, e) + V(0, math.abs(math.sin(a * 2.4 * 7)) * 0.15, 0)
		cam.CFrame = CFrame.lookAt(pos, pos + V(0, 0.6 - e * 0.3, -10))
	end)
	subtitle.Text = "Поляна. Лес, река... и огромные стены со всех сторон."
	-- осматриваемся: налево, вверх на стены, направо, вперёд
	local function lookAt(yaw, pitch)
		return CFrame.new(eye1) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
	end
	local keys = { { 0, 0.03 }, { 0.95, 0.12 }, { 0.6, 0.45 }, { -0.95, 0.15 }, { 0, 0.02 } }
	for k = 1, #keys - 1 do
		local a0, a1 = keys[k], keys[k + 1]
		runFor(1.3, function(a)
			local e = smoothstep(a)
			cam.CFrame = lookAt(a0[1] + (a1[1] - a0[1]) * e, a0[2] + (a1[2] - a0[2]) * e)
		end)
	end
	subtitle.Text = ""
	cam.CameraType = Enum.CameraType.Custom
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		cam.CameraSubject = hum
	end
	cutscene = false
	Viewmodel.rebuild()
	Viewmodel.setItem("fists")
	notify("Нажми C — крафт. Подойди к дереву и зажми E, чтобы рубить.")
end)

------------------------------------------------------------------
-- Финал: дверь открыта, вертолёт садится и уносит всех из лабиринта
------------------------------------------------------------------
local function buildHeli(cf, K)
	K = K or 1
	local m = Instance.new("Model")
	m.Name = "Helicopter"
	local function p(size, rel, color, mat, extra)
		size = size * K
		rel = CFrame.new(rel.Position * K) * rel.Rotation
		local pt = make("Part", { Anchored = true, CanCollide = false, CanQuery = false, Size = size, Color = color, Material = mat or Enum.Material.SmoothPlastic }, m)
		if extra then
			for k, v in pairs(extra) do
				pt[k] = v
			end
		end
		pt:SetAttribute("Rel", rel)
		return pt
	end
	local white, red, dark, glass = RGB(232, 232, 236), RGB(200, 45, 40), RGB(35, 36, 40), RGB(60, 110, 140)
	local M = Enum.Material
	-- кабина: корпус, нос, стёкла, полосы
	p(V(7.5, 6.5, 11), CFrame.new(0, 4.8, 0), white, M.SmoothPlastic)
	p(V(7.6, 1, 11.1), CFrame.new(0, 3.2, 0), red, M.SmoothPlastic)
	p(V(6.5, 5, 4), CFrame.new(0, 4.4, -7), white, M.SmoothPlastic)
	p(V(6, 3, 0.3), CFrame.new(0, 5.6, -9.05), glass, M.Glass, { Transparency = 0.35 })
	for _, x in ipairs({ -3.8, 3.8 }) do
		p(V(0.2, 2.6, 3.6), CFrame.new(x, 5.8, -6.6), glass, M.Glass, { Transparency = 0.35 })
		p(V(0.2, 2.6, 3.4), CFrame.new(x, 5.8, -1.5), glass, M.Glass, { Transparency = 0.35 })
		p(V(0.25, 4.6, 3.6), CFrame.new(x, 4.6, 2.6), dark, M.Metal) -- проём двери
	end
	p(V(5, 1.2, 6), CFrame.new(0, 8.4, 1), white, M.SmoothPlastic) -- двигатель
	-- хвост
	p(V(1.8, 1.8, 16), CFrame.new(0, 6.2, 13), white, M.SmoothPlastic)
	p(V(1.85, 0.5, 16.1), CFrame.new(0, 6.6, 13), red, M.SmoothPlastic)
	p(V(0.4, 5, 3), CFrame.new(0, 8.5, 20.5), white, M.SmoothPlastic)
	p(V(5, 0.3, 2), CFrame.new(0, 6.4, 19), white, M.SmoothPlastic)
	-- полозья
	for _, x in ipairs({ -3.6, 3.6 }) do
		p(V(0.5, 0.5, 15), CFrame.new(x, 0.3, 0), dark, M.Metal)
		p(V(0.35, 1.8, 0.35), CFrame.new(x, 1.3, -3.5), dark, M.Metal)
		p(V(0.35, 1.8, 0.35), CFrame.new(x, 1.3, 3.5), dark, M.Metal)
	end
	-- винты
	p(V(0.8, 1.4, 0.8), CFrame.new(0, 9.6, 1), dark, M.Metal)
	for k = 0, 1 do
		local blade = p(V(34, 0.2, 1.3), CFrame.new(0, 10.3, 1), dark, M.Metal)
		blade:SetAttribute("Blade", k * math.pi / 2)
	end
	for k = 0, 1 do
		local tb = p(V(0.15, 4.5, 0.5), CFrame.new(0.5, 8.6, 21.5), dark, M.Metal)
		tb:SetAttribute("TailBlade", k * math.pi / 2)
	end
	local lamp = p(V(0.8, 0.8, 0.3), CFrame.new(0, 2.8, -9.1), RGB(255, 250, 220), M.Neon)
	make("SpotLight", { Face = Enum.NormalId.Front, Range = 60, Angle = 50, Brightness = 4 }, lamp)
	local beacon = p(V(0.5, 0.5, 0.5), CFrame.new(0, 8.4, 20.5), RGB(255, 40, 40), M.Neon)
	local _ = beacon
	m.Parent = workspace
	local spin = 0
	local function setCF(c, dt)
		spin += (dt or 0) * 25
		for _, d in ipairs(m:GetChildren()) do
			if d:IsA("BasePart") then
				local rel = d:GetAttribute("Rel")
				local b = d:GetAttribute("Blade")
				local tb = d:GetAttribute("TailBlade")
				if b then
					d.CFrame = c * rel * CFrame.Angles(0, spin + b, 0)
				elseif tb then
					d.CFrame = c * rel * CFrame.Angles(spin * 1.5 + tb, 0, 0)
				else
					d.CFrame = c * rel
				end
			end
		end
	end
	setCF(cf)
	return m, setCF
end

-- ходьба от первого лица по точкам: покачивание, шаги, друзья рядом
local function walkPath(cam, points, duration, opts)
	opts = opts or {}
	local total = 0
	local segLen = {}
	for k = 1, #points - 1 do
		segLen[k] = (points[k + 1] - points[k]).Magnitude
		total += segLen[k]
	end
	local t0 = os.clock()
	local nextStep = 0
	runFor(duration, function(a)
		local t = os.clock() - t0
		local dist = total * smoothstep(a)
		local k, acc = 1, 0
		while k < #points - 1 and acc + segLen[k] < dist do
			acc += segLen[k]
			k += 1
		end
		local f = segLen[k] > 0 and math.clamp((dist - acc) / segLen[k], 0, 1) or 1
		local pos = points[k]:Lerp(points[k + 1], f)
		local dir = (points[k + 1] - points[k])
		dir = dir.Magnitude > 0.01 and dir.Unit or V(0, 0, -1)
		local bob = math.sin(t * 9) * 0.2
		local side = math.cos(t * 4.5) * 0.1
		local look = opts.lookAt and opts.lookAt(a, pos) or (pos + dir * 10 + V(0, (opts.pitch or 0) * 10, 0))
		cam.CFrame = CFrame.lookAt(pos + V(side, bob, 0), look) * CFrame.Angles(0, 0, math.cos(t * 4.5) * 0.01)
		if t >= nextStep and a < 0.98 then
			nextStep = t + (opts.stepGap or 0.48)
			sound(Config.Sounds.Step, 0.35, (opts.stepPitch or 0.75) + math.random() * 0.15)
		end
		if opts.each then
			opts.each(a, pos, dir, t)
		end
	end)
end

-- ролик у выхода: туннель → мост над пропастью → дверь лаборатории и считыватель
remote("ExitIntro").OnClientEvent:Connect(function(pts, readerPos)
	cutscene = true
	craft.Visible = false
	Radial.close()
	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Scriptable
	local fwd = ((pts[3] - pts[1]) * V(1, 0, 1)).Unit
	local right = fwd:Cross(V(0, 1, 0))
	subtitle.Text = "Выход... Огромный проход — и сразу пропасть."
	walkPath(cam, { pts[1], pts[2] }, 1.8)
	subtitle.Text = "Не смотри вниз. Только по мосту."
	walkPath(cam, { pts[2], pts[3] }, 3.4, {
		stepGap = 0.6,
		stepPitch = 0.55,
		lookAt = function(a, pos)
			local down = math.sin(math.clamp((a - 0.1) / 0.5, 0, 1) * math.pi) * 9
			return pos + fwd * 10 - V(0, down, 0) + right * math.sin(a * 6) * 1.5
		end,
	})
	local eye = pts[3]
	local fromLook = eye + fwd * 10
	subtitle.Text = "Дверь... и считыватель. Ключ-карта! Нужно приложить ключ-карту."
	runFor(1.2, function(a)
		cam.CFrame = CFrame.lookAt(eye, fromLook:Lerp(readerPos, smoothstep(a)))
	end)
	task.wait(1.2)
	subtitle.Text = ""
	cam.CameraType = Enum.CameraType.Custom
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		cam.CameraSubject = hum
	end
	cutscene = false
	notify("Достань ключ-карту и приложи к считывателю (E). Ключ-карта — в золотом сундуке.")
end)

-- достаём ключ-карту из кармана и прикладываем к считывателю
remote("CardInsert").OnClientEvent:Connect(function(readerPos)
	cutscene = true
	Radial.close()
	local cam = workspace.CurrentCamera
	local eye = cam.CFrame.Position
	cam.CameraType = Enum.CameraType.Scriptable
	local from = cam.CFrame
	runFor(0.5, function(a)
		cam.CFrame = from:Lerp(CFrame.lookAt(eye, readerPos), smoothstep(a))
	end)
	Viewmodel.card()
	task.wait(1.1)
	sound(Config.Sounds.Click, 0.8, 1.6)
	task.wait(0.2)
	sound(Config.Sounds.Click, 0.8, 2)
end)

remote("MazeShift").OnClientEvent:Connect(function()
	shake(0.9)
	sound(Config.Sounds.Rumble, 1.5, 0.35)
	task.delay(1.2, function()
		shake(0.6)
	end)
end)

remote("Outro").OnClientEvent:Connect(function(info)
	cutscene = true
	craft.Visible = false
	Radial.close()
	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Scriptable
	local temp = {}
	local mazeCenter = info.mazeCenter
	local b = info.exitOut
	local fwd = b.LookVector

	-- друзья идут рядом
	local friends = {}
	local k = 0
	for _, who in ipairs(info.players) do
		if who ~= player then
			k += 1
			local av = cloneAvatar(who)
			if av then
				av.Parent = workspace
				table.insert(temp, av)
				table.insert(friends, { m = av, side = (k % 2 == 1) and -3.5 or 3.5, back = 2 + math.floor((k - 1) / 2) * 3.5 })
			end
		end
	end
	local function moveFriends(pos, dir, t)
		local right = dir:Cross(V(0, 1, 0))
		for _, f in ipairs(friends) do
			local fp = pos + right * f.side - dir * f.back - V(0, 2.4, 0) + V(0, math.abs(math.sin(t * 9)) * 0.25, 0)
			f.m:PivotTo(CFrame.lookAt(fp, fp + dir))
		end
	end

	-- 1. дверь лаборатории поднимается
	local eye0 = info.doorEye
	subtitle.Text = "Дверь открывается..."
	runFor(3, function()
		cam.CFrame = CFrame.lookAt(eye0, info.labStart.Position) * CFrame.Angles(math.noise(os.clock() * 3) * 0.008, 0, 0)
	end)

	-- 2. идём через пустую лабораторию
	subtitle.Text = "Лаборатория... Здесь никого нет. Будто все ушли в спешке."
	walkPath(cam, { eye0, info.labStart.Position, info.labEnd.Position }, 11, {
		stepPitch = 0.9,
		lookAt = function(a, pos)
			local sway = math.sin(a * math.pi * 3) * 6
			return pos + fwd * 10 + b.RightVector * sway - V(0, 1, 0)
		end,
		each = function(_, pos, dir, t)
			moveFriends(pos, dir, t)
		end,
	})

	-- 3. вторая дверь открывается — снаружи свет и шум винтов
	subtitle.Text = "Ещё одна дверь..."
	local back = info.backDoor
	if back and back.Parent then
		local goal = back.CFrame + V(0, 11, 0)
		TweenService:Create(back, TweenInfo.new(2.4, Enum.EasingStyle.Sine), { CFrame = goal }):Play()
	end
	local eye1 = info.labEnd.Position
	runFor(2.6, function()
		cam.CFrame = CFrame.lookAt(eye1, eye1 + fwd * 10) * CFrame.Angles(math.noise(os.clock() * 4) * 0.01, 0, 0)
	end)

	-- 4. огромный вертолёт садится на площадку
	local K = 1.8
	local pad = info.pad
	local heliCF = pad * CFrame.new(0, 0.6 * K, 0) * CFrame.Angles(0, math.pi / 2, 0)
	local startCF = heliCF + V(0, 140, 0) + fwd * 160
	local heli, setCF = buildHeli(startCF, K)
	table.insert(temp, heli)
	local rotor = make("Sound", { SoundId = Config.Sounds.Rumble, Looped = true, Volume = 1, PlaybackSpeed = 0.7 }, SoundService)
	rotor:Play()
	subtitle.Text = "Вертолёт! Он садится прямо перед нами!"
	local outside = (pad * CFrame.new(0, 5.3, 0)).Position - fwd * 34
	local heliNow = startCF
	walkPath(cam, { eye1, outside }, 9, {
		lookAt = function(_, pos)
			local hp = heliNow.Position
			return pos:Lerp(hp, 0.5) + (hp - pos).Unit * 10
		end,
		each = function(a, pos, dir, t)
			moveFriends(pos, dir, t)
			local e = smoothstep(math.clamp(a * 1.15, 0, 1))
			local cf = startCF:Lerp(heliCF, e) * CFrame.Angles(0.12 * (1 - e), 0, math.sin(t * 1.3) * 0.04 * (1 - e))
			heliNow = cf
			setCF(cf, 1 / 60)
			if e > 0.85 then
				shake(0.02)
			end
		end,
	})
	runFor(1.5, function()
		setCF(heliCF, 1 / 60)
		cam.CFrame = CFrame.lookAt(outside, heliCF.Position)
	end)

	-- 5. садимся у открытой боковой двери
	subtitle.Text = "Залезаем!"
	fade.BackgroundColor3 = RGB(0, 0, 0)
	TweenService:Create(fade, TweenInfo.new(0.4), { BackgroundTransparency = 0 }):Play()
	task.wait(0.45)
	for _, f in ipairs(friends) do
		f.m:Destroy()
	end
	local seat = CFrame.new(5.4 * K, 4.6 * K, 2.6 * K)
	cam.CFrame = CFrame.lookAt((heliCF * seat).Position, (heliCF * CFrame.new(30 * K, 2, 2.6 * K)).Position)
	TweenService:Create(fade, TweenInfo.new(0.6), { BackgroundTransparency = 1 }):Play()

	-- 6. взлёт: высоко над лабиринтом, смотрим на него целиком
	subtitle.Text = "Взлетаем... Вот он — весь лабиринт."
	local high = heliCF.Position:Lerp(mazeCenter, 0.35) + V(0, 520, 0)
	runFor(11, function(a)
		local e = smoothstep(a)
		local pos = heliCF.Position:Lerp(high, e)
		local toMaze = (mazeCenter - pos) * V(1, 0, 1)
		local hc = CFrame.lookAt(pos, pos + V(toMaze.Z, 0, -toMaze.X)) * CFrame.Angles(-0.08 * math.sin(a * math.pi), 0, 0)
		setCF(hc, 1 / 60)
		cam.CFrame = CFrame.lookAt((hc * seat).Position, mazeCenter) * CFrame.Angles(math.noise(os.clock() * 5) * 0.006, 0, 0)
	end)
	task.wait(2.5)

	-- 7. улетаем к горизонту
	subtitle.Text = "Прощай, лабиринт."
	local away = (high - mazeCenter) * V(1, 0, 1)
	away = away.Magnitude > 1 and away.Unit or V(1, 0, 0)
	runFor(5, function(a)
		local pos = high + away * 700 * a * a + V(0, 60 * a, 0)
		local hc = CFrame.lookAt(pos, pos + V(-away.Z, 0, away.X))
		setCF(hc, 1 / 60)
		cam.CFrame = CFrame.lookAt((hc * seat).Position, mazeCenter)
	end)
	rotor:Destroy()
	for _, d in ipairs(temp) do
		if d.Parent then
			d:Destroy()
		end
	end
	TweenService:Create(fade, TweenInfo.new(1.2), { BackgroundTransparency = 0 }):Play()
	task.wait(1.3)
	subtitle.Text = ""
	lobbyLabel.ZIndex = 22
	lobbyLabel.Text = "ВЫ ВЫБРАЛИСЬ ИЗ ЛАБИРИНТА!\nДней в лабиринте: " .. info.day .. "   ·   +" .. info.coins .. " монет"
	task.wait(4)
	-- ждём, пока сервер вернёт нас в лобби, и только потом убираем чёрный экран
	local waitT = os.clock()
	while inMatch() and os.clock() - waitT < 14 do
		task.wait(0.1)
	end
	local char = player.Character or player.CharacterAdded:Wait()
	local hum = char:WaitForChild("Humanoid", 5)
	task.wait(0.3)
	char = player.Character
	hum = char and char:FindFirstChildOfClass("Humanoid") or hum
	cam.CameraType = Enum.CameraType.Custom
	if hum then
		cam.CameraSubject = hum
	end
	lobbyLabel.Text = ""
	lobbyLabel.ZIndex = 1
	cutscene = false
	TweenService:Create(fade, TweenInfo.new(1.5), { BackgroundTransparency = 1 }):Play()
end)

------------------------------------------------------------------
-- Каждый кадр: интерфейс, прицел, руки, бег
------------------------------------------------------------------
local devCursorOn = false
local fullLightOn = false
local cursorFree = false
local function cursorForced()
	return devCursorOn or cursorFree
end
local function staminaMax()
	return Config.StaminaMax + (player:GetAttribute("Class") == "runner" and 60 or 0)
end
local function className(id)
	for _, c in ipairs(Config.Classes) do
		if c.Id == id then
			return c.Name
		end
	end
	return "Без класса"
end

-- освещение: у каждой группы своё время суток
local atmo = Lighting:FindFirstChildOfClass("Atmosphere")
local cc = Lighting:FindFirstChildOfClass("ColorCorrectionEffect")
local rays = Lighting:FindFirstChildOfClass("SunRaysEffect")
local function applyLighting(phase, a)
	if fullLightOn then
		return
	end
	atmo = atmo or Lighting:FindFirstChildOfClass("Atmosphere")
	cc = cc or Lighting:FindFirstChildOfClass("ColorCorrectionEffect")
	rays = rays or Lighting:FindFirstChildOfClass("SunRaysEffect")
	local clock, night = 14, 0
	if phase == "day" then
		clock = 6.5 + a * 11.5
		night = math.clamp((clock - 16.5) / 2, 0, 1) * 0.5 + math.clamp((7.5 - clock) / 1, 0, 1) * 0.5
	elseif phase == "night" then
		clock = (18.2 + a * 12.1) % 24
		night = 0.5 + 0.5 * math.clamp(math.min(a, 1 - a) / 0.08, 0, 1)
	end
	local function mix(x, y)
		return x:Lerp(y, night)
	end
	Lighting.ClockTime = clock
	-- светлее: даже ночью всё хорошо видно (лунный свет)
	Lighting.Brightness = 4.5 - night * 2.2
	Lighting.ExposureCompensation = 0.6 - night * 0.05
	Lighting.Ambient = mix(RGB(150, 145, 135), RGB(95, 102, 130))
	Lighting.OutdoorAmbient = mix(RGB(200, 196, 186), RGB(120, 130, 165))
	if atmo then
		atmo.Density = 0.22 + night * 0.08
		atmo.Haze = 1.2 + night * 1.2
		atmo.Color = mix(RGB(200, 190, 170), RGB(60, 70, 100))
		atmo.Decay = mix(RGB(110, 100, 90), RGB(20, 22, 40))
	end
	if cc then
		cc.TintColor = mix(RGB(255, 245, 230), RGB(190, 205, 255))
		cc.Saturation = 0.1 - night * 0.35
		cc.Contrast = 0.12
	end
	if rays then
		rays.Intensity = 0.12 * (1 - night)
	end
end

-- монеты (в лобби): золотая монета с гравировкой Скрежетника и счётчик
