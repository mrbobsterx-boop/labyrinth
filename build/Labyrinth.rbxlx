		Rotation = math.deg(a),
		BackgroundColor3 = RGB(30 + k % 3 * 10, 70 + k % 4 * 8, 30),
		BackgroundTransparency = 0.15,
		ZIndex = 5,
	}, restPanel)
	corner(f, 200)
